#!/bin/sh
# Transport for a host that is reached by password on its own port and whose user is not in the
# docker group. `EPC_DEPLOY_SSH=deploy/ssh-with-password` makes epc-deploy call this in place of ssh;
# EPC_DEPLOY_SUDO=1 stays the deploy's own business.
#
#   EPC_DEPLOY_SSH_PORT      the port, default 22
#   EPC_DEPLOY_SSH_PASSWORD  the login password, which is also the sudo password
#
# The password never enters a command line on either machine: ssh asks this same script for it
# through SSH_ASKPASS, and sudo reads it as the first line of every remote command's stdin, which
# `sudo -k -S -v` consumes before the command itself sees the rest (the image stream, the env file).
# -k makes sudo always ask, so the line can never fall through into the command's input.
set -eu

if [ -n "${SSH_WITH_PASSWORD_ASKPASS:-}" ]; then
	printf '%s\n' "$EPC_DEPLOY_SSH_PASSWORD"
	exit 0
fi

[ -n "${EPC_DEPLOY_SSH_PASSWORD:-}" ] || { printf 'ssh-with-password: EPC_DEPLOY_SSH_PASSWORD is unset\n' >&2; exit 1; }
[ $# -eq 2 ] || { printf 'ssh-with-password: expected <user@host> <command>\n' >&2; exit 2; }
target=$1
command=$2
port=${EPC_DEPLOY_SSH_PORT:-22}

self=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")
export SSH_ASKPASS="$self" SSH_ASKPASS_REQUIRE=force SSH_WITH_PASSWORD_ASKPASS=1 DISPLAY="${DISPLAY:-none:0}"
remote_command="sudo -k -S -v 2>/dev/null && { $command
}"

if [ -p /dev/stdin ]; then
	{ printf '%s\n' "$EPC_DEPLOY_SSH_PASSWORD"; cat; } | exec ssh -p "$port" -o StrictHostKeyChecking=yes "$target" "$remote_command"
else
	printf '%s\n' "$EPC_DEPLOY_SSH_PASSWORD" | exec ssh -p "$port" -o StrictHostKeyChecking=yes "$target" "$remote_command"
fi
