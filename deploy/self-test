#!/bin/sh
set -eu

deploy_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
script="$deploy_dir/epc-deploy"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
stub_bin="$work/bin"
mkdir -p "$stub_bin"
failures=0

check() {
	if [ "$2" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s\n' "$1"
		failures=$((failures + 1))
	fi
}

cat > "$stub_bin/docker" <<'DOCKER_STUB'
#!/bin/sh
set -e
side=${EPC_STUB_SIDE:-local}
line="$side docker"
for argument in "$@"; do line="$line $argument"; done
printf '%s\n' "$line" >> "$EPC_STUB_JOURNAL"

target=
for argument in "$@"; do target=$argument; done
sanitise() { printf '%s' "$1" | tr '/:' '__'; }

case ${1:-} in
	build) exit 0 ;;
	save) printf 'fake-image-stream\n'; exit 0 ;;
	load) cat >/dev/null; printf 'Loaded image: %s\n' "$target"; exit 0 ;;
	rm) exit 0 ;;
	tag)
		[ "${EPC_STUB_TAG_STATUS:-0}" -eq 0 ] || exit "$EPC_STUB_TAG_STATUS"
		printf '%s' "$2" > "$EPC_STUB_STATE/tagged-$(sanitise "$target")"
		exit 0 ;;
	stop)
		if [ -n "${EPC_STUB_STOP_ECHO:-}" ]; then
			printf '%s\n' "$EPC_STUB_STOP_ECHO"
		elif [ -z "${EPC_STUB_STOP_SILENT:-}" ]; then
			printf '%s\n' "$target"
		fi
		exit "${EPC_STUB_STOP_STATUS:-0}" ;;
	ps)
		[ -z "${EPC_STUB_PS:-}" ] || printf '%s\n' "$EPC_STUB_PS"
		exit 0 ;;
	inspect)
		kind=unpinned
		case " $* " in
			*" --type container "*) kind=container ;;
			*" --type image "*) kind=image ;;
		esac
		format=
		previous=
		for argument in "$@"; do
			if [ "$previous" = -f ]; then format=$argument; fi
			previous=$argument
		done
		case $kind in
			unpinned)
				printf '%s\n' 'sha256:imagefallback||sha256:imagefallback|||'
				exit 0 ;;
			container)
				if [ -n "${EPC_STUB_CONTAINER_MISSING:-}" ]; then
					printf 'Error: No such container: %s\n' "$target" >&2
					exit 1
				fi
				case $format in
					*RestartPolicy*) printf '%s\n' "$EPC_STUB_CONTAINER" ;;
					*) printf '%s\n' "${EPC_STUB_STARTED_IMAGE:-$EPC_STUB_REMOTE_IMAGE_ID}" ;;
				esac
				exit 0 ;;
			image)
				if [ "$side" = local ]; then
					[ -z "${EPC_STUB_LOCAL_IMAGE_MISSING:-}" ] || exit 1
					printf '%s\n' "$EPC_STUB_LOCAL_IMAGE_ID"
					exit 0
				fi
				case $target in
					*:pre-*)
						tagged="$EPC_STUB_STATE/tagged-$(sanitise "$target")"
						if [ -f "$tagged" ]; then
							cat "$tagged"
							printf '\n'
							exit 0
						fi
						[ -n "${EPC_STUB_ROLLBACK_TAG_ID:-}" ] || exit 1
						printf '%s\n' "$EPC_STUB_ROLLBACK_TAG_ID"
						exit 0 ;;
				esac
				[ -z "${EPC_STUB_REMOTE_IMAGE_MISSING:-}" ] || exit 1
				printf '%s\n' "$EPC_STUB_REMOTE_IMAGE_ID"
				exit 0 ;;
		esac ;;
	run)
		case " $* " in
			*" --entrypoint "*)
				mount=
				body=
				previous=
				for argument in "$@"; do
					if [ "$previous" = -v ]; then mount=$argument; fi
					if [ "$previous" = -c ]; then body=$argument; fi
					previous=$argument
				done
				source_directory=${mount%%:*}
				body=$(printf '%s' "$body" | sed "s#/database#$source_directory#g")
				if [ -n "${EPC_STUB_PROBE_TRUNCATE:-}" ]; then
					body=$(printf '%s' "$body" | sed 's#: >>#: >#')
				fi
				output=$(sh -c "$body" 2>&1) || true
				if [ -n "${EPC_STUB_PROBE_SUPPRESS:-}" ]; then
					output=$(printf '%s\n' "$output" | grep -v "$EPC_STUB_PROBE_SUPPRESS" || true)
				fi
				printf '%s\n' "$output"
				exit "${EPC_STUB_PROBE_STATUS:-0}" ;;
		esac
		previous=
		for argument in "$@"; do
			if [ "$previous" = --env-file ]; then cp "$argument" "$EPC_STUB_STATE/env-file"; fi
			previous=$argument
		done
		: > "$EPC_STUB_STATE/started"
		printf 'fake-container-id\n'
		exit 0 ;;
esac
printf 'docker stub: unhandled %s\n' "$*" >&2
exit 90
DOCKER_STUB

cat > "$stub_bin/curl" <<'CURL_STUB'
#!/bin/sh
set -e
line="curl"
for argument in "$@"; do line="$line $argument"; done
printf '%s\n' "$line" >> "$EPC_STUB_JOURNAL"
