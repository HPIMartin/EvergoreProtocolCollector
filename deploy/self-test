	*/health*) printf '%s' "$EPC_STUB_HEALTH" ;;
	*/api/v1/avatars*) printf '%s' "${EPC_STUB_UNAUTH_CODE:-401}" ;;
	*) printf '%s' "${EPC_STUB_ROOT_CODE:-200}" ;;
esac
CURL_STUB

