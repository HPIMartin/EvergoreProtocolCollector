#!/bin/sh
# git builds a merge commit itself and asks pre-commit for none of them, so a merge gets its own
# hook. It runs on the resolved index before the merge commit exists, so like pre-applypatch it
# refuses outright rather than recording after the fact. `main` advances only by fast-forwards
# (the author's landing push, `git merge --ff-only refs/remotes/origin/main`, handbook §7), which
# create no commit at all; this gates the content of a merge somebody makes by mistake.
set -eu

cd "$(git rev-parse --show-toplevel)"
hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

"$hooks_dir/breach-guard"
"$hooks_dir/content-gate" --staged

if ! "$hooks_dir/format-gate"; then
	printf '\n[pre-merge-commit] format/style gate failed on the merge result.\n' >&2
	exit 1
fi
