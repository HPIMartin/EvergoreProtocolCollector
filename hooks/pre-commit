#!/bin/sh
# The pre-commit quality gate. It leaves the project's test run and its build out, to keep the TDD
# micro-commit loop fast; every commit is already green by the time it is made. A commit that
# touches a tooling folder with a self-test runs that folder's whole suite (hooks/self-test-legs).
# Active via: git config core.hooksPath hooks (wire that into the devcontainer postCreate).
set -eu

cd "$(git rev-parse --show-toplevel)"
hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

reject() {
	printf '\n[pre-commit] %s\n' "$1" >&2
	exit 1
}

# A merge git left in progress (refused by pre-merge-commit, stopped by --no-commit, or halted on a
# conflict) would be concluded here as a merge commit; work lands by rebase and fast-forward only.
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
	reject "a merge is in progress and this commit would conclude it as a merge commit. Run 'git merge --abort' and land by rebase and fast-forward (handbook §7)."
fi

# A rebase stopped at a conflict is finished by `git rebase --continue`; a commit or an amend there
# would fold the conflicted state into the wrong commit. An edit or reword stop is none: git writes
# rebase-merge/amend there, but at a fixup or squash conflict stop too, so the last done line naming
# the edit or the reword is what tells them apart. A fixup or squash whose message editor failed
# leaves the same files as its conflict stop and is refused alike; `git rebase --continue` finishes
# it. --git-path resolves each path in a linked worktree too.
stopped_at_edit() {
	[ -f "$(git rev-parse --git-path rebase-merge/amend)" ] \
		&& tail -n 1 "$(git rev-parse --git-path rebase-merge/done)" 2>/dev/null | grep -qE '^(edit|reword)'
}

stopped_at_conflict() {
	{ [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; } \
		&& git rev-parse -q --verify REBASE_HEAD >/dev/null \
		&& ! stopped_at_edit
}

if stopped_at_conflict; then
	reject "a rebase stopped here, at a conflict or at a fixup or squash that could not finish. Run 'git rebase --continue', after resolving any conflict, never a commit or an amend, which would fold this state into the wrong commit."
fi

"$hooks_dir/breach-guard"

"$hooks_dir/content-gate" --staged

# The self-test legs run the staged suites of the folders the commit touches (self-test-legs).
"$hooks_dir/self-test-legs" pre-commit

# The agent entry files carry one section verbatim. It is compared from the staged blobs, falling
# back to HEAD for the file the commit does not touch, so editing one of the two alone is caught.
entry_wrapper=CLAUDE.md
entry_template=docs/knowledge-base/agent-entry-template.md

entry_blob() {
	git show ":$1" 2>/dev/null || git show "HEAD:$1" 2>/dev/null || true
}

shared_section() {
	entry_blob "$1" | awk '
		/^## SHARED section/ { inside = 1; print; next }
		inside && (/^## / || $0 == "---") { exit }
		inside { print }
	'
}

if git diff --cached --name-only --diff-filter=ACM -- "$entry_wrapper" "$entry_template" | grep -q .; then
	printf '[pre-commit] entry-file SHARED section...\n'
	scratch=$(mktemp -d)
	trap 'rm -rf "$scratch"' EXIT
	shared_section "$entry_template" > "$scratch/${entry_template##*/}"
	shared_section "$entry_wrapper" > "$scratch/${entry_wrapper##*/}"
	diff -u "$scratch/${entry_template##*/}" "$scratch/${entry_wrapper##*/}" >&2 \
		|| reject "the SHARED section of $entry_wrapper no longer matches $entry_template (diff above). Re-sync the wrapper; the template is the source."
	template_version=$(entry_blob "$entry_template" | sed -n 's/.*\*\*Template version: \([0-9][0-9]*\)\.\*\*.*/\1/p' | head -n 1)
	if [ -n "$template_version" ]; then
		entry_blob "$entry_wrapper" | sed -n '1,/^## SHARED section/p' | grep -qE "version: $template_version([^0-9]|$)" \
			|| reject "$entry_wrapper does not record template version $template_version. A version bump lands in the template and in every wrapper together."
	fi
fi

"$hooks_dir/format-gate" || reject "formatting/style gate failed. Run your stack's format command (hooks/format-gate names it), fix what it cannot, then restage."

# The tree this hook approved, so post-rewrite can tell an amend of it from an ungated commit.
git write-tree > "$(git rev-parse --git-dir)/gate-stamp"
