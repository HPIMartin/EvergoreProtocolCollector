	'fetched listed noninteractive install -y --no-install-recommends --allow-downgrades tmux docker-ce=PIN docker-ce-cli=PIN containerd.io=PIN docker-buildx-plugin=PIN docker-compose-plugin=PIN' \
	'fetched listed interactive clean')" ] || r=1
check 'apt fetches the tools first, then tmux and every Docker package pinned from the signed repository, then cleans up' "$r"

r=0
[ -d "$stub/root/var/lib/apt/lists" ] && [ -z "$(find "$stub/root/var/lib/apt/lists" -mindepth 1)" ] || r=1
check 'the apt lists are emptied, their directory stays' "$r"

r=0
[ "$(system_config core.hooksPath)" = hooks ] && [ "$(system_config push.default)" = nothing ] || r=1
check 'the system git config sets core.hooksPath to hooks and push.default to nothing' "$r"

r=0
grep -qx -- '-aG docker vscode' "$stub/usermod" || r=1
check 'vscode is added to the docker group' "$r"

r=0
home="$stub/root/home/vscode"
grep -qx -- "-d -o vscode -g vscode $stub/root/workspaces $home/.claude $home/.npm" "$stub/install" &&
	grep -qx -- "-d -m 0700 -o vscode -g vscode $home/.ssh" "$stub/install" || r=1
check 'the mount points are created owned by vscode, ~/.npm among them, ~/.ssh with mode 0700, and ~/.local, which holds Claude Code, is none' "$r"

r=0
[ -n "$(downloaded_file)" ] && [ ! -e "$(dirname "$(downloaded_file)")" ] || r=1
check 'the downloaded key leaves no temporary directory behind' "$r"

new_tool_case provision-cache-dirs
run_tool "$(tool_copy provision cache_dirs "'.npm .m2'")" --root "$stub/root"
r=0
home="$stub/root/home/vscode"
[ "$status" -eq 0 ] && grep -qx -- "-d -o vscode -g vscode $stub/root/workspaces $home/.claude $home/.npm $home/.m2" "$stub/install" || r=1
check 'every cache folder the cache_dirs line names is created owned by vscode' "$r"

new_tool_case provision-release
printf 'ID="debian"\nVERSION_CODENAME="trixie"\n' > "$stub/root/etc/os-release"
run_tool "$(tool_copy provision debian_release trixie)" --root "$stub/root"
r=0
[ "$status" -eq 0 ] && [ "$(cat "$stub/root/etc/apt/sources.list.d/docker.list")" = 'deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian trixie stable' ] || r=1
check 'docker.list names the Debian release the debian_release line holds, matched by a quoted os-release' "$r"

for os_case in other-release other-distribution no-os-release; do
	new_tool_case "provision-$os_case"
	case $os_case in
		other-release)
			printf 'ID=debian\nVERSION_CODENAME=trixie\n' > "$stub/root/etc/os-release"
			description='a base image of another Debian release than the debian_release line' ;;
		other-distribution)
			printf 'ID=ubuntu\nVERSION_CODENAME=bookworm\n' > "$stub/root/etc/os-release"
			description='a base image of another distribution than Debian' ;;
		no-os-release)
			mv "$stub/root/etc/os-release" "$stub/root/etc/os-release.gone"
			description='a base image without /etc/os-release' ;;
	esac
	run_tool "$(shipped_tool provision)" --root "$stub/root"
	r=0
	[ "$status" -eq 1 ] && [ ! -e "$stub/apt-get" ] && [ ! -e "$stub/curl" ] && grep -q 'debian_release' "$stub/err" || r=1
	check "$description is refused before any call, naming the debian_release line" "$r"
done

for refusal in foreign-key second-key secret-key foreign-key-first secret-key-first key-listing-fails key-download-fails; do
	new_tool_case "provision-$refusal"
	case $refusal in
		foreign-key) foreign_key > "$stub/colons" ;;
		second-key) foreign_key >> "$stub/colons" ;;
		secret-key) secret_key >> "$stub/colons" ;;
		foreign-key-first) { foreign_key; genuine_key; } > "$stub/colons" ;;
		secret-key-first) { secret_key; genuine_key; } > "$stub/colons" ;;
		key-listing-fails) touch "$stub/gpg.show.fail" ;;
		key-download-fails) touch "$stub/curl.fail" ;;
	esac
	run_tool "$(shipped_tool provision)" --root "$stub/root"
	r=0
	[ "$status" -ne 0 ] && nothing_installed_from_docker && [ ! -e "$stub/root/etc/apt/keyrings/docker.gpg" ] &&
		[ ! -e "$stub/root/etc/apt/sources.list.d/docker.list" ] && [ ! -e "$stub/gitconfig" ] &&
		[ -n "$(downloaded_file)" ] && [ ! -e "$(dirname "$(downloaded_file)")" ] || r=1
	case $refusal in
		foreign-key) description='a key with another fingerprint is refused before apt trusts it' ;;
		second-key) description='a second key beside the genuine one is refused before apt trusts either' ;;
		secret-key) description='a secret key beside the genuine one is refused before apt trusts either' ;;
		foreign-key-first) description='a key listed before the genuine one is refused before apt trusts either' ;;
		secret-key-first) description='a secret key listed before the genuine one is refused before apt trusts either' ;;
		key-listing-fails) description='gpg failing after it listed the genuine key stops provision before apt trusts anything' ;;
		key-download-fails) description='a failed key download stops provision before apt trusts anything' ;;
	esac
	check "$description" "$r"
done

for usage in missing-root no-root-value other-option extra-argument; do
	new_tool_case "provision-$usage"
	case $usage in
		missing-root) run_tool "$(shipped_tool provision)" --root "$stub/missing"; description='a root that does not exist' ;;
		no-root-value) run_tool "$(shipped_tool provision)" --root; description='--root without a directory' ;;
		other-option) run_tool "$(shipped_tool provision)" --prefix "$stub/root"; description='another option' ;;
		extra-argument) run_tool "$(shipped_tool provision)" --root "$stub/root" extra; description='an extra argument' ;;
	esac
	r=0
	[ "$status" -eq 2 ] && [ ! -e "$stub/apt-get" ] || r=1
	check "provision refuses $description before any call" "$r"
done

for failing in apt-get:1 apt-get:2 apt-get:3 apt-get:4 apt-get:5 dearmor dpkg usermod install:1 install:2 install:3 git:core.hooksPath git:push.default apt-lists; do
	new_tool_case "provision-fails-$(printf '%s' "$failing" | tr ':' '-')"
	case $failing in
		apt-get:*|install:*|git:*) printf '%s\n' "${failing#*:}" > "$stub/${failing%%:*}.fail" ;;
		apt-lists) mv "$stub/root/var/lib/apt/lists" "$stub/root/var/lib/apt/lists.gone" ;;
		*) touch "$stub/$failing.fail" ;;
	esac
	run_tool "$(shipped_tool provision)" --root "$stub/root"
	r=0
	[ "$status" -ne 0 ] || r=1
	check "a failing step ($failing) fails provision" "$r"
done

new_tool_case claude-code
run_tool "$agent_dir/install-claude-code"
version=$(sed -n 's/^[^ ]* //p' "$stub/bash" 2>/dev/null || true)
r=0
[ "$status" -eq 0 ] || r=1
check 'install-claude-code exits 0 when Claude Code reports the pin' "$r"

r=0
grep -qx -- "-fsSL --proto =https --proto-redir =https -o $(downloaded_file) https://claude.ai/install.sh" "$stub/curl" || r=1
check 'the native installer comes over HTTPS only, from claude.ai' "$r"

r=0
printf '%s\n' "$version" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' || r=1
check 'the installer is asked for an exact version' "$r"

r=0
[ -n "$(downloaded_file)" ] && [ ! -e "$(downloaded_file)" ] || r=1
check 'the installer leaves no temporary file behind' "$r"

new_tool_case claude-code-pin
run_tool "$(tool_copy install-claude-code version 9.8.7)"
r=0
[ "$status" -eq 0 ] && [ "$(sed -n 's/^[^ ]* //p' "$stub/bash")" = 9.8.7 ] || r=1
check 'the installer is asked for the version the version line pins, and Claude Code reporting it passes' "$r"

new_tool_case claude-code-other-version
touch "$stub/other-version"
run_tool "$agent_dir/install-claude-code"
r=0
[ "$status" -ne 0 ] && grep -q 'pinned' "$stub/err" || r=1
check 'a Claude Code reporting another version than the pin fails the install' "$r"

new_tool_case claude-code-download-fails
touch "$stub/curl.fail"
run_tool "$agent_dir/install-claude-code"
r=0
[ "$status" -ne 0 ] && [ -e "$stub/curl" ] && [ ! -e "$stub/bash" ] || r=1
check 'a failed installer download runs no installer' "$r"

new_tool_case claude-code-argument
run_tool "$agent_dir/install-claude-code" 9.9.9
r=0
[ "$status" -ne 0 ] && [ ! -e "$stub/curl" ] && [ ! -e "$stub/bash" ] || r=1
check 'install-claude-code refuses an argument before any call' "$r"

for malformed in stable v2.1.325 2.1; do
	new_tool_case "claude-code-version-$malformed"
	run_tool "$(tool_copy install-claude-code version "$malformed")"
	r=0
	[ "$status" -eq 1 ] && [ ! -e "$stub/curl" ] && [ ! -e "$stub/bash" ] && grep -qF "'$malformed'" "$stub/err" || r=1
	check "a version line holding $malformed is refused before any call, naming it" "$r"
done

new_tool_case claude-code-version-two-lines
awk -v q="'" '/^version=/ { print "version=" q "2.1.325"; print "stable" q; next } { print }' "$agent_dir/install-claude-code" > "$stub/install-claude-code"
run_tool "$stub/install-claude-code"
r=0
[ "$(grep -c '^stable' "$stub/install-claude-code")" -eq 1 ] && [ "$status" -eq 1 ] && [ ! -e "$stub/curl" ] && [ ! -e "$stub/bash" ] || r=1
check 'a version line over two lines is refused before any call' "$r"

real_git=$(command -v git)
for missing in git ssh-keygen; do
	farm="$work/farm-$missing"
	mkdir -p "$farm"
	if [ "$missing" != git ]; then
		printf '#!/bin/sh\nexec "%s" "$@"\n' "$real_git" > "$farm/git"
		chmod +x "$farm/git"
	fi
	set +e
	PATH="$farm" /bin/sh "$agent_dir/self-test" > "$work/farm-out" 2> "$work/farm-err"
	status=$?
	set -e
	r=0
	[ "$status" -eq 2 ] && [ ! -s "$work/farm-out" ] &&
		[ "$(cat "$work/farm-err")" = "agent image self-test: no $missing on PATH; the cases need git and ssh-keygen, so no case ran" ] || r=1
	check "without $missing the agent image self-test exits 2 before any case, naming it" "$r"
done

if [ "$failures" -ne 0 ]; then
	printf 'agent image self-test: %s case(s) failed, %s skipped\n' "$failures" "$skips"
	exit 1
fi
if [ "$skips" -ne 0 ]; then
	printf 'agent image self-test: all cases passed, %s skipped\n' "$skips"
	exit 0
fi
printf 'agent image self-test: all cases passed\n'
