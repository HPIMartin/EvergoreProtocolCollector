#!/bin/sh
set -eu

for tool in git ssh-keygen; do
	command -v "$tool" > /dev/null 2>&1 || {
		printf 'agent image self-test: no %s on PATH; the cases need git and ssh-keygen, so no case ran\n' "$tool" >&2
		exit 2
	}
done

agent_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
build="$agent_dir/build"
case_url=https://example.invalid/project.git

for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=self-test GIT_AUTHOR_EMAIL=self-test@example.invalid
export GIT_COMMITTER_NAME=self-test GIT_COMMITTER_EMAIL=self-test@example.invalid

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export GIT_CEILING_DIRECTORIES="$work"
failures=0
skips=0

check() {
	if [ "$2" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s\n' "$1"
		failures=$((failures + 1))
	fi
}

skip() {
	printf '  skip %s: %s\n' "$1" "$2"
	skips=$((skips + 1))
}

repeat() {
	awk -v text="$1" -v count="$2" 'BEGIN { while (count-- > 0) printf "%s", text }'
}

utf8_locale=
for listed in $(locale -a 2>/dev/null | grep -iE '\.utf-?8$' || true); do
	if printf '\303\251\n' | LC_ALL=$listed grep -Eqx '[a-z]' 2> /dev/null; then
		utf8_locale=$listed
		break
	fi
done

signal_reset=
if env --default-signal=HUP,INT,PIPE,QUIT,TERM true > /dev/null 2>&1; then
	signal_reset=--default-signal=HUP,INT,PIPE,QUIT,TERM
fi

mkdir -p "$work/bin"
cat > "$work/bin/npx" <<'STUB'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$STUB_DIR/npx"
[ ! -f "$STUB_DIR/npx.fail" ] || exit 1
image=
workspace=
expect=
for argument in "$@"; do
	[ "$expect" != image ] || image=$argument
	[ "$expect" != workspace ] || workspace=$argument
	expect=
	[ "$argument" != --image-name ] || expect=image
	[ "$argument" != --workspace-folder ] || expect=workspace
done
[ -z "$image" ] || touch "$STUB_DIR/images/$(printf '%s' "$image" | tr ':/' '__')"
if [ -n "$workspace" ]; then
	mkdir -p "$STUB_DIR/seen-workspace"
	cp -R "$workspace/." "$STUB_DIR/seen-workspace/"
fi
[ ! -f "$STUB_DIR/npx.interrupt" ] || kill -"$(cat "$STUB_DIR/npx.interrupt")" "$PPID"
[ ! -f "$STUB_DIR/npx.edit" ] || printf 'RUN true\n' >> "$STUB_DC/agent/Dockerfile"
[ ! -f "$STUB_DIR/npx.move" ] || git commit -q --allow-empty -m "Move HEAD"
[ ! -f "$STUB_DIR/npx.untrack" ] || printf 'new\n' > "$STUB_DC/extra"
if [ -f "$STUB_DIR/npx.hide" ]; then
	git update-index --assume-unchanged "$STUB_DC/agent/Dockerfile"
	printf 'RUN true\n' >> "$STUB_DC/agent/Dockerfile"
fi
STUB
cat > "$work/bin/docker" <<'STUB'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$STUB_DIR/docker"
marker() { printf '%s/images/%s' "$STUB_DIR" "$(printf '%s' "$1" | tr ':/' '__')"; }
case "$1 $2" in
	"image ls")
		[ ! -f "$STUB_DIR/ls.fail" ] || exit 1
		[ ! -f "$(marker "${5#reference=}")" ] || printf 'sha256:0123\n' ;;
	"image rm")
		[ $# -eq 3 ] || exit 64
		[ ! -f "$STUB_DIR/rm.fail" ] || exit 1
		printf '%s\n' "$3" >> "$STUB_DIR/removed"
		mv "$(marker "$3")" "$(marker "$3").removed" ;;
	"build "*)
		file=
		expect=
		for argument in "$@"; do
			[ "$expect" != file ] || file=$argument
			expect=
			[ "$argument" != --file ] || expect=file
			context=$argument
		done
		mkdir -p "$STUB_DIR/seen-context"
		cp -R "$context/." "$STUB_DIR/seen-context/"
		cp "$file" "$STUB_DIR/seen-file"
		[ ! -f "$STUB_DIR/build.fail" ] ;;
	*) exit 64 ;;
esac
STUB
real_rm=$(command -v rm)
cat > "$work/bin/rm" <<STUB
#!/bin/sh
printf '%s\n' "\$*" >> "\$STUB_DIR/rm"
[ ! -f "\$STUB_DIR/rm-snapshot.fail" ] || exit 1
exec "$real_rm" "\$@"
STUB
real_git=$(command -v git)
cat > "$work/bin/git" <<STUB
#!/bin/sh
case " \$* " in
	*" checkout-index "*) printf '%s\n' "\${GIT_ATTR_NOSYSTEM-unset}" >> "\$STUB_DIR/attr-nosystem" ;;
esac
if [ -f "\$STUB_DIR/git.fail" ]; then
	case " \$* " in
		*" \$(cat "\$STUB_DIR/git.fail") "*) exit 128 ;;
	esac
fi
"$real_git" "\$@" || exit
if [ -f "\$STUB_DIR/alternates.fail" ]; then
	case " \$* " in
		*" init "*)
			for last in "\$@"; do :; done
			mkdir -p "\$last/.git/objects/info/alternates" ;;
	esac
fi
STUB
real_mktemp=$(command -v mktemp)
cat > "$work/bin/mktemp" <<STUB
#!/bin/sh
if [ -f "\$STUB_DIR/mktemp.ghost" ]; then
	printf '%s\n' "\$STUB_DIR/ghost"
	exit 0
fi
exec "$real_mktemp" "\$@"
STUB
chmod +x "$work/bin/npx" "$work/bin/docker" "$work/bin/rm" "$work/bin/git" "$work/bin/mktemp"

use_layout() {
	layout=$1
	case $layout in
		template) dc=env/devcontainer/.devcontainer; ws=env/devcontainer ;;
		adopted) dc=.devcontainer; ws=. ;;
	esac
}

lcheck() {
	check "$1 ($layout layout)" "$2"
}

new_case() {
	stub="$work/$layout-$1"
	repo="$stub/repo"
	mkdir -p "$stub/images" "$stub/tmp" "$repo/$dc/agent"
	git -C "$repo" init -q
	printf '{}\n' > "$repo/$dc/devcontainer.json"
	printf 'FROM scratch\n' > "$repo/$dc/agent/Dockerfile"
	sed "s|^source_url=.*|source_url='$case_url'|" "$build" > "$repo/$dc/agent/build"
	git -C "$repo" add -A
	git -C "$repo" commit -q -m "Add the devcontainer"
	printf 'FROM scratch\nUSER root\n' > "$repo/$dc/agent/Dockerfile"
	git -C "$repo" commit -q -am "Change the agent layer"
	printf 'FROM scratch\n' > "$repo/$dc/Dockerfile"
	git -C "$repo" add -A
	git -C "$repo" commit -q -m "Add the devcontainer's own Dockerfile"
	printf 'elsewhere\n' > "$repo/$ws/README"
	git -C "$repo" add -A
	git -C "$repo" commit -q -m "Add a readme beside the devcontainer folder"
	cwd=$repo
	script=$dc/agent/build
	tmpdir="$stub/tmp"
	run_xdg=
	run_global=/dev/null
	run_parameters=
	run_count=
}

run_build() {
	set +e
	(
		if [ -n "$run_parameters" ]; then
			GIT_CONFIG_PARAMETERS=$run_parameters
			export GIT_CONFIG_PARAMETERS
		fi
		if [ -n "$run_count" ]; then
			GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=${run_count%%=*} GIT_CONFIG_VALUE_0=${run_count#*=}
			export GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
		fi
		cd "$cwd" && PATH="$work/bin:$PATH" STUB_DIR="$stub" STUB_DC="$dc" TMPDIR="$tmpdir" GIT_CONFIG_GLOBAL="$run_global" \
		env ${signal_reset:+"$signal_reset"} ${run_locale:+"LC_ALL=$run_locale"} ${run_xdg:+"XDG_CONFIG_HOME=$run_xdg"} \
		sh "$script" "$@") \
		> "$stub/out" 2> "$stub/err"
	status=$?
	set -e
}

no_calls() { [ ! -e "$stub/npx" ] && [ ! -e "$stub/docker" ]; }
docker_build() { grep '^build ' "$stub/docker" 2>/dev/null; }
base_name() { sed -n 's/.*--image-name \([^ ]*\).*/\1/p' "$stub/npx" 2>/dev/null || true; }
leftover_images() { find "$stub/images" -type f ! -name '*.removed' | grep -q .; }
context_arg() { docker_build | awk '{ print $NF }'; }
workspace_arg() { sed -n 's/.*--workspace-folder \([^ ]*\).*/\1/p' "$stub/npx" 2>/dev/null || true; }
in_snapshot() { case $1 in "$stub/tmp/"?*"/$2") return 0 ;; *) return 1 ;; esac; }
temporary_folder_gone() { [ -d "$tmpdir" ] && [ -z "$(ls -A "$tmpdir")" ]; }
snapshot_holds_committed() {
	same_as_committed "$1" "$stub/seen-context/${1#"$dc/agent/"}" && same_as_committed "$1" "$stub/seen-file" &&
		same_as_committed "$1" "$stub/seen-workspace/.devcontainer/${1#"$dc/"}"
}
committed() { git -C "$repo" show "HEAD:$1"; }
same_as_committed() { committed "$1" > "$stub/committed" && cmp -s "$stub/committed" "$2"; }

expect_usage_refused() {
	description=$1
	shift
	usage_cases=$((usage_cases + 1))
	new_case "usage-$usage_cases"
	run_build "$@"
	r=0
	[ "$status" -eq 2 ] && no_calls && grep -qxF "usage: $script --tag <image:tag>" "$stub/err" || r=1
	lcheck "$description" "$r"
}

expect_accepted() {
	accepted_cases=$((accepted_cases + 1))
	new_case "accept-$accepted_cases"
	run_build --tag "$2"
	r=0
	[ "$status" -eq 0 ] && docker_build | grep -Fq -- "--tag $2 $(context_arg)" || r=1
	lcheck "$1 is built as named" "$r"
}

refused_before_any_call() {
	[ "$status" -eq 1 ] && no_calls
}

build_cases() {
	usage_cases=0
	expect_usage_refused 'no argument is refused with the usage line before any call'
	expect_usage_refused 'a missing tag value is refused with the usage line before any call' --tag
	expect_usage_refused 'an empty tag is refused with the usage line before any call' --tag ''
	expect_usage_refused 'another option is refused with the usage line before any call' --name agent-seat:test
	expect_usage_refused 'an extra argument is refused with the usage line before any call' --tag agent-seat:test --push
	expect_usage_refused 'a tag that reads as an option is refused with the usage line before any call' --tag -x
	expect_usage_refused 'a tag with a space is refused with the usage line before any call' --tag 'agent seat'
	expect_usage_refused 'a repository name in capitals is refused with the usage line before any call' --tag Agent-Seat:test
	expect_usage_refused 'a tag over two lines is refused with the usage line before any call' --tag "$(printf 'agent-seat:test\n--push')"
	expect_usage_refused 'a tag with two tag parts is refused with the usage line before any call' --tag agent-seat:a:b
	locale_case='a tag with a letter outside ASCII is refused with the usage line before any call under a UTF-8 locale that locale -a lists and whose [a-z] matches that letter'
	if [ -n "$utf8_locale" ]; then
		run_locale=$utf8_locale
		expect_usage_refused "$locale_case" --tag "$(printf 'agent-seat:\303\251')"
		run_locale=
	else
		skip "$locale_case ($layout layout)" 'no listed UTF-8 locale lets [a-z] match that letter here, so LC_ALL=C cannot be proven'
	fi
	longest_tag=$(repeat a 128)
	expect_usage_refused 'a repository name over 255 characters is refused with the usage line before any call' --tag "$(repeat a 256):x"
	expect_usage_refused 'a tag longer than 128 characters is refused with the usage line before any call' --tag "agent-seat:a$longest_tag"

	new_case usage-absolute
	script="$repo/$dc/agent/build"
	run_build
	r=0
	[ "$status" -eq 2 ] && grep -qxF "usage: $repo/$dc/agent/build --tag <image:tag>" "$stub/err" || r=1
	lcheck 'the usage line names the script by the path it was run as' "$r"

	accepted_cases=0
	expect_accepted 'a tag with a registry host and a path' registry.example.org/agent-seat/agent:0.3.0
	expect_accepted 'a tag with a registry port, a path and capitals in the tag part' localhost:5000/agent-seat/agent:V1_x
	expect_accepted 'a repository name without a tag part' agent-seat
	expect_accepted 'a tag part of 128 characters' "agent-seat:$longest_tag"
	expect_accepted 'a repository name of 255 characters' "$(repeat a 255):x"

	new_case happy
	run_build --tag agent-seat:test
	head=$(git -C "$repo" rev-parse HEAD)
	devcontainer_head=$(git -C "$repo" rev-parse HEAD~1)
	base=$(base_name)
	r=0
	[ "$status" -eq 0 ] || r=1
	lcheck 'a clean checkout builds' "$r"

	workspace=$(workspace_arg)
	context=$(context_arg)
	r=0
	[ -n "$base" ] && in_snapshot "$workspace" "$ws" &&
		[ "$(sed -E 's#^--yes @devcontainers/cli@[0-9]+\.[0-9]+\.[0-9]+ build #--yes CLI build #' "$stub/npx")" = \
		"--yes CLI build --workspace-folder $workspace --no-lockfile --image-name $base" ] || r=1
	lcheck 'the devcontainer image comes from a pinned devcontainer CLI, built from the folder above the devcontainer folder in a snapshot under the temporary folder, without a lockfile where none is committed' "$r"

	r=0
	docker_build | grep -q -- "--build-arg BASE=$base " && [ -n "$base" ] || r=1
	lcheck 'the agent layer builds on the devcontainer image just built' "$r"

	r=0
	docker_build | grep -q -- "--label org.opencontainers.image.revision=$head " || r=1
	lcheck 'the image names the full hash of the commit it was built from' "$r"

	r=0
	[ "$head" != "$devcontainer_head" ] &&
		docker_build | grep -q -- "--label agent-seat.devcontainer.revision=$devcontainer_head " || r=1
	lcheck 'the image names the full hash of the last commit that changed the devcontainer folder, not the folder above it' "$r"

	r=0
	docker_build | grep -q -- "--label org.opencontainers.image.source=$case_url " || r=1
	lcheck 'the image names the repository its source_url line holds' "$r"

	r=0
	in_snapshot "$context" "$dc/agent" && [ "${workspace%/"$ws"}" = "${context%/"$dc/agent"}" ] &&
		docker_build | grep -qF -- "--file $context/Dockerfile --tag agent-seat:test $context" || r=1
	lcheck 'the agent layer is built from the agent folder of the same snapshot and tagged with the requested tag' "$r"

	r=0
	[ -n "$context" ] && [ "$(docker_build)" = "build --build-arg BASE=$base --label org.opencontainers.image.revision=$head --label agent-seat.devcontainer.revision=$devcontainer_head --label org.opencontainers.image.source=$case_url --file $context/Dockerfile --tag agent-seat:test $context" ] || r=1
	lcheck 'the agent layer is built with exactly these arguments and no other' "$r"

	r=0
	grep -qx "$base" "$stub/removed" && ! leftover_images || r=1
	lcheck 'the temporary tag is gone after a build' "$r"

	r=0
	! grep -Eq '^(push|login|tag) ' "$stub/docker" || r=1
	lcheck 'no docker push, login or tag call is made' "$r"

	r=0
	! docker_build | grep -Eq -- ' --(push|output)' || r=1
	lcheck 'the agent layer is built without --push or --output' "$r"

	r=0
	[ -n "$context" ] && temporary_folder_gone || r=1
	lcheck 'the temporary folder with the snapshot is gone after a build' "$r"

	new_case temporary-folder-after-refusal
	printf 'changed\n' >> "$repo/$dc/agent/Dockerfile"
	run_build --tag agent-seat:test
	r=0
	refused_before_any_call && temporary_folder_gone || r=1
	lcheck 'the temporary folder is gone after a refused run' "$r"

	new_case temporary-folder-stays
	touch "$stub/rm-snapshot.fail"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -ne 0 ] && docker_build > /dev/null && grep -q -- '-rf ' "$stub/rm" 2>/dev/null || r=1
	lcheck 'a temporary folder that cannot be removed fails the run' "$r"

	new_case ignored-login
	printf '/%s/.claude-home/\n' "$dc" >> "$repo/.git/info/exclude"
	mkdir -p "$repo/$dc/.claude-home"
	printf 'login\n' > "$repo/$dc/.claude-home/login"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && [ -f "$stub/seen-workspace/.devcontainer/devcontainer.json" ] &&
		[ ! -e "$stub/seen-workspace/.devcontainer/.claude-home" ] || r=1
	lcheck 'a git-ignored folder in the devcontainer folder is not in the workspace folder the devcontainer CLI gets' "$r"

	new_case trustctime
	git -C "$repo" config core.trustctime false
	find "$repo/$dc" -type f -exec touch -t 202001010000 {} +
	git -C "$repo" update-index -q --refresh
	printf 'FROM scratch\nUSER rout\n' > "$repo/$dc/agent/Dockerfile"
	touch -t 202001010000 "$repo/$dc/agent/Dockerfile"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && ! same_as_committed "$dc/agent/Dockerfile" "$repo/$dc/agent/Dockerfile" &&
		same_as_committed "$dc/agent/Dockerfile" "$stub/seen-context/Dockerfile" &&
		same_as_committed "$dc/agent/Dockerfile" "$stub/seen-file" &&
		same_as_committed "$dc/agent/Dockerfile" "$stub/seen-workspace/.devcontainer/agent/Dockerfile" || r=1
	lcheck 'a same-size edit git status misses under core.trustctime=false reaches neither build, both get the committed bytes' "$r"

	new_case export-attributes
	printf 'FROM scratch\nLABEL commit=$Format:%%H$\n' > "$repo/$dc/agent/Dockerfile"
	printf '/%s/agent/Dockerfile export-subst\n/%s/devcontainer.json export-ignore\n' "$dc" "$dc" > "$repo/.gitattributes"
	git -C "$repo" add -A
	git -C "$repo" commit -q -m "Mark the devcontainer files for export"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && same_as_committed "$dc/agent/Dockerfile" "$stub/seen-context/Dockerfile" &&
		same_as_committed "$dc/devcontainer.json" "$stub/seen-workspace/.devcontainer/devcontainer.json" || r=1
	lcheck 'export-subst and export-ignore attributes on devcontainer files change nothing the builds receive' "$r"

	new_case ignored-attributes
	printf 'FROM scratch\nLABEL id=$Id$\n' > "$repo/$dc/agent/Dockerfile"
	git -C "$repo" commit -q -am "Name the agent layer's blob"
	printf '/%s/agent/.gitattributes\n' "$dc" >> "$repo/.git/info/exclude"
	printf 'Dockerfile text eol=crlf ident\n' > "$repo/$dc/agent/.gitattributes"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && snapshot_holds_committed "$dc/agent/Dockerfile" || r=1
	lcheck 'a git-ignored .gitattributes in the devcontainer folder (ident, eol=crlf) changes nothing the builds receive' "$r"

	new_case repository-filter
	printf '%s/agent/Dockerfile filter=swap\n' "$dc" > "$repo/.git/info/attributes"
	git -C "$repo" config filter.swap.smudge 'sed s/scratch/elsewhere/'
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && snapshot_holds_committed "$dc/agent/Dockerfile" || r=1
	lcheck '.git/info/attributes naming a smudge filter of the repository configuration changes nothing the builds receive' "$r"

	new_case global-filter
	mkdir -p "$stub/xdg/git"
	printf 'Dockerfile filter=swap text eol=crlf\n' > "$stub/xdg/git/attributes"
	printf '[filter "swap"]\n\tsmudge = sed s/scratch/elsewhere/\n' > "$stub/global-config"
	run_xdg="$stub/xdg"
	run_global="$stub/global-config"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && snapshot_holds_committed "$dc/agent/Dockerfile" || r=1
	lcheck 'a global attributes file and a smudge filter of the global configuration change nothing the builds receive' "$r"

	for inherited in GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT; do
		new_case "inherited-$inherited"
		printf '/%s/agent/Dockerfile filter=swap\n' "$dc" > "$repo/.gitattributes"
		git -C "$repo" add -A
		git -C "$repo" commit -q -m "Name a filter for the agent layer"
		case $inherited in
			GIT_CONFIG_PARAMETERS) run_parameters="'filter.swap.smudge=sed s/scratch/elsewhere/'" ;;
			GIT_CONFIG_COUNT) run_count='filter.swap.smudge=sed s/scratch/elsewhere/' ;;
		esac
		run_build --tag agent-seat:test
		r=0
		[ "$status" -eq 0 ] && snapshot_holds_committed "$dc/agent/Dockerfile" || r=1
		lcheck "a smudge filter inherited through $inherited for a filter the commit names changes nothing the builds receive" "$r"
	done

	new_case committed-attributes
	printf '/%s/agent/Dockerfile text eol=crlf\n' "$dc" > "$repo/.gitattributes"
	git -C "$repo" add -A
	git -C "$repo" commit -q -m "Check the agent layer out with CRLF"
	printf 'FROM scratch\r\nUSER root\r\n' > "$stub/expected-crlf"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && cmp -s "$stub/expected-crlf" "$stub/seen-context/Dockerfile" &&
		cmp -s "$stub/expected-crlf" "$stub/seen-workspace/.devcontainer/agent/Dockerfile" || r=1
	lcheck "the commit's own .gitattributes still applies: its eol=crlf gives CRLF in what both builds receive" "$r"

	new_case system-attributes-off
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && [ "$(sort -u "$stub/attr-nosystem" 2>/dev/null)" = 1 ] || r=1
	lcheck "the snapshot's checkout runs with the system attributes file off (GIT_ATTR_NOSYSTEM=1)" "$r"

	new_case xdg-config
	printf '/%s/agent/Dockerfile filter=swap\n' "$dc" > "$repo/.gitattributes"
	git -C "$repo" add -A
	git -C "$repo" commit -q -m "Name a filter for the agent layer"
	mkdir -p "$stub/xdg/git"
	printf '[filter "swap"]\n\tsmudge = sed s/scratch/elsewhere/\n' > "$stub/xdg/git/config"
	run_xdg="$stub/xdg"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && snapshot_holds_committed "$dc/agent/Dockerfile" || r=1
	lcheck 'a smudge filter in the XDG global configuration for a filter the commit names changes nothing the builds receive' "$r"

	new_case relative-tmpdir
	mkdir -p "$stub/rel"
	tmpdir=../rel
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && snapshot_holds_committed "$dc/agent/Dockerfile" && [ -z "$(ls -A "$stub/rel")" ] || r=1
	lcheck 'a relative TMPDIR outside the checkout builds the committed bytes and leaves nothing behind' "$r"

	new_case relative-tmpdir-up
	mkdir -p "$work/$layout-up"
	tmpdir="../../$layout-up"
	run_build --tag agent-seat:test
	r=0
	[ "$status" -eq 0 ] && snapshot_holds_committed "$dc/agent/Dockerfile" && [ -z "$(ls -A "$work/$layout-up")" ] &&
		[ -z "$(find "$work" -path "*/$layout-up/*" -name snapshot)" ] || r=1
	lcheck 'a relative TMPDIR two folders up builds the committed bytes and leaves no snapshot behind' "$r"

	new_case unenterable-temporary-folder
	touch "$stub/mktemp.ghost"
	run_build --tag agent-seat:test
	r=0
	refused_before_any_call && grep -qF 'cannot be entered' "$stub/err" || r=1
	lcheck 'a temporary folder that cannot be entered is refused before any call, saying so' "$r"

	new_case fsmonitor
	find "$repo/$dc" -type f -exec touch -t 202001010000 {} +
	git -C "$repo" update-index -q --refresh
	cat > "$stub/fsmonitor" <<'HOOK'
#!/bin/sh
printf 'unchanged\0'
HOOK
	chmod +x "$stub/fsmonitor"
	git -C "$repo" config core.fsmonitor "$stub/fsmonitor"
	git -C "$repo" config core.fsmonitorHookVersion 2
	git -C "$repo" status --porcelain > /dev/null
	git -C "$repo" status --porcelain > /dev/null
