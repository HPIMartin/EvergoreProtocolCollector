#!/bin/sh
set -eu

# > **ADAPT:** the gate values of this project, one single-quoted assignment per line: /adopt fills
# > them from the stack preset's gate.env and /template-upgrade keeps them. `base_ref` follows the
# > landing model: `refs/remotes/origin/main` in the hub models, `refs/heads/main` in the local one.
# > The `needs_` and `reads_` values are the playbook's read-path table: a diff path matching
# > `needs_<lens>` calls for that lens, and a lens report of an earlier tip stands while no path
# > matching `reads_<lens>` changed since; an empty value calls for no lens and reads no path.
# > `test_readers` names the readers on: `junit`, `vitest`, `sh`, and one of `unittest` and
# > `pytest`. An empty `walk_success_re` or `docs_guard_test`, or `bdd_leg='off'`, switches that
# > leg off, and the PASS line names every leg that is off. `walk_count_re` matches from the start of
# > a line, its first group the count. `docs_guard_ran_re` may read an UP-TO-DATE run as one only
# > where the build declares the docs the test reads as that task's inputs. `backlog_row` is the
# > start of a backlog row, its `%s` the ID. `walk_failed_reports` holds the globs, separated by
# > blanks and each below a walk worktree, of the test reports a failed build leaves, one for each
# > stack of a composed project, which gate/walk keeps beside its log; empty keeps none.
# > `docs_guard_test` is also the name gate/tip-evidence finds the test by: the one file
# > `<docs_guard_test>.<ext>` in any directory outside `.template/`. The helpers here read `base_ref`,
# > `features_dir`, the walk and docs guard values and `bdd_leg` from here through `--value`, and
# > judge a walk log through `--walk-green`.
base_ref='refs/heads/main'
features_dir='src/test/resources/features'
test_readers='junit vitest sh unittest'
test_path_re='(^|/)src/test/|(^|/)tests?/|\.(test|spec)\.[cm]?[jt]sx?$|(^|/)self-test$|^release/test_[^/]*\.py$'
failure_marker='FAILED|FAIL |×|✗|AssertionError|AssertionFailedError|^(FAIL|ERROR): [^ (]+ \([^ ().]+(\.[^ ().]+)+\)'
frontend_root='frontend'
needs_domain='^src/'
needs_frontend='^frontend/'
reads_domain='^src/'
reads_frontend='^((frontend|src|grid|gradle)/|(build|settings)\.gradle\.kts$|gradle\.properties$|gradlew$|Dockerfile$|verify$)'
walk_success_re='^BUILD SUCCESSFUL'
walk_task_lines='> Task :test|> Task :frontend:npmTest'
walk_count_re='^\[verify\] executed test classes: ([0-9]+)$'
walk_failed_reports='build/test-results/test/*.xml'
docs_guard_test='KbCitationGuardTest'
docs_guard_ran_re='^> Task :test$'
bdd_leg='on'
bdd_paths_re='^(src|frontend)/'
backlog_row='| **%s** |'
doc_debt_heading='## Doc debt: wrong text left over'

usage() {
	printf 'usage: gate/dossier-check [--base <commit>] <strand worktree> <tip>\n' >&2
	printf '       gate/dossier-check --phase <strand worktree>\n' >&2
	printf '       gate/dossier-check --walk-log <strand worktree> <commit>\n' >&2
	printf '       gate/dossier-check --wip <strand worktree> <commit>\n' >&2
	printf '       gate/dossier-check --walk-green <strand worktree> <commit> <log>\n' >&2
	printf '       gate/dossier-check --value <ADAPT value>\n' >&2
	exit 2
}

for tool in awk git mktemp; do
	command -v "$tool" > /dev/null 2>&1 || {
		printf 'dossier-check: no %s on PATH; the gate module needs sh, awk, git and mktemp, so nothing was checked\n' "$tool" >&2
		exit 2
	}
done

# The readers name a non-ASCII byte by the range \200-\377, which awk refuses under a UTF-8 locale,
# so the check reads bytes in the C locale whatever locale its caller set.
LC_ALL=C
export LC_ALL

python_readers=0
for reader in $test_readers; do
	case "$reader" in
		junit|vitest|sh) ;;
		unittest|pytest) python_readers=$((python_readers + 1)) ;;
		*)
			printf 'dossier-check: the ADAPT block names the test reader %s, which the check does not know\n' "$reader" >&2
			exit 2
			;;
	esac
done
[ "$python_readers" -le 1 ] || {
	printf 'dossier-check: the ADAPT block turns on both Python readers; name the one the project runs\n' >&2
	exit 2
}

# The code tree is a commit's tree without *.md, so a commit that changes only docs shares the
# full-suite log of the code tree before it. The key is hashed in the strand's repository, so its
# object format, not the caller's directory, sets the hash.
code_tree_key() {
	listing=$(git -c core.quotepath=off -C "$1" ls-tree -r "$2") || return 1
	code=$(printf '%s\n' "$listing" | awk -F '\t' '$2 !~ /\.md$/') || return 1
	printf '%s\n' "$code" | git -C "$1" hash-object --stdin
}

# One line per scenario tagged @wip at a commit, on itself, its feature, its rule or one of its
# Examples: the feature's name, a tab, the scenario's name. A file git cannot show or awk cannot
# read is named instead, as `?unread-feature@<path>`, and so is one written in a language the
# reader does not read, as `?unread-language@<language>@<path>`. The reader knows the structural
# keywords of English and, under `# language: de`, of German, where `Szenarien:` opens a scenario
# outline while the English `Scenarios:` opens an examples table; it reads no step. The language
# line counts where Gherkin reads it, before the first tag or keyword line, and a byte order mark
# before the first line is dropped. A doc string ends only at the delimiter that opened it; one
# still open at the end of the file, and a file with no feature line the reader knows, are named
# unread as well (`?unread-docstring@<path>`, `?unread-nofeature@<path>`), since the reader could
# not tell its scenarios.
wip_scenarios() {
	features=$(git -c core.quotepath=off -C "$1" ls-tree -r --name-only "$2" -- "$features_dir") \
		|| { printf '?unread-feature@%s\n' "$features_dir"; return 0; }
	printf '%s\n' "$features" | grep '\.feature$' | while IFS= read -r feature; do
		content=$(git -c core.quotepath=off -C "$1" show "$2:$feature") || {
			printf '?unread-feature@%s\n' "$feature"
			continue
		}
		printf '%s\n' "$content" | feature="$feature" awk '
			function flush() { if (name != "" && wip) print feature_name "\t" name; name = "" }
			function tagged() { return tags ~ /@wip([^A-Za-z0-9_-]|$)/ }
			function kind_of(line) {
				if (language == "de") {
					if (line ~ /^(Funktionalit\303\244t|Funktion):/) return "feature"
					if (line ~ /^(Regel|Rule):/) return "rule"
					if (line ~ /^(Szenario|Beispiel|Szenariogrundriss|Szenarien):/) return "scenario"
					if (line ~ /^Beispiele:/) return "examples"
					return ""
				}
				if (line ~ /^(Feature|Ability|Business Need):/) return "feature"
				if (line ~ /^Rule:/) return "rule"
				if (line ~ /^(Scenario|Scenario Outline|Scenario Template|Example):/) return "scenario"
				if (line ~ /^(Examples|Scenarios):/) return "examples"
				return ""
			}
			BEGIN { language = "en" }
			NR == 1 { sub(/^\357\273\277/, "") }
			{ sub(/^[ \t]+/, ""); sub(/\r$/, "") }
			!opened && /^#[ \t]*language[ \t]*:[ \t]*[A-Za-z_-]+[ \t]*$/ {
				language = $0; sub(/^#[ \t]*language[ \t]*:[ \t]*/, "", language); sub(/[ \t]+$/, "", language)
				opened = 1
				if (language != "en" && language != "de") {
					print "?unread-language@" language "@" ENVIRON["feature"]
					unknown = 1
					exit
				}
				next
			}
			in_docstring { if (index($0, delimiter) == 1) in_docstring = 0; next }
			/^("""|```)/ { delimiter = substr($0, 1, 3); in_docstring = 1; next }
			/^#/ || $0 == "" { next }
			/^@/ { tags = tags " " $0; opened = 1; next }
			{ opened = 1; kind = kind_of($0) }
			kind == "feature" {
				featured = 1
				flush(); feature_name = $0; sub(/^[^:]*:[ \t]*/, "", feature_name)
				feature_wip = tagged(); rule_wip = 0; tags = ""; next
			}
			kind == "rule" { flush(); rule_wip = tagged(); tags = ""; next }
			kind == "scenario" {
				flush(); name = $0; sub(/^[^:]*:[ \t]*/, "", name)
				wip = feature_wip || rule_wip || tagged(); tags = ""; next
			}
			kind == "examples" { if (tagged()) wip = 1; tags = ""; next }
			{ tags = "" }
			END {
				if (unknown) exit
				if (in_docstring) { print "?unread-docstring@" ENVIRON["feature"]; exit }
				if (!featured) { print "?unread-nofeature@" ENVIRON["feature"]; exit }
				flush()
			}
		' || printf '?unread-feature@%s\n' "$feature"
	done
}

# The lines of a reading that name a file the reader could not read, each as a sentence.
wip_unread() {
	printf '%s\n' "$1" | awk '
		index($0, "?unread-language@") == 1 {
			rest = substr($0, 18); at = index(rest, "@")
			printf "%s is written in the Gherkin language \047%s\047, which the @wip reader does not read (it reads en and de)\n", substr(rest, at + 1), substr(rest, 1, at - 1)
			next
		}
		index($0, "?unread-feature@") == 1 { printf "the scenarios of %s could not be read\n", substr($0, 17) }
		index($0, "?unread-docstring@") == 1 {
			printf "%s holds a doc string that never closes, so the @wip reader could not read its scenarios\n", substr($0, 19)
		}
		index($0, "?unread-nofeature@") == 1 {
			printf "%s holds no feature line the @wip reader knows (Feature, Ability, Business Need; under # language: de Funktionalit\303\244t, Funktion), so the @wip reader could not read its scenarios\n", substr($0, 19)
		}
	'
}

# The faults of a walk log, one per line, a word and what it is about: a green log has none. It opens
# with the tree it was built from, which holds the commit's code tree, has as its last gate/walk
# line the one gate/walk writes after a verify that exited 0, so no line of a failed or dirty build
# follows it, and shows what the ADAPT block asks of a build: the success line, each task line alone
# on its line and a count above zero. Both the walk leg and --walk-green judge a log by this list.
walk_log_faults() {
	content=$(tr -d '\r' < "$3") || { printf 'unreadable\n'; return 0; }
	built=$(printf '%s\n' "$content" | sed -n '1s/^tree: //p')
	case "$built" in
		''|*[!0-9a-f]*) printf 'tree\n' ;;
		*)
			if [ "${#built}" -ne 40 ] && [ "${#built}" -ne 64 ]; then
				printf 'tree\n'
			elif ! built_key=$(code_tree_key "$1" "$built" 2> /dev/null); then
				printf 'unknown %s\n' "$built"
			elif ! commit_key=$(code_tree_key "$1" "$2"); then
				printf 'commit\n'
			elif [ "$built_key" != "$commit_key" ]; then
				printf 'foreign %s\n' "$built"
			fi
			;;
	esac
	walk_last=$(printf '%s\n' "$content" | awk 'index($0, "[gate/walk] ") == 1 { last = $0 } END { print last }')
	[ "$walk_last" = '[gate/walk] verify exited 0' ] || printf 'exited\n'
	printf '%s\n' "$content" | grep -Eq -- "$walk_success_re" || printf 'success\n'
	tasks=$(printf '%s\n' "$walk_task_lines" | tr '|' '\n')
	while IFS= read -r task; do
		[ -n "$task" ] || continue
		printf '%s\n' "$content" | grep -qxF -- "$task" || printf 'task %s\n' "$task"
	done <<TASKS
$tasks
TASKS
	if [ -n "$walk_count_re" ]; then
		delimiter=$(printf '\001')
		count=$(printf '%s\n' "$content" | sed -n -E "s${delimiter}${walk_count_re}.*${delimiter}\1${delimiter}p" | head -n 1)
		[ "${count:-0}" -gt 0 ] 2> /dev/null || printf 'count\n'
	fi
	return 0
}

walk_green() {
	faults=$(walk_log_faults "$@") || return 1
	[ -z "$faults" ]
}

case "${1:-}" in
	--wip)
		[ $# -eq 3 ] || usage
		git -C "$2" rev-parse --verify --quiet "$3^{commit}" > /dev/null || usage
		listed=$(wip_scenarios "$2" "$3")
		unread=$(wip_unread "$listed")
		if [ -n "$unread" ]; then
			printf '%s\n' "$unread" | sed 's/^/dossier-check: /; s/$/, so the @wip scenarios cannot be listed/' >&2
			exit 2
		fi
		[ -z "$listed" ] || printf '%s\n' "$listed"
		exit 0
		;;
	--walk-log)
		[ $# -eq 3 ] || usage
		key=$(code_tree_key "$2" "$3") || usage
		printf '%s/gate.local.d/walk/%s.log\n' "$2" "$key"
		exit 0
		;;
	--value)
		[ $# -eq 2 ] || usage
		case "$2" in
			base_ref) printf '%s\n' "$base_ref" ;;
			features_dir) printf '%s\n' "$features_dir" ;;
			walk_success_re) printf '%s\n' "$walk_success_re" ;;
			walk_failed_reports) printf '%s\n' "$walk_failed_reports" ;;
			docs_guard_test) printf '%s\n' "$docs_guard_test" ;;
			docs_guard_ran_re) printf '%s\n' "$docs_guard_ran_re" ;;
			bdd_leg) printf '%s\n' "$bdd_leg" ;;
			*) usage ;;
		esac
		exit 0
		;;
	--walk-green)
		[ $# -eq 4 ] || usage
		[ -n "$walk_success_re" ] || {
			printf 'dossier-check: the ADAPT block has no walk_success_re, so no walk log can be judged\n' >&2
			exit 2
		}
		git -C "$2" rev-parse --verify --quiet "$3^{tree}" > /dev/null || usage
		[ -f "$4" ] && walk_green "$2" "$3" "$4" || exit 1
		exit 0
		;;
esac

phase=no
stacked_base=
case "${1:-}" in
	--phase)
		[ $# -eq 2 ] || usage
		phase=yes
		worktree=$2
		tip_ref=HEAD
		;;
	--base)
		[ $# -eq 4 ] || usage
		stacked_base=$2
		worktree=$3
		tip_ref=$4
		;;
	-*) usage ;;
	*)
		[ $# -eq 2 ] || usage
		worktree=$1
		tip_ref=$2
		;;
esac

dossier="$worktree/gate.local.d"
surface_path=gate/authentication-surface
refusals=0
legs_off=
failing_reports=
rejected_findings=0

leg_off() { legs_off="${legs_off:+$legs_off; }$1"; }

[ -n "$walk_success_re" ] || leg_off 'walk (no walk_success_re)'
[ -n "$docs_guard_test" ] || leg_off 'docs guard (no docs_guard_test)'
[ "$bdd_leg" = on ] || leg_off 'bdd (bdd_leg off)'

refuse() {
	printf 'refused [%s]: %s\n' "$1" "$2"
	refusals=$((refusals + 1))
}

verdict() {
	if [ "$refusals" -eq 0 ] && [ "$phase" = yes ]; then
		printf 'dossier-check: PHASE PASS %s over %s\n' "$tip" "$base"
		exit 0
	fi
	# PASS says the evidence is consistent, not that every report passed: a report whose own verdict
	# is FAIL or `robust: no`, and the count of rejected findings, stand on the line for the author.
	if [ "$refusals" -eq 0 ]; then
		rejected_note=
		[ "$rejected_findings" -eq 0 ] || rejected_note="; rejected findings: $rejected_findings"
		printf 'dossier-check: PASS %s on %s %s%s%s%s%s\n' "$tip" "$base_ref" "$base_tip" "${stacked_base:+, stacked on $base}" \
			"${legs_off:+; legs off: $legs_off}" "${failing_reports:+; reports that do not pass: $failing_reports}" "$rejected_note"
		exit 0
	fi
	if [ "$phase" = yes ]; then
		printf 'dossier-check: FAIL, %s refusal(s); do not hand the phase back\n' "$refusals"
	else
		printf 'dossier-check: FAIL, %s refusal(s); do not close the panel round\n' "$refusals"
	fi
	exit 1
}

in_worktree() { git -c core.quotepath=off -C "$worktree" "$@"; }

tip=$(in_worktree rev-parse --verify --quiet "$tip_ref^{commit}") || usage
base_tip=$(in_worktree rev-parse --verify --quiet "$base_ref^{commit}") || {
	printf 'dossier-check: %s has no %s, the base ref of the ADAPT block, to check the strand against\n' "$worktree" "$base_ref" >&2
	exit 2
}

if [ -L "$dossier" ]; then
	refuse location "$dossier is a symlink, so a build could clean what it points to: keep the evidence in the directory itself (playbook, The gate dossier)"
	verdict
fi
if [ ! -d "$dossier" ]; then
	refuse location "no dossier at $dossier: gate evidence lives in the strand worktree's gate.local.d, where no build cleans it (playbook, The gate dossier)"
	verdict
fi
in_worktree check-ignore -q gate.local.d \
	|| refuse ignored "git does not ignore gate.local.d, so the evidence could be committed or cleaned with the tree (playbook, The gate dossier)"

stand_in_refs='refs/main refs/origin/main refs/heads/main refs/heads/origin/main refs/tags/main refs/tags/origin/main refs/remotes/origin/main'
stand_ins=$(in_worktree for-each-ref --ignore-case --format='%(refname)' $stand_in_refs) || {
	refuse base "git could not list the refs that could stand in for main, so the base is not shown to be the branch (handbook §7)"
	verdict
}
# for-each-ref also lists the refs below a name, such as refs/main/x, which stand in for nothing.
for ref in $stand_ins; do
	case " $stand_in_refs " in *" $(printf '%s' "$ref" | tr 'A-Z' 'a-z') "*) ;; *) continue ;; esac
	case "$ref" in
		refs/heads/main|refs/remotes/origin/main) ;;
		*) refuse base "$ref could stand in for main or origin/main, so the base the strand is held against may not be the branch: rename or delete it (handbook §7)" ;;
	esac
done
# git reads a file main or origin/main directly in the common git dir before any ref, and
# for-each-ref lists neither.
common_dir=$(in_worktree rev-parse --git-common-dir) || {
	refuse base "git could not name the common git dir, so no file there is shown not to stand in for main (handbook §7)"
	verdict
}
case "$common_dir" in
	/*|[A-Za-z]:*) ;;
	*) common_dir="$worktree/$common_dir" ;;
esac
for name in main origin/main; do
	if [ -f "$common_dir/$name" ] || [ -L "$common_dir/$name" ]; then
		refuse base "the file $name in the common git dir $common_dir could stand in for main or origin/main, so the base the strand is held against may not be the branch: rename or delete it (handbook §7)"
	fi
done
# What git itself resolves the two names to also catches a stand-in no list above shows, such as a
# packed-refs line 'main' without the refs/ prefix. A name git cannot resolve exits non-zero and
# passes; an ambiguous one exits 0 with an empty answer, which is refused.
for name in main origin/main; do
	resolved=$(in_worktree rev-parse --verify --symbolic-full-name "$name" 2> /dev/null) || continue
	case "$name:$resolved" in
		main:refs/heads/main|origin/main:refs/remotes/origin/main) ;;
		*) refuse base "git resolves $name in the strand worktree to '$resolved', not to the branch, so something could stand in for main or origin/main: rename or delete it (handbook §7)" ;;
	esac
done

if [ -n "$stacked_base" ]; then
	base=$(in_worktree rev-parse --verify --quiet "$stacked_base^{commit}") || {
		refuse base "the stacked base $stacked_base is no commit (handbook §7)"
		verdict
	}
	in_worktree merge-base --is-ancestor "$base" "$tip" \
		|| refuse base "the stacked base $base is no ancestor of the tip $tip, so the range has no base to review against (handbook §7)"
	in_worktree merge-base --is-ancestor "$base_tip" "$base" \
		|| refuse base "the stacked base $base does not contain $base_ref at $base_tip: rebase the strand below onto it and this strand onto that (handbook §7)"
	[ "$refusals" -eq 0 ] || verdict
else
	base=$(in_worktree merge-base "$tip" "$base_tip") || {
		refuse base "the tip and $base_ref share no history, so the strand has no base to review against (handbook §7)"
		verdict
	}
	[ "$phase" = yes ] || [ "$base" = "$base_tip" ] \
		|| refuse base "the strand's merge-base is $base, but $base_ref is at $base_tip now: rebase onto it and re-run the gate on the rebased tip (handbook §7)"
fi
if [ "$phase" = no ]; then
	[ "$(in_worktree rev-parse "$tip^{tree}")" != "$(in_worktree rev-parse "$base^{tree}")" ] \
		|| refuse base "the tip's tree is the base's, so the strand changes nothing to review"
fi

commits=$(in_worktree log --reverse --format='%H %s' "$base..$tip") || {
	refuse base "git could not list the commits of $base..$tip (handbook §7)"
	verdict
}
while read -r commit subject; do
	[ -n "$commit" ] || continue
	case "$subject" in
		'[wip]'*) refuse parked "'$subject' is a [wip] parking commit, which never lands: resume it with /resume-work and re-commit the work (handbook §7)" ;;
	esac
done <<COMMITS
$commits
COMMITS

if [ "$phase" = no ]; then
	head=$(in_worktree rev-parse HEAD)
	[ "$head" = "$tip" ] \
		|| refuse freeze "the strand worktree is checked out at $head, not at the tip under review $tip (handbook §7)"
	# The flag outranks a status.showUntrackedFiles=no in git's config, which would hide new files.
	changes=$(in_worktree status --porcelain --untracked-files=normal)
	[ -z "$changes" ] \
		|| refuse freeze "the strand worktree has uncommitted changes, so no verdict reads the tip as committed (handbook §7): $(printf '%s' "$changes" | tr '\n' ' ')"
fi

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
# A shell such as dash runs no EXIT trap when a signal ends it, so each signal exits explicitly.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
cr=$(printf '\r')
tab=$(printf '\t')
byte_order_mark=$(printf '\357\273\277')

# The breach guard of the checkout this check runs from answers, from the strand worktree, whether
# the tip reaches a commit the hooks recorded as ungated; its first stderr line is the contract.
check_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || check_dir=$(dirname -- "$0")
breach_guard="$check_dir/../hooks/breach-guard"
if [ ! -f "$breach_guard" ]; then
	refuse breach "no breach guard at $breach_guard, so the tip is not shown to reach no commit the hooks recorded as ungated (handbook §7)"
else
	guard_status=0
	(CDPATH= cd -- "$worktree" && sh "$breach_guard" --reaches "$tip") > /dev/null 2> "$scratch/breach.err" || guard_status=$?
	guard_line=$(sed -n '1p' "$scratch/breach.err" 2> /dev/null | tr -d '\r')
	case "$guard_status" in
		0) ;;
		1) refuse breach "the breach guard answers '$guard_line': take each recorded commit out of the strand's history by a rewrite, or have the author release one already on main (handbook §7)" ;;
		*) refuse breach "the breach guard $breach_guard exited $guard_status with '$guard_line', so the tip is not shown to reach no commit the hooks recorded as ungated (handbook §7)" ;;
	esac
fi
merges=$(in_worktree rev-list --merges "$base..$tip") || {
	refuse merge "git could not list the merge commits of $base..$tip (handbook §7)"
	verdict
}
[ -z "$merges" ] \
	|| refuse merge "the range holds the merge commit(s) $(printf '%s' "$merges" | tr '\n' ' '), which a fast-forward landing would bring onto main: rebuild the strand without them (handbook §7)"

# The paths each commit changes are read once, into a file per commit, so a read git fails is a
# refusal, never a commit that changes no test: a pipe would hide git's status behind grep's.
mkdir "$scratch/touched"
while read -r commit subject; do
	[ -n "$commit" ] || continue
	in_worktree diff-tree --no-commit-id --name-only -r "$commit" > "$scratch/touched/$commit" || {
		rm -f "$scratch/touched/$commit"
		refuse red "git could not list the paths '$subject' changes, so the commit is not shown to change no test (handbook §4)"
	}
done <<COMMITS
$commits
COMMITS

changes_tests() { [ -f "$scratch/touched/$1" ] && grep -Eq -- "$test_path_re" "$scratch/touched/$1"; }

# A red record names its commit by subject, so of two commits that need one under one subject
# neither can carry its own; the check stops here rather than refuse what follows from that.
while read -r commit subject; do
	[ -n "$commit" ] || continue
	changes_tests "$commit" || continue
	printf '%s %s\n' "$(in_worktree rev-parse --short "$commit")" "$subject"
done > "$scratch/tested.subjects" <<COMMITS
$commits
COMMITS
shared=$(awk '
	{ subject = substr($0, length($1) + 2) }
	subject in first { print first[subject], $1, subject; next }
	{ first[subject] = $1 }
' "$scratch/tested.subjects")
while IFS=' ' read -r first_short second_short subject; do
	[ -n "$first_short" ] || continue
	refuse subject "$first_short and $second_short both change tests under the subject '$subject', and a red record names its commit by subject, so the two cannot each carry their own: reword one, so each commit's subject is its own (handbook §7)"
done <<SHARED
$shared
SHARED
[ -z "$shared" ] || verdict

changed_paths() {
	in_worktree diff --no-renames --name-only -z "$1" "$2" > "$scratch/paths.z" || return 1
	tr '\000' '\n' < "$scratch/paths.z"
}

paths_read_by() {
	case "$1" in
		lens-robustness.md|lens-security.md) reads='.' ;;
		lens-domain.md) reads=$reads_domain ;;
		lens-frontend.md) reads=$reads_frontend ;;
	esac
	reads="$reads" awk 'BEGIN { reads = ENVIRON["reads"] } reads != "" && $0 != "" && $0 !~ /\.md$/ && $0 ~ reads'
}

lens_report_stands() {
	case "$1" in lens-robustness.md|lens-security.md|lens-domain.md|lens-frontend.md) ;; *) return 1 ;; esac
	printf '%s\n' "$2" | grep -Eqx '[0-9a-f]{40}([0-9a-f]{24})?' || return 1
	then_base=$(in_worktree merge-base "$2" "$base_tip" 2>/dev/null) || return 1
	on_strand=$(changed_paths "$2" "$tip") && on_main=$(changed_paths "$then_base" "$base_tip") || return 1
	read_since=$(printf '%s\n%s\n' "$on_strand" "$on_main" | paths_read_by "$1") || return 1
	[ -z "$read_since" ]
}

opening_lines() {
	grep -a -E "^[[:space:]]*([-*+]|[0-9]+[.)])?[[:space:]]*(\*\*|\`)?$2:" "$1" || true
}

# A report's own verdict, its count of findings and whether two share a line: the verdict is the
# one line that opens with the field and reads its value alone, "-" where there is none.
report_facts() {
	field="$2" raised="${3:-}" awk '
		BEGIN {
			field = ENVIRON["field"]; raised = ENVIRON["raised"]
			lead = "^[[:space:]]*([-*+]|[0-9]+[.)])?[[:space:]]*"
			opening = lead "(\\*\\*|`)?" field ":"
			alone = opening "[[:space:]]*(\\*\\*|`)?[A-Za-z]+(\\*\\*|`)?[[:space:]]*$"
			entry = lead "`?\\{[[:space:]]*" raised
		}
		{ sub(/\r$/, "") }
		$0 ~ opening { openings++; line = $0 }
		raised != "" && $0 ~ entry {
			count++
			if ($0 ~ ("\\{[[:space:]]*" raised ".*\\{[[:space:]]*" raised)) twice = 1
		}
		END {
			value = "-"
			if (openings == 1 && line ~ alone) {
				value = line; sub("^[^:]*" field ":", "", value); gsub(/[*`[:space:]]/, "", value)
			}
			print value, count + 0, twice + 0
		}
	' "$1"
}

own_verdict() {
	facts=$(report_facts "$1" "$2")
	facts=${facts%% *}
	[ "$facts" = - ] || printf '%s\n' "$facts"
}

findings_lines=
if [ -f "$dossier/findings.txt" ]; then
	findings_lines=$(sed 1d "$dossier/findings.txt" | tr -d '\r')
fi
# A backlog ID is letters and digits, its parts joined by a dash (DOC-5), in a trace as in a filed row.
backlog_id_re='[A-Za-z0-9]+(-[A-Za-z0-9]+)*'
filed_ids=$(printf '%s\n' "$findings_lines" | id="^$backlog_id_re\$" awk 'BEGIN { id = ENVIRON["id"] } $2 == "backlog" && NF == 3 && $3 ~ id { print $3 }')
filed_debts=$(printf '%s\n' "$findings_lines" | awk '$2 == "debt" && NF == 3 { print $3 }')

beside_filed_only() {
	in_worktree show "$1:docs/backlog.md" > "$scratch/backlog.before" 2>/dev/null || return 1
	in_worktree show "$tip:docs/backlog.md" > "$scratch/backlog.after" 2>/dev/null || return 1
	in_worktree diff --text --no-color --no-ext-diff --no-renames -U0 \
		--output-indicator-old='<' --output-indicator-new='>' "$1" "$tip" -- docs/backlog.md > "$scratch/backlog.patch" || return 1
	printf '%s\n' "$filed_ids" > "$scratch/filed.ids"
	printf '%s\n' "$filed_debts" > "$scratch/filed.debts"
	awk -v row="$backlog_row" -v heading="$doc_debt_heading" '
		function group_of(lines, at,    k, j) {
			for (k = at; k >= 1; k--) {
				if (lines[k] ~ /^## /) return ""
				if (lines[k] ~ /^- /) break
			}
			if (k < 1) return ""
			for (j = k - 1; j >= 1; j--) if (lines[j] ~ /^## /) break
			if (j < 1 || lines[j] != heading) return ""
			return lines[k]
		}
		function filed_debt(head,    f) {
			if (head == "") return 0
			for (f in debts) if (head == "- " f || head == "- `" f "`" || index(head, "- `" f "` ") == 1 || index(head, "- " f " ") == 1) return 1
			return 0
		}
		function filed(text, lines, at,    id) {
			for (id in ids) if (index(text, sprintf(row, id)) == 1) return 1
			return filed_debt(group_of(lines, at))
		}
		FILENAME == ARGV[1] { if ($0 != "") ids[$0] = 1; next }
		FILENAME == ARGV[2] { if ($0 != "") debts[$0] = 1; next }
		FILENAME == ARGV[3] { before[FNR] = $0; next }
		FILENAME == ARGV[4] { after[FNR] = $0; next }
		/^@@ / {
			split($2, o, ","); old_at = substr(o[1], 2) + 0
			split($3, n, ","); new_at = substr(n[1], 2) + 0
			in_hunk = 1; next
		}
		!in_hunk { next }
		/^</ { if (!filed(substr($0, 2), before, old_at)) bad = 1; old_at++; next }
		/^>/ { if (!filed(substr($0, 2), after, new_at)) bad = 1; new_at++; next }
		/^\\/ { next }
		{ bad = 1 }
		END { exit bad }
	' "$scratch/filed.ids" "$scratch/filed.debts" "$scratch/backlog.before" "$scratch/backlog.after" "$scratch/backlog.patch"
}

stands_beside_filed_lows() {
	case "$1" in doc-reviewer.md|reviewer.md|bdd.log|wip.expected|kb-guard.log) ;; *) return 1 ;; esac
	printf '%s\n' "$2" | grep -Eqx '[0-9a-f]{40}([0-9a-f]{24})?' || return 1
	in_worktree rev-parse --verify --quiet "$2^{commit}" > /dev/null || return 1
	case "$1" in
		doc-reviewer.md|reviewer.md) [ "$(own_verdict "$dossier/$1" verdict)" = PASS ] || return 1 ;;
	esac
	[ -n "$filed_ids$filed_debts" ] && [ "$(changed_paths "$2" "$tip" 2>/dev/null)" = docs/backlog.md ] || return 1
	beside_filed_only "$2"
}

if [ "$phase" = no ]; then
	for evidence in "$dossier"/*; do
		[ -f "$evidence" ] || continue
		named=
		IFS= read -r named < "$evidence" || true
		named=${named#"$byte_order_mark"}
		case "$named" in
			'tip: '*) named=${named#tip: } ;;
			*) named= ;;
		esac
		named=${named%"${named##*[![:space:]]}"}
		file=${evidence#"$dossier"/}
		[ "$named" = "$tip" ] || lens_report_stands "$file" "$named" \
			|| stands_beside_filed_lows "$file" "$named" \
			|| refuse tip "$file names tip '${named:-none}', not the tip under review $tip, and is neither a lens report whose paths stayed unchanged since nor a report or run beside which only the filed lows changed (handbook §9)"
	done
fi

# The list of the authentication surface is a file of the repository, read as the base and as the
# tip hold it: a path matching a line of either calls for the security lens, so a strand that adds
# a path and its line, or deletes a line, is held by the list on the other side. The leg is off
# while neither holds the list.
surface_held=no
surface_removed=no
base_holds=no
tip_holds=unknown
for side in base tip; do
	: > "$scratch/surface.$side"
	case "$side" in base) commit=$base ;; *) commit=$tip ;; esac
	listed=$(in_worktree ls-tree --name-only "$commit" -- "$surface_path") || {
		refuse surface "git could not look for $surface_path at the $side $commit, so no diff can be told to call for the security lens"
		continue
	}
	[ "$side" != tip ] || tip_holds=no
	[ -n "$listed" ] || continue
	surface_held=yes
	[ "$side" != base ] || base_holds=yes
	[ "$side" != tip ] || tip_holds=yes
	in_worktree show "$commit:$surface_path" > "$scratch/surface.$side.raw" || {
		refuse surface "git could not read $surface_path at the $side $commit, so no diff can be told to call for the security lens"
		continue
	}
	sed 's/[[:space:]]*$//' < "$scratch/surface.$side.raw" > "$scratch/surface.$side.trimmed" || {
		refuse surface "the check could not trim the lines of $surface_path read at the $side $commit"
		continue
	}
	grep -v '^$' < "$scratch/surface.$side.trimmed" > "$scratch/surface.$side" || [ $? -eq 1 ] \
		|| refuse surface "the check could not drop the blank lines of $surface_path read at the $side $commit"
done
if [ "$surface_held" = no ]; then
	legs_off="security (no $surface_path)${legs_off:+; $legs_off}"
elif [ "$base_holds" = yes ] && [ "$tip_holds" = no ]; then
	surface_removed=yes
fi
if [ "$tip_holds" = yes ] && [ "$phase" = no ]; then
	[ -s "$scratch/surface.tip" ] \
		|| refuse surface "$surface_path at the tip names no path, so no diff can be told to call for the security lens (playbook, The gate dossier)"
	stale_lines=
	if in_worktree ls-tree -r -z --name-only "$tip" > "$scratch/tracked.tip.z" \
		&& tr '\000' '\n' < "$scratch/tracked.tip.z" > "$scratch/tracked.tip"; then
		stale_lines=$(awk 'NR == FNR { tracked[++t] = $0; next } { for (i = 1; i <= t; i++) if (index(tracked[i], $0) == 1) next; print }' \
			"$scratch/tracked.tip" "$scratch/surface.tip") \
			|| refuse surface "the check could not match the lines of $surface_path against the paths tracked at the tip"
	else
		refuse surface "git could not list the paths tracked at the tip $tip, so the lines of $surface_path are not shown to start any"
	fi
	while IFS= read -r stale; do
		[ -n "$stale" ] || continue
		refuse surface "the line '$stale' of $surface_path starts no path tracked at the tip, so the list no longer names what it means to (playbook, The gate dossier)"
	done <<STALE
$stale_lines
STALE
fi

wrapper_path=gate/lens-request

# The wrapper's tree entry at a commit, its mode and object beside its path, so a change of its
# content or mode, a link in its place, a rename and a delete each read as a change; empty where the
# commit holds none.
wrapper_entry() { in_worktree ls-tree "$1" -- "$wrapper_path"; }

# The lens runs the worktree's file, so it must be the tip's byte for byte with git's filters off:
# an edit that skip-worktree, assume-unchanged or a clean filter hides from git status still shows.
# Where the tip tracks no wrapper, the worktree holds none.
wrapper_on_disk() {
	disk="$worktree/$wrapper_path"
	if [ -z "$1" ]; then
		[ ! -e "$disk" ] \
			|| refuse lens-request "the worktree holds $wrapper_path, which the tip $tip does not track, so the lens would run a wrapper the check never saw"
		return 0
	fi
	disk_blob=$(in_worktree hash-object --no-filters -- "$disk" 2> /dev/null) || disk_blob=
	[ "$disk_blob" = "$(printf '%s\n' "$1" | awk '{ print $3 }')" ] \
		|| refuse lens-request "the worktree's $wrapper_path is not the tip's byte for byte (an edit git status does not show, behind skip-worktree, assume-unchanged or a clean filter), so the lens would run a wrapper the check never saw"
}

changed=$(changed_paths "$base" "$tip") || {
	refuse base "git could not list the paths of $base..$tip (handbook §7)"
	verdict
}
code_changed=$(printf '%s\n' "$changed" | grep -v '\.md$' || true)

if [ "$phase" = no ]; then
	needed=$(printf '%s\n' "$changed" | domain="$needs_domain" frontend="$needs_frontend" base_list="$scratch/surface.base" tip_list="$scratch/surface.tip" awk '
		BEGIN {
			domain = ENVIRON["domain"]; frontend = ENVIRON["frontend"]
			while ((getline prefix < ENVIRON["base_list"]) > 0) prefixes[++n] = prefix
			while ((getline prefix < ENVIRON["tip_list"]) > 0) prefixes[++n] = prefix
		}
		$0 == "" { next }
		{ any = 1 }
		/\.md$/ { next }
		{ for (i = 1; i <= n; i++) if (index($0, prefixes[i]) == 1) security = 1 }
		{ code = 1; if (domain != "" && $0 ~ domain) in_domain = 1; if (frontend != "" && $0 ~ frontend) in_frontend = 1 }
		END {
			if (any) { print "doc-reviewer.md the strand"; print "reviewer.md the strand" }
			if (code) print "lens-robustness.md code"
			if (in_domain) print "lens-domain.md a path matching " domain
			if (in_frontend) print "lens-frontend.md a path matching " frontend
			if (security) print "lens-security.md the authentication surface"
		}
	') || {
		refuse lens "the check could not read which reports the diff calls for, so none is shown to be in place (playbook, The gate dossier)"
		needed=
	}
	needs_security=no
	while read -r report reason; do
		[ -n "$report" ] || continue
		[ "$report" != lens-security.md ] || needs_security=yes
		[ -f "$dossier/$report" ] \
			|| refuse lens "the diff touches $reason, so the gate needs $report (playbook, Cadence)"
	done <<NEEDED
$needed
NEEDED
	if [ "$needs_security" = yes ]; then
		wrapper_bases=$base
		[ -z "$stacked_base" ] || [ "$base" = "$base_tip" ] || wrapper_bases="$base $base_tip"
		for wrapper_base in $wrapper_bases; do
			if wrapper_before=$(wrapper_entry "$wrapper_base") && wrapper_after=$(wrapper_entry "$tip"); then
				[ "$wrapper_before" = "$wrapper_after" ] \
					|| refuse lens-request "the strand touches the authentication surface and changes $wrapper_path against $wrapper_base (its content, its mode, a link, a rename or a delete), so the security lens would run a wrapper this strand or one below it changed: such a change lands in a strand of its own, which calls for no security lens (playbook, The gate dossier)"
			else
				refuse lens-request "git could not read $wrapper_path at $wrapper_base or the tip $tip, so the strand is not shown to leave the wrapper alone"
			fi
		done
		if wrapper_after=$(wrapper_entry "$tip"); then
			wrapper_on_disk "$wrapper_after"
		fi
	fi
	if [ "$surface_removed" = yes ] && [ "$needs_security" = yes ]; then
		leg_off "security after this strand (it removes $surface_path; the list at its base still called for the report here)"
	elif [ "$surface_removed" = yes ]; then
		leg_off "security (this strand removes $surface_path, so the leg is off from here)"
	fi
fi

red_record_of() {
	for record in "$dossier"/red/*; do
		[ -f "$record" ] || continue
		first=
		IFS= read -r first < "$record" || true
		if [ "${first%"$cr"}" = "commit: $1" ]; then
			printf '%s\n' "$record"
			return 0
		fi
	done
	return 1
}

own_code_in_diff() {
	[ -f "$scratch/touched/$1" ] || return 1
	own=$(grep -Ev -- "$test_path_re" "$scratch/touched/$1" | grep -v '\.md$' || true)
	[ -n "$own" ] || return 1
	printf '%s\n' "$own" > "$scratch/own"
	tr -d '\r' < "$2" | awk -v own_file="$scratch/own" '
		function unquote(p,    out, at, c, code) {
			if (p !~ /^".*"$/) return p
			p = substr(p, 2, length(p) - 2); out = ""
			for (at = 1; at <= length(p); at++) {
				c = substr(p, at, 1)
				if (c != "\\") { out = out c; continue }
				at++; c = substr(p, at, 1)
				if (c ~ /[0-7]/) {
					code = c + 0
					while (substr(p, at + 1, 1) ~ /[0-7]/) { at++; code = code * 8 + substr(p, at, 1) }
					out = out sprintf("%c", code)
				} else if (c == "t") out = out "\t"
				else out = out c
			}
			return out
		}
		function owned_name(p,    q) {
			for (q in owned) if (p == q || substr(p, length(p) - length(q)) == "/" q) return q
			return ""
		}
		BEGIN { while ((getline line < own_file) > 0) if (line != "") owned[line] = 1 }
		/^(---|\+\+\+) / {
			path = substr($0, 5); sub(/\t.*/, "", path); path = unquote(path)
			headed = 1
			q = owned_name(path)
			if (q == "") { stripped = path; sub(/^[a-z0-9]\//, "", stripped); q = owned_name(stripped) }
			if (q != "" && !(q in shown)) { shown[q] = 1; print q }
			next
		}
		/^diff / { headed = 1; next }
		/^@@ / && !headed { bare = 1 }
		END { if (bare) print "?bare-hunk" }
	' | grep .
}

# The 'blob:' lines of a record as the file holds them, an empty one kept: the shape check reads
# them here, as a command substitution drops the empty lines at its end. awk ends every line it
# prints, so an empty last line with no newline after it is read too.
blob_lines() { awk '/^blob: / { sub(/^blob: /, ""); print }' "$1" | tr -d '\r'; }

# What a red or mutation record lacks of its provenance, written before the run, so the gate can tie
# the run to the test as committed: the tree its run read, holding the blob of each 'blob:' line,
# each a test file's and the one at the commit, or at the tip for a mutation. A red record names
# every test file its commit adds or changes. A 'blob:' line is a sha, one blank and a path with no
# tab and no blank at either end, the one key the failing lines of the record are filed under.
provenance_of() {
	tree_line=$(sed -n 's/^tree: //p' "$1" | tr -d '\r' | head -n 1)
	# The tree is named by its full hex id alone, as in a walk log: a ref name would name whatever it
	# points at when the check runs, not what the run read. A commit's full id names one tree too, so
	# it is read as that tree.
	case "$tree_line" in
		'') ;;
		*[!0-9a-f]*) tree_line="?$tree_line" ;;
		*) [ "${#tree_line}" -eq 40 ] || [ "${#tree_line}" -eq 64 ] || tree_line="?$tree_line" ;;
	esac
	case "$tree_line" in
		'?'*)
			printf "a 'tree:' line that reads '%s', not the full hex id of the tree the run read" "${tree_line#?}"
			return 0
			;;
	esac
	in_worktree rev-parse --verify --quiet "$tree_line^{tree}" > /dev/null 2>&1 || {
		printf "no 'tree: <sha>' line naming the tree the run read"
		return 0
	}
	blobs=$(blob_lines "$1")
	[ -n "$blobs" ] || {
		printf "no 'blob: <sha> <path>' line naming the test file the run read"
		return 0
	}
	blob_shape="^[0-9a-f]+ [^[:space:]]([^$tab]*[^[:space:]])?\$"
	if blob_lines "$1" | grep -Evq -- "$blob_shape"; then
		odd=$(blob_lines "$1" | grep -Ev -- "$blob_shape" | head -n 1)
		printf "'blob: %s', but a blob line is a sha, one blank and a path with no tab and no blank at either end" "$odd"
		return 0
	fi
	while IFS=' ' read -r blob path; do
		printf '%s\n' "$path" | grep -Eq -- "$test_path_re" || {
			printf "'blob: %s %s', but %s is no test path" "$blob" "$path" "$path"
			return 0
		}
		held=$(in_worktree rev-parse --verify --quiet "$tree_line:$path" 2>/dev/null || true)
		[ "$held" = "$blob" ] || {
			printf "'blob: %s %s', but its tree %s holds %s there" "$blob" "$path" "$tree_line" "${held:-nothing}"
			return 0
		}
		actual=$(in_worktree rev-parse --verify --quiet "$2:$path" 2>/dev/null || true)
		[ "$actual" = "$blob" ] || {
			printf "'blob: %s %s', but %s holds %s there" "$blob" "$path" "$path" "${actual:-nothing}"
			return 0
		}
	done <<BLOBS
$blobs
BLOBS
	[ "${3:-}" = commit ] || return 0
	in_worktree diff-tree --no-commit-id --name-only -r -z --diff-filter=d "$2" > "$scratch/tested.z" || {
		printf "'blob:' lines the check cannot hold against %s, whose test files git could not list" "$2"
		return 0
	}
	tr '\000' '\n' < "$scratch/tested.z" | grep -E -- "$test_path_re" > "$scratch/tested" || true
	while IFS= read -r tested; do
		printf '%s\n' "$blobs" | tested="$tested" awk '
			BEGIN { tested = ENVIRON["tested"] }
			{ sub(/^[^ ]* +/, ""); sub(/ +$/, "") }
			$0 == tested { found = 1 }
			END { exit !found }
		' || {
			printf "no 'blob: <sha> %s' line, though its commit changes that test file" "$tested"
			return 0
		}
	done < "$scratch/tested"
}

# The records whose run the check ties to its test files: each line the revision its blobs are held
# against, then the record.
: > "$scratch/proven"
while read -r commit subject; do
	[ -n "$commit" ] || continue
	changes_tests "$commit" || continue
	if ! record=$(red_record_of "$subject"); then
		refuse red "'$subject' changes tests, but no file in red/ opens with 'commit: $subject' (handbook §4)"
	elif grep -Eq '^exempt:[[:space:]]*[^[:space:]]' "$record"; then
		continue
	elif ! sed 1d "$record" | grep -Eq -- "$failure_marker"; then
		refuse red "red/${record##*/} shows no failing run and claims no exemption (handbook §4)"
	elif mutated=$(own_code_in_diff "$commit" "$record"); then
		case "$mutated" in
			*'?bare-hunk'*) refuse red "red/${record##*/} shows a diff hunk without its file header, so the check cannot tell whose code it changes: a red record holds the failing run, and a mutation belongs under mutation/ (handbook §4)" ;;
			*) refuse red "red/${record##*/} shows a diff of $(printf '%s' "$mutated" | tr '\n' ' ' | sed 's/ $//'), production code '$subject' itself changes: a red record holds the failing run, and a mutation of that code belongs under mutation/ (handbook §4)" ;;
		esac
	else
		missing=$(provenance_of "$record" "$commit" commit)
		if [ -n "$missing" ]; then
			refuse provenance "red/${record##*/} has $missing, written before the run (playbook, The gate dossier)"
		else
			printf '%s\t%s\n' "$commit" "$record" >> "$scratch/proven"
		fi
	fi
done <<COMMITS
$commits
COMMITS

# A red record opens with the subject of the commit whose run it holds, so one that names no commit
# of the range ties its failing lines to nothing under review, and a second one of a commit escapes
# the checks the red leg runs on the first.
while read -r commit subject; do
	[ -n "$commit" ] || continue
	printf 'commit: %s\n' "$subject"
done > "$scratch/subjects" <<COMMITS
$commits
COMMITS
for record in "$dossier"/red/*; do
	[ -f "$record" ] || continue
	first=
	IFS= read -r first < "$record" || true
	first=${first%"$cr"}
	earlier=
	for other in "$dossier"/red/*; do
		if [ "$other" = "$record" ]; then break; fi
		[ -f "$other" ] || continue
		other_first=
		IFS= read -r other_first < "$other" || true
		if [ "${other_first%"$cr"}" = "$first" ]; then
			earlier=${other##*/}
			break
		fi
	done
	if ! grep -qxF -- "$first" "$scratch/subjects"; then
		refuse red "red/${record##*/} opens with '$first', which names no commit of $base..$tip, so its run is tied to no commit under review (handbook §4)"
	elif [ -n "$earlier" ]; then
		refuse red "red/${record##*/} opens with '$first' as red/$earlier does, and a commit keeps one red record (playbook, The gate dossier)"
	fi
done

for record in "$dossier"/mutation/*; do
	[ -f "$record" ] || continue
	grep -Eq '^(@@ |diff )' "$record" && grep -Eq -- "$failure_marker" "$record" \
		|| { refuse mutation "mutation/${record##*/} lacks the mutation's diff or its failing run (handbook §4)"; continue; }
	missing=$(provenance_of "$record" "$tip")
	if [ -n "$missing" ]; then
		refuse provenance "mutation/${record##*/} has $missing, written before the run (playbook, The gate dossier)"
	elif grep -Eq '^older:[[:space:]]*[^[:space:]]' "$record"; then
		printf '%s\t%s\n' "$tip" "$record" >> "$scratch/proven"
	fi
done

reader_on() {
	case " $test_readers " in *" $1 "*) return 0 ;; esac
	return 1
}

declared_java() {
	awk -v unreadable="?unreadable@$1" '
		function unquote(text,    at, c, out) {
			for (at = 1; at <= length(text); at++) {
				c = substr(text, at, 1)
				if (c == "\\") { at++; out = out substr(text, at, 1); continue }
				if (c == "\"") break
				out = out c
			}
			return out
		}
		function test_annotation(text) {
			return match(text, /@([A-Za-z0-9_]+\.)*(Test|ParameterizedTest|RepeatedTest|TestFactory|TestTemplate|ArchTest)([^A-Za-z0-9_]|$)/)
		}
		# 1 where a line opens with a test annotation or with annotations alone before one, 2 for
		# an ArchTest, 0 otherwise. Literals are emptied first, so an annotation argument that
		# quotes one, or holds a bracket, misleads neither the reading nor the count of brackets.
		function leading_test(text,    depth, at, c, closed_at) {
			gsub(/"([^"\\]|\\.)*"/, "\"\"", text)
			gsub(/\047([^\047\\]|\\.)*\047/, "\047\047", text)
			while (1) {
				sub(/^[ \t]+/, "", text)
				if (text !~ /^@/) return 0
				if (test_annotation(text) && RSTART == 1) return (text ~ /^@([A-Za-z0-9_]+\.)*ArchTest/) ? 2 : 1
				if (!match(text, /^@[A-Za-z0-9_.]+[ \t]*/)) return 0
				text = substr(text, RLENGTH + 1)
				if (substr(text, 1, 1) != "(") continue
				depth = 0; closed_at = 0
				for (at = 1; at <= length(text); at++) {
					c = substr(text, at, 1)
					if (c == "(") depth++
					else if (c == ")" && --depth == 0) { closed_at = at; break }
				}
				if (!closed_at) return 0
				text = substr(text, closed_at + 1)
			}
		}
		in_text { if (gsub(/"""/, "&") % 2) in_text = 0; next }
		!annotated && gsub(/"""/, "&") % 2 { in_text = 1; next }
		in_block { if (index($0, "*/")) in_block = 0; next }
		annotated && in_annotation_text {
			closes = index($0, "\"\"\"")
			if (!closes) next
			$0 = "\"\"" substr($0, closes + 3); in_annotation_text = 0
		}
		annotated {
			while (match($0, /"""/)) {
				rest = substr($0, RSTART + 3); closes = index(rest, "\"\"\"")
				if (!closes) { $0 = substr($0, 1, RSTART - 1) "\"\""; in_annotation_text = 1; break }
				$0 = substr($0, 1, RSTART - 1) "\"\"" substr(rest, closes + 3)
			}
		}
		want_display && /^[ \t]*"/ {
			quoted = $0; sub(/^[ \t]*"/, "", quoted); shown = unquote(quoted); want_display = 0
			if (annotated && display == "") display = shown
			if (!annotated) next
		}
		/^[ \t]*@DisplayName[ \t]*\([ \t]*$/ { want_display = 1 }
		!annotated && /^[ \t]*\/\*/ && !index($0, "*/") { in_block = 1; next }
		/^[ \t]*@DisplayName[ \t]*\([ \t]*"/ {
			quoted = $0; sub(/^[ \t]*@DisplayName[ \t]*\([ \t]*"/, "", quoted); shown = unquote(quoted)
			if (annotated && display == "") display = shown
		}
		!annotated && /^[ \t]*@/ && (leads = leading_test($0)) {
			annotated = 1; display = shown; arch = (leads == 2)
			if (match($0, /@DisplayName[ \t]*\([ \t]*"/)) display = unquote(substr($0, RSTART + RLENGTH))
			if (match($0, /name[ \t]*=[ \t]*"[^"]*"/)) {
				display = substr($0, RSTART, RLENGTH); sub(/^name[ \t]*=[ \t]*"/, "", display); sub(/"$/, "", display)
			}
		}
		annotated {
			line = $0
			gsub(/"([^"\\]|\\.)*"/, "\"\"", line)
			gsub(/\047([^\047\\]|\\.)*\047/, "\047\047", line)
			pending = pending " " line
			while (annotated) {
				sub(/^[ \t]+/, "", pending)
				if (pending ~ /^\/\*/) {
					closes = index(pending, "*/")
					if (!closes) { in_block = 1; pending = ""; break }
					pending = substr(pending, closes + 2)
					continue
				}
				if (pending ~ /^(\/\/|\*)/) { pending = ""; break }
				if (match(pending, /^@[A-Za-z0-9_.]+[ \t]*/)) {
					rest = substr(pending, RLENGTH + 1)
					if (substr(rest, 1, 1) != "(") { pending = rest; continue }
					depth = 0; closed_at = 0
					for (at = 1; at <= length(rest); at++) {
						c = substr(rest, at, 1)
						if (c == "(") depth++
						else if (c == ")" && --depth == 0) { closed_at = at; break }
					}
					if (!closed_at) break
					pending = substr(rest, closed_at + 1)
					continue
				}
				if (match(pending, /^[^(=]*([A-Za-z0-9_$]|[\200-\377])[ \t]*=/)) {
					name = substr(pending, 1, RLENGTH); sub(/[ \t]*=$/, "", name); sub(/.*[^A-Za-z0-9_$\200-\377]/, "", name)
					print name "\t" name
				} else if (match(pending, /([A-Za-z0-9_$]|[\200-\377])+[ \t]*\(/)) {
					name = substr(pending, RSTART, RLENGTH); sub(/[ \t]*\($/, "", name)
					print name "\t" (arch ? name : display)
				} else break
				annotated = 0; shown = ""
				pending = substr(pending, RSTART + RLENGTH)
				if (test_annotation(pending)) {
					annotated = 1; display = ""; arch = (substr(pending, RSTART) ~ /^@([A-Za-z0-9_]+\.)*ArchTest/)
					pending = substr(pending, RSTART)
				} else pending = ""
			}
			next
		}
		!/^[ \t]*(@|$)/ { shown = "" }
		END { if (annotated) print unreadable "\t" }
	' "$2"
}

declared_vitest() {
	awk '
		/^[ \t]*\/\// { next }
		{ text = text " " $0 }
		END {
			gsub(/\/\*([^*]|\*+[^*\/])*\*+\//, " ", text)
			while (match(text, /(^|[^A-Za-z0-9_.$"\047`])(it|test)(\.(only|concurrent|fails|sequential))*(\.(each|for|runIf|skipIf))?[ \t]*[(`]/)) {
				head = substr(text, RSTART, RLENGTH)
				text = substr(text, RSTART + RLENGTH)
				call = text
				if (head ~ /`$/) {
					table_end = index(call, "`")
					if (!table_end) continue
					call = substr(call, table_end + 1)
					sub(/^[ \t]*\(/, "", call)
				} else if (head ~ /\.(each|for|runIf|skipIf)/) {
					call_at = index(call, ")(")
					if (!call_at) continue
					call = substr(call, call_at + 2)
				}
				sub(/^[ \t]*/, "", call)
				quote = substr(call, 1, 1)
				if (quote != "\047" && quote != "\"" && quote != "`") {
					if (call ~ /^[A-Za-z_$]/) print "?untitled\t"
					continue
				}
				title = ""
				for (at = 2; at <= length(call); at++) {
					c = substr(call, at, 1)
					if (c == "\\") { at++; title = title substr(call, at, 1); continue }
					if (c == quote) break
					title = title c
				}
				if (at <= length(call) && title != "") print title "\t" title
			}
		}
	' "$1"
}

declared_sh() {
	awk '
		function word_end(s, from,    at, c, q) {
			q = ""
			for (at = from; at <= length(s); at++) {
				c = substr(s, at, 1)
				if (q == "\"") { if (c == "\\") at++; else if (c == "\"") q = ""; continue }
				if (q == "\047") { if (c == "\047") q = ""; continue }
				if (c == "\\") { at++; continue }
				if (c == "\"" || c == "\047") { q = c; continue }
				if (c ~ /[ \t;&|()<>]/) break
			}
			if (q != "") pending_quote = q
			return at
		}
		function quoted_word(s,    q, at, c, out) {
			q = substr(s, 1, 1)
			if (q != "\"" && q != "\047") return ""
			out = ""
			for (at = 2; at <= length(s); at++) {
				c = substr(s, at, 1)
				if (q == "\"" && c == "\\") { at++; out = out substr(s, at, 1); continue }
				if (c == q) return out
				out = out c
			}
			return ""
		}
		{
			line = $0
			if (heredoc != "") {
				probe = line
				if (strip_tabs) sub(/^\t+/, "", probe)
				if (probe == heredoc) heredoc = ""
				next
			}
			at = 1
			if (quote != "") {
				for (; at <= length(line); at++) {
					c = substr(line, at, 1)
					if (quote == "\"" && c == "\\") { at++; continue }
					if (c == quote) { quote = ""; at++; break }
				}
				if (quote != "") next
				command = 0
			}
			if (!continued) command = 1
			continued = 0
			next_heredoc = ""
			while (at <= length(line)) {
				c = substr(line, at, 1)
				if (c == " " || c == "\t") { at++; continue }
				if (c == "\\" && at == length(line)) { continued = 1; break }
				if (c == "#") break
				if (c == ";" || c == "&" || c == "|" || c == "(" || c == ")" || c == "{" || c == "}") { command = 1; at++; continue }
				if (substr(line, at, 2) == "<<") {
					at += 2; tabs = 0
					if (substr(line, at, 1) == "-") { tabs = 1; at++ }
					while (substr(line, at, 1) ~ /[ \t]/) at++
					stop = word_end(line, at)
					word = substr(line, at, stop - at); gsub(/["\047\\]/, "", word)
					if (word != "" && next_heredoc == "") { next_heredoc = word; next_tabs = tabs }
					at = stop; continue
				}
				if (c == "<" || c == ">") { at++; continue }
				if (c == "$" && substr(line, at + 1, 1) == "(") { command = 1; at += 2; continue }
				pending_quote = ""
				stop = word_end(line, at)
				word = substr(line, at, stop - at)
				if (pending_quote != "") { quote = pending_quote; break }
				if (command && word ~ /^(then|do|else|elif|if|while|until|!)$/) { at = stop; continue }
				if (command && word ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { at = stop; continue }
				if (command && word == "check") {
					rest = substr(line, stop); sub(/^[ \t]+/, "", rest)
					name = quoted_word(rest)
					if (name != "") print name "\t"
				}
				command = 0
				at = stop
			}
			if (next_heredoc != "") { heredoc = next_heredoc; strip_tabs = next_tabs }
		}
	' "$1"
}

declared_unittest() {
	awk '
		function indent(s) { match(s, /^[ \t]*/); return RLENGTH }
		in_string { if (index($0, in_string)) in_string = ""; next }
		{
			line = $0
			sub(/#.*/, "", line)
			if (line ~ /^[ \t]*$/) next
			depth = indent(line)
			if (depth == 0) test_class = ""
			if (match(line, /"""|\047\047\047/)) {
				delim = substr(line, RSTART, 3); rest = substr(line, RSTART + 3)
				if (!index(rest, delim)) in_string = delim
			}
			if (depth == 0 && match(line, /^class[ \t]+[^ \t(:]+/)) {
				name = substr(line, RSTART, RLENGTH); sub(/^class[ \t]+/, "", name)
				test_class = (line ~ /^class[^:]*\([^)]*TestCase[^)]*\)/) ? name : ""
				member_depth = -1
				next
			}
			if (test_class == "" || depth == 0) next
			if (member_depth < 0) member_depth = depth
			if (depth != member_depth) next
			if (match(line, /^[ \t]+(async[ \t]+)?def[ \t]+test[^ \t(]*/)) {
				name = substr(line, RSTART, RLENGTH); sub(/^[ \t]+(async[ \t]+)?def[ \t]+/, "", name)
				print test_class "." name "\t"
			}
		}
	' "$1"
}

declared_pytest() {
	awk '
		function indent(s) { match(s, /^[ \t]*/); return RLENGTH }
		in_string { if (index($0, in_string)) in_string = ""; next }
		{
			line = $0
			sub(/#.*/, "", line)
			if (line ~ /^[ \t]*$/) next
			depth = indent(line)
			if (match(line, /"""|\047\047\047/)) {
				delim = substr(line, RSTART, 3); rest = substr(line, RSTART + 3)
				if (!index(rest, delim)) in_string = delim
			}
			while (levels > 0 && depth <= class_depth[levels]) levels--
			if (match(line, /^[ \t]*class[ \t]+[^ \t(:]+/)) {
				name = substr(line, RSTART, RLENGTH); sub(/^[ \t]*class[ \t]+/, "", name)
				collected = (name ~ /^Test/ || line ~ /\([^)]*TestCase[^)]*\)/) && (levels == 0 || class_name[levels] != "")
				if (depth > 0 && levels == 0) collected = 0
				levels++; class_depth[levels] = depth; class_name[levels] = collected ? name : ""
				member[levels] = -1
				next
			}
			if (levels > 0 && member[levels] < 0) member[levels] = depth
			if (match(line, /^[ \t]*(async[ \t]+)?def[ \t]+test[^ \t(]*/)) {
				name = substr(line, RSTART, RLENGTH); sub(/^[ \t]*(async[ \t]+)?def[ \t]+/, "", name)
				if (levels == 0 && depth == 0) { print name "\t"; next }
				if (levels == 0 || class_name[levels] == "" || depth != member[levels]) next
				chain = ""
				for (k = 1; k <= levels; k++) chain = chain class_name[k] "::"
				print chain name "\t"
			}
		}
	' "$1"
}

# One line per test a test file declares at a commit: its name, a tab, and how a failing line shows
# it. A file whose reader test_readers leaves out declares none; a failed read is a refusal.
declared_tests() {
	in_worktree cat-file -e "$1:$2" 2>/dev/null || return 0
	reader=
	case "$2" in
		*.java) reader=junit ;;
		*.test.ts|*.test.tsx|*.test.js|*.test.jsx|*.test.mts|*.test.cts|*.test.mjs|*.test.cjs) reader=vitest ;;
		*.spec.ts|*.spec.tsx|*.spec.js|*.spec.jsx|*.spec.mts|*.spec.cts|*.spec.mjs|*.spec.cjs) reader=vitest ;;
		*.py) if reader_on pytest; then reader=pytest; else reader=unittest; fi ;;
		*self-test) reader=sh ;;
	esac
	[ -n "$reader" ] && reader_on "$reader" || return 0
	in_worktree show "$1:$2" > "$scratch/blob" || return 1
	case "$reader" in
		junit) declared_java "$1" "$scratch/blob" ;;
		vitest) declared_vitest "$scratch/blob" ;;
		sh) declared_sh "$scratch/blob" ;;
		unittest) declared_unittest "$scratch/blob" ;;
		pytest) declared_pytest "$scratch/blob" ;;
	esac
}

# An extended regex matching $1 literally, with each placeholder of a display name or a vitest
# title ({0}, %s, $name, ${...}) standing for any text.
literal_pattern() {
	printf '%s' "$1" | sed -e 's/{[^}]*}/@ANY@/g' -e 's/%[a-z#%]/@ANY@/g' -e 's/\$[{]*[A-Za-z0-9_.]*[}]*/@ANY@/g' \
		-e 's/[][\.*^$+?(){}|]/\\&/g' -e 's/@ANY@/.*/g'
}

escaped() { printf '%s' "$1" | sed -e 's/[][\.*^$+?(){}|]/\\&/g'; }

# The failing line a runner prints for a test: Gradle's "Class > [Nested > ]name(...) FAILED" or its
# display name, vitest's "FAIL  file > [describe > ]title", a self-test's "FAIL name", which may end
# in one bracket that names the case ("[label]", "[case name]"), unittest's
# "FAIL: name (module.Class.name)", pytest's "path::[Class::]name FAILED".
failing_line_pattern() {
	case "$1" in
		*.java)
			class=${1##*/}
			class=${class%.java}
			if in_worktree show "$tip:$1" 2>/dev/null | grep -Eq '(^|[[:space:]])abstract[[:space:]]+class[[:space:]]'; then
				class='[A-Za-z0-9_]+'
			fi
			if [ -n "$3" ]; then
				shown="|$(literal_pattern "$3")"
			else
				shown=
			fi
			printf '(^|[^A-Za-z0-9_])%s > ([^>]* > )*(%s\\(.*%s) FAILED[[:space:]]*$' "$class" "$(escaped "$2")" "$shown"
			;;
		*self-test) printf '^[[:space:]]*FAIL %s( \\[[^]]*\\])?$' "$(literal_pattern "$2")" ;;
		*.py)
			if reader_on pytest; then
				path=$(escaped "$1")
				chain=$(escaped "$2")
				printf '^(%s::%s(\\[.*\\])? (FAILED|ERROR)|(FAILED|ERROR) %s::%s(\\[.*\\])?( - .*)?$)' "$path" "$chain" "$path" "$chain"
			else
				module=${1##*/}
				method=${2##*.}
				printf '^(FAIL|ERROR): %s \\(([A-Za-z_][A-Za-z0-9_]*\\.)*%s\\.%s\\)' "$(escaped "$method")" "$(escaped "${module%.py}")" "$(escaped "$2")"
			fi
			;;
		*)
			printf '^[[:space:]]*FAIL[[:space:]]+%s > ([^>]* > )*%s[[:space:]]*$' \
				"$(literal_pattern "${1#"$frontend_root"/}")" "$(literal_pattern "$3")"
			;;
	esac
}

renames=
if in_worktree diff -M --name-status -z "$base" "$tip" > "$scratch/renames.z"; then
	renames=$(tr '\000' '\n' < "$scratch/renames.z" | awk -v tab="$tab" '
		need == 0 { status = $0; need = (status ~ /^[RC]/) ? 2 : 1; got = 0; next }
		{ got++; if (got == 1) first = $0; if (got == need) { if (status ~ /^R/) print $0 tab first; need = 0 } }
	') || refuse new-test "the check could not read the renames of $base..$tip, so a moved test file cannot be told from a new one (playbook, The gate dossier)"
else
	refuse new-test "git could not list the renames of $base..$tip, so a moved test file cannot be told from a new one (playbook, The gate dossier)"
fi
# A failing line shows a test only from a record the red or mutation leg proved, and only for the
# test files its blob lines name, each followed through a later move to its path at the tip; each
# line of the list is that path, then the failing line.
: > "$scratch/failing"
while IFS="$tab" read -r held record; do
	[ -n "$held" ] || continue
	in_worktree diff -M --name-status -z "$held" "$tip" > "$scratch/moves.z" || {
		refuse new-test "git could not list the moves of $held..$tip, so the failing lines of ${record#"$dossier"/} cannot be tied to their test files (playbook, The gate dossier)"
		continue
	}
	sed -n 's/^blob: [^ ]* //p' "$record" | tr -d '\r' > "$scratch/named"
	tr -d '\r' < "$record" | grep -v '^commit: ' | grep -E -- "$failure_marker" > "$scratch/lines" || true
	tr '\000' '\n' < "$scratch/moves.z" | awk -v tab="$tab" -v named="$scratch/named" -v lines="$scratch/lines" '
		BEGIN { while ((getline path < named) > 0) at[path] = path }
		need == 0 { status = $0; need = (status ~ /^[RC]/) ? 2 : 1; got = 0; next }
		{ got++; if (got == 1) first = $0; if (got == need) { if (status ~ /^R/ && (first in at)) at[first] = $0; need = 0 } }
		END { while ((getline line < lines) > 0) for (path in at) print at[path] tab line }
	' >> "$scratch/failing" || refuse new-test "the check could not read the moves of $held..$tip, so the failing lines of ${record#"$dossier"/} cannot be tied to their test files (playbook, The gate dossier)"
done < "$scratch/proven"

new_tests=$(printf '%s\n' "$changed" | grep -E -- "$test_path_re" | while IFS= read -r file; do
	before=$(printf '%s\n' "$renames" | awk -F "$tab" -v new="$file" '$1 == new { print $2; exit }')
	if ! declared_tests "$base" "${before:-$file}" > "$scratch/base.raw" \
		|| ! declared_tests "$tip" "$file" > "$scratch/tip.raw"; then
		printf '%s\t?extractor-failed\t\n' "$file"
		continue
	fi
	cut -f1 "$scratch/base.raw" > "$scratch/base"
	awk -F "$tab" -v file="$file" -v base="$scratch/base" '
		FILENAME == base { declared[$0]++; next }
		{ seen[$1]++; if (seen[$1] > declared[$1]) print file "\t" $0 }
	' "$scratch/base" "$scratch/tip.raw" || printf '%s\t?extractor-failed\t\n' "$file"
done)

while IFS="$tab" read -r file name shown; do
	[ -n "$name" ] || continue
	case "$name" in
		'?unreadable@'*)
			refuse new-test "$file holds a test annotation the check cannot read to its end, so its tests cannot be counted (playbook, The gate dossier)"
			continue
			;;
		'?extractor-failed')
			refuse new-test "the check's test extractor failed on $file, so its tests cannot be counted (playbook, The gate dossier)"
			continue
			;;
		'?untitled')
			refuse new-test "$file holds a test whose title is no string literal, so no failing line can be told to show it (playbook, The gate dossier)"
			continue
			;;
	esac
	awk -F "$tab" -v file="$file" '$1 == file { print substr($0, length($1) + 2) }' "$scratch/failing" \
		| grep -Eq -- "$(failing_line_pattern "$file" "$name" "$shown")" \
		|| refuse new-test "the new test '$name' of $file is never seen red: no failing line shows it in a red/ record whose blob lines name $file, or in such a mutation/ record that claims older behaviour (handbook §4)"
done <<NEW_TESTS
$new_tests
NEW_TESTS

[ "$phase" = no ] || verdict

if [ -n "$walk_success_re" ]; then
	base_key=$(code_tree_key "$worktree" "$base") || {
		refuse walk "the code tree of the base could not be read, so no commit can be matched to its full-suite log (playbook, The gate dossier)"
		verdict
	}
fi
docs_moved=no
while read -r commit subject; do
	[ -n "$commit" ] || continue
	[ -n "$walk_success_re" ] || break
	key=$(code_tree_key "$worktree" "$commit") || {
		refuse walk "the code tree of $commit could not be read, so its full-suite log cannot be matched (playbook, The gate dossier)"
		continue
	}
	tree=$(in_worktree rev-parse "$commit^{tree}")
	if [ "$key" = "$base_key" ]; then
		[ "$tree" = "$(in_worktree rev-parse "$base^{tree}")" ] || docs_moved=yes
		continue
	fi
	log="$dossier/walk/$key.log"
	if [ ! -f "$log" ]; then
		refuse walk "'$subject' has no full-suite log for its code tree; expected walk/$key.log, a './verify all' run at that commit (handbook §7)"
		continue
	fi
	tr -d '\r' < "$log" > "$scratch/walk.log"
	[ "$(sed -n '1s/^tree: //p' "$scratch/walk.log")" = "$tree" ] || docs_moved=yes
	faults=$(walk_log_faults "$worktree" "$commit" "$scratch/walk.log")
	while read -r fault about; do
		case "$fault" in
			unreadable) refuse walk "walk/$key.log of '$subject' cannot be read (playbook, The gate dossier)" ;;
			tree) refuse walk "walk/$key.log of '$subject' does not open with a 'tree: <sha>' line, so it is not shown to be a run of the commit's code tree (playbook, The gate dossier)" ;;
			unknown) refuse walk "walk/$key.log of '$subject' opens with a tree this repository does not hold, $about, so it is not shown to be a run of the commit's code tree (playbook, The gate dossier)" ;;
			commit) refuse walk "the code tree of $commit could not be read, so its full-suite log cannot be matched (playbook, The gate dossier)" ;;
			foreign) refuse walk "walk/$key.log of '$subject' opens with the tree $about, whose code tree is not the commit's, so it is the run of another commit (playbook, The gate dossier)" ;;
			exited) refuse walk "walk/$key.log of '$subject': its last '[gate/walk] ' line is not '[gate/walk] verify exited 0', so it is no gate/walk run whose verify passed on a clean walk worktree (playbook, The gate dossier)" ;;
			success) refuse walk "walk/$key.log of '$subject' has no line matching $walk_success_re, so it shows no successful run (handbook §7)" ;;
			task) refuse walk "walk/$key.log of '$subject' has no bare '$about' line, so the run is not shown to have executed it (handbook §8)" ;;
			count) refuse walk "walk/$key.log of '$subject' counts no executed tests by a line matching $walk_count_re (handbook §8)" ;;
		esac
	done <<FAULTS
$faults
FAULTS
done <<COMMITS
$commits
COMMITS

guard_log="$dossier/kb-guard.log"
if [ "$docs_moved" = yes ] && [ -n "$docs_guard_test" ]; then
	if [ ! -f "$guard_log" ]; then
		refuse kb-guard "a commit is proven by a run on other docs than its own, but kb-guard.log, a './verify focus' run of $docs_guard_test at the tip, is missing (handbook §7; playbook, The gate dossier)"
	else
		tr -d '\r' < "$guard_log" > "$scratch/kb-guard.log"
		guard_log=$scratch/kb-guard.log
		grep -Eq -- "verify focus (.*/)?$docs_guard_test\.[^./]+$" "$guard_log" && grep -Eq -- "$docs_guard_ran_re" "$guard_log" \
			&& grep -Eq -- "$walk_success_re" "$guard_log" \
			|| refuse kb-guard "kb-guard.log does not show a successful './verify focus' run of $docs_guard_test with a line matching $docs_guard_ran_re (handbook §7; playbook, The gate dossier)"
	fi
fi

findings_file="$scratch/findings.txt"
printf '%s\n' "$findings_lines" > "$findings_file"
# What the dispositions below ask of the report that raised a finding: its name as findings.txt
# traces it, its own verdict and the tip it judged, a tab apart.
: > "$scratch/reports.facts"
report_fact() {
	raiser="${1%-*}" column="$2" awk -F "$tab" '$1 == ENVIRON["raiser"] { print $(ENVIRON["column"] + 0); exit }' "$scratch/reports.facts"
}
for report in "$dossier"/lens-*.md "$dossier/doc-reviewer.md" "$dossier/reviewer.md"; do
	[ -f "$report" ] || continue
	label=${report#"$dossier"/}
	name=${report##*/}
	name=${name%.md}
	name=${name#lens-}
	judged=
	IFS= read -r judged < "$report" || true
	judged=${judged#"$byte_order_mark"}
	case "$judged" in
		'tip: '*) judged=${judged#tip: } ;;
		*) judged= ;;
	esac
	judged=${judged%"${judged##*[![:space:]]}"}
	case "$name" in
		doc-reviewer) raised_pattern='rule: *DOC-' field=verdict passing=PASS choice='PASS or FAIL' ;;
		reviewer) raised_pattern='category:' field=verdict passing=PASS choice='PASS or FAIL' ;;
		*) raised_pattern='severity:' field=robust passing=yes choice='yes or no' ;;
	esac
	facts=$(report_facts "$report" "$field" "$raised_pattern") || facts='- 0 0'
	set -- $facts
	value=$1
	raised=$2
	twice=$3
	case "$field:$value" in
		robust:yes|verdict:PASS) ;;
		robust:no|verdict:FAIL) failing_reports="${failing_reports:+$failing_reports, }$label ($field: $value)" ;;
		*) refuse report "$label has no single line of its own that opens with $field: and reads $choice alone, so it is a summary or an echo of the contract, not the report verbatim (playbook, Handoff contracts; handbook §9)" ;;
	esac
	printf '%s\t%s\t%s\n' "$name" "$value" "$judged" >> "$scratch/reports.facts"
	case "$name" in
		doc-reviewer|reviewer) ;;
		*) grep -Eq '(^|[^A-Za-z])treeDiff:' "$report" \
			|| refuse report "$label lacks the treeDiff: field of a lens report, so it is a summary, not the report verbatim (playbook, Handoff contracts; handbook §9)" ;;
	esac
	[ "$twice" -eq 0 ] \
		|| refuse finding "$label lists two findings on one line, so they cannot be counted (playbook, The gate dossier)"
	[ "$raised" -gt 0 ] || [ "$value" = "$passing" ] \
		|| refuse report "$label lists no finding as a counted entry, but no line of its own that opens with $field: reads '$passing' (playbook, The gate dossier)"
	traces=$(name="$name" raised="$raised" awk '
		BEGIN { prefix = ENVIRON["name"] "-"; raised = ENVIRON["raised"] + 0 }
		index($0, prefix) == 1 {
			rest = substr($0, length(prefix) + 1)
			if (match(rest, /^[0-9]+ /)) { seen[substr(rest, 1, RLENGTH - 1) + 0]++; traced++ }
		}
		END { printf "%d", traced; for (i = 1; i <= raised; i++) if (seen[i] != 1) printf " %d", i; print "" }
	' "$findings_file") || traces=-1
	traced=${traces%% *}
	[ "$raised" -eq "$traced" ] \
		|| refuse finding "$label raises $raised finding(s), but findings.txt traces $traced as $name-<n> (handbook §9)"
	for n in ${traces#"$traced"}; do
		refuse finding "findings.txt does not trace $name-$n exactly once (handbook §9)"
	done
done
if [ -f "$dossier/lens-security.md" ]; then
	requests_form='^[^:]*requests:[`* ]*([0-9]{1,3}) of 120[^0-9]*$'
	opening_lines "$dossier/lens-security.md" requests | tr -d '\r' > "$scratch/requests"
	[ -s "$scratch/requests" ] \
		|| refuse report "lens-security.md has no line 'requests: <n> of 120', so it does not show the request budget held (playbook, Handoff contracts)"
	while IFS= read -r requests_line; do
		printf '%s\n' "$requests_line" | grep -Eq -- "$requests_form" \
			|| refuse report "lens-security.md opens the line '$requests_line', which does not read 'requests: <n> of 120', so the count it gives is not held to the budget (playbook, Handoff contracts)"
	done < "$scratch/requests"
	count_number="[0-9]+([,._'][0-9]{3})*"
	count_mark='[*`_[:space:]]*'
	count_of="$count_number$count_mark(out[[:space:]]+)?of$count_mark"
	count_slash="(^|[^/0-9])$count_number$count_mark/$count_mark"
	if grep -a -o -i -E "($count_of|$count_slash)120([^0-9]|\$)" "$dossier/lens-security.md" > "$scratch/counts" \
		|| [ $? -eq 1 ]; then
		spent=$(sed -E "s/^[^0-9]*($count_number).*/\\1/" "$scratch/counts" | tr -d ",._'" \
			| awk 'NR == 1 || $1 + 0 > top { top = $1 + 0 } END { if (NR) print top }')
		[ -z "$spent" ] || [ "$spent" -le 120 ] \
			|| refuse report "lens-security.md counts $spent requests, above the budget of 120 (playbook, Handoff contracts)"
	else
		refuse report "the check could not read the counts of requests in lens-security.md, so it does not show the request budget held (playbook, Handoff contracts)"
	fi
	for field in notTouched notExercised; do
		[ -n "$(opening_lines "$dossier/lens-security.md" "$field")" ] \
			|| refuse report "lens-security.md lacks its $field: line ('none' where it has none), so it does not show the attack list was read whole (playbook, Handoff contracts)"
	done
fi
if [ -f "$dossier/doc-reviewer.md" ]; then
	for field in findings sweep; do
		[ -n "$(opening_lines "$dossier/doc-reviewer.md" "$field")" ] \
			|| refuse report "doc-reviewer.md lacks its $field: line ('none' where it found nothing), so it does not show which doc hunks were read (playbook, Handoff contracts)"
	done
fi

debt_group() {
	printf '%s\n' "$backlog" | awk -v heading="$doc_debt_heading" -v file="$1" '
		$0 == heading { inside = 1; next }
		inside && /^## / { inside = 0 }
		!inside { next }
		/^- / { grouped = ($0 == "- " file || $0 == "- `" file "`" || index($0, "- `" file "` ") == 1 || index($0, "- " file " ") == 1); next }
		grouped && /^[ \t]+- / { found = 1 }
		END { exit !found }
	'
}

# A dated author row of docs/open-questions.md at the tip: a table row that opens with a date the
# reason names and holds the origin `author decision`. The check holds the date and the origin, not
# what the row decides; that is the reviewer's and the author's to read.
author_row() {
	[ -n "$decisions" ] || return 1
	for dated in $(printf '%s\n' "$1" | grep -Eo '[0-9]{4}-[0-9]{2}-[0-9]{2}' || true); do
		printf '%s\n' "$decisions" | dated="$dated" awk '
			BEGIN { opens = "| " ENVIRON["dated"] " |" }
			index($0, opens) == 1 && index($0, "author decision") { found = 1 }
			END { exit !found }
		' && return 0
	done
	return 1
}

if [ -n "$findings_lines" ]; then
	ticket_key_re=$(in_worktree show "$tip:hooks/commit-msg" 2>/dev/null | sed -n "s/^ticket_key_re='\(.*\)'\$/\1/p" | head -n 1)
	backlog=$(in_worktree show "$tip:docs/backlog.md" 2>/dev/null || true)
	decisions=$(in_worktree show "$tip:docs/open-questions.md" 2>/dev/null | tr -d '\r' || true)
	while read -r id disposition rest; do
		[ -n "$id" ] || continue
		case "$disposition" in
			fixed)
				# A fix lies after the tip the raising report judged: a commit that report already
				# had before it, its own tip included, cannot answer its finding.
				if printf '%s\n' "$rest" | grep -Eqx '[0-9a-f]{7,64}' \
					&& in_worktree rev-parse --verify --quiet "$rest^{commit}" >/dev/null \
					&& in_worktree merge-base --is-ancestor "$rest" "$tip" \
					&& ! in_worktree merge-base --is-ancestor "$rest" "$base"; then
					judged=$(report_fact "$id" 3) || judged=
					if [ -n "$judged" ] && in_worktree merge-base --is-ancestor "$rest" "$judged" 2> /dev/null; then
						refuse finding "$id is marked fixed at '$rest', a commit the report that raised it had before it at its tip $judged: a fix lies after the tip that report judged, so re-run the report at the fixed tip (handbook §9)"
					fi
				else
					refuse finding "$id is marked fixed at '$rest', which is no commit of the strand; a rebase rewrites a fix's SHA, so name its current one (handbook §9)"
				fi
				;;
			backlog|debt)
				if [ -n "$ticket_key_re" ]; then
					refuse finding "$id is traced as '$disposition $rest', but the project keeps its items in a ticket system: trace it as 'ticket <KEY>' (handbook §9)"
				elif [ "$disposition" = backlog ] && ! printf '%s\n' "$rest" | grep -Eqx -- "$backlog_id_re"; then
					refuse finding "$id is traced to backlog row '$rest', which is no backlog ID: letters and digits, their parts joined by a dash (handbook §9; DOC-5)"
				elif [ "$disposition" = backlog ]; then
					printf '%s\n' "$backlog" | awk -v row="$(printf "$backlog_row" "$rest")" 'index($0, row) == 1 { found = 1 } END { exit !found }' \
						|| refuse finding "$id is traced to backlog row '$rest', which docs/backlog.md at the tip does not hold (handbook §9)"
				else
					[ -n "$rest" ] && debt_group "$rest" \
						|| refuse finding "$id is traced as doc debt of '$rest', but docs/backlog.md at the tip has no bullet under that file's group in its doc-debt section (handbook §9; DOC-5)"
				fi
				;;
			ticket)
				if [ -z "$ticket_key_re" ]; then
					refuse finding "$id is traced to ticket '$rest', but hooks/commit-msg sets no ticket_key_re, so the project has no ticket system (handbook §9)"
				else
					printf '%s\n' "$rest" | grep -Eqx -- "$ticket_key_re" \
						|| refuse finding "$id is traced to ticket '$rest', which is no key matching ticket_key_re '$ticket_key_re' (handbook §9)"
				fi
				;;
			rejected)
				if [ -z "$rest" ]; then
					refuse finding "$id is rejected without its reason (handbook §9)"
				else
					set -f
					for word in $rest; do
						word=$(printf '%s' "$word" | sed 's/^[`("]*//; s/[`)",.;]*$//')
						printf '%s\n' "$word" | grep -Eq -- "$test_path_re" || continue
						printf '%s\n' "$word" | grep -Eq ':[0-9]+$' \
							|| refuse finding "$id is rejected naming the test $word without its line, so the reason cannot be checked where it points (handbook §9)"
					done
					set +f
					# The party the gate judges writes the dispositions, so it cannot reject the
					# finding of a report that does not pass by its own word.
					raised_by=$(report_fact "$id" 2) || raised_by=
					case "$raised_by" in
						no|FAIL)
							author_row "$rest" \
								|| refuse finding "$id is rejected, but the report that raised it does not pass: re-run that report with the rejection in its brief, or name in the reason the date of an author row of docs/open-questions.md at the tip (handbook §9)"
							;;
					esac
					rejected_findings=$((rejected_findings + 1))
				fi
				;;
			*)
				refuse finding "$id is '$disposition $rest': a finding is fixed at a strand commit, traced to a backlog row, a doc-debt bullet or a ticket, or rejected with its reason (handbook §9)"
				;;
		esac
	done <<FINDINGS
$findings_lines
FINDINGS
fi

bdd_log="$dossier/bdd.log"
expected="$dossier/wip.expected"
if [ "$bdd_leg" = on ] && printf '%s\n' "$code_changed" | grep -Eq -- "$bdd_paths_re"; then
	wip_at_tip=$(wip_scenarios "$worktree" "$tip")
	wip_unread "$wip_at_tip" > "$scratch/wip.unread" \
		|| refuse wip "the check could not sort the files the @wip reader left unread from its scenarios (playbook, The gate dossier)"
	while IFS= read -r unread; do
		[ -n "$unread" ] || continue
		refuse wip "$unread, so the @wip scenarios at the tip cannot be listed (playbook, The gate dossier)"
	done < "$scratch/wip.unread"
	wip_at_tip=$(printf '%s\n' "$wip_at_tip" | grep -v '^?unread-' || true)
	for evidence in "$bdd_log" "$expected"; do
		[ -f "$evidence" ] || continue
		tr -d '\r' < "$evidence" > "$scratch/${evidence##*/}"
	done
	[ -f "$bdd_log" ] && bdd_log=$scratch/bdd.log
	[ -f "$expected" ] && expected=$scratch/wip.expected
	if [ ! -f "$bdd_log" ] || ! grep -qx '> Task :test' "$bdd_log"; then
		refuse wip "bdd.log, a './verify bdd' run at the tip with a bare '> Task :test' line, is missing (handbook §5)"
	else
		failed_lines=$(grep -v '^> Task ' "$bdd_log" | grep -c ' FAILED$' || true)
		summary_failed=$(sed -n 's/^[0-9][0-9]* tests\{0,1\} completed, \([0-9][0-9]*\) failed.*/\1/p' "$bdd_log" | head -1)
		if ! grep -q '^BUILD SUCCESSFUL' "$bdd_log" && [ "${summary_failed:-none}" != "${failed_lines:-0}" ]; then
			refuse wip "bdd.log shows neither a successful run nor a test summary that counts its FAILED lines, so it is not shown to have run the scenarios (handbook §5)"
		fi
		printf '%s\n' "$wip_at_tip" > "$scratch/wip.scenarios"
		expected_keys=$(sed 1d "$expected" 2>/dev/null | sed -n 's/ | .*//p')
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			key=${line%% | *}
			reason=${line#* | }
			case "$line" in
				*' | '*[![:space:]]*) ;;
				*)
					refuse wip "wip.expected names '$key' without the failure line it is expected to fail with (playbook, The gate dossier)"
					continue
					;;
			esac
			# A key and a name reach awk through the environment: -v would read a backslash in
			# them as an escape. A feature without a name stands in no chain, so there the
			# scenario's name alone is looked for.
			key="$key" awk -F "$tab" '
				BEGIN { key = ENVIRON["key"] }
				$2 == "" { next }
				{
					if ($1 == "") line = key
					else {
						at = index(key, "> " $1 " > ")
						if (!at) next
						line = "> " substr(key, at + length($1) + 5)
					}
					n = "> " $2
					while ((at = index(line, n)) > 0) {
						rest = substr(line, at + length(n))
						if (rest == "" || substr(rest, 1, 2) == " >") found = 1
						line = substr(line, at + 1)
					}
				}
				END { exit !found }
			' "$scratch/wip.scenarios" \
				|| refuse wip "'$key' is expected to fail, but no scenario tagged @wip at the tip is that line's scenario (handbook §5)"
			got=$(failed="$key FAILED" awk 'BEGIN { failed = ENVIRON["failed"] } found { print; exit } $0 == failed { found = 1 }' "$bdd_log") || {
				refuse wip "the check could not read the failure line under '$key' in bdd.log (playbook, The gate dossier)"
				continue
			}
			if [ -z "$got" ]; then
				refuse wip "'$key' is expected to fail, but bdd.log shows it not failing (handbook §5)"
			else
				printf '%s\n' "$got" | grep -qF -- "$reason" \
					|| refuse wip "'$key' fails with '$got', not with its documented reason '$reason' (handbook §5)"
			fi
		done <<EXPECTED
$(sed 1d "$expected" 2>/dev/null)
EXPECTED
		while IFS= read -r failed; do
			[ -n "$failed" ] || continue
			printf '%s\n' "$expected_keys" | grep -qxF -- "$failed" \
				|| refuse wip "'$failed' fails, but wip.expected does not name it (handbook §5)"
		done <<FAILED
$(sed -n '/^> Task /d; s/ FAILED$//p' "$bdd_log")
FAILED
		# The line is split at its first tab by hand: read would drop the tab that opens the line
		# of a feature without a name, and so lose its scenario.
		while IFS= read -r scenario; do
			case "$scenario" in *"$tab"*) ;; *) continue ;; esac
			feature=${scenario%%"$tab"*}
			name=${scenario#*"$tab"}
			[ -n "$name" ] || continue
			of_feature="'$feature'"
			[ -n "$feature" ] || of_feature='a feature without a name'
			printf '%s\n' "$expected_keys" | feature="$feature" name="$name" awk '
				BEGIN { f = "> " ENVIRON["feature"] " > "; n = "> " ENVIRON["name"]; unnamed = (ENVIRON["feature"] == "") }
				{
					if (unnamed) line = $0
					else {
						at = index($0, f)
						if (!at) next
						line = "> " substr($0, at + length(f))
					}
					while ((at = index(line, n)) > 0) {
						rest = substr(line, at + length(n))
						if (rest == "" || substr(rest, 1, 2) == " >") listed = 1
						line = substr(line, at + 1)
					}
				}
				END { exit !listed }
			' || refuse wip "'$name' of $of_feature is tagged @wip at the tip, but wip.expected names no failure of it (handbook §5)"
		done <<WIP
$wip_at_tip
WIP
	fi
fi

verdict
