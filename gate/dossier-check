#!/bin/sh
set -eu

usage() {
	printf 'usage: gate/dossier-check <strand worktree> <tip>\n' >&2
	printf '       gate/dossier-check --walk-log <strand worktree> <commit>\n' >&2
	printf '       gate/dossier-check --wip <strand worktree> <commit>\n' >&2
	exit 2
}

code_tree_key() {
	listing=$(git -c core.quotepath=off -C "$1" ls-tree -r "$2") || return 1
	code=$(printf '%s\n' "$listing" | awk -F '\t' '$2 !~ /\.md$/') || return 1
	printf '%s\n' "$code" | git hash-object --stdin
}

wip_scenarios() {
	git -c core.quotepath=off -C "$1" ls-tree -r --name-only "$2" -- src/test/resources/features | grep '\.feature$' \
		| while IFS= read -r feature; do
			git -c core.quotepath=off -C "$1" show "$2:$feature" | awk '
				function flush() { if (name != "" && wip) print name; name = "" }
				{ sub(/^[ \t]+/, "") }
				/^("""|```)/ { in_docstring = !in_docstring; next }
				in_docstring { next }
				/^#/ || $0 == "" { next }
				/^@/ { tags = tags " " $0; next }
				/^Feature:/ { flush(); feature_wip = (tags ~ /@wip([^A-Za-z0-9_-]|$)/); rule_wip = 0; tags = ""; next }
				/^Rule:/ { flush(); rule_wip = (tags ~ /@wip([^A-Za-z0-9_-]|$)/); tags = ""; next }
				/^(Scenario|Scenario Outline|Scenario Template|Example):/ {
					flush(); name = $0; sub(/^[^:]*:[ \t]*/, "", name)
					wip = feature_wip || rule_wip || (tags ~ /@wip([^A-Za-z0-9_-]|$)/); tags = ""; next
				}
				/^(Examples|Scenarios):/ { if (tags ~ /@wip([^A-Za-z0-9_-]|$)/) wip = 1; tags = ""; next }
				{ tags = "" }
				END { flush() }
			' || printf '?unread-feature@%s\n' "$feature"
		done
}

if [ "${1:-}" = --wip ]; then
	[ $# -eq 3 ] || usage
	git -C "$2" rev-parse --verify --quiet "$3^{commit}" > /dev/null || usage
	wip_scenarios "$2" "$3"
	exit 0
fi

if [ "${1:-}" = --walk-log ]; then
	[ $# -eq 3 ] || usage
	key=$(code_tree_key "$2" "$3") || usage
	printf '%s/gate.local.d/walk/%s.log\n' "$2" "$key"
	exit 0
fi

[ $# -eq 2 ] || usage
worktree=$1
tip_ref=$2
dossier="$worktree/gate.local.d"
surface="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/authentication-surface"
[ -r "$surface" ] && grep -q '[^[:space:]]' "$surface" || {
	printf 'dossier-check: %s cannot be read or names no path, so no diff can be told to call for the security lens\n' "$surface" >&2
	exit 2
}
refusals=0

refuse() {
	printf 'refused [%s]: %s\n' "$1" "$2"
	refusals=$((refusals + 1))
}

verdict() {
	if [ "$refusals" -eq 0 ]; then
		printf 'dossier-check: PASS %s on main %s\n' "$tip" "$main"
		exit 0
	fi
	printf 'dossier-check: FAIL, %s refusal(s); do not close the panel round\n' "$refusals"
	exit 1
}

in_worktree() { git -c core.quotepath=off -C "$worktree" "$@"; }

tip=$(in_worktree rev-parse --verify --quiet "$tip_ref^{commit}") || usage
main=$(in_worktree rev-parse --verify --quiet 'main^{commit}') || {
	printf 'dossier-check: %s has no main branch to check the strand against\n' "$worktree" >&2
	exit 2
}

if [ -L "$dossier" ]; then
	refuse location "$dossier is a symlink, so a build could clean what it points to: keep the evidence in the directory itself (playbook, The gate dossier)"
	verdict
fi
if [ ! -d "$dossier" ]; then
	refuse location "no dossier at $dossier: gate evidence lives in the strand worktree's gate.local.d, where no build cleans it (playbook, The gate dossier)"
	verdict
fi
in_worktree check-ignore -q gate.local.d \
	|| refuse ignored "git does not ignore gate.local.d, so the evidence could be committed or cleaned with the tree (playbook, The gate dossier)"

base=$(in_worktree merge-base "$tip" "$main") || {
	refuse base "the tip and main share no history, so the strand has no base to review against (handbook §7)"
	verdict
}
[ "$base" = "$main" ] \
	|| refuse base "the strand's merge-base is $base, but main is at $main now: rebase onto main and re-run the gate on the rebased tip (handbook §7)"
[ "$(in_worktree rev-parse "$tip^{tree}")" != "$(in_worktree rev-parse "$main^{tree}")" ] \
	|| refuse base "the tip's tree is main's, so the strand changes nothing to review"

head=$(in_worktree rev-parse HEAD)
[ "$head" = "$tip" ] \
	|| refuse freeze "the strand worktree is checked out at $head, not at the tip under review $tip (handbook §7)"
changes=$(in_worktree status --porcelain)
[ -z "$changes" ] \
	|| refuse freeze "the strand worktree has uncommitted changes, so no verdict reads the tip as committed (handbook §7): $(printf '%s' "$changes" | tr '\n' ' ')"

changed_paths() {
	listing=$(in_worktree diff --no-renames --name-only "$1" "$2") || return 1
	printf '%s\n' "$listing" | sed 's/^"\(.*\)"$/\1/'
}

paths_requiring() {
	case "$1" in
		doc-reviewer.md|reviewer.md) cat ;;
		lens-robustness.md) grep -v '\.md$' ;;
		lens-domain.md) grep -v '\.md$' | grep '^src/' ;;
		lens-frontend.md) grep -v '\.md$' | grep '^frontend/' ;;
		lens-security.md) awk -v surface="$surface" '
			BEGIN { while ((getline prefix < surface) > 0) { sub(/[ \t\r]+$/, "", prefix); if (prefix != "") prefixes[++n] = prefix } }
			{ for (i = 1; i <= n; i++) if (index($0, prefixes[i]) == 1) { print; next } }
		' ;;
	esac
}

paths_read_by() {
	case "$1" in
		lens-frontend.md) grep -v '\.md$' \
			| grep -E '^((frontend|src|grid|gradle)/|(build|settings)\.gradle\.kts$|gradle\.properties$|gradlew$|Dockerfile$|verify$)' ;;
		*) paths_requiring "$1" ;;
	esac
}

lens_report_stands() {
	case "$1" in lens-robustness.md|lens-domain.md|lens-frontend.md) ;; *) return 1 ;; esac
	printf '%s\n' "$2" | grep -Eqx '[0-9a-f]{40}' || return 1
	then_base=$(in_worktree merge-base "$2" "$main" 2>/dev/null) || return 1
	on_strand=$(changed_paths "$2" "$tip") && on_main=$(changed_paths "$then_base" "$main") || return 1
	[ -z "$(printf '%s\n%s\n' "$on_strand" "$on_main" | paths_read_by "$1" || true)" ]
}

own_verdict() {
	opening=$(grep -E "^[[:space:]]*([-*+]|[0-9]+[.)])?[[:space:]]*(\*\*|\`)?$2:" "$1" || true)
	[ -n "$opening" ] && [ "$(printf '%s\n' "$opening" | wc -l)" -eq 1 ] || return 0
	! printf '%s\n' "$opening" | grep -Eq "$2:[[:space:]*]*[A-Za-z]+[[:space:]*]*[|/]" || return 0
	printf '%s\n' "$opening" | sed -n "s/^[^:]*$2:[[:space:]*]*\([A-Za-z]*\).*/\1/p"
}

filed_ids=$(sed 1d "$dossier/findings.txt" 2>/dev/null | tr -d '\r' \
	| awk '$2 == "backlog" && $3 ~ /^[A-Za-z0-9]+$/ { print $3 }' | paste -sd '|' -)

changed_lines() {
	patch=$(in_worktree diff --text --no-color --no-ext-diff --no-renames -U0 \
		--output-indicator-old='<' --output-indicator-new='>' "$1" "$2") || return 1
	printf '%s\n' "$patch" | grep -E '^[<>]' || true
}

stands_beside_filed_lows() {
	case "$1" in doc-reviewer.md|reviewer.md|bdd.log|wip.expected|kb-guard.log) ;; *) return 1 ;; esac
	printf '%s\n' "$2" | grep -Eqx '[0-9a-f]{40}' || return 1
	in_worktree rev-parse --verify --quiet "$2^{commit}" > /dev/null || return 1
	case "$1" in
		doc-reviewer.md|reviewer.md) [ "$(own_verdict "$dossier/$1" verdict)" = PASS ] || return 1 ;;
	esac
	[ -n "$filed_ids" ] && [ "$(changed_paths "$2" "$tip" 2>/dev/null)" = docs/backlog.md ] || return 1
	lines=$(changed_lines "$2" "$tip") || return 1
	! printf '%s\n' "$lines" | grep -Ev "^[<>]\\| \\*\\*($filed_ids)\\*\\* \\|" | grep -q .
}

byte_order_mark=$(printf '\357\273\277')
for evidence in "$dossier"/*; do
	[ -f "$evidence" ] || continue
	named=$(sed -n "1s/^$byte_order_mark//; 1s/^tip: //p" "$evidence" | tr -d '\r' | sed 's/[[:space:]]*$//')
	[ "$named" = "$tip" ] || lens_report_stands "${evidence#"$dossier"/}" "$named" \
		|| stands_beside_filed_lows "${evidence#"$dossier"/}" "$named" \
		|| refuse tip "${evidence#"$dossier"/} names tip '${named:-none}', not the tip under review $tip, and is neither a lens report whose paths stayed unchanged since nor a report or run beside which only the filed lows' backlog rows changed (handbook §9)"
done

changed=$(changed_paths "$base" "$tip")
code_changed=$(printf '%s\n' "$changed" | grep -v '\.md$' || true)
needs() {
	[ -n "$(printf '%s\n' "$changed" | paths_requiring "$1" || true)" ] || return 0
	[ -f "$dossier/$1" ] \
		|| refuse lens "the diff touches $2, so the gate needs $1 (playbook, Cadence)"
}
needs doc-reviewer.md 'the strand'
needs reviewer.md 'the strand'
needs lens-robustness.md 'code'
needs lens-domain.md 'src/'
needs lens-frontend.md 'frontend/'
needs lens-security.md 'the authentication surface'

failure_marker='FAILED|FAIL |×|✗|AssertionError|AssertionFailedError|^(FAIL|ERROR): [A-Za-z_][A-Za-z0-9_]* \('
test_path_re='(^|/)src/test/|\.test\.[jt]sx?$|(^|/)self-test$|^release/test_[^/]*\.py$'

command -v awk > /dev/null 2>&1 || {
	printf 'dossier-check: no awk on PATH, so the tests of the strand cannot be read\n' >&2
	exit 2
}

red_record_of() {
	for record in "$dossier"/red/*; do
		[ -f "$record" ] || continue
		if [ "$(sed -n 1p "$record" | tr -d '\r')" = "commit: $1" ]; then
			printf '%s\n' "$record"
			return 0
		fi
	done
	return 1
}

own_code_in_diff() {
	own=$(in_worktree diff-tree --no-commit-id --name-only -r "$1" | grep -Ev "$test_path_re" | grep -v '\.md$' || true)
	tr -d '\r' < "$2" \
		| awk '
			/^(---|\+\+\+) / { path = substr($0, 5); sub(/^[ab]\//, "", path); sub(/\t.*/, "", path); print path }
		' \
		| while IFS= read -r path; do
			printf '%s\n' "$own" | grep -qxF "$path" && printf '%s\n' "$path"
		done | grep .
}

for commit in $(in_worktree rev-list --reverse "$base..$tip"); do
	subject=$(in_worktree log -1 --format=%s "$commit")
	in_worktree diff-tree --no-commit-id --name-only -r "$commit" | grep -Eq "$test_path_re" || continue
	if ! record=$(red_record_of "$subject"); then
		refuse red "'$subject' changes tests, but no file in red/ opens with 'commit: $subject' (handbook §4)"
	elif ! sed 1d "$record" | grep -Eq "$failure_marker" && ! grep -Eq '^exempt:[[:space:]]*[^[:space:]]' "$record"; then
		refuse red "red/${record##*/} shows no failing run and claims no exemption (handbook §4)"
	elif mutated=$(own_code_in_diff "$commit" "$record"); then
		refuse red "red/${record##*/} shows a diff of $mutated, production code '$subject' itself changes: a red record holds the failing run, and a mutation of that code belongs under mutation/ (handbook §4)"
	fi
done

for record in "$dossier"/mutation/*; do
	[ -f "$record" ] || continue
	grep -Eq '^(@@ |diff )' "$record" && grep -Eq "$failure_marker" "$record" \
		|| refuse mutation "mutation/${record##*/} lacks the mutation's diff or its failing run (handbook §4)"
done

tab=$(printf '\t')
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# One line per test a test file declares at a commit: its name, a tab, and how a failing line shows
# it: a Java test's display name or its pattern, a vitest title with its placeholders kept, or
# nothing. A Java file whose last test annotation never closes yields a name no failing line has.
declared_tests() {
	in_worktree cat-file -e "$1:$2" 2>/dev/null || return 0
	case "$2" in
		*.java)
			in_worktree show "$1:$2" | awk -v unreadable="?unreadable@$1" '
				function unquote(text,    at, c, out) {
					for (at = 1; at <= length(text); at++) {
						c = substr(text, at, 1)
						if (c == "\\") { at++; out = out substr(text, at, 1); continue }
						if (c == "\"") break
						out = out c
					}
					return out
				}
				in_text { if (gsub(/"""/, "&") % 2) in_text = 0; next }
				!annotated && gsub(/"""/, "&") % 2 { in_text = 1; next }
				in_block { if (index($0, "*/")) in_block = 0; next }
				want_display && /^[ \t]*"/ {
					quoted = $0; sub(/^[ \t]*"/, "", quoted); shown = unquote(quoted); want_display = 0
					if (annotated && display == "") display = shown
					if (!annotated) next
				}
				/^[ \t]*@DisplayName[ \t]*\([ \t]*$/ { want_display = 1 }
				!annotated && /^[ \t]*\/\*/ && !index($0, "*/") { in_block = 1; next }
				/^[ \t]*@DisplayName[ \t]*\([ \t]*"/ {
					quoted = $0; sub(/^[ \t]*@DisplayName[ \t]*\([ \t]*"/, "", quoted); shown = unquote(quoted)
					if (annotated && display == "") display = shown
				}
				/^[ \t]*@([A-Za-z0-9_]+\.)*(Test|ParameterizedTest|RepeatedTest|TestFactory|TestTemplate|ArchTest)([^A-Za-z0-9_]|$)/ {
					annotated = 1; display = shown; arch = ($0 ~ /@([A-Za-z0-9_]+\.)*ArchTest/)
					if (match($0, /@DisplayName[ \t]*\([ \t]*"/)) display = unquote(substr($0, RSTART + RLENGTH))
					if (match($0, /name[ \t]*=[ \t]*"[^"]*"/)) {
						display = substr($0, RSTART, RLENGTH); sub(/^name[ \t]*=[ \t]*"/, "", display); sub(/"$/, "", display)
					}
				}
				annotated {
					line = $0
					gsub(/"([^"\\]|\\.)*"/, "\"\"", line)
					gsub(/\047([^\047\\]|\\.)*\047/, "\047\047", line)
					pending = pending " " line
					while (1) {
						sub(/^[ \t]+/, "", pending)
						if (pending ~ /^\/\*/) {
							closes = index(pending, "*/")
							if (!closes) { in_block = 1; pending = ""; break }
							pending = substr(pending, closes + 2)
							continue
						}
						if (pending ~ /^(\/\/|\*)/) { pending = ""; break }
						if (match(pending, /^@[A-Za-z0-9_.]+[ \t]*/)) {
							rest = substr(pending, RLENGTH + 1)
							if (substr(rest, 1, 1) != "(") { pending = rest; continue }
							depth = 0; closed_at = 0
							for (at = 1; at <= length(rest); at++) {
								c = substr(rest, at, 1)
								if (c == "(") depth++
								else if (c == ")" && --depth == 0) { closed_at = at; break }
							}
							if (!closed_at) break
							pending = substr(rest, closed_at + 1)
							continue
						}
						if (match(pending, /^[^(=]*([A-Za-z0-9_$]|[\200-\377])[ \t]*=/)) {
							name = substr(pending, 1, RLENGTH); sub(/[ \t]*=$/, "", name); sub(/.*[^A-Za-z0-9_$\200-\377]/, "", name)
							print name "\t" name; annotated = 0; pending = ""; shown = ""
						} else if (match(pending, /([A-Za-z0-9_$]|[\200-\377])+[ \t]*\(/)) {
							name = substr(pending, RSTART, RLENGTH); sub(/[ \t]*\($/, "", name)
							print name "\t" (arch ? name : display); annotated = 0; pending = ""; shown = ""
						}
						break
					}
					next
				}
				!/^[ \t]*(@|$)/ { shown = "" }
				END { if (annotated) print unreadable "\t" }
			'
			;;
		*.test.ts|*.test.tsx|*.test.js|*.test.jsx)
			in_worktree show "$1:$2" | awk '
				/^[ \t]*\/\// { next }
				{ text = text " " $0 }
				END {
					gsub(/\/\*([^*]|\*+[^*\/])*\*+\//, " ", text)
					while (match(text, /(^|[^A-Za-z0-9_.$"\047`])(it|test)(\.(only|concurrent|fails|sequential))*(\.(each|for|runIf|skipIf))?[ \t]*[(`]/)) {
						head = substr(text, RSTART, RLENGTH)
						text = substr(text, RSTART + RLENGTH)
						call = text
						if (head ~ /`$/) {
							table_end = index(call, "`")
							if (!table_end) continue
							call = substr(call, table_end + 1)
							sub(/^[ \t]*\(/, "", call)
						} else if (head ~ /\.(each|for|runIf|skipIf)/) {
							call_at = index(call, ")(")
							if (!call_at) continue
							call = substr(call, call_at + 2)
						}
						sub(/^[ \t]*/, "", call)
						quote = substr(call, 1, 1)
						if (quote != "\047" && quote != "\"" && quote != "`") continue
						title = ""
						for (at = 2; at <= length(call); at++) {
							c = substr(call, at, 1)
							if (c == "\\") { at++; title = title substr(call, at, 1); continue }
							if (c == quote) break
							title = title c
						}
						if (at <= length(call) && title != "") print title "\t" title
					}
				}
			'
			;;
		*.py)
			in_worktree show "$1:$2" | awk '
				/^[ \t]+(async[ \t]+)?def[ \t]+test[A-Za-z0-9_]*/ {
					match($0, /def[ \t]+[A-Za-z0-9_]+/); name = substr($0, RSTART, RLENGTH); sub(/^def[ \t]+/, "", name)
					print name "\t"
				}
			'
			;;
		*self-test)
			in_worktree show "$1:$2" | awk '
				{
					quote = ""; command = 1
					for (at = 1; at <= length($0); at++) {
						c = substr($0, at, 1)
						if (quote == "\"") { if (c == "\\") at++; else if (c == "\"") quote = ""; continue }
						if (quote == "\047") { if (c == "\047") quote = ""; continue }
						if (c == "\"" || c == "\047") { quote = c; command = 0; continue }
						if (c == ";" || c == "&" || c == "|") { command = 1; continue }
						if (c == " " || c == "\t") continue
						if (c == "#" && (at == 1 || substr($0, at - 1, 1) ~ /[ \t]/)) break
						rest = substr($0, at)
						if (command && match(rest, /^(then|do|else|if|!)[ \t]/)) { at += RLENGTH - 1; continue }
						if (command && match(rest, /^check[ \t]+("([^"\\]|\\.)*"|\047[^\047]*\047)/)) {
							name = substr(rest, 1, RLENGTH); sub(/^check[ \t]+["\047]/, "", name); sub(/["\047]$/, "", name)
							gsub(/\\"/, "\"", name)
							print name "\t"
							at += RLENGTH - 1
						}
						command = 0
					}
				}
			'
			;;
	esac
}

# An extended regex matching $1 literally, with each placeholder of a display name or a vitest
# title ({0}, %s, $name, ${...}) standing for any text.
literal_pattern() {
	printf '%s' "$1" | sed -e 's/{[^}]*}/@ANY@/g' -e 's/%[a-z#%]/@ANY@/g' -e 's/\$[{]*[A-Za-z0-9_.]*[}]*/@ANY@/g' \
		-e 's/[][\.*^$+?(){}|]/\\&/g' -e 's/@ANY@/.*/g'
}

# The failing line a runner prints for a test: Gradle's "Class > [Nested > ]name(…) FAILED" or its
# display name, vitest's "FAIL  file > [describe > ]title", the self-tests' "FAIL name".
frontend_root=frontend

failing_line_pattern() {
	case "$1" in
		*.java)
			class=${1##*/}
			class=${class%.java}
			if in_worktree show "$tip:$1" 2>/dev/null | grep -Eq '(^|[[:space:]])abstract[[:space:]]+class[[:space:]]'; then
				class='[A-Za-z0-9_]+'
			fi
			if [ -n "$3" ]; then
				shown="|$(literal_pattern "$3")"
			else
				shown=
			fi
			printf '(^|[^A-Za-z0-9_])%s > ([^>]* > )*(%s\\(.*%s) FAILED[[:space:]]*$' "$class" \
				"$(printf '%s' "$2" | sed -e 's/[][\.*^$+?(){}|]/\\&/g')" "$shown"
			;;
		*self-test) printf '^[[:space:]]*FAIL %s$' "$(literal_pattern "$2")" ;;
		*.py)
			module=${1##*/}
			printf '^(FAIL|ERROR): %s \\(%s\\.([A-Za-z0-9_]+\\.)+%s\\)' "$2" "${module%.py}" "$2"
			;;
		*)
			printf '^[[:space:]]*FAIL[[:space:]]+%s > ([^>]* > )*%s[[:space:]]*$' \
				"$(literal_pattern "${1#"$frontend_root"/}")" "$(literal_pattern "$3")"
			;;
	esac
}

renames=$(in_worktree diff -M --name-status "$base" "$tip" | awk -F "$tab" '$1 ~ /^R/ { print $3 "\t" $2 }')
cat "$dossier"/red/* "$dossier"/mutation/* 2>/dev/null | tr -d '\r' | grep -v '^commit: ' | grep -E "$failure_marker" \
	> "$scratch/failing" || true

new_tests=$(printf '%s\n' "$changed" | grep -E "$test_path_re" | while IFS= read -r file; do
	before=$(printf '%s\n' "$renames" | awk -F "$tab" -v new="$file" '$1 == new { print $2; exit }')
	if ! declared_tests "$base" "${before:-$file}" > "$scratch/base.raw" \
		|| ! declared_tests "$tip" "$file" > "$scratch/tip.raw"; then
		printf '%s\t?extractor-failed\t\n' "$file"
		continue
	fi
	cut -f1 "$scratch/base.raw" > "$scratch/base"
	awk -F "$tab" -v file="$file" -v base="$scratch/base" '
		FILENAME == base { declared[$0]++; next }
		{ seen[$1]++; if (seen[$1] > declared[$1]) print file "\t" $0 }
	' "$scratch/base" "$scratch/tip.raw" || printf '%s\t?extractor-failed\t\n' "$file"
done)

while IFS="$tab" read -r file name shown; do
	[ -n "$name" ] || continue
	case "$name" in
		'?unreadable@'*)
			refuse new-test "$file holds a test annotation the check cannot read to its end, so its tests cannot be counted (playbook, The gate dossier)"
			continue
			;;
		'?extractor-failed')
			refuse new-test "the check's test extractor failed on $file, so its tests cannot be counted (playbook, The gate dossier)"
			continue
			;;
	esac
	grep -Eq -- "$(failing_line_pattern "$file" "$name" "$shown")" "$scratch/failing" \
		|| refuse new-test "the new test '$name' of $file is never seen red: no failing line in red/ or mutation/ shows it (handbook §4)"
done <<NEW_TESTS
$new_tests
NEW_TESTS

base_key=$(code_tree_key "$worktree" "$base") || {
	refuse walk "the code tree of the base could not be read, so no commit can be matched to its full-suite log (playbook, The gate dossier)"
	verdict
}
docs_moved=no
for commit in $(in_worktree rev-list --reverse "$base..$tip"); do
	key=$(code_tree_key "$worktree" "$commit") || {
		refuse walk "the code tree of $commit could not be read, so its full-suite log cannot be matched (playbook, The gate dossier)"
		continue
	}
	tree=$(in_worktree rev-parse "$commit^{tree}")
	if [ "$key" = "$base_key" ]; then
		[ "$tree" = "$(in_worktree rev-parse "$base^{tree}")" ] || docs_moved=yes
		continue
	fi
	log="$dossier/walk/$key.log"
	label="'$(in_worktree log -1 --format=%s "$commit")'"
	if [ ! -f "$log" ]; then
		refuse walk "$label has no full-suite log for its code tree; expected walk/$key.log, a './verify all' run at that commit (handbook §7)"
		continue
	fi
	tr -d '\r' < "$log" > "$scratch/walk.log"
	log=$scratch/walk.log
	[ "$(sed -n '1s/^tree: //p' "$log")" = "$tree" ] || docs_moved=yes
	grep -q '^BUILD SUCCESSFUL' "$log" \
		|| refuse walk "walk/$key.log of $label shows no successful build (handbook §7)"
	for task in ':test' ':frontend:npmTest'; do
		grep -qx "> Task $task" "$log" \
			|| refuse walk "walk/$key.log of $label has no bare '> Task $task' line, so the run is not shown to have executed it (handbook §8)"
	done
	classes=$(sed -n 's/^\[verify\] executed test classes: \([0-9][0-9]*\)$/\1/p' "$log")
	[ "${classes:-0}" -gt 0 ] \
		|| refuse walk "walk/$key.log of $label counts no executed test classes (handbook §8)"
done

guard_log="$dossier/kb-guard.log"
if [ "$docs_moved" = yes ]; then
	if [ -f "$guard_log" ]; then
		tr -d '\r' < "$guard_log" > "$scratch/kb-guard.log"
		guard_log=$scratch/kb-guard.log
	fi
	if [ ! -f "$guard_log" ]; then
		refuse kb-guard "a commit is proven by a run on other docs than its own, but kb-guard.log, a './verify focus' run of KbCitationGuardTest at the tip, is missing (handbook §7; playbook, The gate dossier)"
	elif ! { grep -Eq 'verify focus .*KbCitationGuardTest' "$guard_log" && grep -qx '> Task :test' "$guard_log" \
		&& grep -q '^BUILD SUCCESSFUL' "$guard_log"; }; then
		refuse kb-guard "kb-guard.log does not show a successful './verify focus' run of KbCitationGuardTest with a bare '> Task :test' line (handbook §7; playbook, The gate dossier)"
	fi
fi

for report in "$dossier"/lens-*.md; do
	[ -f "$report" ] || continue
	grep -Eq '(^|[^A-Za-z])robust:' "$report" && grep -Eq '(^|[^A-Za-z])treeDiff:' "$report" \
		|| refuse report "${report#"$dossier"/} lacks the robust: or treeDiff: field of a lens report, so it is a summary, not the report verbatim (playbook, Handoff contracts; handbook §9)"
done
for report in "$dossier/doc-reviewer.md" "$dossier/reviewer.md"; do
	[ -f "$report" ] || continue
	grep -Eq '(^|[^A-Za-z])verdict:' "$report" \
		|| refuse report "${report##*/} lacks the verdict: field of its agent's report, so it is a summary, not the report verbatim (playbook, Handoff contracts; handbook §9)"
done

findings_file="$dossier/findings.txt"
if [ -f "$findings_file" ]; then
	tr -d '\r' < "$findings_file" > "$scratch/findings.txt"
	findings_file=$scratch/findings.txt
fi
for report in "$dossier"/lens-*.md "$dossier/doc-reviewer.md" "$dossier/reviewer.md"; do
	[ -f "$report" ] || continue
	name=${report##*/}
	name=${name%.md}
	name=${name#lens-}
	case "$name" in
		doc-reviewer) raised_pattern='rule: *DOC-' field=verdict passing=PASS ;;
		reviewer) raised_pattern='category:' field=verdict passing=PASS ;;
		*) raised_pattern='severity:' field=robust passing=yes ;;
	esac
	entry="^[[:space:]]*([-*+]|[0-9]+[.)])?[[:space:]]*\`?\{$raised_pattern"
	raised=$(grep -Ec -- "$entry" "$report" || true)
	if grep -E -- "$entry" "$report" | grep -Eq -- "\{$raised_pattern.*\{$raised_pattern"; then
		refuse finding "${report##*/} lists two findings on one line, so they cannot be counted (playbook, The gate dossier)"
	fi
	if [ "${raised:-0}" -eq 0 ] && [ "$(own_verdict "$report" "$field")" != "$passing" ]; then
		refuse report "${report##*/} lists no finding as a counted entry, but no line of its own that opens with $field: reads '$passing' (playbook, The gate dossier)"
	fi
	traced=$(grep -c "^$name-[0-9][0-9]* " "$findings_file" 2>/dev/null || true)
	[ "${raised:-0}" -eq "${traced:-0}" ] \
		|| refuse finding "${report##*/} raises ${raised:-0} finding(s), but findings.txt traces ${traced:-0} as $name-<n> (handbook §9)"
	n=1
	while [ "$n" -le "${raised:-0}" ]; do
		[ "$(grep -c "^$name-$n " "$findings_file" 2>/dev/null || true)" = 1 ] \
			|| refuse finding "findings.txt does not trace $name-$n exactly once (handbook §9)"
		n=$((n + 1))
	done
done

if [ -f "$findings_file" ]; then
	backlog=$(in_worktree show "$tip:docs/backlog.md" 2>/dev/null || true)
	while read -r id disposition rest; do
		[ -n "$id" ] || continue
		case "$disposition" in
			fixed)
				printf '%s\n' "$rest" | grep -Eqx '[0-9a-f]{7,40}' \
					&& in_worktree rev-parse --verify --quiet "$rest^{commit}" >/dev/null \
					&& in_worktree merge-base --is-ancestor "$rest" "$tip" \
					&& ! in_worktree merge-base --is-ancestor "$rest" "$base" \
					|| refuse finding "$id is marked fixed at '$rest', which is no commit of the strand; a rebase rewrites a fix's SHA, so name its current one (handbook §9)"
				;;
			backlog)
				printf '%s\n' "$backlog" | awk -v row="| **$rest** |" 'index($0, row) == 1 { found = 1 } END { exit !found }' \
					|| refuse finding "$id is traced to backlog row '$rest', which docs/backlog.md at the tip does not hold (handbook §9)"
				;;
			rejected)
				[ -n "$rest" ] || refuse finding "$id is rejected without its reason (handbook §9)"
				;;
			*)
				refuse finding "$id is '$disposition $rest': a finding is fixed at a strand commit, traced to a backlog row or rejected with its reason (handbook §9)"
				;;
		esac
	done <<FINDINGS
$(sed 1d "$findings_file")
FINDINGS
fi

bdd_log="$dossier/bdd.log"
expected="$dossier/wip.expected"
wip_at_tip=$(wip_scenarios "$worktree" "$tip")

for unread in $(printf '%s\n' "$wip_at_tip" | sed -n 's/^?unread-feature@//p'); do
	refuse wip "the check could not read the scenarios of $unread, so its @wip scenarios cannot be listed (playbook, The gate dossier)"
done
wip_at_tip=$(printf '%s\n' "$wip_at_tip" | grep -v '^?unread-feature@' || true)
if printf '%s\n' "$code_changed" | grep -Eq '^(src|frontend)/'; then
	for evidence in "$bdd_log" "$expected"; do
		[ -f "$evidence" ] || continue
		tr -d '\r' < "$evidence" > "$scratch/${evidence##*/}"
	done
	[ -f "$bdd_log" ] && bdd_log=$scratch/bdd.log
	[ -f "$expected" ] && expected=$scratch/wip.expected
	if [ ! -f "$bdd_log" ] || ! grep -qx '> Task :test' "$bdd_log"; then
		refuse wip "bdd.log, a './verify bdd' run at the tip with a bare '> Task :test' line, is missing (handbook §5)"
	else
		failed_lines=$(grep -v '^> Task ' "$bdd_log" | grep -c ' FAILED$' || true)
		summary_failed=$(sed -n 's/^[0-9][0-9]* tests\{0,1\} completed, \([0-9][0-9]*\) failed.*/\1/p' "$bdd_log" | head -1)
		if ! grep -q '^BUILD SUCCESSFUL' "$bdd_log" && [ "${summary_failed:-none}" != "${failed_lines:-0}" ]; then
			refuse wip "bdd.log shows neither a successful run nor a test summary that counts its FAILED lines, so it is not shown to have run the scenarios (handbook §5)"
		fi
		expected_keys=$(sed 1d "$expected" 2>/dev/null | sed -n 's/ | .*//p')
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			key=${line%% | *}
			reason=${line#* | }
			case "$line" in
				*' | '*[![:space:]]*) ;;
				*)
					refuse wip "wip.expected names '$key' without the failure line it is expected to fail with (playbook, The gate dossier)"
					continue
					;;
			esac
			got=$(awk -v failed="$key FAILED" 'found { print; exit } $0 == failed { found = 1 }' "$bdd_log")
			if [ -z "$got" ]; then
				refuse wip "'$key' is expected to fail, but bdd.log shows it not failing (handbook §5)"
			else
				printf '%s\n' "$got" | grep -qF -- "$reason" \
					|| refuse wip "'$key' fails with '$got', not with its documented reason '$reason' (handbook §5)"
			fi
		done <<EXPECTED
$(sed 1d "$expected" 2>/dev/null)
EXPECTED
		while IFS= read -r failed; do
			[ -n "$failed" ] || continue
			printf '%s\n' "$expected_keys" | grep -qxF -- "$failed" \
				|| refuse wip "'$failed' fails, but wip.expected does not name it (handbook §5)"
		done <<FAILED
$(sed -n '/^> Task /d; s/ FAILED$//p' "$bdd_log")
FAILED
		while IFS= read -r name; do
			[ -n "$name" ] || continue
			printf '%s\n' "$expected_keys" | awk -v n="> $name" '
				{
					line = $0
					while ((at = index(line, n)) > 0) {
						rest = substr(line, at + length(n))
						if (rest == "" || substr(rest, 1, 2) == " >") listed = 1
						line = substr(line, at + 1)
					}
				}
				END { exit !listed }
			' || refuse wip "'$name' is tagged @wip at the tip, but wip.expected names no failure of it (handbook §5)"
		done <<WIP
$wip_at_tip
WIP
	fi
fi

verdict
