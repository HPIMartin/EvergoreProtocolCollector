# A falsifier's report says soundSpec:, the reviewer's verdict:; a second argument is the verdict
# line in place of the passing one.
scenario_report() {
	step mkdir -p gate.local.d/scenario
	case "$1" in
		reviewer.md) own_line='- `verdict: PASS`' ;;
		*) own_line='- `soundSpec: yes`' ;;
	esac
	{ printf '%s\n' "${2-$own_line}" '- findings: none' '- fingerprints:'; fingerprint_lines; } > "gate.local.d/scenario/$1"
}

falsifier_reports() {
	scenario_report falsifier-scenario.md
	scenario_report falsifier-stakeholder.md
}

scenario_checked() {
	"$gate_copy/scenario-check" "$repo" > "$work/out" 2>&1 && scenario_status=0 || scenario_status=$?
