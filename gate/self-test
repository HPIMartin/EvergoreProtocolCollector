# A seed test file on main, so the strand can edit, add beside or move tests that already exist.
seed_test_on_main() {
	git checkout -q main
	write_file src/test/SeedTest.java 'class SeedTest {' '	@Test' '	void rejectsEmpty() {' '	}' '}'
	commit_all 'Cover the seed'
	git checkout -q strand
	git rebase -q main
}

