#!/bin/sh
# Proves gate/dossier-check refuses each slip it claims to refuse. Every case starts from one
# complete dossier the check accepts and breaks exactly one thing in it, so a refusal can only come
# from the thing that case broke. Runs without the project's build tool.
set -eu

gate_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
dossier_check="$gate_dir/dossier-check"

# git exports GIT_DIR, GIT_INDEX_FILE and friends to the hook that runs this test, so a throwaway
# repo below would otherwise operate on the repo whose commit is being gated.
for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failures=0

check() {
	if [ "$2" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s\n' "$1"
		failures=$((failures + 1))
	fi
}

# One line per argument, so a fixture stays a single readable call.
write_file() {
	target=$1
	shift
	case "$target" in */*) mkdir -p "${target%/*}" ;; esac
	printf '%s\n' "$@" > "$target"
}

commit_all() {
	git add -A
	git commit -q --no-verify -m "$1"
}

# A main with one commit and a strand branch with one more, checked out in the repo itself, which
# stands in for the strand worktree.
new_strand() {
	repo="$work/$1"
	mkdir -p "$repo"
	cd "$repo"
	git init -q -b main .
	git config user.email gate@example.com
	git config user.name Gate
	git config core.autocrlf false
	write_file .gitignore '*.local.*'
	write_file src/main/Seed.java 'class Seed {' '}'
	commit_all 'Add the seed'
	git checkout -q -b strand
	write_file src/main/Feature.java 'class Feature {' '}'
	commit_all 'Add the feature'
}

tip() { git rev-parse HEAD; }

complete_dossier() {
	lens_report robustness
	lens_report domain
	write_file gate.local.d/doc-reviewer.md "tip: $(tip)" '- `verdict: PASS`' '- findings: none'
}

lens_report() {
	write_file "gate.local.d/lens-$1.md" "tip: $(tip)" '- `robust: yes`' \
		'- weaknesses: none found after a genuine attempt' '- `counterTests:` none' '- `treeDiff:` (empty)'
}

# A refusal counts only when it names the check the case broke, so a case cannot pass on a
# refusal some other, incidental breakage caused.
refuses_for() {
	if "$dossier_check" "$repo" strand > "$work/out" 2>&1; then return 1; fi
	grep -q "^refused \[$1\]" "$work/out"
}

accepts() { "$dossier_check" "$repo" strand > "$work/out" 2>&1; }

new_strand complete
complete_dossier
if accepts; then r=0; else r=1; fi
check "a complete dossier passes" "$r"

new_strand under_build
mkdir -p build
complete_dossier
mv gate.local.d build/gate-dossier
if refuses_for location; then r=0; else r=1; fi
check "a dossier kept under build/ is refused" "$r"

new_strand symlinked
mkdir -p build
complete_dossier
mv gate.local.d build/gate-dossier
ln -s build/gate-dossier gate.local.d
if refuses_for location; then r=0; else r=1; fi
check "a gate.local.d that links into build/ is refused" "$r"

new_strand not_ignored
write_file .gitignore 'build/'
commit_all 'Stop ignoring local files'
complete_dossier
if refuses_for ignored; then r=0; else r=1; fi
check "a gate.local.d that git does not ignore is refused" "$r"

new_strand older_tip
complete_dossier
write_file src/main/Fold.java 'class Fold {' '}'
commit_all 'Fold a gate fix'
if refuses_for tip; then r=0; else r=1; fi
check "a report produced at an older tip is refused" "$r"

new_strand crlf_report
complete_dossier
awk '{ printf "%s\r\n", $0 }' gate.local.d/lens-robustness.md > gate.local.d/crlf
mv gate.local.d/crlf gate.local.d/lens-robustness.md
if accepts; then r=0; else r=1; fi
check "a report with Windows line endings names its tip" "$r"

new_strand tip_line_with_trailing_space
complete_dossier
awk 'NR == 1 { $0 = $0 "  " } { print }' gate.local.d/lens-robustness.md > gate.local.d/spaced
mv gate.local.d/spaced gate.local.d/lens-robustness.md
if accepts; then r=0; else r=1; fi
check "a report whose tip line ends in spaces names its tip" "$r"

new_strand tip_line_after_byte_order_mark
complete_dossier
{ printf '\357\273\277'; cat gate.local.d/lens-robustness.md; } > gate.local.d/bom
mv gate.local.d/bom gate.local.d/lens-robustness.md
if accepts; then r=0; else r=1; fi
check "a report that opens with a byte order mark names its tip" "$r"

new_strand no_tip_line
complete_dossier
write_file gate.local.d/lens-robustness.md '- `robust: yes`' '- `treeDiff:` (empty)'
if refuses_for tip; then r=0; else r=1; fi
check "a report that names no tip is refused" "$r"

new_strand main_moved
complete_dossier
git checkout -q main
write_file src/main/Elsewhere.java 'class Elsewhere {' '}'
commit_all 'Land another strand'
git checkout -q strand
if refuses_for base; then r=0; else r=1; fi
check "a strand whose merge-base main has moved past is refused" "$r"

new_strand empty_strand
git checkout -q -B strand main
complete_dossier
if refuses_for base; then r=0; else r=1; fi
check "a strand with no commit beyond main is refused" "$r"

new_strand empty_commits_only
git checkout -q -B strand main
git commit -q --allow-empty --no-verify -m 'Change nothing'
complete_dossier
if refuses_for base; then r=0; else r=1; fi
check "a strand whose commits change no file is refused" "$r"

new_strand unrelated_history
git checkout -q --orphan alone
write_file src/main/Alone.java 'class Alone {' '}'
commit_all 'Start an unrelated history'
git branch -q -f strand alone
git checkout -q strand
complete_dossier
if refuses_for base; then r=0; else r=1; fi
check "a strand that shares no history with main is refused" "$r"

new_strand no_main
git branch -q -m main trunk
complete_dossier
"$dossier_check" "$repo" strand > "$work/out" 2>&1 && status=0 || status=$?
if [ "$status" -eq 2 ] && grep -q 'no main branch' "$work/out"; then r=0; else r=1; fi
check "a strand worktree without a main branch is named, not checked" "$r"

new_strand dirty_tree
complete_dossier
write_file src/main/Probe.java 'class Probe {' '}'
if refuses_for freeze; then r=0; else r=1; fi
check "a strand worktree with uncommitted changes is refused" "$r"

new_strand other_head
complete_dossier
git checkout -q --detach main
if refuses_for freeze; then r=0; else r=1; fi
check "a strand worktree checked out at another commit than the tip is refused" "$r"

new_strand lens_summary
complete_dossier
write_file gate.local.d/lens-robustness.md "tip: $(tip)" 'Robustness lens: PASS, two lows, both fixed.'
if refuses_for report; then r=0; else r=1; fi
check "a lens summary in place of the lens report is refused" "$r"

new_strand lens_without_tree_diff
complete_dossier
write_file gate.local.d/lens-robustness.md "tip: $(tip)" '- `robust: yes`' '- weaknesses: none found after a genuine attempt'
if refuses_for report; then r=0; else r=1; fi
check "a lens report without its treeDiff field is refused" "$r"

new_strand lens_without_verdict_field
complete_dossier
write_file gate.local.d/lens-robustness.md "tip: $(tip)" '- weaknesses: none found after a genuine attempt' '- `treeDiff:` (empty)'
if refuses_for report; then r=0; else r=1; fi
check "a lens report without its robust field is refused" "$r"

new_strand doc_summary
complete_dossier
write_file gate.local.d/doc-reviewer.md "tip: $(tip)" 'The doc-reviewer passed the docs.'
if refuses_for report; then r=0; else r=1; fi
check "a doc-reviewer summary in place of its report is refused" "$r"

new_strand no_domain_lens
complete_dossier
mv gate.local.d/lens-domain.md gate.local.d/notes-domain.txt
if refuses_for lens; then r=0; else r=1; fi
check "a backend change without the domain lens is refused" "$r"

new_strand no_frontend_lens
write_file frontend/src/Page.tsx 'export const page = 1;'
commit_all 'Add a page'
complete_dossier
if refuses_for lens; then r=0; else r=1; fi
check "a frontend change without the frontend lens is refused" "$r"

new_strand no_doc_reviewer
complete_dossier
mv gate.local.d/doc-reviewer.md gate.local.d/notes-doc.txt
if refuses_for lens; then r=0; else r=1; fi
check "a dossier without the doc-reviewer's report is refused" "$r"

new_strand no_robustness_lens
complete_dossier
mv gate.local.d/lens-robustness.md gate.local.d/notes-robustness.txt
if refuses_for lens; then r=0; else r=1; fi
check "a code change without the robustness lens is refused" "$r"

new_strand non_ascii_src
git checkout -q main
git checkout -q -B strand
write_file 'src/main/Ärger.java' 'class Aerger {' '}'
commit_all 'Add a class with a non-ASCII name'
complete_dossier
mv gate.local.d/lens-domain.md gate.local.d/notes-domain.txt
if refuses_for lens; then r=0; else r=1; fi
check "a change to a non-ASCII path under src/ still calls for the domain lens" "$r"

new_strand docs_only
git checkout -q main
git checkout -q -B strand
write_file docs/guide.md '# Guide'
commit_all '[doc] Add the guide'
mkdir -p gate.local.d
write_file gate.local.d/doc-reviewer.md "tip: $(tip)" '- `verdict: PASS`' '- findings: none'
if accepts; then r=0; else r=1; fi
check "a docs-only strand passes with the doc-reviewer's report alone" "$r"

if [ "$failures" -eq 0 ]; then
	printf 'gate self-test: all cases pass\n'
else
	printf 'gate self-test: %s case(s) FAILED\n' "$failures" >&2
fi
exit "$failures"
