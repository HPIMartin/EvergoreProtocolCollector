# A fake daemon of the walk worktree waits on a fifo with its working directory in the registry
# directory of the worktree; the sleep shim of the rig releases it on the walk's first poll, so no
# case waits for real time, and the git shim records whether the daemon had left when git removed
# the worktree.
daemon_rig() {
	rig="$work/$case_name-rig"
	step mkdir -p "$rig"
	step mkfifo "$rig/fifo"
	write_file "$rig/git" '#!/bin/sh' \
		'case " $* " in *" worktree remove "*) if [ -e "$GATE_MARKER" ]; then echo seen; else echo missing; fi >> "$GATE_REMOVALS" ;; esac' \
		"exec \"$(real_tool git)\" \"\$@\""
	write_file "$rig/sleep" '#!/bin/sh' 'echo s >> "$GATE_SLEEPS"' \
		'if [ -n "${GATE_RELEASE:-}" ] && [ "$(wc -l < "$GATE_SLEEPS")" -eq 1 ]; then printf "x\n" > "$GATE_FIFO"; fi'
	step chmod +x "$rig/git" "$rig/sleep"
	GATE_FIFO="$rig/fifo"
	GATE_MARKER="$rig/marker"
	GATE_HOLDER="$rig/holders"
	GATE_REMOVALS="$rig/removals"
	GATE_SLEEPS="$rig/sleeps"
	export GATE_FIFO GATE_MARKER GATE_HOLDER GATE_REMOVALS GATE_SLEEPS
	: > "$GATE_HOLDER"
	: > "$GATE_REMOVALS"
	: > "$GATE_SLEEPS"
}

release_daemons() {
	printf 'x\n' 1<> "$GATE_FIFO"
	unset GATE_FIFO GATE_MARKER GATE_HOLDER GATE_REMOVALS GATE_SLEEPS
}

builds() { grep -c '^all ' "$GATE_BUILDS" || true; }

stops() { grep -c '^stop ' "$GATE_BUILDS" || true; }

