#!/bin/sh
# Proves gate/dossier-check refuses each slip it claims to refuse. Every case starts from one
# complete dossier the check accepts and breaks exactly one thing in it, so a refusal can only come
# from the thing that case broke. Runs without the project's build tool.
# It proves the helpers beside the check too, gate/walk, gate/tip-evidence and gate/scenario-check
# with their gate/lock: each runs as a copy beside a copy of the check, whose ADAPT block a case
# may swap, against a stub verify script that logs the commands it is given.
# sh gate/self-test [pattern ...] runs only the cases whose label, the argument of new_strand or
# new_case, matches one of the shell patterns, and exits 2 when no case matches; the hooks leg and
# the gate run them all. A filtered run whose matching cases all skip, as where ln -s makes no link,
# exits 0.
set -eu

for tool in awk git mktemp; do
	command -v "$tool" > /dev/null 2>&1 || {
		printf 'gate self-test: no %s on PATH; the gate module needs sh, awk, git and mktemp, so no case ran\n' "$tool" >&2
		exit 2
	}
done

gate_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
live_check="$gate_dir/dossier-check"
filters="$*"

# git exports GIT_DIR, GIT_INDEX_FILE and friends to the hook that runs this test, so a throwaway
# repo below would otherwise operate on the repo whose commit is being gated.
for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The purge above also strips an isolation the caller set, so the suite sets its own: no case reads
# the user's or the system's git configuration, where a signing setup, a global ignore or a diff
# option would change what a fixture commits or what the check reads.
mkdir "$work/home"
GIT_CONFIG_GLOBAL=/dev/null
GIT_CONFIG_NOSYSTEM=1
HOME="$work/home"
export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM HOME

# A copy of a check whose ADAPT block takes the assignments of a values file in place of its own.
splice() {
	awk '
		FILENAME == ARGV[1] { key = $0; sub(/=.*/, "", key); line[key] = $0; next }
		{ key = $0; sub(/=.*/, "", key) }
		$0 ~ /^[a-z_]+=/ && (key in line) && !(key in done) { print line[key]; done[key] = 1; next }
		{ print }
	' "$1" "$2" > "$3" && chmod +x "$3"
}

# The cases are written against these values, not against the live block, which an adopted project
# fills from its preset; each case runs a copy of the live check that holds them.
mkdir -p "$work/fixture"
cat > "$work/fixture/values" <<'VALUES'
base_ref='refs/heads/main'
features_dir='src/test/resources/features'
test_readers='junit vitest sh unittest'
test_path_re='(^|/)src/test/|(^|/)tests?/|\.(test|spec)\.[cm]?[jt]sx?$|(^|/)self-test$'
failure_marker='FAILED|FAIL |×|✗|AssertionError|AssertionFailedError|^(FAIL|ERROR): [^ (]+ \([^ ().]+(\.[^ ().]+)+\)'
frontend_root='frontend'
needs_domain='^src/'
needs_frontend='^frontend/'
reads_domain='^src/'
reads_frontend='^((frontend|src|gradle)/|(build|settings)\.gradle\.kts$|gradle\.properties$|gradlew$|Dockerfile$|verify$)'
walk_success_re='^BUILD SUCCESSFUL'
walk_task_lines='> Task :test|> Task :frontend:npmTest'
walk_count_re='^\[verify\] executed test classes: ([0-9]+)$'
walk_failed_reports='build/test-results/test/*.xml'
docs_guard_test=''
docs_guard_ran_re='^> Task :test$'
bdd_leg='on'
bdd_paths_re='^(src|frontend)/'
backlog_row='| **%s** |'
doc_debt_heading='## Doc debt: wrong text left over'
VALUES
dossier_check="$work/fixture/dossier-check"
splice "$work/fixture/values" "$live_check" "$dossier_check" || {
	printf 'gate self-test: no copy of %s could be made, so no case ran\n' "$live_check" >&2
	exit 2
}
while IFS= read -r value; do
	grep -qxF -- "$value" "$dossier_check" || {
		printf 'gate self-test: the ADAPT block of %s has no %s, so no case ran\n' "$live_check" "${value%%=*}" >&2
		exit 2
	}
done < "$work/fixture/values"

# The check asks the breach guard at ../hooks/breach-guard beside it, so every copy of the check
# below $work meets this stub, which answers that the tip reaches no recorded commit; a case that
# needs another answer gives its copy a guard of its own.
mkdir -p "$work/hooks"
printf '#!/bin/sh\nexit 0\n' > "$work/hooks/breach-guard"

# The helpers sit beside the check they read their values from, so a case that swaps the check's
# values swaps theirs too.
helpers="walk tip-evidence scenario-check lock"

exec 3>&1
failures=0
matched=0
case_name=''
broken=0
checker=$dossier_check
gate_copy=$work/fixture

# A case whose setup failed proves nothing either way, so its checks report FAIL. A FAIL line ends
# with the case's label in brackets, the word the filter takes.
check() {
	if [ "$2" -eq 0 ] && [ "$broken" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s [%s]\n' "$1" "$case_name"
		failures=$((failures + 1))
	fi
}

# A setup line that fails marks its case broken instead of ending the run.
step() {
	"$@" && return 0
	printf '  setup failed in %s: %s\n' "$case_name" "$*" >&3
	broken=1
}

write_file() {
	target=$1
	shift
	case "$target" in */*) mkdir -p "${target%/*}" ;; esac
	printf '%s\n' "$@" > "$target"
}

edit_file() { sed "$1" "$2" > "$2.edited" && mv "$2.edited" "$2"; }

crlf_file() { awk '{ printf "%s\r\n", $0 }' "$1" > "$1.edited" && mv "$1.edited" "$1"; }

commit_all() {
	step git add -A
	step git commit -q -m "$1"
}

tip() { git rev-parse HEAD; }

mkdir -p "$work/no-hooks"
object_format=
init_repo() {
	step mkdir -p "$1"
	step cd "$1"
	step git init -q --template= ${object_format:+"--object-format=$object_format"} -b main .
	step git config user.email gate@example.com
	step git config user.name Gate
	step git config core.autocrlf false
	step git config core.hooksPath "$work/no-hooks"
}

feature_dir=src/test/resources/features
sorting_failure='RunAcceptanceScenariosTest > Sorting the tables > Sorting a ledger orders the whole ledger'
headline_failure='RunAcceptanceScenariosTest > Sorting the tables > A headline <what> is skipped > corrected behavior > Example #2.1'

seed_strand() {
	init_repo "$1"
	write_file .gitignore '*.local.*'
	write_file src/main/Seed.java 'class Seed {' '}'
	write_file docs/backlog.md '| ID | Item |' '|---|---|' '| **G99** | A finding traced as live work |' '' \
		'## Doc debt: wrong text left over' ''
	write_file "$feature_dir/ledger.feature" 'Feature: Sorting the tables' '' '  @wip' \
		'  Scenario: Sorting a ledger orders the whole ledger' '    Given a ledger' '' \
		'  Scenario: An armed scenario' '    Given a ledger' '' \
		'  Scenario Outline: A headline <what> is skipped' '    Given a ledger' '' \
		"    Examples: today's behaviour" '      | what |' '      | ok   |' '' \
		'    @wip' '    Examples: corrected behavior' '      | what  |' '      | wrong |'
	commit_all 'Add the seed'
	step git checkout -q -b strand
	write_file src/main/Feature.java 'class Feature {' '}'
	write_file src/test/FeatureTest.java 'class FeatureTest {' '	@Test' '	void featureWorks() {' '	}' '}'
	commit_all 'Add the feature'
}

# A red record of a commit by its subject, its tree and the blob of each test file in the list,
# taken at that commit.
red_record() {
	record=$1
	subject=$2
	test_files=$3
	shift 3
	recorded=$(git log -1 --format=%H --fixed-strings --grep="$subject" 2> /dev/null || true)
	recorded=${recorded:-HEAD}
	blob_lines=
	for test_file in $test_files; do
		blob_lines="${blob_lines}blob: $(git rev-parse "$recorded:$test_file" 2> /dev/null) $test_file
"
	done
	write_file "gate.local.d/red/$record.txt" "commit: $subject" "tree: $(git rev-parse "$recorded^{tree}")" \
		"${blob_lines%?}" "$@"
}

# The seed's red record names 'Add the feature', so a strand without that commit keeps none.
complete_dossier() {
	tip_sha=$(tip)
	if git log --format=%s main..HEAD 2> /dev/null | grep -qx 'Add the feature'; then
		red_record feature 'Add the feature' src/test/FeatureTest.java 'FeatureTest > featureWorks() FAILED' \
			'    org.opentest4j.AssertionFailedError at FeatureTest.java:4'
	elif [ -f gate.local.d/red/feature.txt ]; then
		step mv gate.local.d/red/feature.txt "$work/$case_name-feature-record"
	fi
	walk_logs
	tip_reports
}

wip_run() {
	failed=$(printf '%s\n' "$@" | grep -c ' FAILED$' || true)
	write_file gate.local.d/bdd.log "tip: $tip_sha" '> Task :test' "$@" "$((failed + 1)) tests completed, $failed failed, 1 skipped" \
		'> Task :test FAILED' 'BUILD FAILED in 3m 57s'
	write_file gate.local.d/wip.expected "tip: $tip_sha" \
		"$sorting_failure | AssertionFailedError at LedgerSortingSteps.java:76" \
		"$headline_failure | AssertionError at HeadlineSteps.java:31"
}

sorting_fails() {
	printf '%s FAILED\n    org.opentest4j.AssertionFailedError at LedgerSortingSteps.java:%s\n' "$sorting_failure" "$1"
}

headline_fails() {
	printf '%s FAILED\n    java.lang.AssertionError at HeadlineSteps.java:31\n' "$headline_failure"
}

tip_reports() {
	tip_sha=$(tip)
	tip_runs
	lens_report robustness
	lens_report domain
}

review() {
	write_file "gate.local.d/$1.md" "tip: $tip_sha" '- `verdict: PASS`' '- findings: none' '- sweep: none'
}

tip_runs() {
	tip_sha=$(tip)
	wip_run "$(sorting_fails 76)" "$(headline_fails)"
	review doc-reviewer
	review reviewer
}

walk_logs() {
	for commit in $(git rev-list main..strand 2>/dev/null); do
		walk_log "$commit" '> Task :test' '> Task :frontend:npmTest' '[verify] executed test classes: 12' \
			'BUILD SUCCESSFUL in 4m 2s'
	done
}

walk_log() {
	commit=$1
	shift
	log=$("$dossier_check" --walk-log "$repo" "$commit") || { step false; return 0; }
	write_file "$log" "tree: $(git rev-parse "$commit^{tree}")" "$@" '[gate/walk] verify exited 0'
}

lens_report() {
	write_file "gate.local.d/lens-$1.md" "tip: $tip_sha" '- `robust: yes`' \
		'- weaknesses: none found after a genuine attempt' '- `counterTests:` none' '- `treeDiff:` (empty)'
}

case_wanted() {
	[ -n "$filters" ] || return 0
	wanted=no
	set -f
	for pattern in $filters; do
		case "$1" in $pattern) wanted=yes ;; esac
	done
	set +f
	[ "$wanted" = yes ]
}

# Each case copies the seed: a main with one commit and a strand branch with one more, checked out
# in the repo itself, which stands in for the strand worktree, and a complete dossier.
new_strand() {
	case_name=$1
	broken=$seed_broken
	tip_sha=$seed_tip
	checker=$dossier_check
	gate_copy=$work/fixture
	case_wanted "$1" || return 1
	matched=$((matched + 1))
	repo="$work/$1"
	step cp -R "$work/seed" "$repo"
	step cd "$repo"
	return 0
}

# A case that builds no repository: the label is all it takes, and the filter reads it as it reads
# a strand's.
new_case() {
	case_name=$1
	broken=0
	case_wanted "$1" || return 1
	matched=$((matched + 1))
	return 0
}

# A copy of the fixture check whose ADAPT block takes the given values, so a case proves the check
# reads a value from its block.
configured() {
	dir="$work/config-$1"
	shift
	mkdir -p "$dir"
	printf '%s\n' "$@" > "$dir/values"
	splice_values
}

configured_from() {
	dir="$work/config-$1"
	mkdir -p "$dir"
	grep '^[a-z_]*=' "$2" > "$dir/values" 2> /dev/null || true
	splice_values
}

place_helpers() {
	for helper in $helpers; do
		[ ! -f "$gate_dir/$helper" ] || { cp "$gate_dir/$helper" "$1/$helper" && chmod +x "$1/$helper"; }
	done
}

splice_values() {
	splice "$dir/values" "$dossier_check" "$dir/dossier-check" || step false
	checker="$dir/dossier-check"
	gate_copy=$dir
	place_helpers "$dir" || step false
}

run_check() {
	"$checker" "$@" "$repo" strand > "$work/out" 2>&1
}

# A refusal counts only when it names the check the case broke, so a case cannot pass on a
# refusal some other, incidental breakage caused.
refuses_for() {
	class=$1
	shift
	if run_check "$@"; then return 1; fi
	grep -q "^refused \[$class\]" "$work/out"
}

accepts() { run_check; }

printed() { grep -q -- "$1" "$work/out"; }

fails_with() {
	if run_check; then return 1; fi
	grep -q -- "$1" "$work/out"
}

real_tool() { command -v "$1"; }

shim_without() {
	shim="$work/shim-$1"
	mkdir -p "$shim"
	for tool in git awk mktemp dirname sed grep tr cut head wc cat rm env; do
		[ "$tool" != "$1" ] || continue
		path=$(real_tool "$tool") || continue
		printf '#!/bin/sh\nexec "%s" "$@"\n' "$path" > "$shim/$tool"
		chmod +x "$shim/$tool"
	done
}

place_helpers "$work/fixture"

printf 'gate self-test\n'

case_name=seed
seed_strand "$work/seed"
tip_sha=$(tip)
repo="$work/seed"
complete_dossier
seed_broken=$broken
seed_tip=$tip_sha

if new_strand complete; then
	if accepts; then r=0; else r=1; fi
	check "a complete dossier passes" "$r"
fi

# The live block holds the project's values, so the case asks only that the check can run with them,
# on a seed whose base ref stands at main whatever ref the block names.
if new_strand live_block; then
	live_base=$(sed -n "s/^base_ref='\(.*\)'\$/\1/p" "$live_check" | head -n 1)
	step git update-ref "${live_base:-refs/heads/main}" main
	"$live_check" "$repo" strand > "$work/out" 2>&1 && status=0 || status=$?
	if [ "$status" -ne 2 ]; then r=0; else r=1; fi
	check "the live ADAPT block names readers and a base ref the check can run with" "$r"
fi

if new_strand self_test_block_key; then
	step mkdir -p "$work/$case_name-gate"
	step cp "$gate_dir/self-test" "$work/$case_name-gate/self-test"
	step sed '/^bdd_leg=/d' "$live_check" > "$work/$case_name-gate/dossier-check"
	/bin/sh "$work/$case_name-gate/self-test" complete > "$work/out" 2>&1 && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'has no bdd_leg'; then r=0; else r=1; fi
	check "the gate self-test beside a check whose ADAPT block lacks a fixture key names it and runs no case" "$r"
fi

if new_strand unknown_commit; then
	if "$checker" --walk-log "$repo" no-such-commit > "$work/out" 2>&1; then r=1; else r=0; fi
	check "naming the log of a commit that does not exist fails" "$r"
fi

if new_strand walk_log_key; then
	write_file docs/guide.md '# Guide'
	commit_all '[doc] Add the guide'
	write_file src/main/Feature.java 'class Feature {' '	int more;' '}'
	commit_all 'Grow the feature'
	code=$("$checker" --walk-log "$repo" HEAD~2) || step false
	docs=$("$checker" --walk-log "$repo" HEAD~1) || step false
	grown=$("$checker" --walk-log "$repo" HEAD) || step false
	case "$code" in "$repo/gate.local.d/walk/"*.log) r=0 ;; *) r=1 ;; esac
	if [ "$r" -eq 0 ] && [ "$code" = "$docs" ] && [ "$code" != "$grown" ]; then r=0; else r=1; fi
	check "a commit's full-suite log is named by its code tree, so a docs-only commit shares it" "$r"
fi

if new_strand wip_listing; then
	if "$checker" --wip "$repo" HEAD > "$work/out" 2>&1 \
		&& [ "$(cat "$work/out")" = "$(printf 'Sorting the tables\tSorting a ledger orders the whole ledger\nSorting the tables\tA headline <what> is skipped')" ]; then
		r=0
	else
		r=1
	fi
	check "the @wip scenarios at a commit are listed with their feature" "$r"
fi

if new_strand under_build; then
	step mkdir -p build
	step mv gate.local.d build/gate-dossier
	if refuses_for location; then r=0; else r=1; fi
	check "a dossier kept under build/ is refused" "$r"
fi

if new_strand symlinked; then
	step mkdir -p build
	step mv gate.local.d build/gate-dossier
	# Git Bash's ln -s copies where the host grants no link right, so the case skips by name there.
	ln -s build/gate-dossier gate.local.d 2> /dev/null || true
	if [ -L gate.local.d ]; then
		if refuses_for location; then r=0; else r=1; fi
		check "a gate.local.d that links into build/ is refused" "$r"
	else
		printf '  skip %s\n' 'a gate.local.d that links into build/ is refused: ln -s made no link on this host'
	fi
fi

if new_strand not_ignored; then
	write_file .gitignore 'build/'
	commit_all 'Stop ignoring local files'
	complete_dossier
	if refuses_for ignored; then r=0; else r=1; fi
	check "a gate.local.d that git does not ignore is refused" "$r"
fi

if new_strand main_moved; then
	step git checkout -q main
	write_file src/main/Elsewhere.java 'class Elsewhere {' '}'
	commit_all 'Land another strand'
	step git checkout -q strand
	if refuses_for base; then r=0; else r=1; fi
	check "a strand whose merge-base main has moved past is refused" "$r"
fi

if new_strand empty_strand; then
	step git checkout -q -B strand main
	complete_dossier
	if refuses_for base; then r=0; else r=1; fi
	check "a strand with no commit beyond main is refused" "$r"
fi

if new_strand empty_commits; then
	step git checkout -q -B strand main
	step git commit -q --allow-empty -m 'Change nothing'
	complete_dossier
	if refuses_for base; then r=0; else r=1; fi
	check "a strand whose commits change no file is refused" "$r"
fi

if new_strand unrelated; then
	step git checkout -q --orphan alone
	write_file src/main/Alone.java 'class Alone {' '}'
	commit_all 'Start an unrelated history'
	step git branch -q -f strand alone
	step git checkout -q strand
	complete_dossier
	if refuses_for base; then r=0; else r=1; fi
	check "a strand that shares no history with main is refused" "$r"
fi

if new_strand no_base_ref; then
	configured trunk "base_ref='refs/heads/trunk'"
	run_check && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'has no refs/heads/trunk'; then r=0; else r=1; fi
	check "a strand worktree without the base ref is named, not checked" "$r"
fi

if new_strand dirty_tree; then
	write_file src/main/Probe.java 'class Probe {' '}'
	if refuses_for freeze; then r=0; else r=1; fi
	check "a strand worktree with uncommitted changes is refused" "$r"
fi

if new_strand dirty_hidden; then
	step git config status.showUntrackedFiles no
	write_file src/main/Probe.java 'class Probe {' '}'
	if refuses_for freeze; then r=0; else r=1; fi
	check "a strand worktree with an untracked file is refused when git's config hides untracked files" "$r"
fi

if new_strand other_head; then
	step git checkout -q --detach main
	if refuses_for freeze; then r=0; else r=1; fi
	check "a strand worktree checked out at another commit than the tip is refused" "$r"
fi

if new_strand tag_main; then
	step git tag main 'strand~1'
	if refuses_for base && printed 'refs/tags/main could stand in'; then r=0; else r=1; fi
	check "a tag named main is refused as a stand-in for the base" "$r"
fi

if new_strand tag_main_upper; then
	step git tag Main strand
	if refuses_for base && printed 'refs/tags/Main could stand in'; then r=0; else r=1; fi
	check "a tag named Main, which a case-blind file system resolves for main, is refused as a stand-in" "$r"
fi

if new_strand branch_origin_main; then
	step git branch origin/main main
	if refuses_for base && printed 'refs/heads/origin/main could stand in'; then r=0; else r=1; fi
	check "a local branch named origin/main is refused as a stand-in for the base" "$r"
fi

for stand_in in main origin/main; do
	if new_strand "ref_$(printf '%s' "$stand_in" | tr / _)"; then
		step git update-ref "refs/$stand_in" main
		if refuses_for base && printed "refs/$stand_in could stand in"; then r=0; else r=1; fi
		check "a ref refs/$stand_in, which git resolves before tags and branches, is refused as a stand-in" "$r"
	fi
	if new_strand "file_$(printf '%s' "$stand_in" | tr / _)"; then
		step mkdir -p "$(dirname -- ".git/$stand_in")"
		git rev-parse main > ".git/$stand_in" || step false
		if refuses_for base && printed "the file $stand_in in the common git dir .* could stand in"; then r=0; else r=1; fi
		check "a file $stand_in in the git dir, which git resolves before any ref, is refused as a stand-in" "$r"
	fi
done

for stand_in in main origin/main; do
	if new_strand "packed_$(printf '%s' "$stand_in" | tr / _)"; then
		step git pack-refs --all
		awk -v line="$(git rev-parse strand) $stand_in" 'NR == 1 { print; print line; next } { print }' .git/packed-refs \
			> .git/packed-refs.edited || step false
		step mv .git/packed-refs.edited .git/packed-refs
		if refuses_for base && printed "git resolves $stand_in in the strand worktree to "; then r=0; else r=1; fi
		check "a packed-refs line $stand_in, which no ref list shows and no loose file holds, is refused as a stand-in" "$r"
	fi
done

if new_strand packed_origin_main_beside; then
	step git update-ref refs/remotes/origin/main main
	step git pack-refs --all
	awk -v line="$(git rev-parse strand) origin/main" 'NR == 1 { print; print line; next } { print }' .git/packed-refs \
		> .git/packed-refs.edited || step false
	step mv .git/packed-refs.edited .git/packed-refs
	if refuses_for base && printed "git resolves origin/main in the strand worktree to "; then r=0; else r=1; fi
	check "a packed-refs line origin/main beside the remote-tracking ref, which makes the name ambiguous, is refused" "$r"
fi

if new_strand hub_no_local_main; then
	step git clone -q --template= -c core.autocrlf=false -b strand "$repo" "$work/$case_name-clone"
	step cp -R gate.local.d "$work/$case_name-clone/gate.local.d"
	repo="$work/$case_name-clone"
	step cd "$repo"
	configured hub-clone "base_ref='refs/remotes/origin/main'"
	if git rev-parse --verify --quiet refs/heads/main > /dev/null; then step false; fi
	if accepts; then r=0; else r=1; fi
	check "a hub-model strand worktree with no local main and nothing standing in for it passes" "$r"
fi

if new_strand file_main_linked; then
	step git checkout -q --detach
	step git worktree add -q "$work/$case_name-linked" strand
	step cp -R gate.local.d "$work/$case_name-linked/gate.local.d"
	git rev-parse main > .git/main || step false
	repo="$work/$case_name-linked"
	step cd "$repo"
	if refuses_for base && printed 'the file main in the common git dir'; then r=0; else r=1; fi
	check "a file main in the git dir a linked strand worktree shares is refused as a stand-in" "$r"
fi

if new_strand tag_main_below; then
	step git tag main/x 'strand~1'
	if accepts; then r=0; else r=1; fi
	check "a tag main/x, whose name only starts like a stand-in, is no stand-in" "$r"
fi

if new_strand ref_main_below; then
	step git update-ref refs/main/x main
	if accepts; then r=0; else r=1; fi
