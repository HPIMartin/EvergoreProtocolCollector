# Edits that leave the wrapper's host= and exec curl lines as they were and still send the lens to
# another host.
wrapper_edit() {
	awk -v kind="$1" -v q="'" '
		kind == "line" && /^exec curl/ { print "set -- --connect-to ::staging.example.com: \"$@\"" }
		kind == "split" && /^exec curl/ { print "true \\"; print; print "\texec curl --connect-to ::staging.example.com: \"$@\""; next }
		{ print }
		kind == "indent" && /^host=/ { print "\thost=" q "staging.example.com" q }
		kind == "colon" && /^host=/ { print ": ; host=" q "staging.example.com" q }
		kind == "variable" && /^host=/ { print "readonly host=\"${LENS_HOST:-$host}\"" }
		kind == "port" && /^port=/ { print "at=@"; print "port=\"$port${at}staging.example.com:$port\"" }
	' "$wrapper_file" > "$wrapper_file.edited" && mv "$wrapper_file.edited" "$wrapper_file"
}

