new_strand older_tip
complete_dossier
write_file src/main/Fold.java 'class Fold {' '}'
commit_all 'Fold a gate fix'
if refuses_for tip; then r=0; else r=1; fi
check "a report produced at an older tip is refused" "$r"

new_strand crlf_report
complete_dossier
awk '{ printf "%s\r\n", $0 }' gate.local.d/lens-robustness.md > gate.local.d/crlf
mv gate.local.d/crlf gate.local.d/lens-robustness.md
if accepts; then r=0; else r=1; fi
