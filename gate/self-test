# /MODULE agent-seat+security-lens

# MODULE security-lens
# gate/lens-request, the security lens's fixed-host HTTP wrapper: its refusals, and, against a
# listener that records the request it gets, the request it sends. The cases run a copy of the
# wrapper pinned to localhost, so the host an adopted project sets cannot decide them. The listener
# needs perl and curl; a case that needs one that is missing prints a skip line and passes.
lens_request="$work/lens-request"
sed "s/^host='[^']*'\$/host='localhost'/" "$gate_dir/lens-request" > "$lens_request" && chmod +x "$lens_request"
grep -qx "host='localhost'" "$lens_request" || {
	printf 'gate self-test: gate/lens-request has no single-quoted host line\n' >&2
	exit 2
}

cat > "$work/listener.pl" <<'PERL'
use strict;
use warnings;
use IO::Socket::INET;
my $rec = shift @ARGV;
my $server = IO::Socket::INET->new(Listen => 5, LocalAddr => '127.0.0.1', LocalPort => 0,
	Proto => 'tcp', ReuseAddr => 1) or die "no listener: $!";
open(my $port_file, '>', "$rec.port.tmp") or die;
print $port_file $server->sockport;
close $port_file;
rename "$rec.port.tmp", "$rec.port" or die;
while (my $client = $server->accept) {
	binmode $client;
	my $request_line = <$client>;
	next unless defined $request_line;
	$request_line =~ s/\r?\n\z//;
	my ($command, $path) = split / /, $request_line;
	my ($probe, $length) = ('', 0);
	while (defined(my $header = <$client>)) {
		$header =~ s/\r?\n\z//;
		last if $header eq '';
		$probe = $1 if $header =~ /^X-Probe:\s*(.*)$/i;
		$length = $1 if $header =~ /^Content-Length:\s*(\d+)/i;
	}
	my $body = '';
	read($client, $body, $length) if $length;
	open(my $out, '>', $rec) or die;
	binmode $out;
	print $out "$command\n$path\n$probe\n$body\n";
	close $out;
	if ($path eq '/redir') {
		print $client "HTTP/1.0 302 Found\r\nLocation: /dest\r\n\r\n";
	} elsif ($path eq '/keepalive') {
		print $client "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n";
		1 while read($client, my $discarded, 1024);
	} else {
		print $client "HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\n\r\n";
		print $client 'ok' unless $command eq 'HEAD';
	}
	close $client;
}
PERL

listener_pid=''
port=''
start_listener() {
	rec="$work/req"
	rm -f "$rec" "$rec.port" "$rec.port.tmp"
	perl "$work/listener.pl" "$rec" > /dev/null 2>&1 &
	listener_pid=$!
	while [ ! -f "$rec.port" ] && kill -0 "$listener_pid" 2> /dev/null; do sleep 0.1; done
	port=$(cat "$rec.port" 2> /dev/null || true)
}
stop_listener() {
	[ -n "$listener_pid" ] || return 0
	kill "$listener_pid" 2> /dev/null || true
	wait "$listener_pid" 2> /dev/null || true
	listener_pid=''
}
trap 'stop_listener; rm -rf "$work"' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

listener_tool_missing() {
	command -v curl > /dev/null 2>&1 || { missing=curl; return 0; }
	command -v perl > /dev/null 2>&1 || { missing=perl; return 0; }
	perl -MIO::Socket::INET -e 1 > /dev/null 2>&1 || { missing='perl module IO::Socket::INET'; return 0; }
	return 1
}

new_listener_case() {
	new_case "$1" || return 1
	case_description=$2
	if listener_tool_missing; then
		printf '  skip %s: no %s\n' "$case_description" "$missing"
		return 1
	fi
	return 0
}

new_curl_case() {
	new_case "$1" || return 1
	case_description=$2
	if ! command -v curl > /dev/null 2>&1; then
		printf '  skip %s: no curl\n' "$case_description"
		return 1
	fi
	return 0
}

run_lens_request() { "$lens_request" "$@" > "$work/out" 2>&1; }

recorded_line() { sed -n "${1}p" "$rec"; }

if new_case lens_request_usage; then
	run_lens_request 8080 && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed '^usage: gate/lens-request'; then r=0; else r=1; fi
	check "the lens request prints its usage for too few arguments" "$r"
fi

if new_case lens_request_port_low; then
	run_lens_request 500 GET /health && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'is outside 1024-65535'; then r=0; else r=1; fi
	check "the lens request refuses a port below 1024" "$r"
fi

if new_case lens_request_port_high; then
	run_lens_request 70000 GET /health && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'is outside 1024-65535'; then r=0; else r=1; fi
	check "the lens request refuses a port above 65535" "$r"
fi

if new_case lens_request_port_text; then
	run_lens_request abc GET /health && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'is not a number'; then r=0; else r=1; fi
	check "the lens request refuses a non-numeric port" "$r"
fi

if new_case lens_request_method_unknown; then
	run_lens_request 8080 FETCH /health && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'is not one of'; then r=0; else r=1; fi
	check "the lens request refuses an unknown method" "$r"
fi

if new_case lens_request_path_slash; then
	run_lens_request 8080 GET health && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'does not begin with /'; then r=0; else r=1; fi
	check "the lens request refuses a path without a leading slash" "$r"
fi

if new_case lens_request_header_pair; then
	run_lens_request 8080 GET /health --header NoColonHere && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'is not a Name: Value pair'; then r=0; else r=1; fi
	check "the lens request refuses a header that is no Name: Value pair" "$r"
fi

if new_case lens_request_option_unknown; then
	run_lens_request 8080 GET /health --resolve example.com:8080:10.0.0.1 && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'unknown option'; then r=0; else r=1; fi
	check "the lens request refuses an option that is not --header or --body-file" "$r"
fi

if new_case lens_request_body_missing; then
	run_lens_request 8080 POST /usage --body-file "$work/no-such-body" && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'does not exist'; then r=0; else r=1; fi
	check "the lens request refuses a body file that does not exist" "$r"
fi

if new_case lens_request_body_stdin; then
	printf 'not a body' > "$work/-"
	(cd "$work" && "$lens_request" 8080 POST /usage --body-file - > "$work/out" 2>&1 < /dev/null) && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'reads standard input'; then r=0; else r=1; fi
	check "the lens request refuses a body file named - that curl would read as standard input" "$r"
fi

if new_case lens_request_header_control; then
	control_header=$(printf 'X-Probe: a\nInjected: b')
	run_lens_request 8080 GET /health --header "$control_header" && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'holds a control character'; then r=0; else r=1; fi
	check "the lens request refuses a header with a control character" "$r"
fi

if new_case lens_request_header_cr; then
	carriage_header=$(printf 'X-Probe: a\rInjected: b')
	run_lens_request 8080 GET /health --header "$carriage_header" && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'holds a control character'; then r=0; else r=1; fi
	check "the lens request refuses a header with a bare carriage return" "$r"
fi

if new_case lens_request_header_file; then
	run_lens_request 8080 GET /health --header '@/etc/hostname: x' && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'reads as a file'; then r=0; else r=1; fi
	check "the lens request refuses a header that curl would read from a file" "$r"
fi

if new_case lens_request_header_novalue; then
	run_lens_request 8080 GET /health --header && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'needs a value'; then r=0; else r=1; fi
	check "the lens request refuses --header without a value" "$r"
fi

if new_case lens_request_body_novalue; then
	run_lens_request 8080 POST /usage --body-file && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed 'needs a value'; then r=0; else r=1; fi
	check "the lens request refuses --body-file without a value" "$r"
fi

if new_case lens_request_head_body; then
	printf 'payload' > "$work/body"
	run_lens_request 8080 HEAD /usage --body-file "$work/body" && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed '^refused: HEAD sends no body'; then r=0; else r=1; fi
	check "the lens request refuses a body file with HEAD, which sends none" "$r"
fi

if new_case lens_request_no_curl; then
	shim_without curl
	PATH="$shim" /bin/sh "$lens_request" 8080 GET /health > "$work/out" 2>&1 && status=0 || status=$?
	if [ "$status" -eq 2 ] && printed '^refused: .*curl'; then r=0; else r=1; fi
	check "the lens request without curl on PATH refuses and names curl" "$r"
fi

if new_curl_case lens_request_error_shown "the lens request shows the error curl reports for a URL it cannot send"; then
	run_lens_request 8080 GET '/a b' && status=0 || status=$?
	if [ "$status" -eq 3 ] && printed '^curl: (3)'; then r=0; else r=1; fi
	check "$case_description" "$r"
fi

if new_listener_case lens_request_get_raw "the lens request sends a GET with the raw path to its default host"; then
	start_listener
	run_lens_request "$port" GET '/a/../b' && status=0 || status=$?
	stop_listener
	if [ -n "$port" ] && [ "$status" -eq 0 ] && [ "$(recorded_line 1)" = GET ] \
		&& [ "$(recorded_line 2)" = '/a/../b' ] && printed ' 200'; then r=0; else r=1; fi
	check "$case_description" "$r"
fi

if new_listener_case lens_request_post "the lens request sends a POST with a header and a body file"; then
	start_listener
	printf 'payload' > "$work/body"
	run_lens_request "$port" POST /usage --header 'X-Probe: seen' --body-file "$work/body" && status=0 || status=$?
	stop_listener
	if [ -n "$port" ] && [ "$status" -eq 0 ] && [ "$(recorded_line 1)" = POST ] \
		&& [ "$(recorded_line 3)" = seen ] && [ "$(recorded_line 4)" = payload ]; then r=0; else r=1; fi
	check "$case_description" "$r"
fi

for method in PUT PATCH DELETE OPTIONS HEAD; do
	lowered=$(printf '%s' "$method" | tr 'A-Z' 'a-z')
	if new_listener_case "lens_request_$lowered" "the lens request sends the $method method"; then
		start_listener
		run_lens_request "$port" "$method" /m && status=0 || status=$?
		stop_listener
		if [ -n "$port" ] && [ "$status" -eq 0 ] && [ "$(recorded_line 1)" = "$method" ]; then r=0; else r=1; fi
		check "$case_description" "$r"
	fi
done

if new_listener_case lens_request_head_keepalive "the lens request sends HEAD without waiting for a body that never comes"; then
	start_listener
	run_lens_request "$port" HEAD /keepalive && status=0 || status=$?
	stop_listener
	if [ -n "$port" ] && [ "$status" -eq 0 ] && [ "$(recorded_line 1)" = HEAD ]; then r=0; else r=1; fi
	check "$case_description" "$r"
fi

if new_listener_case lens_request_bracket "the lens request sends a bracket path once, not globbed into many"; then
	start_listener
	run_lens_request "$port" GET '/a[1-3]' && status=0 || status=$?
	stop_listener
	if [ -n "$port" ] && [ "$status" -eq 0 ] && [ "$(recorded_line 2)" = '/a[1-3]' ]; then r=0; else r=1; fi
	check "$case_description" "$r"
fi

if new_listener_case lens_request_proxy "the lens request ignores an http_proxy in the environment"; then
	start_listener
	env -i PATH="$PATH" http_proxy=http://127.0.0.1:1 "$lens_request" "$port" GET /health > "$work/out" 2>&1 && status=0 || status=$?
	stop_listener
	if [ -n "$port" ] && [ "$status" -eq 0 ] && [ -f "$rec" ]; then r=0; else r=1; fi
	check "$case_description" "$r"
fi

if new_listener_case lens_request_curlrc "the lens request ignores a .curlrc that redirects the connection"; then
	start_listener
	printf 'connect-to = "::127.0.0.1:1"\n' > "$work/.curlrc"
	env -i PATH="$PATH" HOME="$work" "$lens_request" "$port" GET /health > "$work/out" 2>&1 && status=0 || status=$?
	stop_listener
	if [ -n "$port" ] && [ "$status" -eq 0 ] && [ -f "$rec" ]; then r=0; else r=1; fi
	check "$case_description" "$r"
fi

if new_listener_case lens_request_redirect "the lens request does not follow a redirect"; then
	start_listener
	run_lens_request "$port" GET /redir && status=0 || status=$?
	stop_listener
	if [ -n "$port" ] && [ "$status" -eq 0 ] && [ "$(recorded_line 2)" = /redir ] && printed ' 302'; then r=0; else r=1; fi
	check "$case_description" "$r"
fi

if new_listener_case lens_request_host "the lens request reaches only the host its ADAPT line names"; then
	start_listener
	run_lens_request "$port" GET /health && status=0 || status=$?
	listener_shown=no
	[ -n "$port" ] && [ "$status" -eq 0 ] && [ -f "$rec" ] && listener_shown=yes
	rm -f "$rec"
	step sed "s/^host='localhost'\$/host='host.invalid'/" "$lens_request" > "$work/lens-request-elsewhere"
	step chmod +x "$work/lens-request-elsewhere"
	step grep -q "^host='host.invalid'\$" "$work/lens-request-elsewhere"
	"$work/lens-request-elsewhere" "$port" GET /health > "$work/out" 2>&1 && status=0 || status=$?
	stop_listener
	if [ "$listener_shown" = yes ] && [ "$status" -ne 0 ] && [ ! -f "$rec" ]; then r=0; else r=1; fi
	check "$case_description" "$r"
fi
# The project's own list against the project's own repository, on every run of the suite.
if new_case n_security_live_list; then
	if [ -f "$gate_dir/authentication-surface" ]; then
		unmatched_surface_lines=$(git -c core.quotepath=off -C "$gate_dir/.." ls-files | awk -v surface="$gate_dir/authentication-surface" '
			BEGIN { while ((getline prefix < surface) > 0) { sub(/[ \t\r]+$/, "", prefix); if (prefix != "") prefixes[++n] = prefix } }
			{ for (i = 1; i <= n; i++) if (index($0, prefixes[i]) == 1) matched[i] = 1 }
			END { for (i = 1; i <= n; i++) if (!matched[i]) print prefixes[i] }
		') || step false
		if [ -z "$unmatched_surface_lines" ]; then r=0; else printf '%s\n' "$unmatched_surface_lines"; r=1; fi
		check "every line of the authentication surface list starts a path the repository tracks" "$r"
	else
		printf '  skip %s\n' 'every line of the authentication surface list starts a path the repository tracks: no gate/authentication-surface'
	fi
fi
# /MODULE security-lens

# MODULE agent-seat+security-lens
# The seat switch of gate/lens-request: where AGENT_SEAT reads unattended the request goes to
# localhost, whatever host the ADAPT line names, and anywhere else it keeps that host. The cases run
# a copy of the wrapper whose ADAPT host resolves nowhere, against the listener of the wrapper's
# cases. A case that shows a request not arriving first shows the same copy reaching that listener
# on the seat, so none passes with its listener not running.
if [ -f "$gate_dir/lens-request" ]; then
	seat_request="$work/lens-request-seat"

	seat_wrapper() {
		step sed "s/^host='[^']*'\$/host='host.invalid'/" "$gate_dir/lens-request" > "$seat_request"
		step chmod +x "$seat_request"
		step grep -qx "host='host.invalid'" "$seat_request"
	}

	# AGENT_SEAT as the first argument names it: a value, an empty one, or unset for no variable.
	run_seat_request() {
		seat=$1
		shift
		if [ "$seat" = unset ]; then
			(unset AGENT_SEAT; "$seat_request" "$@") > "$work/out" 2>&1
		else
			AGENT_SEAT=$seat "$seat_request" "$@" > "$work/out" 2>&1
		fi
	}

	if new_listener_case lens_request_seat_unattended "the lens request on the unattended seat reaches the localhost listener, whatever host its ADAPT line names"; then
		seat_wrapper
		start_listener
		run_seat_request unattended "$port" GET /seat && status=0 || status=$?
		stop_listener
		if [ -n "$port" ] && [ "$status" -eq 0 ] && [ -f "$rec" ] && [ "$(recorded_line 1)" = GET ] \
			&& [ "$(recorded_line 2)" = /seat ] && printed ' 200'; then r=0; else r=1; fi
		check "$case_description" "$r"
	fi

	off_seat_case() {
		if new_listener_case "$1" "the lens request with AGENT_SEAT $2 does not reach the localhost listener"; then
			seat_wrapper
			start_listener
			run_seat_request unattended "$port" GET /seat && status=0 || status=$?
			listener_shown=no
			[ -n "$port" ] && [ "$status" -eq 0 ] && [ -f "$rec" ] && listener_shown=yes
			rm -f "$rec"
			run_seat_request "$3" "$port" GET /seat && status=0 || status=$?
			stop_listener
			if [ "$listener_shown" = yes ] && [ "$status" -ne 0 ] && [ ! -f "$rec" ] && printed '^curl: ('; then r=0; else r=1; fi
			check "$case_description" "$r"
		fi
	}
	off_seat_case lens_request_seat_unset unset unset
	off_seat_case lens_request_seat_empty empty ''
	off_seat_case lens_request_seat_attended 'reading attended' attended

	# The suite as the seat runs it, on the one wrapper case whose copy names another host; that
	# filter matches no case of this block, so the inner run starts no run of its own.
	if new_listener_case lens_request_seat_suite "a gate self-test run on the unattended seat passes the wrapper case whose copy names another host"; then
		AGENT_SEAT=unattended /bin/sh "$gate_dir/self-test" lens_request_host > "$work/out" 2>&1 && status=0 || status=$?
		if [ "$status" -eq 0 ] && printed '^  ok   ' && printed '^0 case(s) failed$'; then r=0; else r=1; fi
		check "$case_description" "$r"
	fi
else
	printf '  skip %s\n' "the seat switch's cases: no gate/lens-request beside gate/self-test"
fi
# /MODULE agent-seat+security-lens

if [ -n "$filters" ] && [ "$matched" -eq 0 ]; then
	printf 'gate self-test: no case matches %s, so nothing was checked\n' "$filters"
	exit 2
fi
printf '%s case(s) failed\n' "$failures"
[ "$failures" -eq 0 ]
