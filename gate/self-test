# The shim holds the check inside its path listing until the case releases it, and marks whether the
# check still lived when that git call returned, so the case tells a check whose trap waited out the
# call from one the signal ended at once. Each wait is on a file or on the check's end, never on a
# clock, and the shim's wait also ends with this self-test's scratch directory, so a run stopped
# before the release leaves no shim behind. bash runs the EXIT trap and exits 143 on a TERM it has
# no trap for, so there the mark is what shows the trap; a shell such as dash leaves the scratch
# directory behind.
if new_strand x_signal; then
	shim="$work/git-$case_name"
	waiting="$work/$case_name.waiting"
	release="$work/$case_name.release"
	checked="$work/$case_name.pid"
	outlived="$work/$case_name.outlived"
	step mkdir -p "$shim" "$work/tmp-$case_name"
	printf '#!/bin/sh\ncase " $* " in *" diff --no-renames --name-only -z "*)\n\t: > "%s"\n\twhile [ ! -f "%s" ] && [ -d "%s" ]; do sleep 1; done\n\t"%s" "$@" && status=0 || status=$?\n\tif kill -0 "$(cat "%s")" 2> /dev/null; then : > "%s"; fi\n\texit "$status" ;;\nesac\nexec "%s" "$@"\n' \
		"$waiting" "$release" "$work" "$(real_tool git)" "$checked" "$outlived" "$(real_tool git)" > "$shim/git"
	step chmod +x "$shim/git"
	TMPDIR="$work/tmp-$case_name" PATH="$shim:$PATH" "$checker" "$repo" strand > "$work/out" 2>&1 &
	pid=$!
	printf '%s\n' "$pid" > "$checked"
	while [ ! -f "$waiting" ] && kill -0 "$pid" 2> /dev/null; do
		sleep 1
	done
	# A shell runs a trap only once its foreground command returns, so the release follows the signal.
	kill -TERM "$pid" 2> /dev/null || true
	: > "$release"
	wait "$pid" && status=0 || status=$?
	if [ -f "$waiting" ] && [ -f "$outlived" ] && [ "$status" -eq 143 ] && [ -z "$(ls -A "$work/tmp-$case_name")" ]; then
		r=0
	else
		r=1
	fi
	check "a check stopped by a signal ends through its trap and leaves no scratch directory behind" "$r"
fi

