	checker="$dir/gate/dossier-check"
	[ $# -eq 0 ] || printf '#!/bin/sh\nprintf "%%s\\n" "%s" "a second line" >&2\nexit %s\n' "$2" "$1" > "$dir/hooks/breach-guard"
}

