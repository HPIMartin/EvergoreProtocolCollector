	sh_case '  FAIL a typed input is refused' 'check "a $kind input is refused" "$r"'
	seen_red "a self-test case named with a variable is seen red with the variable filled"
fi
if new_strand h_escaped; then
	sh_case '  FAIL a "quoted" input is refused' 'check "a \"quoted\" input is refused" "$r"'
	seen_red "a self-test case with an escaped quote in its name is seen red under its printed name"
fi
# The FAIL line in each form a suite prints it: bare, behind the gate suite's label in brackets, and
# behind a bracket of the form "[case <name>]".
for printed_form in label case; do
	if new_strand "h_bracket_$printed_form"; then
		case "$printed_form" in
			label) tail_text='[h_bracket_label]' ;;
			case) tail_text='[case bracketcase]' ;;
		esac
		sh_case "  FAIL a typed input is refused $tail_text" 'check "a typed input is refused" "$r"'
		seen_red "a self-test case is seen red on its FAIL line that ends in the suite's $printed_form bracket"
	fi
done
if new_strand h_bracket_longer; then
	sh_case '  FAIL a typed input is refused twice [h_bracket_longer]' 'check "a typed input is refused" "$r"'
	never_red "a FAIL line of a longer name behind a bracket does not show the case red"
fi
sh_never single "a self-test case in single quotes never seen red is refused" "check 'a single-quoted input is refused' \"\$r\""
sh_never semicolon "a self-test case after a semicolon never seen red is refused" 'r=0;check "a chained input is refused" "$r"'
sh_no_case argument "a check inside a command argument is no self-test case" "write_file gate/dossier-check '#!/bin/sh' 'exit 1'"
sh_no_case fixture "a check inside a quoted fixture string is no self-test case" \
	"write_file tools/self-test 'r=0; check \"a fixture case\" \"\$r\"'"
sh_no_case comment "a check in a shell comment is no self-test case" '# a note; check "a commented case" "$r"'
sh_never then "a check after then is a self-test case" 'if true; then check "a guarded case" "$r"; fi'
sh_no_case heredoc "a check inside a here-document is no self-test case" "cat <<'EOF'" 'check "a quoted case" "$r"' 'EOF'
sh_no_case heredoc_tabs "a check inside a tab-stripped here-document is no self-test case" 'cat <<-END' \
	'	check "a quoted case" "$r"' '	END'
sh_no_case multi_line "a check inside a quoted fixture over several lines is no self-test case" \
	"write_file tools/self-test 'one line" 'check "a fixture case" "$r"' "another line'"
sh_no_case escaped_quote "a check inside a double-quoted string with an escaped quote is no self-test case" \
	"printf \"%s\\n\" \"a \\\" ; check 'a quoted case' ; \\\"\""
sh_no_case quote_start "a word that opens with a quote ends the command position" '"$runner" check "a passed name" "$r"'
for form in subshell group substitution assignment elif case_arm continuation ampersand pipe do else bang word_hash; do
	case "$form" in
		subshell) line='(check "a nested case" "$r")' ;;
		group) line='{ check "a nested case" "$r"; }' ;;
		substitution) line='out=$(check "a nested case" "$r")' ;;
		assignment) line='LC_ALL=C check "a nested case" "$r"' ;;
		elif) line='if false; then :; elif true; then check "a nested case" "$r"; fi' ;;
		case_arm) line='case x in x) check "a nested case" "$r" ;; esac' ;;
		continuation) line='r=0 \' ;;
		ampersand) line='true && check "a nested case" "$r"' ;;
		pipe) line='true | check "a nested case" "$r"' ;;
		do) line='for x in 1; do check "a nested case" "$r"; done' ;;
		else) line='if false; then :; else check "a nested case" "$r"; fi' ;;
		bang) line='! check "a nested case" "$r"' ;;
		word_hash) line='x=a#b; check "a nested case" "$r"' ;;
	esac
	if [ "$form" = continuation ]; then
		sh_never "$form" "a check after a $form is a self-test case" "$line" '	check "a nested case" "$r"'
	else
		sh_never "$form" "a check after a $form is a self-test case" "$line"
	fi
done

