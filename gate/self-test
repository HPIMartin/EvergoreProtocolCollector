#!/bin/sh
# Proves gate/dossier-check refuses each slip it claims to refuse. Every case starts from one
# complete dossier the check accepts and breaks exactly one thing in it, so a refusal can only come
# from the thing that case broke. Runs without the project's build tool.
set -eu

gate_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
dossier_check="$gate_dir/dossier-check"

# git exports GIT_DIR, GIT_INDEX_FILE and friends to the hook that runs this test, so a throwaway
# repo below would otherwise operate on the repo whose commit is being gated.
for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failures=0

check() {
	if [ "$2" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s\n' "$1"
		failures=$((failures + 1))
	fi
}

# One line per argument, so a fixture stays a single readable call.
write_file() {
	target=$1
	shift
	case "$target" in */*) mkdir -p "${target%/*}" ;; esac
	printf '%s\n' "$@" > "$target"
}

commit_all() {
	git add -A
	git commit -q --no-verify -m "$1"
}

# A main with one commit and a strand branch with one more, checked out in the repo itself, which
# stands in for the strand worktree.
new_strand() {
	repo="$work/$1"
	mkdir -p "$repo"
	cd "$repo"
	git init -q -b main .
	git config user.email gate@example.com
	git config user.name Gate
	git config core.autocrlf false
	write_file .gitignore '*.local.*'
	write_file src/main/Seed.java 'class Seed {' '}'
	write_file docs/backlog.md '| ID | Item |' '|---|---|' '| **G99** | A finding traced as live work |'
	write_file src/test/resources/features/ledger.feature 'Feature: Sorting the tables' '' '  @wip' \
		'  Scenario: Sorting a ledger orders the whole ledger' '    Given a ledger' '' \
		'  Scenario: An armed scenario' '    Given a ledger' '' \
		'  Scenario Outline: A headline <what> is skipped' '    Given a ledger' '' \
		"    Examples: today's behaviour" '      | what |' '      | ok   |' '' \
		'    @wip' '    Examples: corrected behavior' '      | what  |' '      | wrong |'
	commit_all 'Add the seed'
	git checkout -q -b strand
	write_file src/main/Feature.java 'class Feature {' '}'
	write_file src/test/FeatureTest.java 'class FeatureTest {' '	@Test' '	void featureWorks() {' '	}' '}'
	commit_all 'Add the feature'
}

tip() { git rev-parse HEAD; }

complete_dossier() {
	write_file gate.local.d/red/feature.txt 'commit: Add the feature' 'FeatureTest > featureWorks() FAILED' \
		'    org.opentest4j.AssertionFailedError at FeatureTest.java:4'
	walk_logs
	tip_reports
}

sorting_failure='RunAcceptanceScenariosTest > Sorting the tables > Sorting a ledger orders the whole ledger'
headline_failure='RunAcceptanceScenariosTest > Sorting the tables > A headline <what> is skipped > corrected behavior > Example #2.1'

# The two @wip places of the seed feature, each failing for the reason wip.expected names.
wip_run() {
	failed=$(printf '%s\n' "$@" | grep -c ' FAILED$' || true)
	write_file gate.local.d/bdd.log "tip: $(tip)" '> Task :test' "$@" "$((failed + 1)) tests completed, $failed failed, 1 skipped" \
		'> Task :test FAILED' 'BUILD FAILED in 3m 57s'
	write_file gate.local.d/wip.expected "tip: $(tip)" \
		"$sorting_failure | AssertionFailedError at DashboardSortingSteps.java:76" \
		"$headline_failure | AssertionError at ServiceLogSteps.java:31"
}

sorting_fails() {
	printf '%s FAILED\n    org.opentest4j.AssertionFailedError at DashboardSortingSteps.java:%s\n' "$sorting_failure" "$1"
}

headline_fails() {
	printf '%s FAILED\n    java.lang.AssertionError at ServiceLogSteps.java:31\n' "$headline_failure"
}

# The reports produced at the tip; a case that moves the tip writes them again.
tip_reports() {
	wip_run "$(sorting_fails 76)" "$(headline_fails)"
	lens_report robustness
	lens_report domain
	write_file gate.local.d/doc-reviewer.md "tip: $(tip)" '- `verdict: PASS`' '- findings: none'
}

# One green full-suite log per commit, at the path the check itself names for that commit's code tree.
walk_logs() {
	for commit in $(git rev-list main..strand 2>/dev/null); do
		walk_log "$commit" '> Task :test' '> Task :frontend:npmTest' '[verify] executed test classes: 12' \
			'BUILD SUCCESSFUL in 4m 2s'
	done
}

walk_log() {
	commit=$1
	shift
	write_file "$("$dossier_check" --walk-log "$repo" "$commit")" "tree: $(git rev-parse "$commit^{tree}")" "$@"
}

kb_guard_log() {
	write_file gate.local.d/kb-guard.log "tip: $(tip)" \
		'$ ./verify focus src/test/java/dev/example/arch/KbCitationGuardTest.java' '> Task :test' "$@"
}

lens_with_findings() {
	write_file gate.local.d/lens-robustness.md "tip: $(tip)" '- `robust: no`' '- weaknesses:' "$@" \
		'- `counterTests:` none' '- `treeDiff:` (empty)'
}

findings() {
	write_file gate.local.d/findings.txt "tip: $(tip)" "$@"
}

lens_report() {
	write_file "gate.local.d/lens-$1.md" "tip: $(tip)" '- `robust: yes`' \
		'- weaknesses: none found after a genuine attempt' '- `counterTests:` none' '- `treeDiff:` (empty)'
}

# A refusal counts only when it names the check the case broke, so a case cannot pass on a
# refusal some other, incidental breakage caused.
refuses_for() {
	if "$dossier_check" "$repo" strand > "$work/out" 2>&1; then return 1; fi
	grep -q "^refused \[$1\]" "$work/out"
}

accepts() { "$dossier_check" "$repo" strand > "$work/out" 2>&1; }

new_strand complete
complete_dossier
if accepts; then r=0; else r=1; fi
check "a complete dossier passes" "$r"

new_strand under_build
mkdir -p build
complete_dossier
mv gate.local.d build/gate-dossier
