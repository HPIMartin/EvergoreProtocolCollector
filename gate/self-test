if new_strand h_never; then
	sh_case '  FAIL an empty input is refused' 'check "a broken input is refused" "$r"'
	never_red "a new self-test case never seen red is refused"
fi
if new_strand h_prefix; then
	sh_case '  FAIL a broken input is refused twice' 'check "a broken input is refused" "$r"'
	never_red "a self-test case is not seen red through a longer case name"
fi
if new_strand h_line_start; then
	sh_case '  ok   FAIL a broken input is refused' 'check "a broken input is refused" "$r"'
	never_red "a self-test FAIL line counts only at the start of its line"
fi
