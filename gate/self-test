# A git on PATH that fails the calls a pattern matches, so a case proves a failed read is a
# refusal, not an empty answer.
git_failing_on() {
	shim="$work/git-$case_name"
	step mkdir -p "$shim"
	printf '#!/bin/sh\ncase " $* " in *%s*) printf "git shim: refused %%s\\n" "$*" >&2; exit 128 ;; esac\nexec "%s" "$@"\n' \
		"$1" "$(real_tool git)" > "$shim/git"
	step chmod +x "$shim/git"
}

run_shimmed() {
	PATH="$shim:$PATH" "$checker" "$@" "$repo" strand > "$work/out" 2>&1
}

shim_refuses_for() {
	class=$1
	shift
	if run_shimmed "$@"; then return 1; fi
	grep -q "^refused \[$class\]" "$work/out"
}

