#!/bin/sh
set -eu

usage() {
	printf 'usage: verify format|focus <path>|bdd|all|outdated|vuln|stop\n' >&2
	exit 2
}

[ $# -ge 1 ] || usage
cmd=$1
shift

target=""
if [ "$cmd" = focus ]; then
	[ $# -eq 1 ] || usage
	case "$1" in
		/*) target=$1 ;;
		*) target=$PWD/$1 ;;
	esac
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
target=${target#"$root"/}

GRADLE_OPTS="${GRADLE_OPTS:+$GRADLE_OPTS }-Dorg.gradle.daemon.registry.base=\"$root/registry.local.d\""
export GRADLE_OPTS

run_in() {
	dir=$1
	shift
	( cd "$dir" && "$@" ) || exit 1
}

run() {
	run_in "$root" "$@"
}

require() {
	case "$1" in
		*/*) if [ -f "$1" ] && [ -x "$1" ]; then return 0; fi ;;
		*) if command -v "$1" >/dev/null 2>&1; then return 0; fi ;;
	esac
	printf '[verify] required tool not available: %s\n' "$1" >&2
	exit 1
}

report() {
	status=0
	"$@" || status=$?
	if [ "$status" -eq 0 ]; then
		return 0
	fi
	if [ "$status" -ge 126 ]; then
		printf '[verify] %s could not be executed (exit %s)\n' "$1" "$status" >&2
		exit 1
	fi
	printf '[verify] %s reported findings (exit %s)\n' "$1" "$status"
}

build_lock=/tmp/epc-build.lock

fd_holds_build_lock() {
	[ "/proc/$$/fd/$1" -ef "$build_lock" ] && grep -q '^lock:.*FLOCK' "/proc/$$/fdinfo/$1" 2>/dev/null
}

hold_build_lock() {
	require flock
	for fd in /proc/$$/fd/*; do
		if fd_holds_build_lock "${fd##*/}"; then
			return 0
		fi
	done
	while :; do
		[ -e "$build_lock" ] || touch "$build_lock" 2>/dev/null || true
		if ! (exec 9<"$build_lock") 2>/dev/null; then
			printf '[verify] cannot read %s, the machine-wide build lock; its owner can make it readable\n' "$build_lock" >&2
			exit 1
		fi
		exec 9<"$build_lock"
		if ! flock -n 9; then
			printf '[verify] waiting for %s: another build on this machine holds it\n' "$build_lock" >&2
			flock 9
		fi
		if [ "/proc/$$/fd/9" -ef "$build_lock" ]; then
			return 0
		fi
	done
}

every_tag='@wip or not @wip'
acceptance_suite='*RunAcceptanceScenariosTest'
frontend=frontend

case "$cmd" in
	format|focus|bdd|all|outdated|vuln|stop) ;;
	*) usage ;;
esac

require ./gradlew

case "$cmd" in
	format)
		run ./gradlew --quiet --console=plain spotlessCheck checkstyleMain checkstyleTest
		;;
	focus)
		case "$target" in
			"$frontend"/*)
				require npm
				hold_build_lock
				run_in "$frontend" npm test -- "${target#"$frontend"/}"
				;;
			src/test/resources/features/*.feature)
				hold_build_lock
				run ./gradlew test --no-build-cache --console=plain --tests "$acceptance_suite" \
					-Dcucumber.features="$target" -Dcucumber.filter.tags="$every_tag"
				;;
			src/main/*|src/test/*)
				hold_build_lock
				run ./gradlew test --no-build-cache --console=plain \
					--tests "$(basename "$target" .java)"
				;;
			*)
				printf '[verify] %s belongs to no stack; known roots: %s, src/main, src/test\n' \
					"$target" "$frontend" >&2
				exit 2
				;;
		esac
		;;
	bdd)
		hold_build_lock
		run ./gradlew test --no-build-cache --console=plain --tests "$acceptance_suite" \
			-Dcucumber.filter.tags='@wip'
		;;
	all)
		hold_build_lock
		run ./gradlew clean build --no-build-cache --console=plain
		results=$(mktemp)
		trap 'rm -f "$results"' EXIT
		if ! find . -type d \
				\( -name .git -o -name .claude -o -name .template -o -name node_modules \) -prune \
				-o -path '*/build/test-results/*' -name 'TEST-*.xml' -print > "$results"; then
			printf '[verify] the test results could not be collected\n' >&2
			exit 1
		fi
		printf '[verify] executed test classes: %s\n' "$(wc -l < "$results" | tr -d ' ')"
		;;
	outdated)
		printf '[verify] required tool not available: a Gradle dependency-freshness task; Dependabot (.github/dependabot.yml) reports freshness for every ecosystem of this project\n' >&2
		exit 1
		;;
	vuln)
		hold_build_lock
		report ./gradlew --console=plain vulnScan
		;;
	stop)
		run ./gradlew --stop
		;;
esac

exit 0
