#!/usr/bin/env python3
# The shell-shape guard: a PreToolUse hook that refuses command shapes of the Bash and Monitor
# tools which hide what runs or run unprompted outside the permission rules, and approves a few
# exact shapes of the Bash tool alone: the fold and the checkout of an agent worktree. Refusals
# are a shape aid, not a security boundary; approvals are a strict, fail-closed boundary. Since
# no agent pushes, it refuses a git command whose subcommand is push, send-pack, http-push, or
# subtree with a later word push, behind every global option it reads past, the programs
# git-push, git-send-pack and git-http-push, and the program git-subtree with a word push; a
# spelling it cannot read meets the permission rules. It compares Linux paths only: a path in any
# other form (a drive letter, a backslash) is never approved and falls to the permission rules.
# It needs python3 3.9 or newer, started with -I, so PYTHONPATH and the folder of this file shadow
# no module it imports. Run with --state, it prints "active", "inactive: <reason>" or
# "misconfigured: <reason>" for the session-start report instead; run with --root, it prints the
# worktree root in use, escaped as in a JSON string, and where it ignores a set AGENT_WORKTREES, a
# second line "AGENT_WORKTREES ignored: <reason>". Before --state says active, it checks that
# APPROVALS names only approvals it knows and that the worktree root does not hold the project
# directory, and runs four canned calls through the hook's code, a switch in the primary checkout
# and a git output into /etc or into the project it must refuse and a git status it must pass, so
# a value of the ADAPT block that makes it raise or answer wrongly reads misconfigured, the error
# escaped as in a JSON string. The hook runs the same check before it approves and approves
# nothing where it fails; it still refuses, except a call on which a value makes it raise, which
# goes on to the permission rules. A checkout, restore or switch whose -C path git cannot resolve
# when the hook runs, a folder the same command makes among them, is refused: the guard cannot
# tell it from the primary checkout.
# MODULE agent-seat
# With the agent-seat module it also approves agent/push and agent/gh, and its push refusal names
# agent/push as the seat's one way to push. Of agent/gh it approves only the words agent/gh
# admits: the same options, values and selectors. A body file of agent/gh must lie in the output
# directory as written and as resolved when the guard reads it; a link made after that is not
# seen.
# /MODULE agent-seat
import contextlib
import functools
import getpass
import json
import os
import posixpath
import re
import shlex
import subprocess
import sys

# > **ADAPT:** the guard's values; /adopt sets ENVIRONMENT from the environment answer only.
# > OUTPUT_DIRECTORY: where a command that names git may write; <uid> becomes the user id, or the
# > user name where the system has no user id. WORKTREE_ROOT: the worktree root where
# > AGENT_WORKTREES names none, under the project directory or an absolute path; the guard takes
# > AGENT_WORKTREES where it is an absolute path in canonical form (no . or .. segment, no //, no
# > backslash), is not /, and neither it nor its resolved path lies in or contains the project
# > directory, as written or resolved. APPROVALS: the approvals switched on, each on its own:
# > `fold` and `checkout`, and with the agent-seat module `push` and `gh`. ENVIRONMENT:
# > devcontainer, native (active only where the project pins python in .tool-versions) or
# > inactive. GUIDE_FILE and GUIDE_HEADING: where the knowledge base explains the shapes; each
# > refusal names them.
OUTPUT_DIRECTORY = "/tmp/claude-<uid>"
WORKTREE_ROOT = ".claude/worktrees"
APPROVALS = "fold checkout push gh"
ENVIRONMENT = "devcontainer"
GUIDE_FILE = "working-with-ai-agents.md"
GUIDE_HEADING = "Command shapes that keep a session unattended"

MAX_COMMAND = 16384
MAX_APPROVED = 4096
ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?\+?=")
HEREDOC = re.compile(r"<<[ \t]*\S")
COMMENT = re.compile(r"#[^\n]*")
REDIRECT = re.compile(r"(\{[A-Za-z_]\w*\}|[0-9]*|&)[<>]+[&|]?")
OPERATOR_START = re.compile(r"(\{[A-Za-z_]\w*\}|[0-9]*|&)[<>]*")
HASH = re.compile(r"[0-9a-f]{7,64}")
FORCED_BRANCH = re.compile(r"--forc|-\w*[DfMC]")
FORCED_MOVES = {"checkout": ("B", "bBt", ("--ignore-other-worktrees",)),
                "switch": ("C", "cCt", ("--force-create", "--ignore-other-worktrees")),
                "worktree add": ("B", "bB", ())}
SHORTEST_ABBREVIATION = {"--force-create": "--force-", "--ignore-other-worktrees": "--i"}
WORKTREE_ADD_FLAGS = {"--force": "f", "--detach": "d"}
KNOWN_APPROVALS = {"fold", "checkout"}
EXEC = re.compile(r"--ex|-\w*x")
OUTPUT = re.compile(r"--output(=|$)")
MOVES_REPOSITORY = re.compile(r"GIT_(DIR|WORK_TREE|COMMON_DIR|NAMESPACE|OBJECT_DIRECTORY|ALTERNATE_OBJECT_DIRECTORIES"
                              r"|CONFIG\w*)\+?=")
VALUED_OPTIONS = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env", "--super-prefix",
                  "--attr-source", "--shallow-file"}
KEYWORDS = {"{", "!", "if", "then", "elif", "else", "while", "until", "do"}
RESERVED = KEYWORDS | {"time", "function", "coproc"}
COMPOUND = {"{", "if", "while", "until", "for", "select", "case"}
SETTERS = {"export", "declare", "readonly", "local", "typeset", "read", "for", "select", "let", "mapfile",
           "readarray", "getopts"}
ENV_OPTIONS = {"-i": "flag", "-0": "flag", "-v": "flag", "-u": "value", "-C": "moves", "-S": "split", "-": "flag",
               "--ignore-environment": "flag", "--null": "flag", "--debug": "flag", "--unset": "value",
               "--chdir": "moves", "--split-string": "split", "--list-signal-handling": "flag",
               "--block-signal": "flag", "--default-signal": "flag", "--ignore-signal": "flag", "--help": "idle",
               "--version": "idle"}
COMMAND_OPTIONS = {"-p": "flag", "-v": "idle", "-V": "idle"}
TIME_OPTIONS = {"-a": "flag", "-p": "flag", "-q": "flag", "-v": "flag", "-f": "value", "-o": "value", "-V": "idle",
                "--append": "flag", "--portability": "flag", "--quiet": "flag", "--verbose": "flag",
                "--format": "value", "--output": "value", "--version": "idle", "--help": "idle"}
EXEC_OPTIONS = {"-a": "value", "-c": "flag", "-l": "flag"}
NOHUP_OPTIONS = {"--help": "idle", "--version": "idle"}
TIMEOUT_OPTIONS = {"-k": "value", "-s": "value", "-v": "flag", "-f": "flag", "-p": "flag", "--kill-after": "value",
                   "--signal": "value", "--verbose": "flag", "--foreground": "flag", "--preserve-status": "flag",
                   "--help": "idle", "--version": "idle", "<duration>": "operand"}
NICE_OPTIONS = {"-n": "value", "--adjustment": "value", "--help": "idle", "--version": "idle",
                "<adjustment>": "operand"}
NICE_ADJUSTMENT = re.compile(r"-[-+]?[0-9]+")
STDBUF_OPTIONS = {"-i": "value", "-o": "value", "-e": "value", "--input": "value", "--output": "value",
                  "--error": "value", "--help": "idle", "--version": "idle"}
SETSID_OPTIONS = {"-c": "flag", "-f": "flag", "-w": "flag", "--ctty": "flag", "--fork": "flag", "--wait": "flag",
                  "--help": "idle", "--version": "idle"}
WRAPPERS = {"env": ENV_OPTIONS, "command": COMMAND_OPTIONS, "builtin": {}, "eval": {}, "time": TIME_OPTIONS,
            "exec": EXEC_OPTIONS, "nohup": NOHUP_OPTIONS, "timeout": TIMEOUT_OPTIONS, "nice": NICE_OPTIONS,
            "stdbuf": STDBUF_OPTIONS, "setsid": SETSID_OPTIONS}
VALUED = {"value", "moves", "split"}
SEPARATORS = ";&|\n()"
WORD_BOUNDARY = ("", " ", "\t", "\n", ";", "&", "|", "(", ")")
EVALUATION = ("the command evaluates text as code ($(…), a backtick, ${…}, $((…)), $[…], ((…)), [[…]], or "
              "test or [ with -v or -R), which hides what runs; compute the value in a step of its own and write "
              "it literally")
PLAIN = re.compile(r"""([A-Za-z0-9._/,-]|'[^']*'|"[^"$`\\]*"| )*""")
PLAIN_CHARACTER = "[A-Za-z0-9._/,=%~^@:+-]"
PLAIN_PIECE = PLAIN_CHARACTER + r"|'[^']*'|" + r'"[^"$`\\]*"'
WORD_END = r"(?=[ \t;&|\n]|$)"
REDIRECT_START = r"(?<![^ \t;&|\n])"
GUIDE = f'{GUIDE_FILE}, "{GUIDE_HEADING}"'
READ_TOOLS = {"Bash", "Monitor"}
APPROVED_TOOL = "Bash"
PUSH_SUBCOMMANDS = {"push", "send-pack", "http-push"}
PUSH_ROUTE = ""
REACHING_OPTIONS = ("--git-dir", "--work-tree")
# MODULE agent-seat
PUSH_PREFIX = re.compile(r"branch_prefix='([A-Za-z0-9._/-]*)'")
PUSHED_BRANCH = re.compile(r"[A-Za-z0-9._/-]+")
PUSH_ROUTE = "; on the agent seat a push runs only through agent/push"
GH_PR = {"create", "edit", "view", "list", "diff", "checks", "comment"}
GH_UNSELECTED = {"create", "list"}
GH_VALUED = {"--base", "--head", "--title", "--json", "--body-file"}
GH_BRANCH = re.compile(r"(?!-)(?!.*\.\.)[A-Za-z0-9._/-]+")
GH_FIELDS = re.compile(r"[A-Za-z]+(,[A-Za-z]+)*")
GH_NUMBER = re.compile(r"#[0-9]+")
