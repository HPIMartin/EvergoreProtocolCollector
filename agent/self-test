# A repository whose origin is a bare repository of its own under the work directory, with a
# linked worktree on claude/t one commit ahead of main. The second argument leaves the remote out
# (no-origin) or adds it without a fetch (unfetched).
new_push_repo() {
	bare="$work/push-$1.git"
	main="$work/push-$1-main"
	repo="$work/push-$1"
	git init -q --bare -b main "$bare"
	git init -q -b main "$main"
	git -C "$main" config user.name t
	git -C "$main" config user.email t@example.test
	commit_file "$main" a.txt 1 A
	case "${2:-fetched}" in
		no-origin) ;;
		unfetched) git -C "$main" remote add origin "$bare" ;;
		fetched)
			git -C "$main" remote add origin "$bare"
			git -C "$main" push -q origin refs/heads/main:refs/heads/main
			;;
	esac
	git -C "$main" worktree add -q -b claude/t "$repo" HEAD
	commit_file "$repo" b.txt 2 D
	mkdir -p "$main/agent"
	cp "$push" "$main/agent/push"
	remote_before=$(git -C "$bare" for-each-ref)
}

