#!/bin/sh
# Proves the agent tools: agent/fold and, with the guard module, agent/bash-shape-guard and
# agent/session-check. Every case builds its own throwaway repository or payload and asserts one
# verdict; the cases run copies of the tools whose ADAPT blocks take the values of the fixtures
# below, so they hold under every value /adopt may set. Needs sh, git and mktemp; refuses with
# exit 2 and a named message where one is missing, so a host without them runs no case and says why.
# MODULE guard
# The guard cases also need timeout and python3 3.9 or newer with the modules the guard imports,
# with the same refusal.
# /MODULE guard
# MODULE agent-seat
# With the agent-seat module it proves agent/push too, each case against a bare repository of its
# own as origin, with the guard's push approval and the report on the agent seat; and
# agent/github-token and agent/gh against a throwaway key and stubs of curl and gh, so no case
# reaches GitHub, with the guard's gh approval. These cases also need jq and openssl, with the same
# refusal.
# /MODULE agent-seat
set -eu

for tool in git mktemp; do
	command -v "$tool" > /dev/null 2>&1 || {
		printf 'agent self-test: no %s on PATH; the agent tools need sh, git and mktemp, so no case ran\n' "$tool" >&2
		exit 2
	}
done
# MODULE guard
command -v timeout > /dev/null 2>&1 || {
	printf 'agent self-test: no timeout on PATH; the guard cases need it, so no case ran\n' >&2
	exit 2
}
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' > /dev/null 2>&1 || {
	printf 'agent self-test: no python3 3.9 or newer runs here; the guard needs it, so no case ran\n' >&2
	exit 2
}
# agent/session-check's module_reason holds the same import-line reader; change both together.
lacking=$(python3 -I -c 'import os, sys
for line in open(os.path.join(os.path.dirname(sys.argv[1]), "bash-shape-guard"), "rb"):
	if line.startswith(b"import "):
		name = line.split()[1].decode()
		try:
			__import__(name)
		except Exception:
			print(name)
			break' "$0" 2> /dev/null) || lacking=
[ -z "$lacking" ] || {
	printf 'agent self-test: python3 lacks its standard library (no module %s); the guard needs it, so no case ran\n' "$lacking" >&2
	exit 2
}
# /MODULE guard
# MODULE agent-seat
for tool in jq openssl; do
	command -v "$tool" > /dev/null 2>&1 || {
		printf 'agent self-test: no %s on PATH; the agent-seat cases need jq and openssl, so no case ran\n' "$tool" >&2
		exit 2
	}
done
# /MODULE agent-seat

agent_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# git exports GIT_DIR, GIT_INDEX_FILE and friends to the hook that runs this test, so a throwaway
# repo below would otherwise operate on the repo whose commit is being gated.
for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done
# The user's and the system's git configuration would reach every throwaway repository below (a
# signing rule, a hook path, an alias); each case sets what it needs itself.
GIT_CONFIG_GLOBAL=/dev/null
GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failures=0

# A FAIL line carries its diagnosis: the status of the last run and the first lines of the
# standard error a case wrote last.
check() {
	if [ "$2" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s\n' "$1"
		printf '       status %s\n' "${status:-none}"
		latest=$(ls -t "$work"/*-err "${stub:-$work/no-stub}/err" 2> /dev/null | head -n 1)
		if [ -s "$latest" ]; then
			printf '       standard error, %s:\n' "${latest#"$work"/}"
			sed -n '1,5s/^/         /p' "$latest"
		fi
		failures=$((failures + 1))
	fi
}

fold_live="$agent_dir/fold"
fold="$work/fold-copy/fold"
mkdir -p "$work/fold-copy"
sed "s#^branch_prefix=.*#branch_prefix='claude/'#" "$fold_live" > "$fold"

commit_file() {
	printf '%s\n' "$3" > "$1/$2"
	git -C "$1" add "$2"
	git -C "$1" commit -q -m "$4"
}

new_fold_repo() {
	main="$work/fold-$1-main"
	repo="$work/fold-$1"
	git init -q ${2:-} -b main "$main"
	git -C "$main" config user.name t
	git -C "$main" config user.email t@example.test
	commit_file "$main" a.txt 1 A
	git -C "$main" worktree add -q -b claude/t "$repo" HEAD
	commit_file "$repo" b.txt 1 B
	commit_file "$repo" c.txt 1 C
	target=$(git -C "$repo" rev-parse HEAD~1)
	commit_file "$repo" b.txt 2 D
	fix_tree=$(git -C "$repo" rev-parse 'HEAD^{tree}')
	before=$(git -C "$repo" rev-parse HEAD)
}

run_fold() {
	set +e
	sh "${fold_script:-$fold}" "$repo" "$1" > "$work/fold-out" 2> "$work/fold-err"
	status=$?
	set -e
}

expect_folded() {
	r=0
	[ "$status" -eq 0 ] && [ "$(git -C "$repo" log --format=%s | tr '\n' ' ')" = 'C B A ' ] \
		&& [ "$(git -C "$repo" show HEAD~1:b.txt)" = 2 ] && [ "$(git -C "$repo" rev-parse 'HEAD^{tree}')" = "$fix_tree" ] || r=1
	check "$1" "$r"
}

expect_fold_refused() {
	r=0
	[ "$status" -eq 2 ] && grep -q '^fold: ' "$work/fold-err" && [ "$(wc -l < "$work/fold-err")" -eq 1 ] \
		&& [ "$(git -C "$repo" rev-parse HEAD)" = "$before" ] || r=1
	check "$1" "$r"
}

new_fold_repo folds
run_fold "$target"
expect_folded 'agent/fold folds the fix into its target and keeps the target message'

new_fold_repo after-target
run_fold "$target"
r=0
[ "$status" -eq 0 ] && [ "$(git -C "$repo" diff --name-only HEAD~1 HEAD)" = c.txt ] || r=1
check 'agent/fold leaves the commits after the target as they were' "$r"

new_fold_repo detached
git -C "$repo" switch -q --detach
run_fold "$target"
expect_folded 'agent/fold folds on a detached head'
r=0
! grep -q 'fatal' "$work/fold-err" || r=1
check 'agent/fold folds on a detached head without a fatal line' "$r"

new_fold_repo abbreviated
git -C "$repo" config rebase.abbreviateCommands true
run_fold "$target"
expect_folded 'agent/fold folds whatever rebase.abbreviateCommands says'

new_fold_repo tagged
git -C "$repo" tag -a -m owner owner "$target"
run_fold owner
expect_folded 'agent/fold folds onto an annotated tag of the owning commit'

new_fold_repo relative
set +e
(cd "$work/fold-copy" && sh ./fold "$repo" "$target") > "$work/fold-out" 2> "$work/fold-err"
status=$?
set -e
expect_folded 'agent/fold folds when called by a relative path'

new_fold_repo untracked
printf 'x\n' > "$repo/scratch.txt"
run_fold "$target"
expect_folded 'agent/fold folds beside an untracked file'

new_fold_repo update-refs
git -C "$repo" config rebase.updateRefs true
git -C "$repo" branch other "$target"
run_fold "$target"
r=0
[ "$status" -eq 0 ] && [ "$(git -C "$repo" rev-parse other)" = "$target" ] || r=1
check 'agent/fold moves no other branch, whatever rebase.updateRefs says' "$r"

new_fold_repo sha256 --object-format=sha256
run_fold "$target"
expect_folded 'agent/fold folds in a repository of SHA-256 commits'

new_fold_repo quoted-path
mkdir -p "$work/it's/agent"
if [ -f "$fold" ]; then cp "$fold" "$work/it's/agent/fold"; fi
fold_script="$work/it's/agent/fold"
run_fold "$target"
fold_script=
expect_folded 'agent/fold folds from a path that holds a quote'

new_fold_repo dirty
printf 'x\n' >> "$repo/a.txt"
run_fold "$target"
expect_fold_refused 'agent/fold refuses a worktree with uncommitted changes'

new_fold_repo itself
run_fold HEAD
expect_fold_refused 'agent/fold refuses the fix as its own target'

new_fold_repo root
run_fold "$(git -C "$repo" rev-list --max-parents=0 HEAD)"
expect_fold_refused 'agent/fold refuses a root commit as the target'

new_fold_repo unknown
run_fold no-such-commit
expect_fold_refused 'agent/fold refuses a name that is no commit'

new_fold_repo foreign
git -C "$main" switch -q -c side
commit_file "$main" e.txt 1 E
run_fold "$(git -C "$main" rev-parse HEAD)"
expect_fold_refused 'agent/fold refuses a target that is not an ancestor of the fix'

new_fold_repo merge
git -C "$repo" switch -q -c side HEAD~1
commit_file "$repo" e.txt 1 E
git -C "$repo" switch -q claude/t
git -C "$repo" merge -q --no-edit side
before=$(git -C "$repo" rev-parse HEAD)
run_fold "$target"
expect_fold_refused 'agent/fold refuses a range that holds a merge'

new_fold_repo primary
repo=$main
git -C "$repo" switch -q -c claude/p
commit_file "$repo" b.txt 1 B
commit_file "$repo" c.txt 1 C
target=$(git -C "$repo" rev-parse HEAD~1)
commit_file "$repo" b.txt 2 D
before=$(git -C "$repo" rev-parse HEAD)
run_fold "$target"
expect_fold_refused 'agent/fold refuses the primary checkout of a repository'

new_fold_repo landed
git -C "$main" merge -q --ff-only "$target"
run_fold "$target"
expect_fold_refused 'agent/fold refuses a target main already holds'
r=0
[ "$(cat "$work/fold-err")" = 'fold: the target is on main, and a fold would rewrite a landed commit; keep the fix as a commit of its own' ] || r=1
check 'agent/fold names main where the target is landed' "$r"

new_fold_repo fetched
git -C "$main" update-ref refs/remotes/origin/main "$target"
run_fold "$target"
expect_fold_refused 'agent/fold refuses a target origin/main already holds'

new_fold_repo conflict
commit_file "$repo" b.txt 3 F
run_fold "$target"
r=0
[ "$status" -ne 0 ] && [ -d "$(git -C "$repo" rev-parse --path-format=absolute --git-path rebase-merge)" ] || r=1
check 'agent/fold stops where the fix conflicts with a commit after its target' "$r"
before=$(git -C "$repo" rev-parse HEAD)
run_fold "$target"
expect_fold_refused 'agent/fold refuses a worktree in the middle of a rebase'
r=0
[ "$(cat "$work/fold-err")" = "fold: a rebase is in progress; resolve the conflict, git -C $repo add the files, then GIT_EDITOR=true git -C $repo rebase --continue" ] || r=1
check 'agent/fold names the way on in the middle of a rebase' "$r"

new_fold_repo applying
mkdir -p "$(git -C "$repo" rev-parse --path-format=absolute --git-path rebase-apply)"
: > "$(git -C "$repo" rev-parse --path-format=absolute --git-path rebase-apply/applying)"
run_fold "$target"
expect_fold_refused 'agent/fold refuses a worktree in the middle of a git am'
r=0
[ "$(cat "$work/fold-err")" = "fold: a git am is in progress; finish it with git -C $repo am --continue or --abort first" ] || r=1
check 'agent/fold names the way on in the middle of a git am, not the rebase one' "$r"

new_fold_repo foreign-branch
git -C "$repo" switch -q -c topic
run_fold "$target"
expect_fold_refused 'agent/fold refuses a branch that is no claude/ branch'

new_fold_repo claudex
git -C "$repo" switch -q -c claudex
run_fold "$target"
expect_fold_refused 'agent/fold refuses a branch named like claude without its slash'

new_fold_repo no-repo
repo="$work/no-repo"
mkdir -p "$repo"
before=
set +e
sh "$fold" "$repo" "$target" > "$work/fold-out" 2> "$work/fold-err"
status=$?
set -e
r=0
[ "$status" -eq 2 ] && [ "$(cat "$work/fold-err")" = "fold: $repo is no git worktree" ] && [ ! -s "$work/fold-out" ] || r=1
check 'agent/fold refuses a path that is no git worktree' "$r"

new_fold_repo one-argument
set +e
sh "$fold" "$repo" > "$work/fold-out" 2> "$work/fold-err"
status=$?
set -e
expect_fold_refused 'agent/fold refuses a call without its target'

new_fold_repo three-arguments
set +e
sh "$fold" "$repo" "$target" x > "$work/fold-out" 2> "$work/fold-err"
status=$?
set -e
expect_fold_refused 'agent/fold refuses a third argument'

new_fold_repo unborn
repo="$work/fold-unborn-orphan"
git -C "$main" worktree add -q --orphan -b claude/e "$repo"
target=$(git -C "$main" rev-parse HEAD)
before=
run_fold "$target"
r=0
[ "$status" -eq 2 ] && [ "$(cat "$work/fold-err")" = 'fold: the worktree has no commit' ] || r=1
check 'agent/fold refuses a worktree without a commit' "$r"

printf 'pick 1 A\n' > "$work/todo"
set +e
env -u FOLD_HEAD -u FOLD_TARGET sh "$fold" --edit-todo "$work/todo" > /dev/null 2>&1
status=$?
set -e
r=0
[ "$status" -ne 0 ] && [ "$(cat "$work/todo")" = 'pick 1 A' ] || r=1
check 'agent/fold edits no todo without the commits it moves' "$r"

fold_bot="$work/fold-bot"
sed "s#^branch_prefix=.*#branch_prefix='bot/'#" "$fold" > "$fold_bot"
new_fold_repo prefix-refused
fold_script=$fold_bot
run_fold "$target"
fold_script=
expect_fold_refused 'agent/fold refuses a branch outside the prefix its block names'
r=0
[ "$(cat "$work/fold-err")" = "fold: the branch 'claude/t' is no bot/ branch" ] || r=1
check 'agent/fold names the prefix its block holds' "$r"
new_fold_repo prefix-folds
git -C "$repo" switch -q -c bot/t
fold_script=$fold_bot
run_fold "$target"
fold_script=
expect_folded 'agent/fold folds on a branch under the prefix its block names'

# MODULE agent-seat
# The agent seat's own environment (AGENT_SEAT) would put the seat's lines into every report below
# and let a push case run as the seat unasked; the cases that need it name it themselves.
unset AGENT_SEAT
# /MODULE agent-seat
# MODULE guard
# A worktree root the environment names (AGENT_WORKTREES) would move the guard's root under every
# case below; the cases that need one name it themselves.
unset AGENT_WORKTREES
guard_live="$agent_dir/bash-shape-guard"
guard="$work/guard/bash-shape-guard"
guard_project=/work/proj
mkdir -p "$work/guard"

cat > "$work/fixture-values" <<'VALUES'
OUTPUT_DIRECTORY = "/tmp/claude-<uid>"
WORKTREE_ROOT = ".claude/worktrees"
APPROVALS = "fold checkout"
ENVIRONMENT = "devcontainer"
GUIDE_FILE = "working-with-ai-agents.md"
GUIDE_HEADING = "Command shapes that keep an auto-mode session unattended"
VALUES

# A copy of the live guard at the first path whose ADAPT block takes the assignments of the given
# values files in place of its own; the cases are written against the fixture values, which an
# adopted project's block may differ from.
splice_values() {
	target=$1
	shift
	mkdir -p "${target%/*}"
	cat "$@" > "$work/values"
	awk '
		FILENAME == ARGV[1] { key = $0; sub(/ = .*/, "", key); line[key] = $0; next }
		{ key = $0; sub(/ = .*/, "", key) }
		$0 ~ /^[A-Z_]+ = / && (key in line) && !(key in done) { print line[key]; done[key] = 1; next }
		{ print }
	' "$work/values" "$guard_live" > "$target"
}
use_values() {
	splice_values "$guard" "$@"
}
use_values "$work/fixture-values"

guard_launch='python3 -I'
guard_env=

run_guard() {
	set +e
	printf '%s' "$1" | env CLAUDE_PROJECT_DIR=$guard_project $guard_env timeout 20 $guard_launch "$guard" > "$work/guard-out" 2> "$work/guard-err"
	status=$?
	set -e
}

tool_payload() {
	python3 -c 'import json, sys; print(json.dumps({"tool_name": sys.argv[1], "tool_input": {"command": sys.argv[2]}}))' "$1" "$2"
}

bash_payload() {
	tool_payload Bash "$1"
}

approval_field() {
	python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["hookSpecificOutput"][sys.argv[2]])' "$work/guard-out" "$1" 2> /dev/null
}

expect_guard() {
	run_guard "$(bash_payload "$2")"
	r=0
	case "$1" in
		refused) [ "$status" -eq 2 ] && grep -q '^bash-shape-guard: ' "$work/guard-err" || r=1 ;;
		passed) [ "$status" -eq 0 ] && [ ! -s "$work/guard-err" ] && [ ! -s "$work/guard-out" ] || r=1 ;;
		approved) [ "$status" -eq 0 ] && [ ! -s "$work/guard-err" ] \
			&& [ "$(approval_field permissionDecision)" = allow ] \
			&& [ "$(approval_field hookEventName)" = PreToolUse ] \
			&& approval_field permissionDecisionReason | grep -q '^bash-shape-guard: ' || r=1 ;;
	esac
	check "$3" "$r"
}

expect_payload_passes() {
	run_guard "$1"
	r=0
	[ "$status" -eq 0 ] && [ ! -s "$work/guard-err" ] && [ ! -s "$work/guard-out" ] || r=1
	check "$2" "$r"
}

expect_payload_passes '{"tool_name":"Read","tool_input":{"file_path":"/x"}}' 'the guard lets every other tool pass'
expect_payload_passes '{"tool_name":"Bash","tool_input":{}}' 'the guard lets a call without a command pass'
expect_payload_passes '{"tool_name":"Bash","tool_input":{"command":7}}' 'the guard lets a command that is no text pass'
expect_payload_passes '["Bash"]' 'the guard lets a payload that is no object pass'
expect_payload_passes 'not json' 'the guard never blocks a call it cannot read'
expect_guard passed 'git status' 'the guard lets a plain command pass'

guide='(working-with-ai-agents.md, "Command shapes that keep an auto-mode session unattended").'
expect_guard_says() {
	run_guard "$(bash_payload "$1")"
	r=0
	[ "$status" -eq 2 ] && [ "$(cat "$work/guard-err")" = "bash-shape-guard: $2 $guide" ] || r=1
	check "$3" "$r"
}
expect_guard_says "$(printf 'cat <<EOF\nx\nEOF')" 'a heredoc carries a script or file body inside the command; write it with the Write tool into the scratchpad and run it by path' 'the guard names the heredoc rule and its guide'
expect_guard_says 'W=/x' "'W=/x' sets a shell variable for a later command, so that command matches no allow rule; write the literal value into it" 'the guard names the setter rule and its guide'
expect_guard_says 'ls | xargs cat' "xargs runs a command the permission rules cannot see, so it waits on the author; use 'find … -exec … {} +' or 'grep -r'" 'the guard names the xargs rule and its guide'
expect_guard_says 'git 2> >(cat) switch x' 'a process substitution hides the command around it; write to a file and read it' 'the guard names the process-substitution rule and its guide'
expect_guard_says 'git reset --hard' "'git reset' discards work and stays on the deny floor in every form; fold instead" 'the guard names the reset rule and its guide'
expect_guard_says 'git clean -fdx' "'git clean' discards work and stays on the deny floor in every form; fold instead" 'the guard names the clean rule and its guide'
expect_guard_says 'git branch -D x' 'a forced branch deletion or move rewrites a branch git would protect; delete with -d' 'the guard names the forced-branch rule and its guide'
expect_guard_says 'git -C /work/proj/.claude/worktrees/t -C /tmp/r log' "behind an agent worktree's -C, no other global option may follow; name one -C and the subcommand" 'the guard names the worktree -C rule and its guide'
expect_guard_says 'git switch x' "'git switch' runs only as 'git -C <absolute path of your own worktree> switch', never in the primary checkout other sessions share" 'the guard names the checkout rule and its guide'

expect_guard refused 'W=/x; ls $W' 'the guard refuses an assignment that stands before the command it feeds'
expect_guard refused 'W=/x && ls $W' 'the guard refuses an assignment joined to its command by &&'
expect_guard refused "$(printf 'W=/x\nls $W')" 'the guard refuses an assignment on a line of its own'
expect_guard refused 'ls /x || W=/y' 'the guard refuses an assignment behind ||'
expect_guard refused 'W=$(git rev-parse HEAD); git show $W' 'the guard refuses an assignment of a command substitution with spaces'
expect_guard refused 'W=`git rev-parse HEAD`; git show $W' 'the guard refuses an assignment of a backtick substitution with spaces'
expect_guard refused 'export W=/x; ls $W' 'the guard refuses an exported assignment'
expect_guard refused 'declare -x W=/x; ls $W' 'the guard refuses a declared assignment with an option'
expect_guard refused 'readonly W=/x' 'the guard refuses a read-only assignment'
expect_guard refused '(W=/x; ls $W)' 'the guard refuses an assignment that opens a subshell'
expect_guard refused '{ W=/x; ls $W; }' 'the guard refuses an assignment inside braces'
expect_guard refused 'if true; then W=/x; fi' 'the guard refuses an assignment behind then'
expect_guard refused '{ W=/x' 'the guard refuses an assignment behind an opening brace'
expect_guard refused '! W=/x' 'the guard refuses an assignment behind a negation'
expect_guard refused 'if W=/x' 'the guard refuses an assignment behind if'
expect_guard refused 'elif W=/x' 'the guard refuses an assignment behind elif'
expect_guard refused 'else W=/x' 'the guard refuses an assignment behind else'
expect_guard refused 'while W=/x' 'the guard refuses an assignment behind while'
expect_guard refused 'until W=/x' 'the guard refuses an assignment behind until'
expect_guard refused 'do W=/x' 'the guard refuses an assignment behind do'
expect_guard refused 'local W=/x' 'the guard refuses a local assignment'
expect_guard refused 'typeset W=/x' 'the guard refuses a typeset assignment'
expect_guard refused 'wa_2=/x; ls $wa_2' 'the guard refuses an assignment to a lowercase name with a digit'
expect_guard refused '_W=/x; ls $_W' 'the guard refuses an assignment to a name that opens with an underscore'
expect_guard passed 'env' 'the guard lets a bare env pass'
expect_guard refused 'read W < /tmp/f; ls $W' 'the guard refuses a variable read into the shell'
expect_guard refused 'for W in /x /y; do ls $W; done' 'the guard refuses a loop variable'
expect_guard refused 'W+=/x; ls $W' 'the guard refuses an appending assignment'
expect_guard refused 'printf -v W /x; ls $W' 'the guard refuses a variable printf writes'
expect_guard passed "printf '%s' x" 'the guard lets printf without -v pass'
expect_guard refused 'let W=1; ls $W' 'the guard refuses a variable let computes'
expect_guard refused 'mapfile W < /tmp/f; ls $W' 'the guard refuses an array mapfile reads'
expect_guard refused 'readarray W < /tmp/f; ls $W' 'the guard refuses an array readarray reads'
expect_guard refused 'IFS= read -r W < /tmp/f; ls $W' 'the guard refuses a read behind an environment prefix'
expect_guard refused 'command export W=/x' 'the guard refuses an export run through command'
expect_guard refused 'builtin declare W=/x' 'the guard refuses a declare run through builtin'
expect_guard refused 'eval W=/x' 'the guard refuses an assignment run through eval'
expect_guard refused 'time W=/x' 'the guard refuses an assignment behind time'
expect_guard refused 'select W in /x /y; do ls $W; done' 'the guard refuses a select variable'
expect_guard refused 'getopts a W' 'the guard refuses a variable getopts sets'
expect_guard passed 'GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git rebase -i main' 'the guard lets an environment prefix of a command pass'
expect_guard passed "python3 -c 'import os; x = 1; print(x)'" 'the guard ignores an assignment inside single quotes'
expect_guard passed 'git commit -m "Keep a; b=c apart"' 'the guard ignores an assignment inside double quotes'
expect_guard passed 'echo a=b' 'the guard lets an assignment-shaped argument pass'

expect_guard refused "$(printf "python3 - <<'PY'\nprint(1)\nPY")" 'the guard refuses a heredoc with a quoted delimiter'
expect_guard refused "$(printf 'cat > /tmp/f <<EOF\nx\nEOF')" 'the guard refuses a heredoc that writes a file'
expect_guard refused "$(printf 'cat <<-EOF\n\tx\nEOF')" 'the guard refuses a heredoc that strips tabs'
expect_guard refused "$(printf 'cat <<\\EOF\nx\nEOF')" 'the guard refuses a heredoc with a backslash-quoted delimiter'
expect_guard refused "$(printf 'cat <<1\nx\n1')" 'the guard refuses a heredoc with a digit delimiter'
expect_guard refused "$(printf 'cat << EOF\nx\nEOF')" 'the guard refuses a heredoc with a space before its delimiter'
expect_guard refused "$(printf 'cat <<\tEOF\nx\nEOF')" 'the guard refuses a heredoc with a tab before its delimiter'
expect_guard refused "$(printf 'cat << -EOF\nx\n-EOF')" 'the guard refuses a heredoc whose delimiter starts with a dash'
expect_guard refused "$(printf "cat <<'!'\nx\n!")" 'the guard refuses a heredoc with a punctuation delimiter'
expect_guard refused "$(printf 'git commit -m "$(cat <<%sEOF%s\nmsg\nEOF\n)"' "'" "'")" 'the guard refuses a heredoc inside a quoted command substitution'
