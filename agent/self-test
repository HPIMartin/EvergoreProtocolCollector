# A stand-in for curl that reaches no network: it records its arguments, the bearer header, the
# header file's directory and both modes, and answers from the case's files; with an interrupt
# file it sends TERM to the script that called it.
cat > "$seat_bin/curl" <<'STUB'
#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$STUB_DIR/argv"
url=
output=
expect=
for argument in "$@"; do
	case "$expect" in
		output) output=$argument; expect=; continue ;;
	esac
	case "$argument" in
		--output) expect=output ;;
		https://*) url=$argument ;;
		@*) file=${argument#@}
			if grep -q '^Authorization: Bearer ' "$file"; then
				sed -n 's/^Authorization: Bearer //p' "$file" >> "$STUB_DIR/jwts"
				dirname "$file" >> "$STUB_DIR/workdirs"
				stat -c %a "$file" >> "$STUB_DIR/modes"
				stat -c %a "$(dirname "$file")" >> "$STUB_DIR/dirmodes"
			else
				cat "$file" >> "$STUB_DIR/bodies"
				printf '\n' >> "$STUB_DIR/bodies"
			fi ;;
	esac
done
printf '%s\n' "$url" >> "$STUB_DIR/urls"
case "$url" in
	*/installation) answer=installation ;;
	*/access_tokens) answer=token ;;
	*) exit 22 ;;
esac
if [ -f "$STUB_DIR/interrupt" ]; then
	kill -TERM "$PPID"
	sleep 1
fi
if [ -f "$STUB_DIR/$answer.fail" ]; then
	printf 'curl: (22) The requested URL returned error: 401\n' >&2
	exit 22
fi
if [ -n "$output" ]; then cat "$STUB_DIR/$answer.json" > "$output"; else cat "$STUB_DIR/$answer.json"; fi
STUB
chmod +x "$seat_bin/curl"

