bash_payload() { jq -cn --arg command "$1" '{tool_name: "Bash", tool_input: {command: $command}}'; }

expect_guard() {
	run_guard "$(bash_payload "$2")"
	r=0
	case "$1" in
		refused) [ "$status" -eq 2 ] && grep -q '^bash-shape-guard: ' "$work/guard-err" || r=1 ;;
		passed) [ "$status" -eq 0 ] && [ ! -s "$work/guard-err" ] && [ ! -s "$work/guard-out" ] || r=1 ;;
		approved) [ "$status" -eq 0 ] && [ ! -s "$work/guard-err" ] \
			&& [ "$(jq -r .hookSpecificOutput.permissionDecision "$work/guard-out" 2>/dev/null)" = allow ] \
			&& [ "$(jq -r .hookSpecificOutput.hookEventName "$work/guard-out" 2>/dev/null)" = PreToolUse ] \
			&& jq -r .hookSpecificOutput.permissionDecisionReason "$work/guard-out" 2>/dev/null | grep -q '^bash-shape-guard: ' || r=1 ;;
	esac
	check "$3" "$r"
}

expect_payload_passes() {
	run_guard "$1"
	r=0
	[ "$status" -eq 0 ] && [ ! -s "$work/guard-err" ] && [ ! -s "$work/guard-out" ] || r=1
