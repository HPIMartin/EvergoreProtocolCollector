# A hook staged non-executable is skipped outright by git on POSIX, so the gate would not narrate,
# it would not run at all; core.fileMode=false on a Windows host hides that from every local check.
# Fix a finding here with: git update-index --chmod=+x hooks/<name>
tracked=$(git -C "$hooks_dir" ls-files -s -- "$hooks_dir" 2>/dev/null | grep -v '\.md$' || true)
if [ -z "$tracked" ]; then
	printf '  skip every tracked hook is staged executable: none tracked yet, so this proves nothing.\n'
	printf '       Stage them (git add hooks/) and re-run, or the first commit may record them 100644.\n'
else
	if printf '%s\n' "$tracked" | grep -qv '^100755 '; then r=1; else r=0; fi
	check "every tracked hook is staged executable (100755)" "$r"
fi

if [ "$outer_head" = "$(git -C "$hooks_dir" rev-parse HEAD 2>/dev/null || echo none)" ] \
	&& [ "$outer_branch" = "$(git -C "$hooks_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)" ]; then r=0; else r=1; fi
check "the cases left the surrounding repository's HEAD and branch untouched" "$r"

if [ "$failures" -eq 0 ]; then
	printf 'hook self-test: all cases pass\n'
else
	printf 'hook self-test: %s case(s) FAILED\n' "$failures" >&2
fi
exit "$failures"
