check "--reaches names every recorded commit the rev reaches, in record order" "$r"

# The author's release. The suite may run inside a Claude Code session, which exports CLAUDECODE,
# so every call but the one about that check runs with it unset.
release() {
	release_status=0
	(unset CLAUDECODE; sh "$hooks_dir/breach-release" "$@") >"$work/release-out" 2>"$work/printed" || release_status=$?
}

new_repo release
step git checkout -q -B main
record_tip Loud
onmain=$(git rev-parse HEAD)
step git checkout -q -b strand
clean_file Topic
step git add -A
step git commit -q --no-verify -m "Add topic class"
record_tip Noisy
stranded=$(git rev-parse HEAD)
step git checkout -q main
step cp "$repo/.git/gate-record" "$work/record-before"
release_status=0
CLAUDECODE=1 sh "$hooks_dir/breach-release" "$onmain" >"$work/release-out" 2>"$work/printed" || release_status=$?
if [ "$release_status" -eq 1 ] && printed "the author's act" && unchanged; then r=0; else r=1; fi
check "breach-release refuses where CLAUDECODE is set, as in a Claude Code session" "$r"
release "$stranded"
if [ "$release_status" -eq 1 ] && printed 'by a rewrite of that strand' && unchanged; then r=0; else r=1; fi
check "breach-release refuses a recorded commit only a strand reaches" "$r"
release "$(git rev-parse HEAD~1)"
if [ "$release_status" -eq 1 ] && printed 'is not recorded' && unchanged; then r=0; else r=1; fi
check "breach-release refuses a commit that is not recorded" "$r"
release
if [ "$release_status" -eq 1 ] && printed 'usage: hooks/breach-release' && unchanged; then r=0; else r=1; fi
check "breach-release refuses a call without a commit" "$r"
release "$(git rev-parse 'HEAD^{tree}')"
if [ "$release_status" -eq 1 ] && printed 'is not a commit' && unchanged; then r=0; else r=1; fi
check "breach-release refuses an argument that names a tree, saying it is not a commit" "$r"
release "$(git rev-parse HEAD:Seed1.java)"
if [ "$release_status" -eq 1 ] && printed 'is not a commit' && unchanged; then r=0; else r=1; fi
check "breach-release refuses an argument that names a blob, saying it is not a commit" "$r"
step git config user.name ''
release "$onmain"
if [ "$release_status" -eq 1 ] && printed 'user.name' && unchanged; then r=0; else r=1; fi
check "breach-release refuses where user.name is empty" "$r"
step git config user.name ' '
release "$onmain"
if [ "$release_status" -eq 1 ] && printed 'user.name' && unchanged; then r=0; else r=1; fi
check "breach-release refuses where user.name holds blanks alone" "$r"
step git config user.name Gate
release "$onmain"
if [ "$release_status" -eq 0 ] && grep -qx "$onmain" "$repo/.git/gate-record" \
	&& [ "$(grep -c "^released $onmain " "$repo/.git/gate-record")" -eq 1 ] \
	&& grep -qF "$onmain" "$work/release-out"; then r=0; else r=1; fi
check "breach-release appends one release line for a recorded commit main reaches and keeps the entry" "$r"
clean_file Next
if accepts "Add next class"; then r=0; else r=1; fi
check "the commit after the release is accepted" "$r"
step cp "$repo/.git/gate-record" "$work/record-before"
release "$onmain"
if [ "$release_status" -eq 1 ] && printed 'is already released' && unchanged; then r=0; else r=1; fi
check "breach-release refuses a recorded commit that is already released" "$r"
step printf '%s\n' "$onmain" >> "$repo/.git/gate-record"
clean_file Later
if accepts "Add later class"; then r=0; else r=1; fi
check "a released commit recorded once more stays released" "$r"

new_repo releaseunreadable
step mkdir "$repo/.git/gate-record"
release HEAD
if [ "$release_status" -eq 1 ] && printed 'cannot read the breach record' && printed 'gate-record'; then r=0; else r=1; fi
check "breach-release refuses where the record cannot be read, naming it" "$r"
step mkdir -p "$work/release-outside"
release_status=0
(unset CLAUDECODE; cd "$work/release-outside" && GIT_CEILING_DIRECTORIES=$work sh "$hooks_dir/breach-release" HEAD) \
	>"$work/release-out" 2>"$work/printed" || release_status=$?
if [ "$release_status" -eq 1 ] && printed 'is not inside a git work tree'; then r=0; else r=1; fi
check "breach-release refuses outside a work tree" "$r"

new_repo releasemalformed
step git checkout -q -B main
record_tip Loud
step printf '%s\n' "$(git rev-parse HEAD | cut -c 1-39)" >> "$repo/.git/gate-record"
step cp "$repo/.git/gate-record" "$work/record-before"
release "$(git rev-parse HEAD)"
if [ "$release_status" -eq 1 ] && printed 'breach-guard could not answer' && printed 'neither an entry nor a release' \
	&& unchanged; then r=0; else r=1; fi
check "breach-release refuses where the record holds a malformed line, giving breach-guard's answer" "$r"

# A release line names who released the commit and stays one line of the record.
release_named() {
	new_repo "$1"
	step git checkout -q -B main
	record_tip Loud
	step git config user.name "$2"
	step cp "$repo/.git/gate-record" "$work/record-before"
	release "$(git rev-parse HEAD)"
}

release_named releasenamenewline "$(printf 'The\nAuthor')"
if [ "$release_status" -eq 1 ] && printed 'line break' && unchanged; then r=0; else r=1; fi
check "breach-release refuses where user.name holds a newline" "$r"

release_named releasenamecr "$(printf 'The\rAuthor')"
if [ "$release_status" -eq 1 ] && printed 'line break' && unchanged; then r=0; else r=1; fi
check "breach-release refuses where user.name holds a CR" "$r"

# Every writer of the record puts a newline before its line as well as after it, so a line a writer
# cut short, or one the author saved without its final newline, stays alone on its line. Glued to
# the next append, a 24-digit stub and a 40-digit entry would pass as one 64-digit id, and an entry
# after a release line would become part of the release's name.
drop_final_newline() {
	if content=$(cat "$repo/.git/gate-record"); then
		printf '%s' "$content" > "$repo/.git/gate-record"
	else
		broken=1
	fi
}

ends_in_newline() { [ -z "$(tail -c 1 "$repo/.git/gate-record")" ]; }

released_without_newline() {
	step git checkout -q -B main
	record_tip Loud
	release "$(git rev-parse HEAD)"
	step [ "$release_status" -eq 0 ]
	drop_final_newline
}

new_repo appendstub
step printf '%s' "$(git rev-parse HEAD~2 | cut -c 1-24)" >> "$repo/.git/gate-record"
step git checkout -q -b donor
smelly_file Loud
step git add -A
step git commit -q --no-verify -m "Add loud class"
step git checkout -q -
git cherry-pick donor >/dev/null 2>&1 || true
clean_file Next
if refuses "Add next class" 'line 1 of' && printed 'neither an entry nor a release'; then r=0; else r=1; fi
check "a record line cut short to 24 digits stays malformed after a recorder's append, and refuses" "$r"

new_repo appendpick
released_without_newline
step git checkout -q -b donor
smelly_file Noisy
step git add -A
step git commit -q --no-verify -m "Add noisy class"
step git checkout -q main
git cherry-pick donor >/dev/null 2>&1 || true
picked=$(git rev-parse HEAD)
clean_file Next
if refuses "Add next class" "$picked" && ends_in_newline; then r=0; else r=1; fi
check "a cherry-pick recorded after a release line without its newline refuses, naming the pick" "$r"

# An amend runs post-rewrite once; record_tip's rebase runs it twice, and the second append would
# start on a line of its own whatever the first one did.
new_repo appendrewrite
