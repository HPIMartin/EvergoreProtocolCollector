check "a --no-ff merge whose format leg fails leaves no commit behind" "$r"

wrapper_file() {
	write_file CLAUDE.md '# Wrapper' '' "Based on agent-entry-template version: $2." '' \
		'## SHARED section (keep textually identical)' '' "$1" '' '## Tool mechanics' '' 'tool notes'
}

template_file() {
	write_file docs/knowledge-base/agent-entry-template.md '# Template' '' "**Template version: $2.**" '' \
		'## SHARED section (keep textually identical)' '' "$1" '' '## Adoption' '' 'adoption notes'
}

new_repo sharedmatch
wrapper_file 'the shared rule' 4
template_file 'the shared rule' 4
if accepts "Add the entry files"; then r=0; else r=1; fi
check "entry files carrying the same SHARED section commit" "$r"

new_repo shareddrift
