# The adoption commit copies a stack preset's verify to the root, ADAPT notes and all. The presets
# sit beside hooks/ in the template only; an adopted project has removed them.
new_repo stockverify
found=0
r=0
for preset in "$hooks_dir"/../stacks/*/verify; do
	[ -f "$preset" ] || continue
	found=1
	step cp "$preset" verify
	step git add verify
	"$hooks_dir/content-gate" --staged >/dev/null 2>&1 || r=1
done
if [ "$found" -eq 1 ]; then
	check "every stack preset's verify, staged as the adoption commit stages it, passes the content gate" "$r"
else
	printf '  skip the stack presets pass the content gate: no stacks/ beside hooks/, as in an adopted project.\n'
fi

