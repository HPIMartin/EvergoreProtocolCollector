# Every writer checks its append: where it fails, it says the commit is NOT recorded, naming the
# record, instead of dying on the shell's own error. A record that is a directory refuses the append
# to root too.
new_repo unrecordedpick
step mkdir "$repo/.git/gate-record"
step git checkout -q -b donor
smelly_file Loud
step git add -A
step git commit -q --no-verify -m "Add loud class"
step git checkout -q -
git cherry-pick donor >/dev/null 2>"$work/printed" || true
picked=$(git rev-parse HEAD)
if [ "$(git log -1 --format=%s)" = "Add loud class" ] && printed "[post-commit] $picked is NOT recorded" \
	&& printed '.git/gate-record' && ! printed 'Is a directory'; then r=0; else r=1; fi
check "a cherry-pick whose append to the record fails says it is NOT recorded, naming the record" "$r"

new_repo unrecordedmergecommit
step mkdir "$repo/.git/gate-record"
base_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
topic_branch
git merge --no-commit --no-ff topic >/dev/null 2>&1 || true
git commit -q --no-verify -m "Merge topic" >/dev/null 2>"$work/printed" || true
merged=$(git rev-parse HEAD)
if merge_written && printed "[post-commit] $merged is NOT recorded" && printed '.git/gate-record' \
	&& ! printed 'Is a directory'; then r=0; else r=1; fi
check "a merge commit whose append to the record fails says it is NOT recorded, naming the record" "$r"

new_repo unrecordedamend
step mkdir "$repo/.git/gate-record"
smelly_file Noisy
step git add -A
git commit -q --amend --no-verify --no-edit >/dev/null 2>"$work/printed" || true
rewritten=$(git rev-parse HEAD)
if git ls-tree --name-only HEAD | grep -qx Noisy.java && printed "[post-rewrite] they are NOT recorded ($rewritten)" \
	&& printed '.git/gate-record' && ! printed 'Is a directory'; then r=0; else r=1; fi
check "an amend whose append to the record fails says it is NOT recorded, naming the record" "$r"

new_repo unrecordedmerge
step mkdir "$repo/.git/gate-record"
base_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
topic_branch
git merge --no-verify --no-ff --no-edit topic >/dev/null 2>"$work/printed" || true
merged=$(git rev-parse HEAD)
if merge_written && printed "[post-merge] $merged is NOT recorded" && printed '.git/gate-record' \
	&& ! printed 'Is a directory'; then r=0; else r=1; fi
check "a merge whose append to the record fails says it is NOT recorded, naming the record" "$r"

# breach-release reads the record before it appends, so a directory never reaches its append; a
# file-size limit of 0 makes the append to the readable record fail, for root too. The limit holds
# for every regular file the run writes, so what it prints comes back through a pipe.
capped_append_fails() {
	printf 'x\n' > "$work/capped-probe"
	capped_status=0
	(trap '' XFSZ; ulimit -f 0 || exit 2; printf 'y\n' >> "$work/capped-probe" || exit 1) 2>/dev/null || capped_status=$?
	[ "$capped_status" -eq 1 ]
}

new_repo unrecordedrelease
step git checkout -q -B main
record_tip Loud
step cp "$repo/.git/gate-record" "$work/record-before"
if capped_append_fails; then
	release_status=0
	capped_printed=$( (unset CLAUDECODE; trap '' XFSZ; ulimit -f 0 && sh "$hooks_dir/breach-release" "$(git rev-parse HEAD)" 2>&1) ) \
		|| release_status=$?
	printf '%s\n' "$capped_printed" > "$work/printed"
	if [ "$release_status" -eq 1 ] && printed "the release of $(git rev-parse HEAD) is NOT recorded" \
		&& printed '.git/gate-record' && unchanged; then r=0; else r=1; fi
	check "a release whose append to the record fails says it is NOT recorded, naming the record" "$r"
else
	printf '  skip a release whose append to the record fails says it is NOT recorded: this host sets no file-size limit of 0\n'
fi

new_repo cherry
step git checkout -q -b donor
smelly_file Loud
step git add -A
step git commit -q --no-verify -m "Add loud class"
step git checkout -q -
git cherry-pick donor >/dev/null 2>&1 || true
if [ -f "$(git rev-parse --git-dir)/gate-record" ]; then r=0; else r=1; fi
check "a cherry-picked violation is recorded" "$r"
clean_file After
if refuses "Add after class"; then r=0; else r=1; fi
check "the next commit is refused after a cherry-picked violation" "$r"

new_repo revert
smelly_file Loud
step git add -A
step git commit -q --no-verify -m "Add loud class"
step git rm -q Loud.java
step git commit -q --no-verify -m "Remove the loud class"
git revert --no-edit HEAD >/dev/null 2>&1 || true
if [ -f "$(git rev-parse --git-dir)/gate-record" ]; then r=0; else r=1; fi
check "a revert that puts a violation back is recorded" "$r"

new_repo valve
smelly_file Loud
step git add -A
before=$(commits)
git commit -q --no-verify -m "Add loud class" >/dev/null 2>&1 || true
if [ "$(commits)" -eq $((before + 1)) ] && [ ! -f "$(git rev-parse --git-dir)/gate-record" ]; then r=0; else r=1; fi
check "--no-verify stays the deliberate valve and is not recorded" "$r"

# A rebase stopped at a conflict: the side branch adds Seed3.java against a tip that holds its own.
conflict_stop() {
	new_repo "$1"
	onto=$(git rev-parse HEAD)
	step git checkout -q -b side HEAD~1
	write_file Seed3.java 'class Seed3 {' '	int side;' '}'
	step git add -A
	step git commit -q --no-verify -m "Change seed 3 on the side"
	git rebase "$2" "$onto" >/dev/null 2>&1 || true
	write_file Seed3.java 'class Seed3 {' '	int resolved;' '}'
	step git add -A
}

conflict_stop conflictamend --merge
before=$(git rev-parse HEAD)
git commit -q --amend --no-edit >/dev/null 2>"$work/printed" || true
if [ "$(git rev-parse HEAD)" = "$before" ] && printed 'a rebase stopped here'; then r=0; else r=1; fi
check "an amend at a rebase's conflict stop leaves no commit behind" "$r"

conflict_stop conflictcommit --merge
if refuses "Resolve seed 3"; then r=0; else r=1; fi
check "a commit at a rebase's conflict stop leaves no commit behind" "$r"

# The second pick of the side branch folds into the first and stops at a conflict while doing so.
folding_conflict_stop() {
	new_repo "$1"
	onto=$(git rev-parse HEAD)
	step git checkout -q -b side HEAD~1
	clean_file Folded
	step git add -A
	step git commit -q --no-verify -m "Add folded class"
	write_file Seed3.java 'class Seed3 {' '	int side;' '}'
	step git add -A
	step git commit -q --no-verify -m "${3:-Change seed 3 on the side}"
	edit_todo "2s/^pick/$2/" "$onto" >/dev/null 2>&1 || true
	write_file Seed3.java 'class Seed3 {' '	int resolved;' '}'
	step git add -A
}

folding_conflict_stop conflictfixup fixup
if refuses "Resolve seed 3"; then r=0; else r=1; fi
check "a commit at a fixup's conflict stop leaves no commit behind" "$r"

folding_conflict_stop conflictfixupedit fixup "Change seed 3 to edit the side"
if refuses "Resolve seed 3"; then r=0; else r=1; fi
check "a commit at a fixup's conflict stop whose subject names edit leaves no commit behind" "$r"

folding_conflict_stop conflictsquash squash
if refuses "Resolve seed 3"; then r=0; else r=1; fi
check "a commit at a squash's conflict stop leaves no commit behind" "$r"

folding_conflict_stop conflictedit edit
if refuses "Resolve seed 3"; then r=0; else r=1; fi
check "a commit at an edit pick's conflict stop leaves no commit behind" "$r"

conflict_stop conflictapply --apply
if refuses "Resolve seed 3"; then r=0; else r=1; fi
check "a commit at a conflict stop of the apply backend leaves no commit behind" "$r"

new_repo conflictworktree
onto=$(git rev-parse HEAD)
step git worktree add -q -b side "$work/conflictworktree-side" HEAD~1 >/dev/null 2>&1
step cd "$work/conflictworktree-side"
write_file Seed3.java 'class Seed3 {' '	int side;' '}'
step git add -A
step git commit -q --no-verify -m "Change seed 3 on the side"
git rebase --merge "$onto" >/dev/null 2>&1 || true
write_file Seed3.java 'class Seed3 {' '	int resolved;' '}'
if refuses "Resolve seed 3" 'a rebase stopped here'; then r=0; else r=1; fi
check "a commit at a rebase's conflict stop in a linked worktree leaves no commit behind" "$r"

new_repo breakstop
