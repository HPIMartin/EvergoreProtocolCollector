if [ "$(git rev-parse HEAD)" != "$recorded" ] && git log --oneline -- Loud.java | grep -q . && unchanged \
	&& accepts "Add next class"; then r=0; else r=1; fi
check "a rebase that replays a released commit records nothing, and the next commit lands" "$r"

# A commit recorded for its format alone passes the content gate, and so does one a later commit
# mended: what tells its replay is that its change is unchanged. The wrapper fails the format leg
# while a file BAD stands, or while Topic.java holds a blank at a line's end.
format_recorded_strand() {
	write_file verify '#!/bin/sh' '[ "$1" = format ] || exit 0' '[ ! -e BAD ] && ! grep -q " $" Topic.java 2>/dev/null'
	step chmod +x verify
	step git add -A
	step git commit -q --no-verify -m "Add the verify wrapper"
	base_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
	step git checkout -q -b strand
	clean_file Topic
	step git add -A
	step git commit -q --no-verify -m "Add topic class"
	step edit_todo '1s/^pick/edit/' HEAD~1 >/dev/null 2>&1
	"$@"
	step git add -A
	GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
	recorded=$(git rev-parse HEAD)
	step grep -qx "$recorded" "$repo/.git/gate-record"
}

new_repo replayformat
format_recorded_strand write_file BAD 'unformatted'
step git checkout -q -b mender
step git rm -q BAD
step git commit -q --no-verify -m "Remove the unformatted file"
step git checkout -q strand
git cherry-pick mender >/dev/null 2>&1 || true
step [ ! -e BAD ]
rebase_onto_moved_base
replayed=$(git rev-parse HEAD~1)
clean_file Next
if [ "$replayed" != "$recorded" ] && git ls-tree --name-only HEAD~1 | grep -qx BAD \
	&& grep -qx "$replayed" "$repo/.git/gate-record" && refuses "Add next class" "$replayed"; then r=0; else r=1; fi
check "a commit recorded for its format alone and mended by a later commit stays recorded under its new id when a rebase replays it" "$r"

new_repo replayformatmended
format_recorded_strand write_file Topic.java 'class Topic { ' '}'
step cp "$repo/.git/gate-record" "$work/record-before"
step edit_todo '1s/^pick/edit/' HEAD~1 >/dev/null 2>&1
clean_file Topic
step git add Topic.java
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
clean_file Next
if [ "$(git rev-parse HEAD)" != "$recorded" ] && unchanged && accepts "Add next class"; then r=0; else r=1; fi
check "a commit recorded for its format sheds its block once its edit stop mends it, a change of blanks alone included" "$r"

# post-rewrite beside a guard that answers as its stub is told, called directly with one rewritten
# pair on its standard input: the answers a healthy guard never gives. The pair is an old violation
# and its amended twin, which carries the same findings beside one clean file more, so nothing but
# the guard's answer decides whether the twin is recorded.
rewritten_pair() {
	smelly_file Legacy
	step git add -A
	step git commit -q --no-verify -m "Add legacy class"
	old=$(git rev-parse HEAD)
	clean_file Beside
	step git add -A
	step git commit -q --amend --no-verify --no-edit
	new=$(git rev-parse HEAD)
	step [ ! -e "$repo/.git/gate-record" ]
}

rewrite_beside_guard() {
	step mkdir "$work/$case_name-hooks"
	step cp "$hooks_dir"/* "$work/$case_name-hooks/"
	write_file "$work/$case_name-hooks/breach-guard" '#!/bin/sh' "$@"
	step chmod +x "$work/$case_name-hooks/breach-guard"
	printf '%s %s\n' "$old" "$new" | sh "$work/$case_name-hooks/post-rewrite" rebase >/dev/null 2>&1 || true
}

twin_recorded() { grep -qx "$new" "$repo/.git/gate-record" 2>/dev/null; }

new_repo guardcannot
rewritten_pair
rewrite_beside_guard 'exit 2'
if twin_recorded; then r=0; else r=1; fi
check "a rewritten commit is recorded where the guard cannot answer whether its pre-image is a live entry" "$r"

new_repo guardunread
rewritten_pair
rewrite_beside_guard 'echo "an answer of another shape" >&2' 'exit 1'
if twin_recorded; then r=0; else r=1; fi
check "a rewritten commit is recorded where the guard answers 1 without the line that names the recorded ids" "$r"

new_repo guardother
rewritten_pair
rewrite_beside_guard 'echo "a line of another tool" >&2' \
	"echo '[breach-guard] $old reaches recorded commit(s): $(git rev-parse HEAD~1)' >&2" 'exit 1'
if [ ! -e "$repo/.git/gate-record" ]; then r=0; else r=1; fi
check "a rewritten commit whose pre-image only reaches a recorded commit keeps the exemption, the guard's line read behind another line" "$r"

new_repo guardclean
rewritten_pair
rewrite_beside_guard 'exit 0'
if [ ! -e "$repo/.git/gate-record" ]; then r=0; else r=1; fi
check "a rewritten commit whose pre-image the guard clears keeps the exemption for replayed history" "$r"

