# A git that fails the Nth call whose arguments match $STUB_FAIL_MATCH and runs every other call, so
# a case can break one read the content gate makes, the second of two alike included.
real_git=$(command -v git)
write_file "$work/git-stub/git" '#!/bin/sh' \
	'if printf "%s " "$@" | grep -qE -- "$STUB_FAIL_MATCH"; then' \
	'	seen=$(($(cat "$STUB_COUNT") + 1))' \
	'	echo "$seen" > "$STUB_COUNT"' \
	'	[ "$seen" -ne "$STUB_FAIL_NTH" ] || exit 128' \
	'fi' \
	"exec '$real_git' \"\$@\""
chmod +x "$work/git-stub/git"

# Arguments: the pattern, which matching call fails, then the content gate's own arguments.
gate_with_failing_git() {
	echo 0 > "$work/stub-count"
	STUB_FAIL_MATCH=$1 STUB_FAIL_NTH=$2 STUB_COUNT="$work/stub-count" PATH="$work/git-stub:$PATH" \
		"$hooks_dir/content-gate" "$3" ${4+"$4"} >/dev/null 2>"$work/printed"
}

new_repo gitfailnames
clean_file Clean
step git add -A
gate_with_failing_git '--name-only|--raw' 1 --staged && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'git failed to read'; then r=0; else r=1; fi
check "the content gate refuses when git cannot list the staged files" "$r"

