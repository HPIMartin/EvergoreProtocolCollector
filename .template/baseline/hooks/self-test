#!/bin/sh
# Proves the hooks block. Every case asserts the resulting history - a commit count, a sha, a
# recorded breach - and never the text the hooks printed, because a printed rejection is what the
# gate-bypass finding was made of. Runs without the project's build tool, so it works in a host
# session too.
#
# > **ADAPT:** the fixtures below use the extensions, smells, production and test trees and the
# > `./verify` wrapper stub that hooks/content-gate and hooks/format-gate ship with. When you adapt
# > those two, adapt the fixtures with them, or the self-test asserts a gate you no longer have.
set -eu

hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# git exports GIT_DIR, GIT_INDEX_FILE and friends to every hook it runs, so a throwaway repo below
# would otherwise operate on the repo whose commit is being gated.
for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done

outer_head=$(git -C "$hooks_dir" rev-parse HEAD 2>/dev/null || echo none)
outer_branch=$(git -C "$hooks_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failures=0

check() {
	if [ "$2" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s\n' "$1"
		failures=$((failures + 1))
	fi
}

new_repo() {
	repo="$work/$1"
	mkdir -p "$repo"
	cd "$repo"
	git init -q .
	git config user.email gate@example.com
	git config user.name Gate
	git config core.autocrlf false
	git config core.hooksPath "$hooks_dir"
	n=1
	while [ "$n" -le 3 ]; do
		printf 'class Seed%s {\n}\n' "$n" > "Seed$n.java"
		git add -A
		git commit -q --no-verify -m "Add seed $n"
		n=$((n + 1))
	done
}

commits() { git rev-list --count HEAD; }

# One line per argument, so a fixture of any language stays a single readable call.
write_file() {
	target=$1
	shift
	case "$target" in */*) mkdir -p "${target%/*}" ;; esac
	printf '%s\n' "$@" > "$target"
}

refuses() {
	git add -A
	before=$(commits)
	git commit -q -m "$1" >/dev/null 2>&1 || true
	[ "$(commits)" -eq "$before" ]
}

accepts() {
	git add -A
	before=$(commits)
	git commit -q -m "$1" >/dev/null 2>&1 || true
	[ "$(commits)" -eq $((before + 1)) ]
}

clean_file() { printf 'class %s {\n}\n' "$1" > "$1.java"; }
secret_file() { printf 'api_key = "not-a-real-value"\n' > "$1"; }
smelly_file() { printf 'class %s {\n\tvoid run() {\n\t\tSystem.out.println("x");\n\t}\n}\n' "$1" > "$1.java"; }

printf 'hook self-test\n'

new_repo control
clean_file Clean
if accepts "Add clean class"; then r=0; else r=1; fi
check "a clean change commits" "$r"

new_repo secret
secret_file config.txt
if refuses "Add config"; then r=0; else r=1; fi
check "a staged credential literal leaves no commit behind" "$r"
if "$hooks_dir/content-gate" --staged >/dev/null 2>&1; then r=1; else r=0; fi
check "the content gate itself is what refused the credential literal" "$r"

new_repo smell
smelly_file Loud
if refuses "Add loud class"; then r=0; else r=1; fi
check "staged debug output leaves no commit behind" "$r"
if "$hooks_dir/content-gate" --staged >/dev/null 2>&1; then r=1; else r=0; fi
check "the content gate itself is what refused the debug output" "$r"

new_repo csprint
write_file Api.cs 'class Api {' '	void Run() {' '		Console.WriteLine("x");' '	}' '}'
if refuses "Add the api class"; then r=0; else r=1; fi
check "a C# console write leaves no commit behind" "$r"

new_repo pyprint
write_file runner.py 'def run():' '	print("x")'
if refuses "Add the runner module"; then r=0; else r=1; fi
check "a Python debug print leaves no commit behind" "$r"

new_repo cppprint
write_file main.cpp '#include <iostream>' 'int main() {' '	std::cout << "x";' '	return 0;' '}'
if refuses "Add the entry point"; then r=0; else r=1; fi
check "a C++ stream write leaves no commit behind" "$r"

new_repo tsprint
write_file client.ts 'export function run() {' '	console.log("x");' '}'
if refuses "Add the run function"; then r=0; else r=1; fi
check "a TypeScript console log leaves no commit behind" "$r"

new_repo todo
write_file client.ts 'export const label = "TODO: rename";'
if refuses "Add the label constant"; then r=0; else r=1; fi
check "an added TODO marker leaves no commit behind" "$r"

new_repo nullforgiving
write_file src/Api.cs 'class Api {' '	void Run(Node node) {' '		node!.Accept();' '	}' '}'
if refuses "Add the api class"; then r=0; else r=1; fi
check "a null-forgiving operator in production C# leaves no commit behind" "$r"

new_repo nullforgivingtest
write_file tests/ApiTests.cs 'class ApiTests {' '	void Run(Node node) {' '		node!.Accept();' '	}' '}'
if accepts "Add the api tests"; then r=0; else r=1; fi
check "a test may use the null-forgiving operator" "$r"

new_repo prodtoken
write_file src/client.py 'URL = "https://example.com/api?token=abcdef"'
if refuses "Add the client module"; then r=0; else r=1; fi
check "a hard-coded token in production source leaves no commit behind" "$r"

new_repo testtoken
write_file tests/test_client.py 'URL = "https://example.com/api?token=abcdef"'
if accepts "Add the client test"; then r=0; else r=1; fi
check "a test may hard-code a token" "$r"

new_repo secretpem
write_file deploy.conf '-----BEGIN RSA PRIVATE KEY-----' 'not-a-real-key-body' '-----END RSA PRIVATE KEY-----'
if refuses "Add the deploy config"; then r=0; else r=1; fi
check "a staged private-key block leaves no commit behind" "$r"

new_repo secretaws
write_file deploy.conf 'access_key = AKIAZZZZZZZZZZZZZZZZ'
if refuses "Add the deploy config"; then r=0; else r=1; fi
check "a staged AWS-style access key leaves no commit behind" "$r"

new_repo secretemail
write_file team.txt 'owner = gatekeeper@corp.internal'
if refuses "Add the team note"; then r=0; else r=1; fi
check "a routable e-mail address leaves no commit behind" "$r"

# This case pins the allowlist, not the address scan: it is the one that flips when email_allow
# stops matching, while the refusal case above flips when the scan itself does.
new_repo secretemailallowed
write_file team.txt 'owner = gatekeeper@example.com'
if accepts "Add the team note"; then r=0; else r=1; fi
check "an allowlisted example address commits" "$r"

new_repo hostpath
write_file notes.txt 'workspace = /home/someone/projects/demo'
if refuses "Add the notes"; then r=0; else r=1; fi
check "an absolute host path leaves no commit behind" "$r"

new_repo keyfile
write_file server.pem 'not-a-real-key-body'
if refuses "Add the server key"; then r=0; else r=1; fi
check "a staged key file leaves no commit behind" "$r"

new_repo prodtokenassign
write_file src/client.py 'auth_token = "not-a-real-value"'
if refuses "Add the client module"; then r=0; else r=1; fi
check "a hard-coded auth token assignment in production source leaves no commit behind" "$r"

# This case pins the production-only scope of the token scan: it is the one that flips when
# is_production_source stops telling a test tree from a production one.
new_repo testtokenassign
write_file tests/test_client.py 'auth_token = "not-a-real-value"'
if accepts "Add the client test"; then r=0; else r=1; fi
check "a test may hard-code an auth token assignment" "$r"

new_repo printallow_default
write_file cli/main.py 'def run():' '	print("x")'
if refuses "Add the cli entry point"; then r=0; else r=1; fi
check "a debug print is refused wherever it sits until a path opts in" "$r"

new_repo printallow_optin
write_file cli/main.py 'def run():' '	print("x")'
git add -A
before=$(commits)
CONTENT_GATE_PRINT_ALLOW=cli/ git commit -q -m "Add the cli entry point" >/dev/null 2>&1 || true
if [ "$(commits)" -eq $((before + 1)) ]; then r=0; else r=1; fi
check "a path listed in print_allow_paths commits its stdout" "$r"

new_repo amend
smelly_file Loud
git add -A
before=$(git rev-parse HEAD)
git commit -q --amend --no-edit >/dev/null 2>&1 || true
if [ "$(git rev-parse HEAD)" = "$before" ]; then r=0; else r=1; fi
check "an amend carrying a violation does not move HEAD" "$r"

new_repo sequencer
GIT_SEQUENCE_EDITOR="sed -i '1s/^pick/edit/'" git rebase -i HEAD~2 >/dev/null 2>&1
smelly_file Loud
git add Loud.java
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
if git log --oneline --all -- Loud.java | grep -q .; then r=0; else r=1; fi
check "rebase --continue commits without asking a hook (the bypass itself)" "$r"
if [ -f "$(git rev-parse --git-dir)/gate-breach" ]; then r=0; else r=1; fi
check "post-rewrite records the ungated commit" "$r"
clean_file Next
if refuses "Add next class"; then r=0; else r=1; fi
check "the next commit is refused while the ungated commit is reachable" "$r"
recorded=$(head -n 1 "$(git rev-parse --git-dir)/gate-breach")
git checkout -q -b clean-line "$(git rev-list --max-parents=0 HEAD)"
clean_file Fresh
if accepts "Add fresh class" && ! git merge-base --is-ancestor "$recorded" HEAD 2>/dev/null; then r=0; else r=1; fi
check "the record clears itself once the ungated commit is unreachable" "$r"

new_repo replay
smelly_file Legacy
git add -A
git commit -q --no-verify -m "Add legacy class"
clean_file Later
git add -A
git commit -q --no-verify -m "Add later class"
GIT_SEQUENCE_EDITOR=true git rebase -i --no-ff HEAD~2 >/dev/null 2>&1 || true
if [ -f "$(git rev-parse --git-dir)/gate-breach" ]; then r=1; else r=0; fi
check "replaying a pre-existing violation raises no breach" "$r"

new_repo comment
write_file Noted.java 'class Noted {' '	// why this exists' '}'
if refuses "Add noted class"; then r=0; else r=1; fi
check "an added // comment leaves no commit behind" "$r"

# git reports a file renamed and edited in one commit as R, which the scans' ACM filter drops. The
# bodies below are long enough for rename detection to fire, which is what makes the case a rename
# rather than a delete plus an add.
renamed_body() {
	write_file "$1" 'class Old {' '	void run() {' '		int a = 1;' '		int b = 2;' '		int c = 3;' '		int d = 4;' '		int e = 5;' '	}' "$2" '}'
}

new_repo renamecomment
renamed_body Old.java ''
git add -A
git commit -q --no-verify -m "Add old class"
git mv Old.java New.java
renamed_body New.java '	// snuck in on the rename'
if refuses "Rename the old class"; then r=0; else r=1; fi
check "an added comment riding in on a rename leaves no commit behind" "$r"

new_repo renamesecret
renamed_body Old.java ''
git add -A
git commit -q --no-verify -m "Add old class"
git mv Old.java New.java
renamed_body New.java '	String home = "/home/someone/projects/demo";'
if refuses "Rename the old class"; then r=0; else r=1; fi
check "a host path riding in on a rename leaves no commit behind" "$r"

new_repo renamecherry
renamed_body Old.java ''
git add -A
git commit -q --no-verify -m "Add old class"
git checkout -q -b donor
git mv Old.java New.java
renamed_body New.java '	// snuck in on the rename'
git add -A
git commit -q --no-verify -m "Rename the old class"
git checkout -q -
git cherry-pick donor >/dev/null 2>&1 || true
if [ -f "$(git rev-parse --git-common-dir)/gate-breach" ]; then r=0; else r=1; fi
check "a cherry-picked rename carrying a comment is recorded" "$r"

new_repo renamecherrysecret
renamed_body Old.java ''
git add -A
git commit -q --no-verify -m "Add old class"
git checkout -q -b donor
git mv Old.java New.java
renamed_body New.java '	String home = "/home/someone/projects/demo";'
git add -A
git commit -q --no-verify -m "Rename the old class"
git checkout -q -
git cherry-pick donor >/dev/null 2>&1 || true
if [ -f "$(git rev-parse --git-common-dir)/gate-breach" ]; then r=0; else r=1; fi
check "a cherry-picked rename carrying a host path is recorded" "$r"

# Clean content either way, so this one pins only that a zero-diff rename survives the pipeline; the
# case below is the one that pins how such a rename is read.
new_repo renameclean
renamed_body Old.java ''
git add -A
git commit -q --no-verify -m "Add old class"
git mv Old.java New.java
if accepts "Rename the old class"; then r=0; else r=1; fi
check "a rename that edits nothing commits" "$r"

# The counterpart of the `stock` case for the rename path: moving a file is not editing it, so the
# scan that intersects with added lines stays silent about what the file already carried. This is the
# case that goes red when rename detection is switched off instead of `R` joining the filter.
new_repo renamestale
write_file Old.java 'class Old {' '	// an older comment nobody touched' '}'
git add -A
git commit -q --no-verify -m "Add old class"
git mv Old.java New.java
if accepts "Rename the old class"; then r=0; else r=1; fi
check "a rename alone does not re-flag a comment the file already carried" "$r"

new_repo doccomment
write_file Documented.java 'class Documented {' '	/** what it does */' '	void run() {' '	}' '}'
if refuses "Add documented class"; then r=0; else r=1; fi
check "an added doc-comment block leaves no commit behind" "$r"

new_repo literal
write_file Addresses.java 'class Addresses {' '	String home = "https://example.com";' '	String node = "//input[@type=1]";' '}'
if accepts "Add addresses class"; then r=0; else r=1; fi
check "a // inside a string literal is not read as a comment" "$r"

new_repo stock
printf 'class Legacy {\n\t// an older comment nobody touched\n}\n' > Legacy.java
git add -A
git commit -q --no-verify -m "Add legacy class"
printf 'class Legacy {\n\t// an older comment nobody touched\n\tint added = 1;\n}\n' > Legacy.java
if accepts "Add a field to the legacy class"; then r=0; else r=1; fi
check "an untouched existing comment does not block the file's next commit" "$r"

new_repo noprefix
git config diff.noprefix true
write_file Noted.java 'class Noted {' '	// why this exists' '}'
if refuses "Add noted class"; then r=0; else r=1; fi
check "a repository configured with diff.noprefix still has its added comments read" "$r"

new_repo spacedpath
write_file 'Noted Class.java' 'class NotedClass {' '	// why this exists' '}'
if refuses "Add the noted class"; then r=0; else r=1; fi
check "an added comment in a path containing a space leaves no commit behind" "$r"

new_repo scope
write_file build.gradle '// a build script comment' 'plugins {' '}'
if accepts "Add build script"; then r=0; else r=1; fi
check "the check stays out of files the comment scan does not list" "$r"

new_repo template
write_file client.ts 'export const endpoint = `https://example.com/api`;'
if accepts "Add the endpoint constant"; then r=0; else r=1; fi
check "a TypeScript template literal is not read as a comment" "$r"

new_repo textblock
write_file Selector.java 'class Selector {' '	String path = """' '		//div[@id=1]' '		""";' '}'
if accepts "Add the selector class"; then r=0; else r=1; fi
check "a text block holding an XPath is not read as a comment" "$r"

new_repo cppcomment
write_file main.cpp 'int main() {' '	// note' '	return 0;' '}'
if refuses "Add the entry point"; then r=0; else r=1; fi
check "an added // comment in a C++ file leaves no commit behind" "$r"

new_repo cppinclude
write_file main.cpp '#include <vector>' 'int main() {' '	return 0;' '}'
if accepts "Add the entry point"; then r=0; else r=1; fi
check "an added #include is code, not a comment" "$r"

new_repo cscomment
write_file Api.cs 'class Api {' '	// note' '}'
if refuses "Add the api class"; then r=0; else r=1; fi
check "an added // comment in a C# file leaves no commit behind" "$r"

new_repo csregion
write_file Api.cs '#region Api' 'class Api {' '}' '#endregion'
if accepts "Add the api class"; then r=0; else r=1; fi
check "an added #region is code, not a comment" "$r"

new_repo hashcomment
write_file counter.py 'def run():' '	# why this exists' '	return 1'
if refuses "Add the counter module"; then r=0; else r=1; fi
check "an added # comment in a Python file leaves no commit behind" "$r"

new_repo hashliteral
write_file counter.py 'MARKER = "#not a comment"'
if accepts "Add the marker constant"; then r=0; else r=1; fi
check "a # inside a string literal is not read as a comment" "$r"

new_repo shebang
write_file tool.py '#!/usr/bin/env python3' 'def run():' '	return 1'
if accepts "Add the tool module"; then r=0; else r=1; fi
check "a shebang on line 1 is not read as a comment" "$r"

new_repo cmakecomment
write_file CMakeLists.txt '# the build' 'project(demo)'
if refuses "Add the cmake build"; then r=0; else r=1; fi
check "an added # comment in CMakeLists.txt leaves no commit behind" "$r"

new_repo tomlcomment
write_file pyproject.toml '[project]' '# the project name' 'name = "demo"'
if refuses "Add the project manifest"; then r=0; else r=1; fi
check "an added # comment in a TOML file leaves no commit behind" "$r"

new_repo templatebaseline
write_file .template/baseline/hooks/Seeded.java 'class Seeded {' '	// a comment the template shipped' '}'
write_file .template/baseline/config.txt 'api_key = "not-a-real-value"' 'home = /home/someone/work'
if accepts "Add the template baseline"; then r=0; else r=1; fi
check "the scans stay out of the adopted template baseline" "$r"

new_repo xmlcomment
write_file App.csproj '<Project>' '	<!-- keep -->' '</Project>'
if refuses "Add the project file"; then r=0; else r=1; fi
check "an added XML comment leaves no commit behind" "$r"

new_repo xmlblock
write_file App.csproj '<Project>' '	<!-- keep' '	     this -->' '</Project>'
if refuses "Add the project file"; then r=0; else r=1; fi
check "an added multi-line XML comment leaves no commit behind" "$r"

new_repo xmlelement
write_file App.csproj '<Project>' '	<TargetFramework>net8.0</TargetFramework>' '</Project>'
if accepts "Add the project file"; then r=0; else r=1; fi
check "a plain XML element is not read as a comment" "$r"

new_repo directive
write_file wide.py '# noqa: E501' 'VALUE = 1'
if accepts "Add the value constant"; then r=0; else r=1; fi
check "a tool directive is configuration, not an explanatory comment" "$r"

new_repo directivetrailingnoqa
write_file trailing_noqa.py 'VALUE = 1  # noqa: E501'
if accepts "Add the value constant"; then r=0; else r=1; fi
check "a trailing noqa directive is configuration, not an explanatory comment" "$r"

new_repo directivetrailingtype
write_file trailing_type.py 'value = maybe_none()  # type: ignore[attr-defined]'
if accepts "Add the value assignment"; then r=0; else r=1; fi
check "a trailing type-ignore directive is configuration, not an explanatory comment" "$r"

new_repo directivetrailingprose
write_file trailing_prose.py 'VALUE = 1  # explains why'
if refuses "Add the value constant"; then r=0; else r=1; fi
check "a trailing explanatory comment beside code is still refused" "$r"

new_repo directiveprosestart
write_file prose_start.py '# noqa because reasons' 'VALUE = 1'
if refuses "Add the value constant"; then r=0; else r=1; fi
check "a directive keyword followed by prose is still refused" "$r"

new_repo docstring
write_file greeter.py '"""Greeting helpers."""' 'def greet():' '	"""Say hello."""' '	return "hi"'
if refuses "Add the greeter module"; then r=0; else r=1; fi
check "an added docstring leaves no commit behind" "$r"

new_repo tripleassign
write_file banner.py 'BANNER = """welcome"""'
if accepts "Add the banner constant"; then r=0; else r=1; fi
check "a triple-quoted assignment is not read as a doc comment" "$r"

new_repo triplehash
write_file banner.py 'BANNER = """' '# not a comment' '"""'
if accepts "Add the banner constant"; then r=0; else r=1; fi
check "a # inside a triple-quoted string is not read as a comment" "$r"

new_repo merge
git checkout -q -b topic
smelly_file Loud
git add -A
git commit -q --no-verify -m "Add loud class"
git checkout -q -
clean_file Other
git add -A
git commit -q --no-verify -m "Add other class"
before=$(commits)
git merge --no-ff --no-edit --no-verify topic >/dev/null 2>&1 || true
if [ "$(git rev-list --count HEAD)" -gt "$before" ] && ! "$hooks_dir/content-gate" --commit HEAD >/dev/null 2>&1; then r=0; else r=1; fi
check "the commit gate can read a merge commit's content" "$r"

new_repo cleanmerge
git checkout -q -b topic
smelly_file Loud
git add -A
git commit -q --no-verify -m "Add loud class"
git checkout -q -
clean_file Other
git add -A
git commit -q --no-verify -m "Add other class"
before=$(commits)
git merge --no-ff --no-edit topic >/dev/null 2>&1 || true
if [ "$(commits)" -eq "$before" ]; then r=0; else r=1; fi
check "a --no-ff merge carrying a violation leaves no commit behind" "$r"

new_repo swallowed
smelly_file Loud
git add -A
git commit -q --no-verify -m "Add loud class"
GIT_SEQUENCE_EDITOR="sed -i '1s/^pick/edit/'" git rebase -i HEAD~1 >/dev/null 2>&1
printf 'class Loud {\n\tvoid run() {\n\t\tSystem.out.println("x");\n\t}\n\t// a brand new comment beside the old smell\n}\n' > Loud.java
git add Loud.java
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
if [ -f "$(git rev-parse --git-common-dir)/gate-breach" ]; then r=0; else r=1; fi
check "a new violation of a later-checked category is recorded beside an older one" "$r"

new_repo sibling
GIT_SEQUENCE_EDITOR="sed -i '1s/^pick/edit/'" git rebase -i HEAD~1 >/dev/null 2>&1
smelly_file Loud
git add Loud.java
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
poisoned=$(git rev-parse HEAD)
git worktree add -q -b sibling-line "$work/sibling-line" >/dev/null 2>&1
cd "$work/sibling-line"
git merge -q --ff-only "$poisoned" >/dev/null 2>&1 || true
clean_file Fresh
if git merge-base --is-ancestor "$poisoned" HEAD 2>/dev/null && refuses "Add fresh class"; then r=0; else r=1; fi
check "a sibling worktree carrying the same recorded commit is refused too" "$r"

new_repo newontop
printf 'class Legacy {\n\t// an older comment nobody touched\n}\n' > Legacy.java
git add -A
git commit -q --no-verify -m "Add legacy class"
GIT_SEQUENCE_EDITOR="sed -i '1s/^pick/edit/'" git rebase -i HEAD~1 >/dev/null 2>&1
printf 'class Legacy {\n\t// an older comment nobody touched\n\tvoid run() {\n\t\tSystem.out.println("x");\n\t}\n}\n' > Legacy.java
git add Legacy.java
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
if [ -f "$(git rev-parse --git-dir)/gate-breach" ]; then r=0; else r=1; fi
check "a rewrite adding a new violation on top of an old one is recorded" "$r"

new_repo applypatch
donor="$work/applypatch-donor"
mkdir -p "$donor"
cd "$donor"
git init -q .
git config user.email gate@example.com
git config user.name Gate
printf 'class Seed1 {\n}\n' > Seed1.java
git add -A
git commit -q --no-verify -m "Add seed 1"
smelly_file Loud
git add -A
git commit -q --no-verify -m "Add loud class"
git format-patch -1 -o "$donor/patches" >/dev/null 2>&1
cd "$repo"
before=$(commits)
git am "$donor/patches/"*.patch >/dev/null 2>&1 || true
if [ "$(commits)" -eq "$before" ]; then r=0; else r=1; fi
check "git am of a violating patch leaves no commit behind" "$r"
git am --abort >/dev/null 2>&1 || true

new_repo persist
GIT_SEQUENCE_EDITOR="sed -i '1s/^pick/edit/'" git rebase -i HEAD~2 >/dev/null 2>&1
smelly_file Loud
git add Loud.java
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
violator=$(git log --format=%H --all -- Loud.java | tail -n 1)
GIT_SEQUENCE_EDITOR="sed -i '1s/^pick/edit/'" git rebase -i HEAD~1 >/dev/null 2>&1
clean_file Harmless
git add Harmless.java
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
if git merge-base --is-ancestor "$violator" HEAD 2>/dev/null && [ -f "$(git rev-parse --git-dir)/gate-breach" ]; then r=0; else r=1; fi
check "a later clean rewrite does not clear a still-reachable record" "$r"
