# The stubs answer on the argument, not on being called at all: a wrapper run with the wrong
# subcommand (or with none) would otherwise satisfy both cases vacuously.
new_repo formatleg_red
write_file verify '#!/bin/sh' '[ "$1" = format ] && exit 1' 'exit 0'
step chmod +x verify
step git add -A
step git commit -q --no-verify -m "Add the verify wrapper"
clean_file Formatted
if refuses "Add formatted class" 'formatting/style gate failed'; then r=0; else r=1; fi
check "a failing format leg leaves no commit behind" "$r"

new_repo formatleg_green
write_file verify '#!/bin/sh' '[ "$1" = format ] && exit 0' 'exit 1'
step chmod +x verify
step git add -A
step git commit -q --no-verify -m "Add the verify wrapper"
clean_file Formatted
if accepts "Add formatted class"; then r=0; else r=1; fi
check "a passing format leg lets the commit through" "$r"

# The content of the patch below is clean, so the format leg is the only thing that can refuse:
# this case pins the exit status of pre-applypatch, which runs before its commit exists.
new_repo formatleg_applypatch
write_file verify '#!/bin/sh' '[ "$1" = format ] && exit 1' 'exit 0'
step chmod +x verify
step git add -A
step git commit -q --no-verify -m "Add the verify wrapper"
new_donor formatleg-donor
clean_file Patched
step git add -A
step git commit -q --no-verify -m "Add patched class"
step git format-patch -1 -o "$donor/patches" >/dev/null 2>&1
step cd "$repo"
before=$(commits)
git am "$donor/patches/"*.patch >/dev/null 2>"$work/printed" || true
if [ "$(commits)" -eq "$before" ] && printed 'format/style gate failed. Fix the patch'; then r=0; else r=1; fi
check "git am whose format leg fails leaves no commit behind" "$r"
git am --abort >/dev/null 2>&1 || true

# A cherry-pick and a rebase build their commits without asking pre-commit, and the classes they
# carry are clean, so the format leg of post-commit or of post-rewrite is the only thing that can
# record the result.
new_repo formatleg_cherrypick
write_file verify '#!/bin/sh' '[ "$1" = format ] && exit 1' 'exit 0'
step chmod +x verify
step git add -A
step git commit -q --no-verify -m "Add the verify wrapper"
step git checkout -q -b picked
clean_file Picked
step git add -A
step git commit -q --no-verify -m "Add picked class"
step git checkout -q -
before=$(commits)
git cherry-pick picked >/dev/null 2>&1 || true
if [ "$(commits)" -eq $((before + 1)) ] && grep -qx "$(git rev-parse HEAD)" "$repo/.git/gate-record"; then r=0; else r=1; fi
check "a cherry-pick whose tree fails the format leg is recorded" "$r"

new_repo formatleg_rebase
write_file verify '#!/bin/sh' '[ "$1" = format ] && exit 1' 'exit 0'
step chmod +x verify
step git add -A
step git commit -q --no-verify -m "Add the verify wrapper"
step git checkout -q -b onto
clean_file Onto
step git add -A
step git commit -q --no-verify -m "Add onto class"
step git checkout -q -
clean_file Moved
step git add -A
step git commit -q --no-verify -m "Add moved class"
git rebase -q onto >/dev/null 2>&1 || true
if [ "$(git rev-parse HEAD~1)" = "$(git rev-parse onto)" ] && grep -qx "$(git rev-parse HEAD)" "$repo/.git/gate-record"; then r=0; else r=1; fi
check "a rebase whose resulting tree fails the format leg is recorded" "$r"

wrapper_file() {
	write_file CLAUDE.md '# Wrapper' '' "Based on agent-entry-template version: $2." '' \
		'## SHARED section (keep textually identical)' '' "$1" '' '## Tool mechanics' '' 'tool notes'
}

template_file() {
	write_file docs/knowledge-base/agent-entry-template.md '# Template' '' "**Template version: $2.**" '' \
		'## SHARED section (keep textually identical)' '' "$1" '' '## Adoption' '' 'adoption notes'
}

new_repo sharedmatch
