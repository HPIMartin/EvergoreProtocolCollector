# A copy of the content gate whose comment_exempt_dirs lists one more directory, written through a
# second file, so a case proves the list the way a project edits it.
gate_exempting() {
	sed "s#^comment_exempt_dirs='\\(.*\\)'\$#comment_exempt_dirs='\\1 $1'#" "$hooks_dir/content-gate" > "$work/gate-exempting"
	grep -q "^comment_exempt_dirs='.* $1'\$" "$work/gate-exempting"
}

new_repo exemptlisted
write_file tools/release/run '#!/bin/sh' '# why this tool exists' 'exit 0'
step git add -A
step gate_exempting tools/release/
if sh "$work/gate-exempting" --staged >/dev/null 2>&1; then r=0; else r=1; fi
check "the content gate passes a comment in a script under a listed tooling directory" "$r"

