# The verb rule refuses an empty subject as well, so this case pins the behaviour rather than the
# one line that names it: the suite asserts history, and no history-asserting case can tell the two
# refusals apart.
new_repo messageempty
clean_file Parser
if refuses ""; then r=0; else r=1; fi
check "an empty commit message leaves no commit behind" "$r"

new_repo messagebody
clean_file Parser
if refuses "$(printf 'Add the parser\n\nThe reason it exists.')"; then r=0; else r=1; fi
check "a message carrying a body leaves no commit behind" "$r"

# A single-line subject, so the footer rule is what refuses it rather than the body rule.
