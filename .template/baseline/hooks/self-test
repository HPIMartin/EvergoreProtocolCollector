#!/bin/sh
# Proves the hooks block. A case that commits takes its verdict from the resulting history - a
# commit count, a sha, a recorded breach - because a printed rejection beside a surviving commit is
# what the gate-bypass finding was made of; such a case may also check the reason the hooks printed.
# A case that calls a gate or a hook directly takes its verdict from the exit status and the
# output, or from the record the hook writes.
# Runs without the project's build tool, so it works in a host session too.
#
# > **ADAPT:** the fixtures below use the extensions, smells, production and test trees and the
# > `./verify` wrapper stub that hooks/content-gate and hooks/format-gate ship with. When you adapt
# > those two, adapt the fixtures with them, or the self-test asserts a gate you no longer have.
set -eu

hooks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# git exports GIT_DIR, GIT_INDEX_FILE and friends to every hook it runs, so a throwaway repo below
# would otherwise operate on the repo whose commit is being gated.
for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done

# The hooks' own seams: a value the caller exported would stand in for a shipped one in every case
# that does not set it.
unset CONTENT_GATE_PRINT_ALLOW COMMIT_MSG_TICKET_KEY_RE COMMIT_MSG_TICKET_POSITION COMMIT_MSG_TICKET_REQUIRED

# The cases on the minimum ask for the version check alone by an argument, never by a variable: the
# hooks/ leg and assemble.sh pass none, and an environment they inherit must not skip a case.
mode=${1-}

# The hooks call git with options that arrived in git 2.31 (dev-environment.md, Variant B). On an
# older git a refusal could come from an unknown option instead of the rule, so no case runs there.
set -- $(git --version | sed -n 's/^git version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p') 0 0
if [ "$1" -lt 2 ] || { [ "$1" -eq 2 ] && [ "$2" -lt 31 ]; }; then
	printf 'hook self-test: %s is older than git 2.31, the minimum the hooks need.\n' "$(git --version)" >&2
	exit 2
fi
[ "$mode" != --version-only ] || exit 0

# The surrounding repository is read with the caller's own configuration, at the start and in the
# closing checks alike: a checkout another user owns opens to git only through a `safe.directory`
# of that configuration, which the scratch HOME below would hide.
outer_home=${HOME-}
outer_home_set=${HOME+set}
outer_xdg=${XDG_CONFIG_HOME-}
outer_xdg_set=${XDG_CONFIG_HOME+set}
outer_git() (
	if [ -n "$outer_home_set" ]; then
		HOME=$outer_home
		export HOME
	else
		unset HOME
	fi
	if [ -n "$outer_xdg_set" ]; then
		XDG_CONFIG_HOME=$outer_xdg
		export XDG_CONFIG_HOME
	else
		unset XDG_CONFIG_HOME
	fi
	unset GIT_CONFIG_NOSYSTEM
	git "$@"
)
outer_head=$(outer_git -C "$hooks_dir" rev-parse HEAD 2>/dev/null || echo none)
outer_branch=$(outer_git -C "$hooks_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# No case reads the user's or the system's git configuration: a `merge.ff=only` there aborts a merge
# before any hook runs, and a global ignore lets a refusal pass with nothing staged. HOME and
# XDG_CONFIG_HOME point at an empty folder, since GIT_CONFIG_GLOBAL arrived after git 2.31. The
# checks that look for a leaked shell message read its English wording, hence the C locale.
mkdir "$work/home"
HOME="$work/home"
XDG_CONFIG_HOME="$work/home/.config"
GIT_CONFIG_NOSYSTEM=1
LC_ALL=C
export HOME XDG_CONFIG_HOME GIT_CONFIG_NOSYSTEM LC_ALL
cd "$work"
exec 3>&1
failures=0
case_name=''
broken=0

# A case whose setup failed proves nothing either way, so its checks report FAIL. A FAIL line names
# its case, and what the hooks last printed in that case follows it, each line behind a bar: the
# calling leg shows the FAIL lines alone, a direct run shows the reason beside them.
check() {
	if [ "$2" -eq 0 ] && [ "$broken" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s [case %s]\n' "$1" "${case_name:-none}"
		if [ -s "$work/printed" ]; then
			sed 's/^/       | /' "$work/printed"
		fi
		failures=$((failures + 1))
	fi
}

# A setup line that fails marks its case broken instead of ending the run, so past the control case
# the summary and both closing guards still report. The note goes to the saved stdout, past any
# redirection on the line.
step() {
	"$@" && return 0
	printf '  setup failed in %s: %s\n' "$case_name" "$*" >&3
	broken=1
}

# Every scratch repository comes from here, so each carries the same identity and line endings. A
# second argument goes to git init (an object format).
init_repo() {
	step mkdir -p "$1"
	step cd "$1"
	step git init -q ${2+"$2"} .
	step git config user.email gate@example.com
	step git config user.name Gate
	step git config core.autocrlf false
}

new_repo() {
	case_name=$1
	broken=0
	: > "$work/printed"
	repo="$work/$1"
	init_repo "$repo" ${2+"$2"}
	step git config core.hooksPath "$hooks_dir"
	n=1
	while [ "$n" -le 3 ]; do
		printf 'class Seed%s {\n}\n' "$n" > "Seed$n.java"
		step git add -A
		step git commit -q --no-verify -m "Add seed $n"
		n=$((n + 1))
	done
}

# The repository a patch for git am is cut from.
new_donor() {
	donor="$work/$1"
	init_repo "$donor"
	printf 'class Seed1 {\n}\n' > Seed1.java
	step git add -A
	step git commit -q --no-verify -m "Add seed 1"
}

commits() { git rev-list --count HEAD 2>/dev/null || echo 0; }

# One line per argument, so a fixture of any language stays a single readable call.
write_file() {
	target=$1
	shift
	case "$target" in */*) mkdir -p "${target%/*}" ;; esac
	printf '%s\n' "$@" > "$target"
}

# A scripted rebase -i whose todo a sed script rewrites; the editor writes the result through a second
# file, since sed -i is a GNU extension.
write_file "$work/todo-editor" 'sed -f "${0%/*}/todo.sed" "$1" > "$1.new" && mv "$1.new" "$1"'
edit_todo() {
	printf '%s\n' "$1" > "$work/todo.sed"
	shift
	GIT_EDITOR=true GIT_SEQUENCE_EDITOR="sh '$work/todo-editor'" git rebase -i "$@"
}

at_edit_stop() { [ -f "$(git rev-parse --git-path rebase-merge/amend)" ]; }

# Turns the tip into a recorded commit: a smell added at an edit stop on it goes in by
# `git rebase --continue`, which asks no pre-commit hook, so post-rewrite records the result.
record_tip() {
	step edit_todo '1s/^pick/edit/' HEAD~1 >/dev/null 2>&1
	smelly_file "$1"
	step git add "$1.java"
	GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
	step grep -qx "$(git rev-parse HEAD)" "$repo/.git/gate-record"
}

unchanged() { cmp -s "$repo/.git/gate-record" "$work/record-before"; }

# The optional second argument is the reason the refusal must name, matched in what the hooks printed.
refuses() {
	step git add -A
	before=$(commits)
	git commit -q -m "$1" >/dev/null 2>"$work/printed" || true
	[ "$(commits)" -eq "$before" ] && printed "${2-}"
}

accepts() {
	step git add -A
	before=$(commits)
	git commit -q -m "$1" >/dev/null 2>"$work/printed" || true
	[ "$(commits)" -eq $((before + 1)) ]
}

# The two above without their `git add -A`, for a case whose work tree holds another copy than the
# index.
refuses_staged() {
	before=$(commits)
	git commit -q -m "$1" >/dev/null 2>"$work/printed" || true
	[ "$(commits)" -eq "$before" ] && printed "${2-}"
}

accepts_staged() {
	before=$(commits)
	git commit -q -m "$1" >/dev/null 2>"$work/printed" || true
	[ "$(commits)" -eq $((before + 1)) ]
}

printed() { [ -z "$1" ] || grep -qF -- "$1" "$work/printed"; }

clean_file() { printf 'class %s {\n}\n' "$1" > "$1.java"; }
secret_file() { printf 'api_key = "not-a-real-value"\n' > "$1"; }
smelly_file() { printf 'class %s {\n\tvoid run() {\n\t\tSystem.out.println("x");\n\t}\n}\n' "$1" > "$1.java"; }

printf 'hook self-test\n'

# Every refusal below is vacuous when a commit fails for a reason of the host, such as its identity
# or a signing setup, so a failing control case ends the run.
new_repo control
clean_file Clean
if accepts "Add clean class"; then r=0; else r=1; fi
check "a clean change commits" "$r"
if [ "$r" -ne 0 ] || [ "$broken" -ne 0 ]; then
	printf 'hook self-test: the control commit failed, so no refusal could be told from a host failure; fix the git setup and run again\n' >&2
	exit 1
fi

new_repo secret
secret_file config.txt
if refuses "Add config" 'possible secret or personal/host data'; then r=0; else r=1; fi
check "a staged credential literal leaves no commit behind" "$r"
if "$hooks_dir/content-gate" --staged >/dev/null 2>&1; then r=1; else r=0; fi
check "the content gate itself is what refused the credential literal" "$r"

new_repo secretumlaut
secret_file 'Ä.txt'
if refuses "Add the config"; then r=0; else r=1; fi
check "a staged credential literal in a file whose path is not ASCII leaves no commit behind" "$r"

new_repo keystoreumlaut
write_file 'Ü.pem' 'x'
if refuses "Add the key"; then r=0; else r=1; fi
check "a key file whose path is not ASCII leaves no commit behind" "$r"

# The link is written to the index directly and the file re-staged from scratch, so the type change
# also happens on a host whose git checks links out as plain files. Where git checks out a real
# link, a write through it would land in its target, so the file replaces the link by `mv -f`.
link_in_index() {
	link=$(printf 'Seed1.java' | git hash-object -w --stdin)
	step git update-index --add --cacheinfo "120000,$link,$1"
	step git commit -q --no-verify -m "Link the $1 file"
	step git checkout -- "$1"
}

new_repo secrettypechange
link_in_index config.txt
step git rm -q --cached config.txt
secret_file replacement.txt
step mv -f replacement.txt config.txt
step git add -A
step sh -c 'git diff --cached --raw | grep -q "^:120000 100644 [0-9a-f. ]* T	config.txt\$"'
if refuses "Replace the config link"; then r=0; else r=1; fi
check "a credential literal in a file that replaces a link leaves no commit behind" "$r"

new_repo secretcopy
write_file Orig.txt 'one' 'two' 'three' 'four' 'five' 'six' 'seven'
step git add -A
step git commit -q --no-verify -m "Add the original config"
step git config diff.renames copies
write_file Orig.txt 'one' 'two' 'three' 'four' 'five' 'six' 'seven' 'eight'
write_file Copy.txt 'one' 'two' 'three' 'four' 'five' 'six' 'seven' 'api_key = "not-a-real-value"'
if refuses "Copy the config"; then r=0; else r=1; fi
check "a credential literal in a near-copy of a changed file leaves no commit behind under diff.renames=copies" "$r"

new_repo secretrebaseumlaut
step edit_todo '1s/^pick/edit/' HEAD~1 >/dev/null 2>&1
secret_file 'Ä.txt'
step git add 'Ä.txt'
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
if git log --oneline -- 'Ä.txt' | grep -q . && [ -f "$(git rev-parse --git-common-dir)/gate-record" ]; then r=0; else r=1; fi
check "a rebase that commits a credential literal in a file whose path is not ASCII is recorded" "$r"

new_repo secretrebasetypechange
link_in_index config.txt
clean_file Later
step git add -A
step git commit -q --no-verify -m "Add later class"
step edit_todo '1s/^pick/edit/' HEAD~1 >/dev/null 2>&1
step git rm -q --cached config.txt
secret_file replacement.txt
step mv -f replacement.txt config.txt
step git add config.txt
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
if git ls-tree HEAD -- config.txt | grep -q '^100644 ' && [ -f "$(git rev-parse --git-common-dir)/gate-record" ]; then r=0; else r=1; fi
check "a rebase that turns a link into a file with a credential literal is recorded" "$r"

new_repo smell
smelly_file Loud
if refuses "Add loud class" 'forbidden in committed source'; then r=0; else r=1; fi
check "staged debug output leaves no commit behind" "$r"
if "$hooks_dir/content-gate" --staged >/dev/null 2>&1; then r=1; else r=0; fi
check "the content gate itself is what refused the debug output" "$r"

new_repo csprint
write_file Api.cs 'class Api {' '	void Run() {' '		Console.WriteLine("x");' '	}' '}'
if refuses "Add the api class"; then r=0; else r=1; fi
check "a C# console write leaves no commit behind" "$r"

new_repo pyprint
write_file runner.py 'def run():' '	print("x")'
if refuses "Add the runner module"; then r=0; else r=1; fi
check "a Python debug print leaves no commit behind" "$r"

new_repo cppprint
write_file main.cpp '#include <iostream>' 'int main() {' '	std::cout << "x";' '	return 0;' '}'
if refuses "Add the entry point"; then r=0; else r=1; fi
check "a C++ stream write leaves no commit behind" "$r"

new_repo tsprint
write_file client.ts 'export function run() {' '	console.log("x");' '}'
if refuses "Add the run function"; then r=0; else r=1; fi
check "a TypeScript console log leaves no commit behind" "$r"

new_repo todo
write_file client.ts 'export const label = "TODO: rename";'
if refuses "Add the label constant"; then r=0; else r=1; fi
check "an added TODO marker leaves no commit behind" "$r"

new_repo smellstock
write_file Legacy.java 'class Legacy {' '	String label = "TODO: rename";' '	void run() {' '		System.out.println("x");' '	}' '}'
step git add -A
step git commit -q --no-verify -m "Add legacy class"
write_file Legacy.java 'class Legacy {' '	String label = "TODO: rename";' '	int added = 1;' '	void run() {' '		System.out.println("x");' '	}' '}'
if accepts "Add a field to the legacy class"; then r=0; else r=1; fi
check "an unrelated edit of a file that already carries a TODO and a debug print commits" "$r"

new_repo smelladded
write_file Legacy.java 'class Legacy {' '	int kept = 1;' '}'
step git add -A
step git commit -q --no-verify -m "Add legacy class"
write_file Legacy.java 'class Legacy {' '	int kept = 1;' '	String label = "TODO: rename";' '}'
if refuses "Add a label to the legacy class" 'forbidden in committed source'; then r=0; else r=1; fi
check "a TODO line added to an existing file leaves no commit behind" "$r"

new_repo smelledited
write_file Legacy.java 'class Legacy {' '	String label = "TODO: rename";' '}'
step git add -A
step git commit -q --no-verify -m "Add legacy class"
write_file Legacy.java 'class Legacy {' '	String label = "TODO: rename it";' '}'
if refuses "Rename the legacy label" 'forbidden in committed source'; then r=0; else r=1; fi
check "an edited line that keeps its TODO leaves no commit behind" "$r"

new_repo nullforgiving
write_file src/Api.cs 'class Api {' '	void Run(Node node) {' '		node!.Accept();' '	}' '}'
if refuses "Add the api class"; then r=0; else r=1; fi
check "a null-forgiving operator in production C# leaves no commit behind" "$r"

new_repo nullforgivingtest
write_file tests/ApiTests.cs 'class ApiTests {' '	void Run(Node node) {' '		node!.Accept();' '	}' '}'
if accepts "Add the api tests"; then r=0; else r=1; fi
check "a test may use the null-forgiving operator" "$r"

new_repo debugwordpy
write_file app.py 'app = Blueprint("app", __name__)' 'key = fingerprint(app)'
if accepts "Add the app module"; then r=0; else r=1; fi
check "a Python name that only ends in print( is no debug print" "$r"

new_repo debugmemberpy
write_file report.py 'def report(self):' '	self.print("x")'
if accepts "Add the report module"; then r=0; else r=1; fi
check "a Python member call self.print( is no debug print" "$r"

new_repo debugwordc
write_file format.c 'void format(char *b, FILE *f) {' '	snprintf(b, 8, "x");' '	sprintf(b, "x");' '	fprintf(f, "x");' '	inputs(b);' '	fputs("x", f);' '}'
if accepts "Add the format function"; then r=0; else r=1; fi
check "a C name that only ends in printf( or puts( is no debug print" "$r"

new_repo debugmemberc
write_file report.c 'void report(struct logger log) {' '	log.printf("x");' '}'
if accepts "Add the report function"; then r=0; else r=1; fi
check "a C member call log.printf( is no debug print" "$r"

new_repo cprintf
write_file main.c 'int main(void) {' '	printf("x");' '	return 0;' '}'
if refuses "Add the entry point" 'forbidden in committed source'; then r=0; else r=1; fi
check "a C printf leaves no commit behind" "$r"

new_repo cputs
write_file main.c 'int main(void) {' '	puts("x");' '	return 0;' '}'
if refuses "Add the entry point" 'forbidden in committed source'; then r=0; else r=1; fi
check "a C puts leaves no commit behind" "$r"

new_repo cppstdprintf
write_file main.cpp 'int main() {' '	std::printf("x");' '	return 0;' '}'
if refuses "Add the entry point" 'forbidden in committed source'; then r=0; else r=1; fi
check "a C++ std::printf leaves no commit behind" "$r"

new_repo pybreakpoint
write_file runner.py 'def run():' '	breakpoint()'
if refuses "Add the runner module" 'forbidden in committed source'; then r=0; else r=1; fi
check "a Python breakpoint() leaves no commit behind" "$r"

new_repo javastacktrace
write_file Runner.java 'class Runner {' '	void run(Exception e) {' '		e.printStackTrace();' '	}' '}'
if refuses "Add the runner class" 'forbidden in committed source'; then r=0; else r=1; fi
check "a Java printStackTrace on a receiver leaves no commit behind" "$r"

new_repo javaparen
write_file Runner.java 'class Runner {' '	void run() {' '		check(System.out.checkError());' '	}' '}'
if refuses "Add the runner class" 'forbidden in committed source'; then r=0; else r=1; fi
check "a Java System.out right after an opening parenthesis leaves no commit behind" "$r"

new_repo tsequals
write_file client.ts 'export const log=console.log;'
if refuses "Add the log constant" 'forbidden in committed source'; then r=0; else r=1; fi
check "a TypeScript console.log right after an equals sign leaves no commit behind" "$r"

new_repo csparen
write_file Api.cs 'class Api {' '	void Run() {' '		Each(Console.WriteLine);' '	}' '}'
if refuses "Add the api class" 'forbidden in committed source'; then r=0; else r=1; fi
check "a C# Console.Write right after an opening parenthesis leaves no commit behind" "$r"

new_repo csbang
write_file src/Api.cs 'class Api {' '	void Run() {' '		Log("Done!");' '	}' '}'
if accepts "Add the api class"; then r=0; else r=1; fi
check "a ! inside a string literal is no null-forgiving operator in production C#" "$r"

new_repo csnullforms
for form in 'var n = node!;' 'Use(node!);' 'Use(node!, 1);' 'items![0].Accept();'; do
	write_file src/Api.cs 'class Api {' '	void Run(Node node) {' "		$form" '	}' '}'
	if refuses "Add the api class" 'forbidden in committed source'; then r=0; else r=1; fi
	check "the null-forgiving form '$form' in production C# leaves no commit behind" "$r"
done

new_repo csnotequal
write_file src/Api.cs 'class Api {' '	bool Differs(int a, int b) {' '		return a!=b;' '	}' '}'
if accepts "Add the api class"; then r=0; else r=1; fi
check "a != comparison is no null-forgiving operator in production C#" "$r"

new_repo prodtoken
