# git commit with a git or a mktemp that fails one matching call, so each refusal on the way to the
# copy is reached. The first mktemp -d is the content gate's, the second the copy's. git puts its
# exec path, which holds a git of its own, first on the PATH it hands its hooks, so the git stub
# goes in as GIT_EXEC_PATH; every git command the hooks run is built in and needs no exec path.
# The mktemp stub goes first on PATH.
real_mktemp=$(command -v mktemp)
write_file "$work/mktemp-stub/mktemp" '#!/bin/sh' \
	'if printf "%s " "$@" | grep -qE -- "$STUB_FAIL_MATCH"; then' \
	'	seen=$(($(cat "$STUB_COUNT") + 1))' \
	'	echo "$seen" > "$STUB_COUNT"' \
	'	[ "$seen" -ne "$STUB_FAIL_NTH" ] || exit 1' \
	'fi' \
	"exec '$real_mktemp' \"\$@\""
chmod +x "$work/mktemp-stub/mktemp"

# Arguments: the stub (git or mktemp), the pattern, which matching call fails, the message.
commit_with_failing() {
	echo 0 > "$work/stub-count"
	before=$(commits)
	if [ "$1" = git ]; then
		STUB_FAIL_MATCH=$2 STUB_FAIL_NTH=$3 STUB_COUNT="$work/stub-count" GIT_EXEC_PATH="$work/git-stub" \
			git commit -q -m "$4" >/dev/null 2>"$work/printed" || true
	else
		STUB_FAIL_MATCH=$2 STUB_FAIL_NTH=$3 STUB_COUNT="$work/stub-count" PATH="$work/$1-stub:$PATH" \
			git commit -q -m "$4" >/dev/null 2>"$work/printed" || true
	fi
	[ "$(commits)" -eq "$before" ]
}

for failing in "git|^write-tree|1|git could not write the staged tree" \
	"git|--show-object-format|1|git could not name its object format" \
	"git|--git-path objects|1|git could not name its object store" \
	"mktemp|-d|2|no scratch directory could be made" \
	"git|^checkout-index|1|the staged tree could not be checked out for its self-tests"; do
	stub=${failing%%|*}
	rest=${failing#*|}
	pattern=${rest%%|*}
	rest=${rest#*|}
	nth=${rest%%|*}
	reason=${rest#*|}
	new_repo "legcopy_$nth$(printf '%s' "$pattern" | tr -cd 'a-z')"
	leg_suite stacks 0 jvm/verify
	write_file stacks/jvm/README.md 'The jvm preset.'
	step git add -A
	if commit_with_failing "$stub" "$pattern" "$nth" "Describe the jvm preset" && printed "$reason"; then r=0; else r=1; fi
	check "pre-commit refuses a leg where $reason" "$r"
done

# breach-guard reads the id length off the object format git names. The entry below names no
# commit, so only that refusal can keep the commit out.
new_repo breachobjectformat
step printf '%s\n' "$(printf '%040d' 0)" >> "$repo/.git/gate-record"
clean_file Next
step git add -A
if commit_with_failing git '--show-object-format' 1 "Add next class" && printed 'no object format'; then r=0; else r=1; fi
check "a breach record refuses every commit where git names no object format breach-guard knows" "$r"

# git am builds its commit without pre-commit; pre-applypatch runs the same legs on the applied index.
new_repo applypatchleg
leg_suite stacks 0 jvm/verify
step git checkout -q -b weakened
write_file stacks/self-test '#!/bin/sh' 'exit 1'
step git add -A
step git commit -q --no-verify -m "Weaken the stacks self-test"
step git format-patch -1 -o "$work/applypatchleg-patches" >/dev/null 2>&1
step git checkout -q -
before=$(commits)
git am "$work/applypatchleg-patches/"*.patch >/dev/null 2>"$work/printed" || true
if [ "$(commits)" -eq "$before" ] && printed 'stacks/self-test fails'; then r=0; else r=1; fi
check "git am of a patch that weakens a staged suite leaves no commit behind" "$r"
git am --abort >/dev/null 2>&1 || true

# The runs below are this suite itself on a git that reports the given version, stopped right after
# its version check.
git_reporting() {
	write_file "$work/git-$1/git" '#!/bin/sh' \
		"if [ \"\$*\" = --version ]; then echo 'git version $1'; exit 0; fi" \
		"exec '$real_git' \"\$@\""
	step chmod +x "$work/git-$1/git"
	PATH="$work/git-$1:$PATH" sh "$hooks_dir/self-test" --version-only >/dev/null 2>"$work/printed"
}

new_repo gitminimum
git_reporting 2.30.9 && status=0 || status=$?
if [ "$status" -eq 2 ] && printed 'is older than git 2.31'; then r=0; else r=1; fi
check "the self-test refuses to run on a git older than 2.31" "$r"
git_reporting 2.31.0 && status=0 || status=$?
if [ "$status" -eq 0 ]; then r=0; else r=1; fi
check "the self-test runs on git 2.31" "$r"

# The sync cases. origin is a plain repository whose main a case moves by committing there, as a
# landing moves origin's main; the primary checkout is its clone and runs no hooks, so only the
# script acts. Each verdict reads the refs afterwards. Every run takes a copy of sync-main whose
# landing model the case names, so a project's own ADAPT value leaves the cases as they are.
sync_copy() {
	mkdir -p "$work/sync-$1" \
		&& sed "s/^landing_model='.*'\$/landing_model='$1'/" "$hooks_dir/sync-main" > "$work/sync-$1/sync-main" \
		&& grep -q "^landing_model='$1'\$" "$work/sync-$1/sync-main"
}
sync_local="$work/sync-local/sync-main"
sync_hub="$work/sync-hub/sync-main"

new_sync_pair() {
	case_name=$1
	broken=0
	: > "$work/printed"
	origin="$work/$1-origin"
	primary="$work/$1-primary"
	init_repo "$origin"
	step git symbolic-ref HEAD refs/heads/main
	step write_file seed.txt seed
	step git add -A
	step git commit -q --no-verify -m "Add the seed"
	step git clone -q "$origin" "$primary"
	step cd "$primary"
	step git config user.email gate@example.com
	step git config user.name Gate
	step git config core.autocrlf false
	seed=$(ref_in "$primary" refs/heads/main)
}

# Arguments: the repository, then the name of the file the commit adds.
commit_in() {
	step write_file "$1/$2.txt" "$2"
	step git -C "$1" add -A
	step git -C "$1" commit -q --no-verify -m "Add $2"
}

ref_in() { git -C "$1" show-ref --verify --hash "$2" 2>/dev/null || echo none; }

# Arguments: the directory it runs in, the copy, then its own arguments.
sync_from() {
	sync_dir=$1
	sync_run=$2
	shift 2
	sync_status=0
	(cd "$sync_dir" && sh "$sync_run" "$@") >"$work/sync-out" 2>"$work/printed" || sync_status=$?
}
synced() { sync_from "$primary" "$sync_local" "$@"; }

# Arguments: the pattern, which matching call fails.
sync_with_failing_git() {
	echo 0 > "$work/stub-count"
	sync_status=0
	(cd "$primary" && STUB_FAIL_MATCH=$1 STUB_FAIL_NTH=$2 STUB_COUNT="$work/stub-count" PATH="$work/git-stub:$PATH" \
		sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$?
}

# A stop: exit 1, the reason, both ids on the last line, and main where it was.
# Arguments: the reason, main's id, origin/main's id after the run.
stopped() {
	[ "$sync_status" -eq 1 ] && printed "$1" \
		&& [ "$(tail -n 1 "$work/printed")" = "[sync-main] main $2, origin/main $3" ] \
		&& [ "$(ref_in "$primary" refs/heads/main)" = "$2" ] \
		&& [ "$(ref_in "$primary" refs/remotes/origin/main)" = "$3" ]
}

# No sync: exit 2, the reason, main where it was and origin/main as before, so nothing was fetched
# where origin's main has moved.
# Arguments: the reason, main's id, origin/main's id.
refused_sync() {
	[ "$sync_status" -eq 2 ] && printed "$1" \
		&& [ "$(ref_in "$primary" refs/heads/main)" = "$2" ] \
		&& [ "$(ref_in "$primary" refs/remotes/origin/main)" = "$3" ]
}

# A file system that folds case holds no two loose refs whose names differ in case alone, and on one
# without symlinks git writes none: a case that needs either prints a skip there, and the check it
# pins stands untested on that host.
folds_case() { [ "$(git -C "$primary" config --get core.ignorecase 2>/dev/null)" = true ]; }
lacks_symlinks() { [ "$(git -C "$primary" config --get core.symlinks 2>/dev/null)" = false ]; }
skip_case() { printf '  skip %s: %s here\n' "$1" "$2"; }

# In step: exit 0, main at the given id, still checked out, the work tree clean.
in_step() {
	[ "$sync_status" -eq 0 ] && [ "$(ref_in "$primary" refs/heads/main)" = "$1" ] \
		&& [ "$(git -C "$primary" symbolic-ref HEAD 2>/dev/null)" = refs/heads/main ] \
		&& [ -z "$(git -C "$primary" status --porcelain 2>/dev/null)" ]
}

case_name=synccopies
broken=0
: > "$work/printed"
step sync_copy local
step sync_copy hub
step sync_copy hubb
step sync_copy ''
check "the sync's copies with a landing model each carry it" "$broken"

new_sync_pair syncbehind
commit_in "$origin" landed
commit_in "$origin" second
landed=$(ref_in "$origin" refs/heads/main)
synced
if in_step "$landed" && [ -f "$primary/landed.txt" ] && [ -f "$primary/second.txt" ] \
	&& grep -qxF "[sync-main] main fast-forwarded from $seed to $landed" "$work/sync-out"; then r=0; else r=1; fi
check "the sync fast-forwards main to the main origin holds, work tree and all, naming both ids" "$r"
synced
if in_step "$landed" && grep -qxF "[sync-main] main is at origin/main, $landed" "$work/sync-out"; then r=0; else r=1; fi
check "a sync where main is at origin/main leaves it there and says so" "$r"

new_sync_pair syncsubdir
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
step mkdir "$primary/sub"
sync_from "$primary/sub" "$sync_local"
if in_step "$landed"; then r=0; else r=1; fi
check "the sync run from a folder inside the primary checkout syncs its main" "$r"

new_sync_pair syncignored
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
step write_file "$primary/.git/info/exclude" 'scratch.log'
step write_file "$primary/scratch.log" 'build output'
synced
if [ "$sync_status" -eq 0 ] && [ "$(ref_in "$primary" refs/heads/main)" = "$landed" ]; then r=0; else r=1; fi
check "an ignored file leaves the checkout clean for the sync" "$r"

new_sync_pair synchub
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
sync_from "$primary" "$sync_hub"
if in_step "$landed"; then r=0; else r=1; fi
check "in the hub model the sync fast-forwards main as in the local one" "$r"

new_sync_pair syncahead
commit_in "$primary" own
own=$(ref_in "$primary" refs/heads/main)
synced
if in_step "$own" \
	&& grep -qxF "[sync-main] main runs 1 commit(s) ahead of origin/main, $seed, at $own; the author pushes it" "$work/sync-out"; then r=0; else r=1; fi
check "in the local model main may run ahead of origin/main, and the sync says by how much" "$r"
sync_from "$primary" "$sync_hub"
if stopped 'main holds 1 commit(s) origin/main lacks' "$own" "$seed"; then r=0; else r=1; fi
check "in the hub model a main that holds what origin/main lacks stops the sync" "$r"

new_sync_pair syncdiverged
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
commit_in "$primary" own
own=$(ref_in "$primary" refs/heads/main)
synced
if stopped 'main and origin/main have diverged' "$own" "$landed"; then r=0; else r=1; fi
check "a main that diverged from origin/main stops the sync in the local model" "$r"
sync_from "$primary" "$sync_hub"
if stopped 'main and origin/main have diverged' "$own" "$landed"; then r=0; else r=1; fi
check "a main that diverged from origin/main stops the sync in the hub model" "$r"

new_sync_pair syncfetchfails
step git -C "$primary" remote set-url origin "$work/no-such-origin"
synced
if stopped 'the fetch from origin failed' "$seed" "$seed"; then r=0; else r=1; fi
check "a failed fetch stops the sync, naming both ids" "$r"

new_sync_pair syncnomain
step git -C "$origin" branch -m main trunk
commit_in "$origin" landed
synced
if stopped "this fetch brought no main of origin at $seed" "$seed" "$seed"; then r=0; else r=1; fi
check "an origin that dropped main stops the sync, though its old remote-tracking ref stays" "$r"

new_sync_pair syncnomainref
step git -C "$origin" branch -m main trunk
commit_in "$origin" landed
step git -C "$primary" update-ref -d refs/remotes/origin/main
synced
if stopped 'origin/main is missing after the fetch' "$seed" none; then r=0; else r=1; fi
check "an origin without main, and no origin/main left, stops the sync" "$r"

# A remote-tracking ref moved after the fetch is not what the fetch brought.
new_sync_pair syncfetchheadmoved
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
later=$(git -C "$origin" commit-tree "$landed^{tree}" -p "$landed" -m later 2>/dev/null || echo none)
step git -C "$origin" update-ref refs/heads/side "$later"
step write_file "$work/$case_name-stub/git" '#!/bin/sh' \
	"if [ \"\$1\" = fetch ]; then '$real_git' \"\$@\" || exit \$?; exec '$real_git' update-ref refs/remotes/origin/main '$later'; fi" \
	"exec '$real_git' \"\$@\""
step chmod +x "$work/$case_name-stub/git"
sync_status=0
(cd "$primary" && PATH="$work/$case_name-stub:$PATH" sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$?
if stopped "this fetch brought no main of origin at $later" "$seed" "$later"; then r=0; else r=1; fi
check "an origin/main the fetch did not write at its id stops the sync" "$r"

new_sync_pair syncnoorigin
step git -C "$primary" remote remove origin
synced
if refused_sync 'there is no remote origin; a project without origin does not sync (handbook §7, the ADAPT note under' "$seed" none; then r=0; else r=1; fi
check "a checkout without origin is refused, naming the ADAPT note" "$r"

for argument in extra --prune; do
	new_sync_pair "syncargument$(printf '%s' "$argument" | tr -cd 'a-z')"
	commit_in "$origin" landed
	synced "$argument"
	if refused_sync 'usage: sh hooks/sync-main' "$seed" "$seed"; then r=0; else r=1; fi
	check "the sync refuses the argument $argument before it fetches" "$r"
done

for model in hubb ''; do
	new_sync_pair "syncmodel$model"
	commit_in "$origin" landed
	sync_from "$primary" "$work/sync-$model/sync-main"
	if refused_sync "the landing model '$model' is neither local nor hub" "$seed" "$seed"; then r=0; else r=1; fi
	check "the sync refuses the landing model '$model' before it fetches" "$r"
done

new_sync_pair syncnowhere
step mkdir "$work/syncnowhere-plain"
sync_from "$work/syncnowhere-plain" "$sync_local"
if [ "$sync_status" -eq 2 ] && printed 'is not inside a git work tree'; then r=0; else r=1; fi
check "the sync refuses a folder outside every git work tree" "$r"

new_sync_pair synclinked
commit_in "$origin" landed
step git -C "$primary" worktree add -q --detach "$work/synclinked-side" main
sync_from "$work/synclinked-side" "$sync_local"
if refused_sync 'is a linked worktree; the sync runs in the primary checkout' "$seed" "$seed"; then r=0; else r=1; fi
check "the sync refuses a linked worktree before it fetches" "$r"

new_sync_pair syncotherbranch
commit_in "$origin" landed
step git -C "$primary" switch -q -c side
synced
if refused_sync 'the checkout is on refs/heads/side, not on refs/heads/main' "$seed" "$seed"; then r=0; else r=1; fi
check "the sync refuses a checkout on another branch before it fetches" "$r"

new_sync_pair syncdetached
commit_in "$origin" landed
step git -C "$primary" switch -q --detach main
synced
if refused_sync 'the checkout is on a detached HEAD, not on refs/heads/main' "$seed" "$seed"; then r=0; else r=1; fi
check "the sync refuses a detached HEAD before it fetches" "$r"

new_sync_pair syncunborn
commit_in "$origin" landed
step git -C "$primary" switch -q -c side
step git -C "$primary" update-ref -d refs/heads/main
step git -C "$primary" symbolic-ref HEAD refs/heads/main
synced
if refused_sync 'main has no commit yet' none "$seed"; then r=0; else r=1; fi
check "the sync refuses a main without a commit before it fetches" "$r"

for dirt in changed staged untracked hidden; do
	new_sync_pair "syncdirty$dirt"
	commit_in "$origin" landed
	case $dirt in
		changed) step write_file "$primary/seed.txt" 'changed seed' ;;
		staged) step write_file "$primary/seed.txt" 'staged seed' && step git -C "$primary" add seed.txt ;;
		untracked) step write_file "$primary/stray.txt" 'stray' ;;
		hidden) step git -C "$primary" config status.showUntrackedFiles no && step write_file "$primary/stray.txt" 'stray' ;;
	esac
	synced
	if refused_sync 'the checkout holds a change or an untracked file' "$seed" "$seed"; then r=0; else r=1; fi
	check "the sync refuses a checkout with a file $dirt before it fetches" "$r"
done

# Each refspec value below is set alone, or as the second of two beside the default, or as the
# first of two before it, so a check that reads one value of several fails a case.
for refspec in '+refs/heads/*:refs/heads/*|alone|does not map a branch onto refs/remotes/origin/' \
	'+refs/tags/*:refs/remotes/origin/*|after|does not map a branch onto refs/remotes/origin/' \
	'+refs/tags/*:refs/remotes/origin/*|before|does not map a branch onto refs/remotes/origin/' \
	'+refs/heads/*:refs/remotes/upstream/*|alone|does not map a branch onto refs/remotes/origin/' \
	'refs/heads/main|alone|does not map a branch onto refs/remotes/origin/' \
	'+refs/heads/:refs/remotes/origin/|alone|does not map a branch onto refs/remotes/origin/' \
	'+refs/heads/feature:refs/remotes/origin/main|after|maps a branch onto another name' \
	'+refs/heads/*:refs/remotes/origin/x/*|alone|maps a branch onto another name' \
	'+refs/heads/side:refs/remotes/origin/side|alone|no fetch refspec of origin brings main' \
	'^refs/heads/main|after|leaves main out' \
	'^refs/heads/*|after|leaves main out' \
	'|none|no fetch refspec of origin brings main'; do
	value=${refspec%%|*}
	rest=${refspec#*|}
	place=${rest%%|*}
	reason=${rest#*|}
	new_sync_pair "syncrefspec$place$(printf '%s' "$value" | tr -cd 'a-z')"
	commit_in "$origin" landed
	step git -C "$primary" config --unset-all remote.origin.fetch
	case $place in
		alone) step git -C "$primary" config --add remote.origin.fetch "$value" ;;
		after) step git -C "$primary" config --add remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*' \
			&& step git -C "$primary" config --add remote.origin.fetch "$value" ;;
		before) step git -C "$primary" config --add remote.origin.fetch "$value" \
			&& step git -C "$primary" config --add remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*' ;;
	esac
	synced
	if refused_sync "$reason" "$seed" "$seed"; then r=0; else r=1; fi
	check "the sync refuses the fetch refspec '$value' ($place) before it fetches" "$r"
done

for refspec in '+refs/heads/main:refs/remotes/origin/main' 'refs/heads/*:refs/remotes/origin/*' '^refs/heads/side'; do
	new_sync_pair "syncrefspecok$(printf '%s' "$refspec" | tr -cd 'a-z')"
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	case $refspec in
		^*) step git -C "$primary" config --add remote.origin.fetch "$refspec" ;;
		*) step git -C "$primary" config --replace-all remote.origin.fetch "$refspec" ;;
	esac
	synced
	if in_step "$landed"; then r=0; else r=1; fi
	check "the sync takes the fetch refspec '$refspec'" "$r"
done

# A stand-in made in the primary checkout before the run, or brought by the fetch itself; each
# stops the sync before main moves.
for stand_in in 'tag main|refs/tags/main could stand in' \
	'tag origin/main|refs/tags/origin/main could stand in' \
	'branch origin/main|refs/heads/origin/main could stand in' \
	'update-ref refs/main|refs/main could stand in' \
	'update-ref refs/origin/main|refs/origin/main could stand in' \
	'update-ref refs/tags/MAIN|refs/tags/MAIN could stand in' \
	'branch Main|refs/heads/Main could stand in' \
	'update-ref refs/heads/Origin/Main|refs/heads/Origin/Main could stand in'; do
	made=${stand_in%%|*}
	reason=${stand_in#*|}
	new_sync_pair "syncstandin$(printf '%s' "$made" | tr -cd 'a-zA-Z')"
	case $made in
		*[A-Z]*)
			if folds_case; then
				skip_case "the stand-in made by $made stops the sync" 'the file system folds case'
				continue
			fi
			;;
	esac
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	case $made in
		update-ref*) step git -C "$primary" ${made} "$seed" ;;
		*) step git -C "$primary" ${made} ;;
	esac
	synced
	if stopped "$reason" "$seed" "$landed"; then r=0; else r=1; fi
	check "the stand-in made by $made stops the sync" "$r"
done

new_sync_pair syncfetchedtag
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
step git -C "$origin" tag main
synced
if stopped 'refs/tags/main could stand in' "$seed" "$landed"; then r=0; else r=1; fi
check "a tag main the fetch itself brings stops the sync" "$r"

new_sync_pair syncfetchedcase
if folds_case; then
	skip_case 'a branch the fetch brings whose name differs from main only in case stops the sync' 'the file system folds case'
else
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	step git -C "$origin" branch Main
	synced
	if stopped 'refs/remotes/origin/Main could stand in' "$seed" "$landed"; then r=0; else r=1; fi
	check "a branch the fetch brings whose name differs from main only in case stops the sync" "$r"
fi

for file in main origin/main; do
	for content in id text link; do
		new_sync_pair "synccommonfile$(printf '%s' "$file" | tr -cd 'a-z')$content"
		if [ "$content" = link ] && lacks_symlinks; then
			skip_case "a file $file in the common git dir ($content) stops the sync" 'git writes no symlinks'
			continue
		fi
		commit_in "$origin" landed
		landed=$(ref_in "$origin" refs/heads/main)
		step mkdir -p "$primary/.git/origin"
		case $content in
			id) step write_file "$primary/.git/$file" "$seed" ;;
			text) step write_file "$primary/.git/$file" 'no ref at all' ;;
			link) step ln -s no-such-target "$primary/.git/$file" ;;
		esac
		synced
		if stopped "the file $file in the common git dir" "$seed" "$landed"; then r=0; else r=1; fi
		check "a file $file in the common git dir ($content) stops the sync" "$r"
	done
done

for packed in main origin/main; do
	new_sync_pair "syncpacked$(printf '%s' "$packed" | tr -cd 'a-z')"
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	step git -C "$primary" pack-refs --all
	awk -v line="$seed $packed" 'NR == 1 { print; print line; next } { print }' "$primary/.git/packed-refs" \
		> "$primary/.git/packed-refs.edited" || step false
	step mv "$primary/.git/packed-refs.edited" "$primary/.git/packed-refs"
	synced
	if stopped "git resolves $packed to " "$seed" "$landed"; then r=0; else r=1; fi
	check "a packed-refs line $packed, which no ref list shows, stops the sync" "$r"
done

new_sync_pair syncbelowname
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
step git -C "$primary" update-ref refs/main/x "$seed"
step git -C "$primary" update-ref refs/tags/main/x "$seed"
synced
if in_step "$landed"; then r=0; else r=1; fi
check "a ref below the name main stands in for nothing, and the sync fast-forwards" "$r"

# A replace ref, a grafts file and a graft file named by a variable each make a diverged main read
# as an ancestor of origin/main.
for graft in replace file variable; do
	new_sync_pair "syncgraft$graft"
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	commit_in "$primary" own
	own=$(ref_in "$primary" refs/heads/main)
	step git -C "$primary" fetch -q origin
	case $graft in
		replace)
			step git -C "$primary" replace --graft "$landed" "$own"
			synced
			if stopped 'main and origin/main have diverged' "$own" "$landed"; then r=0; else r=1; fi
			;;
		file)
			step write_file "$primary/.git/info/grafts" "$landed $own"
			synced
			if refused_sync 'gives commits other parents than they hold' "$own" "$landed"; then r=0; else r=1; fi
			;;
		variable)
			step write_file "$work/$case_name-grafts" "$landed $own"
			sync_status=0
			(cd "$primary" && GIT_GRAFT_FILE="$work/$case_name-grafts" sh "$sync_local") \
				>"$work/sync-out" 2>"$work/printed" || sync_status=$?
			if stopped 'main and origin/main have diverged' "$own" "$landed"; then r=0; else r=1; fi
			;;
	esac
	check "a graft ($graft) makes no diverged main fast-forward" "$r"
done

new_sync_pair syncgitdir
commit_in "$origin" landed
step mkdir "$work/syncgitdir-plain"
sync_status=0
(cd "$work/syncgitdir-plain" && GIT_DIR="$primary/.git" GIT_WORK_TREE="$primary" sh "$sync_local") \
	>"$work/sync-out" 2>"$work/printed" || sync_status=$?
if refused_sync 'is not inside a git work tree' "$seed" "$seed"; then r=0; else r=1; fi
check "GIT_DIR and GIT_WORK_TREE do not point the sync at another repository" "$r"

# A second remote whose refspec writes origin/main, reached through a remote group named origin, a
# group given by variables alone, or a fetch of more than origin.
for second in group variables parameters beside tracking; do
	new_sync_pair "syncsecond$second"
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	step git clone -q "$origin" "$work/$case_name-other"
	step git -C "$work/$case_name-other" config user.email gate@example.com
	step git -C "$work/$case_name-other" config user.name Gate
	commit_in "$work/$case_name-other" foreign
	step git -C "$primary" remote add other "$work/$case_name-other"
	step git -C "$primary" config --replace-all remote.other.fetch '+refs/heads/main:refs/remotes/origin/main'
	case $second in
		group)
			step git -C "$primary" config remotes.origin other
			synced
			if refused_sync 'a remote group named origin makes the fetch read other remotes' "$seed" "$seed"; then r=0; else r=1; fi
			;;
		variables)
			sync_status=0
			(cd "$primary" && GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=remotes.origin GIT_CONFIG_VALUE_0=other sh "$sync_local") \
				>"$work/sync-out" 2>"$work/printed" || sync_status=$?
			if in_step "$landed"; then r=0; else r=1; fi
			;;
		parameters)
			sync_status=0
			(cd "$primary" && GIT_CONFIG_PARAMETERS="'remotes.origin'='other'" sh "$sync_local") \
				>"$work/sync-out" 2>"$work/printed" || sync_status=$?
			if in_step "$landed"; then r=0; else r=1; fi
			;;
		beside)
			synced
			if in_step "$landed"; then r=0; else r=1; fi
			;;
		tracking)
			step git -C "$primary" config branch.main.remote other
			synced
			if in_step "$landed"; then r=0; else r=1; fi
			;;
	esac
	check "a second remote writing origin/main ($second) never decides where main goes" "$r"
done

# The fast-forward names the commit the checks read: origin/main moved just before git merges
# leaves main at the commit checked.
new_sync_pair syncbyid
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
later=$(git -C "$origin" commit-tree "$landed^{tree}" -p "$landed" -m later 2>/dev/null || echo none)
step git -C "$origin" update-ref refs/heads/side "$later"
step write_file "$work/$case_name-stub/git" '#!/bin/sh' \
	"case \"\$1\" in merge) '$real_git' update-ref refs/remotes/origin/main '$later' ;; esac" \
	"exec '$real_git' \"\$@\""
step chmod +x "$work/$case_name-stub/git"
sync_status=0
(cd "$primary" && PATH="$work/$case_name-stub:$PATH" sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$?
if [ "$sync_status" -eq 0 ] && [ "$(ref_in "$primary" refs/heads/main)" = "$landed" ]; then r=0; else r=1; fi
check "main fast-forwards to the id the checks read, not to where origin/main moved after them" "$r"

# git's own --ff-only refuses a fast-forward that a wrong answer of the ancestry read let through.
new_sync_pair syncffonly
commit_in "$origin" landed
commit_in "$primary" own
own=$(ref_in "$primary" refs/heads/main)
step write_file "$work/$case_name-stub/git" '#!/bin/sh' \
	'case "$*" in "merge-base --is-ancestor"*) exit 0 ;; esac' \
	"exec '$real_git' \"\$@\""
step chmod +x "$work/$case_name-stub/git"
sync_status=0
(cd "$primary" && PATH="$work/$case_name-stub:$PATH" sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$?
if [ "$sync_status" -eq 1 ] && printed 'git refused the fast-forward' && [ "$(ref_in "$primary" refs/heads/main)" = "$own" ]; then r=0; else r=1; fi
check "git itself refuses a fast-forward the ancestry read wrongly allowed" "$r"

# A branch whose name only starts with main, at the stale id, is no main the fetch brought.
new_sync_pair syncnomainlike
step git -C "$origin" branch mainline
step git -C "$origin" branch -m main trunk
commit_in "$origin" landed
synced
if stopped "this fetch brought no main of origin at $seed" "$seed" "$seed"; then r=0; else r=1; fi
check "a branch mainline at the stale id is no main the fetch brought" "$r"

# GIT_NAMESPACE, no local variable of git's, would let a file-path origin serve a namespaced ref as
# its main.
new_sync_pair syncnamespace
step git -C "$origin" switch -q -c side
commit_in "$origin" sidework
side=$(ref_in "$origin" refs/heads/side)
step git -C "$origin" switch -q main
step git -C "$origin" update-ref refs/namespaces/x/refs/heads/main "$side"
sync_status=0
(cd "$primary" && GIT_NAMESPACE=x sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$?
if in_step "$seed"; then r=0; else r=1; fi
check "GIT_NAMESPACE does not hand the sync another main of origin" "$r"

new_sync_pair syncindexfile
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
sync_status=0
(cd "$primary" && GIT_INDEX_FILE="$work/$case_name-index" sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$?
if in_step "$landed"; then r=0; else r=1; fi
check "GIT_INDEX_FILE does not hand the sync another index" "$r"

new_sync_pair syncemptygrafts
commit_in "$origin" landed
landed=$(ref_in "$origin" refs/heads/main)
step touch "$primary/.git/info/grafts"
synced
if in_step "$landed"; then r=0; else r=1; fi
check "an empty grafts file grafts nothing, and the sync fast-forwards" "$r"

# The version check: a git that reports an older version, one at the minimum, and one whose answer
# names no version.
for reported in 1.9.5 2.30.9 2.31.0 2.100.0 3.0.0 x twolines longfield; do
	new_sync_pair "syncversion$(printf '%s' "$reported" | tr -cd 'a-z0-9')"
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	case $reported in
		twolines) answer='git version 1.9.0\ngit version 2.40.0' ;;
		longfield) answer='git version 2.12345678901234567890.0' ;;
		*) answer="git version $reported" ;;
	esac
	step write_file "$work/$case_name-stub/git" '#!/bin/sh' \
		"if [ \"\$*\" = --version ]; then printf '$answer\\n'; exit 0; fi" \
		"exec '$real_git' \"\$@\""
	step chmod +x "$work/$case_name-stub/git"
	sync_status=0
	(cd "$primary" && PATH="$work/$case_name-stub:$PATH" sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$?
	case $reported in
		1.9.5|2.30.9) if refused_sync "git version $reported is older than git 2.31" "$seed" "$seed"; then r=0; else r=1; fi ;;
		2.31.0|2.100.0|3.0.0) if in_step "$landed"; then r=0; else r=1; fi ;;
		x) if refused_sync "git names its version 'git version x', which the sync cannot read" "$seed" "$seed"; then r=0; else r=1; fi ;;
		*) if refused_sync 'which the sync cannot read' "$seed" "$seed"; then r=0; else r=1; fi ;;
	esac
	check "a git that reports version $reported is held to git 2.31" "$r"
done

# A post-merge hook stands in for anything that moves main or HEAD between git's fast-forward and
# the script's last read.
for command in 'git update-ref refs/heads/main HEAD~1' 'git symbolic-ref HEAD refs/heads/other'; do
	new_sync_pair "syncmoved$(printf '%s' "$command" | tr -cd 'a-z')"
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	step write_file "$work/$case_name-hooks/post-merge" '#!/bin/sh' "$command"
	step chmod +x "$work/$case_name-hooks/post-merge"
	step git -C "$primary" config core.hooksPath "$work/$case_name-hooks"
	case $command in
		*update-ref*) reason="main is at $seed after the fast-forward, not at the commit checked, $landed" ;;
		*) reason='the checkout is on refs/heads/other after the fast-forward, not on refs/heads/main' ;;
	esac
	synced
	if [ "$sync_status" -eq 1 ] && printed "$reason"; then r=0; else r=1; fi
	check "the sync stops where main or HEAD is not where the fast-forward left it ($command)" "$r"
done

for failing in '--git-dir|1|0|2|git could not name the git dir' \
	'--git-common-dir|1|0|2|git could not name the common git dir' \
	'status --porcelain|1|0|2|git could not read the state of the checkout' \
	'--get remote.origin.url|1|0|2|git could not read the url of origin' \
	'--get-all remotes.origin|1|0|2|git could not read the remote groups' \
	'--get-all remote.origin.fetch|1|0|2|git could not read the fetch refspecs of origin' \
	'^rev-parse --verify --symbolic-full-name|1|1|2|git could not resolve main' \
	'^rev-parse --verify --symbolic-full-name|2|1|2|git could not resolve origin/main' \
	'^--version|1|0|2|git could not name its version' \
	'^rev-parse --local-env-vars|1|0|2|git could not name its own repository variables' \
	'^for-each-ref|1|1|2|git could not list the refs that could stand in' \
	'^show-ref --verify --hash refs/heads/main|1|1|2|git could not read main' \
	'^merge-base|1|1|2|git could not compare main with origin/main' \
	'^merge-base|2|2|2|git could not compare main with origin/main' \
	'^rev-list --count|1|2|2|git could not count the commits main holds' \
	'^merge --ff-only|1|1|1|git refused the fast-forward to '; do
	pattern=${failing%%|*}
	rest=${failing#*|}
	nth=${rest%%|*}
	rest=${rest#*|}
	setup=${rest%%|*}
	rest=${rest#*|}
	expected=${rest%%|*}
	reason=${rest#*|}
	new_sync_pair "syncgitfails$nth$(printf '%s' "$pattern" | tr -cd 'a-z')"
	case $setup in
		1) commit_in "$origin" landed ;;
		2) commit_in "$primary" own ;;
	esac
	before=$(ref_in "$primary" refs/heads/main)
	sync_with_failing_git "$pattern" "$nth"
	if [ "$sync_status" -eq "$expected" ] && printed "$reason" && [ "$(ref_in "$primary" refs/heads/main)" = "$before" ]; then r=0; else r=1; fi
	check "the sync ends with exit $expected where $reason, main where it was" "$r"
done

# MODULE agent-seat
# On the seat the sync's fetch prunes; elsewhere the remote-tracking ref of a branch origin dropped
# stays.
for seat in unattended attended unset; do
	new_sync_pair "syncseat$seat"
	step git -C "$origin" branch gone
	step git -C "$primary" fetch -q origin
	step git -C "$origin" branch -q -d gone
	commit_in "$origin" landed
	landed=$(ref_in "$origin" refs/heads/main)
	sync_status=0
	case $seat in
		unset) (cd "$primary" && unset AGENT_SEAT && sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$? ;;
		*) (cd "$primary" && AGENT_SEAT=$seat sh "$sync_local") >"$work/sync-out" 2>"$work/printed" || sync_status=$? ;;
	esac
	gone=$(ref_in "$primary" refs/remotes/origin/gone)
	if [ "$seat" = unattended ]; then
		if in_step "$landed" && [ "$gone" = none ]; then r=0; else r=1; fi
		check "on the seat the sync's fetch drops the remote-tracking ref of a branch origin no longer holds" "$r"
	else
		if in_step "$landed" && [ "$gone" = "$seed" ]; then r=0; else r=1; fi
		check "with AGENT_SEAT $seat the sync's fetch keeps the remote-tracking ref of a dropped branch" "$r"
	fi
done
# /MODULE agent-seat

# MODULE agent-seat
# The pre-push cases push to a bare repository beside the case's own, named origin by its file path,
# and read every verdict from the refs that repository holds afterwards. A setup push passes
# --no-verify, so only the push under test asks the hook. The hook they ask is a copy of pre-push,
# beside the content gate and the breach guard it calls, whose branch_prefix line reads the shipped
# claude/, so a project's own prefix (/adopt, step 5) leaves the cases as they are. No other hook
# lies in that folder, so a case writes a breach record by hand.
hook_copy() {
	mkdir -p "$work/$1" \
		&& sed "s#^branch_prefix='.*'\$#branch_prefix='$2'#" "$hooks_dir/pre-push" > "$work/$1/pre-push" \
		&& grep -q "^branch_prefix='$2'\$" "$work/$1/pre-push" \
		&& cp "$hooks_dir/content-gate" "$hooks_dir/breach-guard" "$work/$1/" \
		&& chmod +x "$work/$1/pre-push" "$work/$1/content-gate" "$work/$1/breach-guard"
}

new_pushing_repo() {
	new_repo "$1"
	remote="$work/$1.git"
	step git init -q --bare "$remote"
	step git remote add origin "$remote"
	[ -d "$work/shipped" ] || step hook_copy shipped claude/
	step git config core.hooksPath "$work/shipped"
}

held() { git --git-dir="$remote" rev-parse --verify --quiet "$1" 2>/dev/null || echo none; }

push_under_test() { git push -q "$@" >/dev/null 2>"$work/printed" || true; }

commit_as() {
	step git add -A
	step git commit -q --no-verify -m "$1"
}


new_pushing_repo prepush_agent
clean_file Work
commit_as "Add work"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = "$(git rev-parse HEAD)" ]; then r=0; else r=1; fi
check "a push of a claude/ branch reaches the remote" "$r"

new_pushing_repo prepush_main
clean_file Work
commit_as "Add work"
push_under_test origin HEAD:refs/heads/main
if [ "$(held refs/heads/main)" = "$(git rev-parse HEAD)" ]; then r=0; else r=1; fi
check "a push of main reaches the remote" "$r"

new_pushing_repo prepush_tag
push_under_test origin HEAD:refs/tags/v1
if [ "$(held refs/tags/v1)" = "$(git rev-parse HEAD)" ]; then r=0; else r=1; fi
check "a push of a tag reaches the remote" "$r"

new_pushing_repo prepush_other
push_under_test origin HEAD:refs/heads/topic
if [ "$(held refs/heads/topic)" = none ] && printed 'refs/heads/topic is refused'; then r=0; else r=1; fi
check "a push of a branch that is neither claude/ nor main leaves the remote without it" "$r"

new_pushing_repo prepush_prefixless
step hook_copy prefixless ''
step git config core.hooksPath "$work/prefixless"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = none ] && printed 'refs/heads/claude/work is refused'; then r=0; else r=1; fi
check "with an empty branch prefix a push of a claude/ branch leaves the remote without it" "$r"

new_pushing_repo prepush_wip
clean_file Work
commit_as "[wip] Add work"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = none ] && printed 'is a [wip] commit'; then r=0; else r=1; fi
check "a push whose tip is a [wip] commit leaves the remote without the branch" "$r"

new_pushing_repo prepush_wip_case
clean_file Work
commit_as "  [WIP] Add work"
