# Two edits two lines apart: under diff.interHunkContext git would join their hunks and print the
# lines between them as context, and a count of the added lines alone numbers the second edit low.
inter_hunk_repo() {
	new_repo "$1"
	write_file Noted.java 'class Noted {' '	int a = 1;' '	int b = 2;' '	int c = 3;' '}'
	step git add -A
	step git commit -q --no-verify -m "Add noted class"
	step git config diff.interHunkContext 3
	write_file Noted.java 'class Noted {' '	int a = 10;' '	int b = 2;' "$2" '}'
}

inter_hunk_repo commentinterhunk '	int c = 3; // explains c'
if refuses "Change noted class" 'explanatory comment(s) added'; then r=0; else r=1; fi
