step git replace "$wip" "$(git commit-tree "$wip^{tree}" -p "$wip^" -m 'Add draft')"
push_under_test origin "$wip:refs/heads/claude/work"
if [ "$(held refs/heads/claude/work)" = none ] && printed 'is a [wip] commit'; then r=0; else r=1; fi
check "a replace ref hides no [wip] commit from the pushed range" "$r"

new_pushing_repo prepush_replaced_gate
secret_file config.txt
commit_as "Add config"
secret=$(git rev-parse HEAD)
