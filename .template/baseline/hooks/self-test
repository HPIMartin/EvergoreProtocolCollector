# A reword whose new message commit-msg refuses stops the rebase for an amend of the reworded commit.
new_repo rewordstop
write_file "$work/bad-message" 'printf "added the seed\n" > "$1"'
printf '%s\n' '1s/^pick/reword/' > "$work/todo.sed"
GIT_EDITOR="sh '$work/bad-message'" GIT_SEQUENCE_EDITOR="sh '$work/todo-editor'" git rebase -i HEAD~1 >/dev/null 2>&1 || true
before=$(git rev-parse HEAD)
if at_edit_stop; then git commit -q --amend -m "Add the third seed" >/dev/null 2>&1 || true; fi
if [ "$(git rev-parse HEAD)" != "$before" ]; then r=0; else r=1; fi
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
check "an amend at a reword stop folds into the reworded commit" "$r"

new_repo staleRebaseHead
step edit_todo '1s/^pick/edit/' HEAD~1 >/dev/null 2>&1
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
clean_file After
if git rev-parse -q --verify REBASE_HEAD >/dev/null && accepts "Add after class"; then r=0; else r=1; fi
check "a commit after a finished rebase that left REBASE_HEAD behind is let through" "$r"

# The landing collapse of the template's own strands: every pick after the first becomes a fixup,
# then the finished result is amended with the confirmed message.
new_repo collapse
base=$(git rev-parse HEAD)
step git checkout -q -b strand
clean_file First
step git add -A
step git commit -q --no-verify -m "Add first class"
clean_file Second
step git add -A
step git commit -q --no-verify -m "Add second class"
step edit_todo '2,$s/^pick/fixup/' "$base" >/dev/null 2>&1
before=$(git rev-parse HEAD)
git commit -q --amend -m "Add the strand classes" >/dev/null 2>&1 || true
if [ "$(git rev-parse HEAD)" != "$before" ] && [ "$(git rev-list --count "$base"..HEAD)" -eq 1 ]; then r=0; else r=1; fi
check "the landing collapse, fixups and then an amend once the rebase finished, commits" "$r"

conflicted_file() {
	write_file "$1" 'before' '<<<<<<< HEAD' 'ours' '=======' 'theirs' '>>>>>>> 1a2b3c4 (Change the line)' 'after'
}

