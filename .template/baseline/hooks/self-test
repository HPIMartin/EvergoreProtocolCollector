# Two worktrees rewrite at once: B amends while A's post-rewrite stands between finding a commit and
# its one append to the record. A runs a copy of the hooks whose content gate starts B's amend when
# asked about the second rewritten commit, so the interleaving is the same on every run.
new_repo rewriterace
step git worktree add -q -b race-side "$work/rewriterace-side" HEAD >/dev/null 2>&1
clean=$(git rev-parse HEAD)
smelly_file Loud
step git add -A
step git commit -q --no-verify -m "Add loud class"
loud=$(git rev-parse HEAD)
clean_file Calm
step git add -A
step git commit -q --no-verify -m "Add calm class"
calm=$(git rev-parse HEAD)
step mkdir "$work/race-hooks"
step cp "$hooks_dir"/* "$work/race-hooks/"
write_file "$work/race-hooks/content-gate" '#!/bin/sh' \
	"if [ \"\$2\" = $calm ]; then (cd '$work/rewriterace-side' && git commit -q --amend -m 'Add the side seed') >/dev/null 2>&1; fi" \
	"exec '$hooks_dir/content-gate' \"\$@\""
step chmod +x "$work/race-hooks/content-gate"
side_before=$(git -C "$work/rewriterace-side" rev-parse HEAD) || broken=1
printf '%s %s\n%s %s\n' "$clean" "$loud" "$loud" "$calm" | sh "$work/race-hooks/post-rewrite" rebase >/dev/null 2>&1 || true
step [ "$(git -C "$work/rewriterace-side" rev-parse HEAD)" != "$side_before" ]
clean_file Next
if refuses "Add next class" "$loud"; then r=0; else r=1; fi
check "an amend in another worktree while post-rewrite runs leaves the commit it found in the record" "$r"

