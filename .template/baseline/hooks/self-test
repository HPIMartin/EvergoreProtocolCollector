if [ "$(commits)" -eq "$before" ] && printed 'the message must be a single line'; then r=0; else r=1; fi
check "a # line in a -F message file leaves no commit behind" "$r"

new_repo messageeditor
clean_file Parser
write_file "$work/subject-editor" '{ printf "Add the parser\n"; cat "$1"; } > "$1.new" && mv "$1.new" "$1"'
step git add -A
before=$(commits)
GIT_EDITOR="sh '$work/subject-editor'" git commit -q >/dev/null 2>"$work/printed" || true
if [ "$(commits)" -eq $((before + 1)) ]; then r=0; else r=1; fi
check "an editor session's template comments are stripped before the message is judged" "$r"

# A caller's own GIT_EDITOR=: cannot be told from the one git sets where it opens no editor, so the
# template lines of that editor session are judged (hooks/README.md, known residue).
new_repo messageeditorcolon
before=$(git rev-parse HEAD)
GIT_EDITOR=: git commit -q --amend >/dev/null 2>"$work/printed" || true
if [ "$(git rev-parse HEAD)" = "$before" ] && printed 'the message must be a single line'; then r=0; else r=1; fi
check "an amend under a caller's own GIT_EDITOR=: is refused for git's template lines, as documented" "$r"

ticket_key='[A-Z][A-Z0-9]+-[0-9]+'

commits_with_ticket() {
	required=no
	if [ "$3" = required ]; then required=yes; fi
	step git add -A
	before=$(commits)
	COMMIT_MSG_TICKET_KEY_RE=$1 COMMIT_MSG_TICKET_POSITION=$2 COMMIT_MSG_TICKET_REQUIRED=$required \
		git commit -q -m "$4" >/dev/null 2>"$work/printed" || true
	[ "$(commits)" -eq $((before + 1)) ]
}

new_repo ticketoff
clean_file Plain
if accepts "Add the plain class (PROJ-12)"; then r=0; else r=1; fi
check "no ticket pattern configured leaves a parenthesised subject alone" "$r"

new_repo ticketsuffix
clean_file Parser
if commits_with_ticket "$ticket_key" suffix optional "Add the parser (PROJ-12)"; then r=0; else r=1; fi
check "a suffix ticket key is accepted where suffix is configured" "$r"
clean_file Lexer
if ! commits_with_ticket "$ticket_key" suffix optional "[PROJ-12] Add the lexer" && printed 'the ticket key belongs at the end'; then r=0; else r=1; fi
check "a prefix ticket key is refused where suffix is configured" "$r"
clean_file Reader
if ! commits_with_ticket "$ticket_key" suffix optional "Add the reader (proj12)" && printed 'the trailing group is no ticket key'; then r=0; else r=1; fi
check "a malformed ticket key is refused" "$r"
clean_file Writer
if commits_with_ticket "$ticket_key" suffix optional "Add the writer"; then r=0; else r=1; fi
check "an optional ticket key may be left out" "$r"

new_repo ticketprefix
clean_file Parser
if commits_with_ticket "$ticket_key" prefix optional "[PROJ-12] Add the parser"; then r=0; else r=1; fi
check "a prefix ticket key is accepted where prefix is configured" "$r"
clean_file Backlog
if commits_with_ticket "$ticket_key" prefix optional "[PROJ-12] [doc] Groom the backlog"; then r=0; else r=1; fi
check "a doc tag sits behind the ticket prefix" "$r"
clean_file Lexer
if ! commits_with_ticket "$ticket_key" prefix optional "Add the lexer (PROJ-12)" && printed 'the ticket key belongs in front'; then r=0; else r=1; fi
check "a suffix ticket key is refused where prefix is configured" "$r"
clean_file Reader
if ! commits_with_ticket "$ticket_key" prefix optional "[proj12] Add the reader" && printed 'the leading tag is no ticket key'; then r=0; else r=1; fi
check "a leading tag that is no ticket key is refused where prefix is configured" "$r"

new_repo ticketrequired
clean_file Parser
if ! commits_with_ticket "$ticket_key" suffix required "Add the parser" && printed 'requires a ticket key'; then r=0; else r=1; fi
check "a required ticket key that is missing is refused" "$r"
clean_file Lexer
if commits_with_ticket "$ticket_key" suffix required "Add the lexer (PROJ-12)"; then r=0; else r=1; fi
check "a required ticket key that is there is accepted" "$r"
clean_file Writer
if ! commits_with_ticket "$ticket_key" prefix required "Add the writer" && printed 'requires a ticket key'; then r=0; else r=1; fi
check "a required ticket key that is missing is refused where prefix is configured" "$r"

new_repo ticketdefaults
clean_file Parser
step git add -A
before=$(commits)
COMMIT_MSG_TICKET_KEY_RE=$ticket_key git commit -q -m "Add the parser (PROJ-12)" >/dev/null 2>&1 || true
if [ "$(commits)" -eq $((before + 1)) ]; then r=0; else r=1; fi
check "the shipped ticket defaults are the suffix position and no requirement" "$r"

# Commits a stub self-test of the given folder that exits with the given status, beside one tool,
# so the folder keeps a file when the stub leaves the index.
leg_suite() {
	write_file "$1/self-test" '#!/bin/sh' "exit $2"
	step chmod +x "$1/self-test"
	write_file "$1/$3" '#!/bin/sh' 'exit 0'
	step git add -A
	step git commit -q --no-verify -m "Add the $1 self-test"
}

# Stages a stub self-test of the given folder that exits with the given status, and puts the
# committed one back in the work tree, so the index and the work tree hold different suites.
stage_suite() {
	step cp "$1/self-test" "$work/worktree-suite"
	write_file "$1/self-test" '#!/bin/sh' "exit $2"
	step git add "$1/self-test"
	step cp "$work/worktree-suite" "$1/self-test"
}

# The hooks/ leg's cases run in a repository laid out like this one: copies of the hooks under
# hooks/, wired as core.hooksPath=hooks, with a stub suite there that exits with the given status.
# The hook under test is this pre-commit, and the suite it runs is the stub, never this one.
hooks_leg_repo() {
	new_repo "$1"
	step mkdir hooks
	step cp "$hooks_dir"/* hooks/
	write_file hooks/self-test '#!/bin/sh' "exit $2"
	step chmod +x hooks/self-test
	step git config core.hooksPath hooks
	step git add -A
	step git commit -q --no-verify -m "Add the hooks"
}

hooks_leg_repo hooksleg_staged 0
stage_suite hooks 1
if refuses_staged "Change the hook self-test" 'hooks/self-test fails'; then r=0; else r=1; fi
check "a failing hooks self-test staged beside a passing one in the work tree leaves no commit behind" "$r"

hooks_leg_repo hooksleg_unstaged 1
stage_suite hooks 0
if accepts_staged "Change the hook self-test"; then r=0; else r=1; fi
check "a passing hooks self-test staged beside a failing one in the work tree commits" "$r"

hooks_leg_repo hooksleg_uncached 0
step git rm -q --cached hooks/self-test
if refuses_staged "Untrack the hook self-test" 'hooks/self-test is missing'; then r=0; else r=1; fi
check "untracking the hooks self-test while the work tree keeps it leaves no commit behind" "$r"

