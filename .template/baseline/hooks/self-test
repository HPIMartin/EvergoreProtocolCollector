new_repo breachsha256 --object-format=sha256
record_tip Loud
recorded=$(git rev-parse HEAD)
clean_file Next
if [ "${#recorded}" -eq 64 ] && refuses "Add next class" "$recorded"; then r=0; else r=1; fi
check "a recorded commit refuses in a sha256 repository, naming its 64-digit id" "$r"
step git rm -q --cached Next.java
step edit_todo '1s/^pick/edit/' HEAD~1 >/dev/null 2>&1
clean_file Loud
step git add Loud.java
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
if ! git merge-base --is-ancestor "$recorded" HEAD 2>/dev/null && accepts "Add next class"; then r=0; else r=1; fi
check "rewriting the recorded commit away in a sha256 repository ends the block" "$r"

new_repo breachroot
