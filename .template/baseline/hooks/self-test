# A record the committer cannot write would lose the next breach a writer finds, so it refuses every
# commit, also one whose HEAD reaches no recorded commit. Root writes a read-only file all the same,
# so the case cannot be staged as root.
new_repo breachreadonly
record_tip Loud
step git checkout -q -b strand HEAD~1
step chmod a-w "$repo/.git/gate-record"
if [ ! -w "$repo/.git/gate-record" ]; then
	clean_file Next
	if refuses "Add next class" '.git/gate-record' && printed 'could not record a later breach'; then r=0; else r=1; fi
	check "a breach record the committer cannot write refuses every commit, naming the file" "$r"
else
	printf '  skip a breach record the committer cannot write refuses every commit: a read-only file can be written here, as by root\n'
fi
step chmod u+w "$repo/.git/gate-record"

# An unborn HEAD reaches nothing, yet the record is read and checked first, so a broken record
# refuses the first commit of an orphan branch too.
