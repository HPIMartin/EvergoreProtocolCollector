smelly_file Noisy
step git add -A
git commit -q --amend --no-verify --no-edit >/dev/null 2>&1 || true
rewritten=$(git rev-parse HEAD)
clean_file Next
if refuses "Add next class" "$rewritten" && ends_in_newline; then r=0; else r=1; fi
check "an amend recorded by post-rewrite after a release line without its newline refuses, naming it" "$r"

new_repo appendmerge
released_without_newline
base_branch=main
topic_branch
git merge --no-verify --no-ff --no-edit topic >/dev/null 2>&1 || true
merged=$(git rev-parse HEAD)
clean_file Next
if merge_written && refuses "Add next class" "$merged" && ends_in_newline; then r=0; else r=1; fi
check "a merge recorded by post-merge after a release line without its newline refuses, naming it" "$r"

new_repo appendmergecommit
