# The hook-skipping routes to a merge commit: none can be refused before it exists, so the commit
# is recorded afterwards and the next commit is refused, as for an ungated rebase.
merge_written() { git rev-parse -q --verify HEAD^2 >/dev/null && [ ! -f "$(git rev-parse --git-path MERGE_HEAD)" ]; }

new_repo bypassmerge
