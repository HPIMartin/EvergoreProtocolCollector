push_under_test origin "$secret:refs/heads/claude/work"
if [ "$(held refs/heads/claude/work)" = none ] && printed 'possible secret or personal/host data'; then r=0; else r=1; fi
check "a replace ref hides no commit the content gate refuses from the pushed range" "$r"

new_pushing_repo prepush_breach
clean_file Work
commit_as "Add work"
recorded=$(git rev-parse HEAD)
step printf '\n%s\n' "$recorded" >> "$repo/.git/gate-record"
clean_file More
commit_as "Add more"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = none ] && printed 'recorded as a breach' && printed "$recorded"; then r=0; else r=1; fi
check "a push whose tip reaches a recorded commit leaves the remote without the branch, naming the commit" "$r"
step printf '\nreleased %s 2026-01-01 Gate\n' "$recorded" >> "$repo/.git/gate-record"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = "$(git rev-parse HEAD)" ]; then r=0; else r=1; fi
check "once the recorded commit is released the same push reaches the remote" "$r"

new_pushing_repo prepush_breach_unreadable
step printf '\nno entry and no release line\n' >> "$repo/.git/gate-record"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = none ] && printed 'git failed to read the breach record'; then r=0; else r=1; fi
check "a push while the breach record cannot be read leaves the remote without the branch" "$r"

merged_topic() {
	base_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
	step git checkout -q -b topic
	clean_file Topic
	commit_as "Add topic class"
	step git checkout -q "$base_branch"
	clean_file Work
	commit_as "Add work"
	git merge --no-ff --no-edit topic >/dev/null 2>&1 || true
	step git rev-parse --verify --quiet 'HEAD^2' >/dev/null
}

new_pushing_repo prepush_merge
merged_topic
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = none ] && printed 'is a merge commit'; then r=0; else r=1; fi
check "a push whose tip is a merge commit leaves the remote without the branch" "$r"
clean_file After
commit_as "Add after class"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = none ] && printed 'is a merge commit'; then r=0; else r=1; fi
check "a push holding a merge commit below its tip leaves the remote without the branch" "$r"

new_pushing_repo prepush_pushed_merge
merged_topic
step git push -q --no-verify origin HEAD:refs/heads/main
clean_file After
commit_as "Add after class"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = "$(git rev-parse HEAD)" ]; then r=0; else r=1; fi
check "a merge commit a remote-tracking ref already holds does not refuse a later push" "$r"

new_pushing_repo prepush_annotated_tag
step git tag -a -m "Tag the tip" v1 HEAD
push_under_test origin refs/tags/v1
if [ "$(held refs/tags/v1)" = "$(git rev-parse v1)" ]; then r=0; else r=1; fi
check "a push of an annotated tag on a clean commit reaches the remote" "$r"

new_pushing_repo prepush_annotated_wip
clean_file Draft
commit_as "[wip] Add draft"
step git tag -a -m "Tag the draft" v1 HEAD
push_under_test origin refs/tags/v1
if [ "$(held refs/tags/v1)" = none ] && printed 'is a [wip] commit'; then r=0; else r=1; fi
check "a push of an annotated tag on a [wip] commit leaves the remote without the tag" "$r"

# The hook called directly, with the ref lines on its standard input as git hands them over: the
# paths a healthy `git push` never takes. git puts its exec path ahead of PATH for a hook it runs
# itself, so only a direct call meets the stub git. Each verdict is the hook's exit status and what
# it printed.
zero_id=0000000000000000000000000000000000000000
pushed_line() { printf '%s %s %s %s' "$1" "$2" "$1" "$zero_id"; }

hook_directly() {
	lines=$1
	shift
	printf '%s\n' "$lines" | sh "$work/shipped/pre-push" "$@" >/dev/null 2>"$work/printed"
}

# Arguments: the pattern, which matching call fails, then the ref lines.
hook_with_failing_git() {
	echo 0 > "$work/stub-count"
	printf '%s\n' "$3" | STUB_FAIL_MATCH=$1 STUB_FAIL_NTH=$2 STUB_COUNT="$work/stub-count" PATH="$work/git-stub:$PATH" \
		sh "$work/shipped/pre-push" origin "$remote" >/dev/null 2>"$work/printed"
}

new_pushing_repo prepush_direct
clean_file Work
commit_as "Add work"
branch_line=$(pushed_line refs/heads/claude/work "$(git rev-parse HEAD)")
hook_directly "$branch_line" origin "$remote" && status=0 || status=$?
if [ "$status" -eq 0 ]; then r=0; else r=1; fi
check "the hook called directly with a clean claude/ tip passes" "$r"
hook_directly "$branch_line" origin && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'this run got 1 argument(s)'; then r=0; else r=1; fi
check "the hook refuses a call with one argument" "$r"
hook_directly "$branch_line" origin "$remote" extra && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'this run got 3 argument(s)'; then r=0; else r=1; fi
check "the hook refuses a call with three arguments" "$r"
hook_directly "refs/heads/claude/work $(git rev-parse HEAD) refs/heads/claude/work" origin "$remote" && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'git failed to read the pushed ref line'; then r=0; else r=1; fi
check "the hook refuses a ref line of three fields" "$r"
hook_directly "$(pushed_line refs/heads/claude/work 1234567890123456789012345678901234567890)" origin "$remote" && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'git failed to read the object pushed to refs/heads/claude/work'; then r=0; else r=1; fi
check "the hook refuses an object id the repository does not hold" "$r"
hook_with_failing_git '^remote $' 1 "$branch_line" && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'git failed to read the configured remotes'; then r=0; else r=1; fi
check "the hook refuses when git cannot list the remotes" "$r"
hook_with_failing_git '^cat-file -t ' 1 "$branch_line" && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'git failed to read the object pushed to refs/heads/claude/work'; then r=0; else r=1; fi
check "the hook refuses when git cannot name the kind of the pushed object" "$r"
hook_with_failing_git '^log ' 1 "$branch_line" && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'git failed to read the commits pushed to refs/heads/claude/work'; then r=0; else r=1; fi
check "the hook refuses when git cannot list the pushed commits" "$r"
hook_with_failing_git '^rev-parse --short ' 1 "$branch_line" && status=0 || status=$?
if [ "$status" -eq 1 ] && printed "git failed to read commit $(git rev-parse HEAD)"; then r=0; else r=1; fi
check "the hook refuses when git cannot shorten the id of a pushed commit" "$r"
step git tag -a -m "Tag the tip" v1 HEAD
tag_line=$(pushed_line refs/tags/v1 "$(git rev-parse v1)")
hook_directly "$tag_line" origin "$remote" && status=0 || status=$?
if [ "$status" -eq 0 ]; then r=0; else r=1; fi
check "the hook called directly with an annotated tag on a clean commit passes" "$r"
hook_with_failing_git '^rev-parse --verify ' 1 "$tag_line" && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'git failed to read the object the tag pushed to refs/tags/v1 points at'; then r=0; else r=1; fi
check "the hook refuses when git cannot resolve what a pushed tag points at" "$r"
hook_with_failing_git '^cat-file -t ' 2 "$tag_line" && status=0 || status=$?
if [ "$status" -eq 1 ] && printed 'git failed to read the kind of the object the tag pushed to refs/tags/v1 points at'; then r=0; else r=1; fi
check "the hook refuses when git cannot name the kind of what a pushed tag points at" "$r"
# /MODULE agent-seat

# The closing checks belong to no case, so a FAIL of theirs prints nothing a case's hooks printed.
case_name=''
broken=0
: > "$work/printed"

# A hook staged non-executable is skipped outright by git on POSIX, so the gate would not narrate,
# it would not run at all; core.fileMode=false on a Windows host hides that from every local check.
# Fix a finding here with: git update-index --chmod=+x hooks/<name>
tracked=$(outer_git -C "$hooks_dir" ls-files -s -- "$hooks_dir" 2>/dev/null | grep -v '\.md$' || true)
if [ -z "$tracked" ]; then
	printf '  skip every tracked hook is staged executable: none tracked yet, so this proves nothing.\n'
	printf '       Stage them (git add hooks/) and re-run, or the first commit may record them 100644.\n'
else
	if printf '%s\n' "$tracked" | grep -qv '^100755 '; then r=1; else r=0; fi
	check "every tracked hook is staged executable (100755)" "$r"
fi

if [ "$outer_head" = "$(outer_git -C "$hooks_dir" rev-parse HEAD 2>/dev/null || echo none)" ] \
	&& [ "$outer_branch" = "$(outer_git -C "$hooks_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)" ]; then r=0; else r=1; fi
check "the cases left the surrounding repository's HEAD and branch untouched" "$r"

# Exit 1 for any failure, never the count: the hooks leg reads exit 2 with a last line that opens
# `hook self-test: `, as the summary below does, as a suite that cannot run here, and a count of 256
# would wrap to 0.
if [ "$failures" -eq 0 ]; then
	printf 'hook self-test: all cases pass\n'
else
	printf 'hook self-test: %s case(s) FAILED\n' "$failures" >&2
	exit 1
fi
