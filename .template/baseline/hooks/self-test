if [ "$(held refs/heads/claude/work)" = none ]; then r=0; else r=1; fi
check "a push holding a [wip] commit below its tip leaves the remote without the branch" "$r"

new_pushing_repo prepush_wip_tag
clean_file Draft
commit_as "[wip] Add draft"
push_under_test origin HEAD:refs/tags/v1
if [ "$(held refs/tags/v1)" = none ]; then r=0; else r=1; fi
check "a push of a tag on a [wip] commit leaves the remote without the tag" "$r"

new_pushing_repo prepush_tree_tag
step git tag -a -m "Tag the tree" treetag 'HEAD^{tree}'
push_under_test origin refs/tags/treetag
if [ "$(held refs/tags/treetag)" = "$(git rev-parse treetag)" ]; then r=0; else r=1; fi
check "a push of a tag that points at no commit reaches the remote" "$r"

new_pushing_repo prepush_gate
clean_file Work
commit_as "Add work"
pushed=$(git rev-parse HEAD)
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = "$pushed" ]; then r=0; else r=1; fi
check "a claude/ branch without the commit the content gate refuses reaches the remote" "$r"
secret_file config.txt
commit_as "Add config"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = "$pushed" ] && printed 'possible secret or personal/host data'; then r=0; else r=1; fi
check "a push holding a commit the content gate refuses leaves the remote branch where it was" "$r"

new_pushing_repo prepush_delete_agent
step git push -q --no-verify origin HEAD:refs/heads/claude/work
push_under_test origin :refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = none ]; then r=0; else r=1; fi
check "a push deleting a claude/ branch removes it from the remote" "$r"

new_pushing_repo prepush_delete_other
step git push -q --no-verify origin HEAD:refs/heads/topic
push_under_test origin :refs/heads/topic
if [ "$(held refs/heads/topic)" = "$(git rev-parse HEAD)" ] && printed 'refs/heads/topic is refused'; then r=0; else r=1; fi
check "a push deleting a branch that is neither claude/ nor main leaves it on the remote" "$r"

new_pushing_repo prepush_delete_main
step git push -q --no-verify origin HEAD:refs/heads/main
push_under_test origin :refs/heads/main
if [ "$(held refs/heads/main)" = "$(git rev-parse HEAD)" ] && printed 'deleting refs/heads/main is refused'; then r=0; else r=1; fi
check "a push deleting main leaves it on the remote" "$r"

new_pushing_repo prepush_mixed
push_under_test origin HEAD:refs/heads/claude/work HEAD:refs/heads/topic
if [ "$(held refs/heads/claude/work)" = none ] && [ "$(held refs/heads/topic)" = none ]; then r=0; else r=1; fi
check "a push of a claude/ branch together with a refused ref leaves the remote untouched" "$r"

new_pushing_repo prepush_pushed_wip
clean_file Draft
commit_as "[wip] Add draft"
step git push -q --no-verify origin HEAD:refs/heads/main
clean_file Work
commit_as "Add work"
push_under_test origin HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = "$(git rev-parse HEAD)" ]; then r=0; else r=1; fi
check "a [wip] commit a remote-tracking ref already holds does not refuse a later push" "$r"

new_pushing_repo prepush_remote_tip
clean_file Draft
commit_as "[wip] Add draft"
step git push -q --no-verify "$remote" HEAD:refs/heads/claude/work
clean_file Work
commit_as "Add work"
push_under_test "$remote" HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = "$(git rev-parse HEAD)" ]; then r=0; else r=1; fi
check "a [wip] commit the remote's own tip already holds does not refuse a later push" "$r"

new_pushing_repo prepush_url
