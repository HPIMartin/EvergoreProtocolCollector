step git checkout -q -
clean_file Other
step git add -A
step git commit -q --no-verify -m "Add other class"
git merge --no-commit --no-ff topic >/dev/null 2>&1 || true
git commit -q --no-verify -m "Merge topic" >/dev/null 2>&1 || true
clean_file Next
if merge_written && refuses "Add next class"; then r=0; else r=1; fi
check "a merge concluded with --no-verify blocks the next commit" "$r"

