new_repo credyaml
write_file application.yml 'db:' '  password: s3cretValue'
if refuses "Add the application config" 'possible secret or personal/host data'; then r=0; else r=1; fi
check "an unquoted password value in YAML leaves no commit behind" "$r"

new_repo credproperties
write_file application.properties 'db.password=s3cretValue'
if refuses "Add the application config" 'possible secret or personal/host data'; then r=0; else r=1; fi
check "an unquoted password value in a .properties file leaves no commit behind" "$r"

new_repo credreference
write_file application.yml 'db:' '  password: ${DB_PASSWORD}' '  secret: $APP_SECRET'
write_file application.properties 'db.password=${DB_PASSWORD}'
if accepts "Add the application config"; then r=0; else r=1; fi
check "an unquoted value that references the environment commits" "$r"

new_repo credquotedreference
for reference in 'compose.yml|  password: "${DB_PASSWORD}"' 'ci.yml|  password: "${{ secrets.DB }}"' \
	'env.sh|PASSWORD="${DB_PASSWORD}"'; do
	write_file "${reference%%|*}" "${reference#*|}"
	if accepts "Add ${reference%%|*}"; then r=0; else r=1; fi
	check "a quoted value that references the environment commits (${reference#*|})" "$r"
done

new_repo envfile
write_file .env 'MODE=dev'
if refuses "Add the environment" 'refusing to commit environment file(s)'; then r=0; else r=1; fi
check "a staged .env file leaves no commit behind" "$r"

new_repo envnamed
write_file config/.env.local 'MODE=dev'
if refuses "Add the environment" 'refusing to commit environment file(s)'; then r=0; else r=1; fi
check "a staged .env.<name> file in a subdirectory leaves no commit behind" "$r"

new_repo envexample
for name in .env.example .env.sample .env.template; do
	write_file "$name" 'MODE=dev'
	if accepts "Add the environment template"; then r=0; else r=1; fi
	check "a $name file commits" "$r"
done

new_repo envexampleplaceholder
write_file .env.example 'API_KEY=placeholder123'
if refuses "Add the environment template" 'possible secret or personal/host data'; then r=0; else r=1; fi
check "a placeholder of eight characters or more after a credential key in .env.example leaves no commit behind" "$r"

# Claude Code's home holds its login token and transcripts and is ignored by its own .gitignore,
# so each case force-adds it the way a deliberate `git add -f` would.
claude_home() {
	write_file "$1.devcontainer/.claude-home/.gitignore" '*' '!.gitignore'
	write_file "$1.devcontainer/.claude-home/$2" "$3"
	step git add -A -f "${1:-.}"
}

new_repo claudehomecredentials
claude_home '' .credentials.json '{"claudeAiOauth":{"accessToken":"made-up-access","refreshToken":"made-up-refresh"}}'
if refuses_staged "Add the Claude home" "refusing to commit Claude Code's home"; then r=0; else r=1; fi
check "a force-added .credentials.json in the Claude home leaves no commit behind" "$r"

new_repo claudehometranscript
