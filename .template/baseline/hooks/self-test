if refuses "Adding the parser"; then r=0; else r=1; fi
check "a gerund subject leaves no commit behind" "$r"

ticket_key='[A-Z][A-Z0-9]+-[0-9]+'

commits_with_ticket() {
	required=no
	if [ "$3" = required ]; then required=yes; fi
	git add -A
	before=$(commits)
	COMMIT_MSG_TICKET_KEY_RE=$1 COMMIT_MSG_TICKET_POSITION=$2 COMMIT_MSG_TICKET_REQUIRED=$required \
		git commit -q -m "$4" >/dev/null 2>&1 || true
	[ "$(commits)" -eq $((before + 1)) ]
}

new_repo ticketoff
clean_file Plain
if accepts "Add the plain class (PROJ-12)"; then r=0; else r=1; fi
check "no ticket pattern configured leaves a parenthesised subject alone" "$r"

new_repo ticketsuffix
clean_file Parser
if commits_with_ticket "$ticket_key" suffix optional "Add the parser (PROJ-12)"; then r=0; else r=1; fi
check "a suffix ticket key is accepted where suffix is configured" "$r"
clean_file Lexer
if ! commits_with_ticket "$ticket_key" suffix optional "[PROJ-12] Add the lexer"; then r=0; else r=1; fi
check "a prefix ticket key is refused where suffix is configured" "$r"
clean_file Reader
if ! commits_with_ticket "$ticket_key" suffix optional "Add the reader (proj12)"; then r=0; else r=1; fi
check "a malformed ticket key is refused" "$r"
clean_file Writer
if commits_with_ticket "$ticket_key" suffix optional "Add the writer"; then r=0; else r=1; fi
check "an optional ticket key may be left out" "$r"

new_repo ticketprefix
clean_file Parser
if commits_with_ticket "$ticket_key" prefix optional "[PROJ-12] Add the parser"; then r=0; else r=1; fi
check "a prefix ticket key is accepted where prefix is configured" "$r"
clean_file Backlog
if commits_with_ticket "$ticket_key" prefix optional "[PROJ-12] [doc] Groom the backlog"; then r=0; else r=1; fi
check "a doc tag sits behind the ticket prefix" "$r"
clean_file Lexer
if ! commits_with_ticket "$ticket_key" prefix optional "Add the lexer (PROJ-12)"; then r=0; else r=1; fi
check "a suffix ticket key is refused where prefix is configured" "$r"

new_repo ticketrequired
clean_file Parser
if ! commits_with_ticket "$ticket_key" suffix required "Add the parser"; then r=0; else r=1; fi
check "a required ticket key that is missing is refused" "$r"
clean_file Lexer
if commits_with_ticket "$ticket_key" suffix required "Add the lexer (PROJ-12)"; then r=0; else r=1; fi
check "a required ticket key that is there is accepted" "$r"

new_repo ticketdefaults
clean_file Parser
git add -A
before=$(commits)
COMMIT_MSG_TICKET_KEY_RE=$ticket_key git commit -q -m "Add the parser (PROJ-12)" >/dev/null 2>&1 || true
if [ "$(commits)" -eq $((before + 1)) ]; then r=0; else r=1; fi
check "the shipped ticket defaults are the suffix position and no requirement" "$r"

