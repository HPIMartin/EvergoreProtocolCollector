new_repo appendrelease
step git checkout -q -B main
record_tip Loud
drop_final_newline
release "$(git rev-parse HEAD)"
clean_file Next
if [ "$release_status" -eq 0 ] && accepts "Add next class" && ends_in_newline; then r=0; else r=1; fi
