GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
check "a commit at a rebase's break stop is let through" "$r"

new_repo editamend
step edit_todo '1s/^pick/edit/' HEAD~1 >/dev/null 2>&1
clean_file Folded
step git add -A
before=$(git rev-parse HEAD)
if at_edit_stop; then git commit -q --amend --no-edit >/dev/null 2>&1 || true; fi
if [ "$(git rev-parse HEAD)" != "$before" ]; then r=0; else r=1; fi
GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 || true
check "an amend at a rebase's edit stop folds into the stopped commit" "$r"

new_repo editamendsecond
