# The landing step and the gate ask breach-guard --reaches about a strand tip; another strand's gate
# relies on these cases for the exit codes, the first stderr line and the record left untouched.
reaches_from() {
	reach_dir=$1
	reach_script=$2
	shift 2
	reach_status=0
	(cd "$reach_dir" && sh "$reach_script" "$@") >"$work/reaches-out" 2>"$work/printed" || reach_status=$?
}

new_repo reaches
step mkdir sub
reaches_from "$repo/sub" "$hooks_dir/breach-guard" --reaches HEAD
if [ "$reach_status" -eq 0 ] && [ ! -e "$repo/.git/gate-record" ]; then r=0; else r=1; fi
check "--reaches answers 0 and writes nothing where nothing is recorded" "$r"
base_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
root=$(git rev-list --max-parents=0 HEAD)
step git checkout -q -b strand
record_tip Loud
tip=$(git rev-parse HEAD)
step git checkout -q "$base_branch"
step cp "$repo/.git/gate-record" "$work/record-before"
reached_line="[breach-guard] $tip reaches recorded commit(s): $tip"
reaches_from "$repo/sub" "$hooks_dir/breach-guard" --reaches HEAD
if [ "$reach_status" -eq 0 ] && unchanged; then r=0; else r=1; fi
check "--reaches answers 0 for a rev that reaches no recorded commit and leaves the record as it was" "$r"
reaches_from "$repo/sub" "$hooks_dir/breach-guard" --reaches "$tip"
if [ "$reach_status" -eq 1 ] && [ "$(head -n 1 "$work/printed")" = "$reached_line" ] && [ ! -s "$work/reaches-out" ] && unchanged; then r=0; else r=1; fi
check "--reaches answers 1 for a strand tip this checkout's HEAD does not reach, naming the commit on its first stderr line" "$r"
reaches_from "$repo/sub" "$hooks_dir/breach-guard" --reaches strand
if [ "$reach_status" -eq 1 ] && [ "$(head -n 1 "$work/printed")" = "[breach-guard] strand reaches recorded commit(s): $tip" ] && unchanged; then r=0; else r=1; fi
check "--reaches names a rev given by name as given on its first stderr line" "$r"
reaches_from "$repo/sub" "$hooks_dir/breach-guard" --reaches
if [ "$reach_status" -eq 2 ] && printed 'usage: hooks/breach-guard' && unchanged; then r=0; else r=1; fi
check "--reaches without a rev answers 2 with the usage line" "$r"
reaches_from "$repo/sub" "$hooks_dir/breach-guard" --reaches "$tip" extra
if [ "$reach_status" -eq 2 ] && printed 'usage: hooks/breach-guard' && unchanged; then r=0; else r=1; fi
check "--reaches with an extra argument answers 2 with the usage line" "$r"
reaches_from "$repo/sub" "$hooks_dir/breach-guard" --bogus
if [ "$reach_status" -eq 2 ] && printed 'usage: hooks/breach-guard' && unchanged; then r=0; else r=1; fi
check "an unknown option answers 2 with the usage line" "$r"
reaches_from "$repo/sub" "$hooks_dir/breach-guard" --reaches "$tip^{tree}"
if [ "$reach_status" -eq 2 ] && unchanged; then r=0; else r=1; fi
check "--reaches for a rev that is no commit answers 2" "$r"
step git worktree add -q --detach "$work/reaches-linked" "$root" >/dev/null 2>&1
step mkdir "$work/reaches-linked/deeper"
reaches_from "$work/reaches-linked/deeper" "$hooks_dir/breach-guard" --reaches "$tip"
if [ "$reach_status" -eq 1 ] && [ "$(head -n 1 "$work/printed")" = "$reached_line" ] && unchanged; then r=0; else r=1; fi
check "--reaches gives the same answer from a linked worktree whose HEAD does not reach the commit" "$r"
step mkdir "$work/reaches-copy"
step cp "$hooks_dir/breach-guard" "$work/reaches-copy/breach-guard"
reaches_from "$work/reaches-linked" "$work/reaches-copy/breach-guard" --reaches "$tip"
if [ "$reach_status" -eq 1 ] && [ "$(head -n 1 "$work/printed")" = "$reached_line" ] && unchanged; then r=0; else r=1; fi
check "a copy of the script outside the repository answers for the repository it runs in" "$r"

new_repo reachesreleased
record_tip Loud
released=$(git rev-parse HEAD)
step printf 'released %s 2000-01-01 The Author\n' "$released" >> "$repo/.git/gate-record"
step cp "$repo/.git/gate-record" "$work/record-before"
reaches_from "$repo" "$hooks_dir/breach-guard" --reaches "$released"
if [ "$reach_status" -eq 0 ] && unchanged; then r=0; else r=1; fi
check "--reaches answers 0 for a rev that reaches only a released recorded commit" "$r"

new_repo reachestwo
record_tip Loud
first=$(git rev-parse HEAD)
clean_file Between
step git add -A
step git commit -q --no-verify -m "Add between class"
record_tip Noisy
