check "replaying a pre-existing violation raises no breach" "$r"

# Moves the base branch one clean commit on and rebases the current branch onto it, so every commit
# of the branch is replayed under a new id, whatever the clock reads.
rebase_onto_moved_base() {
	line=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
	step git checkout -q "$base_branch"
	clean_file Moved
	step git add -A
	step git commit -q --no-verify -m "Add moved class"
	step git checkout -q "$line"
	git rebase "$base_branch" >/dev/null 2>&1 || true
}

strand_with_recorded_tip() {
	base_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
	step git checkout -q -b strand
	clean_file Topic
	step git add -A
	step git commit -q --no-verify -m "Add topic class"
	record_tip Loud
	recorded=$(git rev-parse HEAD)
}

# A recorded commit keeps its block through a rewrite that replays it unchanged: the new id is
# recorded in its place, so the next commit and the landing query still meet it.
new_repo replayrecorded
strand_with_recorded_tip
rebase_onto_moved_base
replayed=$(git rev-parse HEAD)
clean_file Next
if [ "$replayed" != "$recorded" ] && git log --oneline -- Loud.java | grep -q . \
	&& grep -qx "$replayed" "$repo/.git/gate-record" && refuses "Add next class" "$replayed"; then r=0; else r=1; fi
check "a recorded commit a rebase replays onto a moved base is recorded under its new id, and the next commit is refused" "$r"
status=0
sh "$hooks_dir/breach-guard" --reaches HEAD >/dev/null 2>&1 || status=$?
if [ "$status" -eq 1 ]; then r=0; else r=1; fi
check "the landing query answers 1 for the tip of a strand whose recorded commit a rebase replayed" "$r"

new_repo replaybeside
base_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
step git checkout -q -b other
record_tip Noisy
step git checkout -q "$base_branch"
step git checkout -q -b line
smelly_file Legacy
step git add -A
step git commit -q --no-verify -m "Add legacy class"
legacy=$(git rev-parse HEAD)
step cp "$repo/.git/gate-record" "$work/record-before"
rebase_onto_moved_base
if [ "$(git rev-parse HEAD)" != "$legacy" ] && git log --oneline -- Legacy.java | grep -q . && unchanged; then r=0; else r=1; fi
check "a rebase that replays an old violation no hook recorded records nothing while the record holds another branch's commit" "$r"

new_repo replayabove
strand_with_recorded_tip
smelly_file Legacy
step git add -A
step git commit -q --no-verify -m "Add legacy class"
rebase_onto_moved_base
if grep -qx "$(git rev-parse HEAD~1)" "$repo/.git/gate-record" && ! grep -qx "$(git rev-parse HEAD)" "$repo/.git/gate-record" \
	&& [ "$(git rev-parse HEAD~1)" != "$recorded" ]; then r=0; else r=1; fi
check "of a recorded commit and an old violation above it, a rebase records the replayed recorded commit alone" "$r"

new_repo replayreleased
