check "--no-verify stays the deliberate valve and is not recorded" "$r"

# The stubs answer on the argument, not on being called at all: a wrapper run with the wrong
# subcommand (or with none) would otherwise satisfy both cases vacuously.
new_repo formatleg_red
write_file verify '#!/bin/sh' '[ "$1" = format ] && exit 1' 'exit 0'
chmod +x verify
git add -A
git commit -q --no-verify -m "Add the verify wrapper"
clean_file Formatted
if refuses "Add formatted class"; then r=0; else r=1; fi
check "a failing format leg leaves no commit behind" "$r"

new_repo formatleg_green
write_file verify '#!/bin/sh' '[ "$1" = format ] && exit 0' 'exit 1'
chmod +x verify
git add -A
git commit -q --no-verify -m "Add the verify wrapper"
clean_file Formatted
if accepts "Add formatted class"; then r=0; else r=1; fi
check "a passing format leg lets the commit through" "$r"

# The content of both patches below is clean, so the format leg is the only thing that can refuse:
# these two cases pin the exit status of the hooks that run before their commit exists.
new_repo formatleg_applypatch
write_file verify '#!/bin/sh' '[ "$1" = format ] && exit 1' 'exit 0'
chmod +x verify
git add -A
git commit -q --no-verify -m "Add the verify wrapper"
donor="$work/formatleg-donor"
mkdir -p "$donor"
cd "$donor"
git init -q .
git config user.email gate@example.com
git config user.name Gate
git config core.autocrlf false
printf 'class Seed1 {\n}\n' > Seed1.java
git add -A
git commit -q --no-verify -m "Add seed 1"
clean_file Patched
git add -A
git commit -q --no-verify -m "Add patched class"
git format-patch -1 -o "$donor/patches" >/dev/null 2>&1
cd "$repo"
before=$(commits)
git am "$donor/patches/"*.patch >/dev/null 2>&1 || true
if [ "$(commits)" -eq "$before" ]; then r=0; else r=1; fi
check "git am whose format leg fails leaves no commit behind" "$r"
git am --abort >/dev/null 2>&1 || true

new_repo formatleg_merge
