before=$(commits)
HOME="$work/crlf-home" git commit -q -m "Describe the jvm preset" >/dev/null 2>"$work/printed" || true
if [ "$(commits)" -eq $((before + 1)) ]; then r=0; else r=1; fi
check "a global core.autocrlf=true leaves the scripts of the copy with LF" "$r"

