commit_as "[wip] Add draft"
step git push -q --no-verify origin HEAD:refs/heads/main
clean_file Work
commit_as "Add work"
push_under_test "$remote" HEAD:refs/heads/claude/work
if [ "$(held refs/heads/claude/work)" = "$(git rev-parse HEAD)" ]; then r=0; else r=1; fi
check "a push to a URL that is no named remote leaves out what any remote-tracking ref holds" "$r"
clean_file More
commit_as "[wip] Add more"
push_under_test "$remote" HEAD:refs/heads/claude/next
if [ "$(held refs/heads/claude/next)" = none ]; then r=0; else r=1; fi
