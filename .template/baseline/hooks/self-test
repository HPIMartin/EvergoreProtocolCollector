# post-commit and post-merge append to the record too: their entry lands beside one another branch
# recorded, which still refuses on that branch.
first_branch_recorded() {
	base_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo none)
	step git checkout -q -b first
	record_tip Noisy
	first_entry=$(git rev-parse HEAD)
	step git checkout -q "$base_branch"
}

topic_branch() {
	step git checkout -q -b topic
	clean_file Topic
	step git add -A
	step git commit -q --no-verify -m "Add topic class"
	step git checkout -q "$base_branch"
}

new_repo appendpickentry
first_branch_recorded
step git checkout -q -b donor
smelly_file Loud
step git add -A
step git commit -q --no-verify -m "Add loud class"
step git checkout -q "$base_branch"
git cherry-pick donor >/dev/null 2>&1 || true
step grep -qx "$(git rev-parse HEAD)" "$repo/.git/gate-record"
step git checkout -q first
clean_file Next
if refuses "Add next class" "$first_entry"; then r=0; else r=1; fi
check "a cherry-pick recorded after another branch's entry leaves that entry refusing" "$r"

new_repo appendmergeentry
first_branch_recorded
topic_branch
git merge --no-verify --no-ff --no-edit topic >/dev/null 2>&1 || true
step merge_written
step grep -qx "$(git rev-parse HEAD)" "$repo/.git/gate-record"
step git checkout -q first
clean_file Next
if refuses "Add next class" "$first_entry"; then r=0; else r=1; fi
check "a merge recorded by post-merge after another branch's entry leaves that entry refusing" "$r"

