# A copy of the hooks whose content gate has one allowlist emptied, wired as core.hooksPath, so a
# case commits through the gate the way a project that empties the value would.
hooks_emptying() {
	step mkdir "$work/$case_name-hooks"
	step cp "$hooks_dir"/* "$work/$case_name-hooks/"
	sed "s#^$1=.*#$1=''#" "$hooks_dir/content-gate" > "$work/$case_name-hooks/content-gate"
	step grep -q "^$1=''\$" "$work/$case_name-hooks/content-gate"
	step git config core.hooksPath "$work/$case_name-hooks"
}

new_repo emailallowempty
write_file team.txt 'owner = gatekeeper@corp.internal'
hooks_emptying email_allow
if refuses "Add the team note" 'possible secret or personal/host data'; then r=0; else r=1; fi
check "an emptied email_allow lets no address through instead of switching the scan off" "$r"

new_repo hostallowempty
write_file notes.txt 'workspace = /home/someone/projects/demo'
hooks_emptying host_allow
if refuses "Add the notes" 'possible secret or personal/host data'; then r=0; else r=1; fi
check "an emptied host_allow lets no host path through instead of switching the scan off" "$r"

