#!/bin/sh
# git builds a merge commit itself and asks pre-commit for none of them, so a merge gets its own
# hook. Work lands by rebase and fast-forward (handbook §7), which writes no commit and so never runs
# this hook. A merge commit records a step of the working process rather than a change to the
# project, so this refuses every one outright, before it exists.
set -eu

printf '\n[pre-merge-commit] a merge commit is refused. Run %s and land by rebase and fast-forward (handbook §7).\n' \
	"'git merge --abort'" >&2
exit 1
