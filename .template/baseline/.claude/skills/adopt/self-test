#!/bin/sh
set -euf

adopt_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
live_filter=$adopt_dir/module-filter
live_manifest=$adopt_dir/module-manifest
repository=$(CDPATH= cd -- "$adopt_dir/../../.." && pwd)

for needed in awk cmp cp diff find grep mktemp sed sort tr; do
	command -v "$needed" > /dev/null 2>&1 || {
		printf 'module filter self-test: no %s on PATH, so no case ran\n' "$needed" >&2
		exit 2
	}
done
for shipped in "$live_filter" "$live_manifest"; do
	[ -f "$shipped" ] || {
		printf 'module filter self-test: %s is missing, so no case ran\n' "$shipped" >&2
		exit 2
	}
done

for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
exec 3>&1
failures=0
cases=0
case_name=''
broken=0
status=0
out=$work/out
err=$work/err
tab=$(printf '\t')

check() {
	cases=$((cases + 1))
	if [ "$2" -eq 0 ] && [ "$broken" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s\n' "$1"
		failures=$((failures + 1))
		shift 2
		for diagnosis in "$@"; do
			[ ! -s "$diagnosis" ] || sed -n '1,20s/^/         /p' "$diagnosis"
		done
	fi
}

step() {
	"$@" && return 0
	printf '  setup failed in %s: %s\n' "$case_name" "$*" >&3
	broken=1
}

tool_with_manifest() {
	tool=$work/tool-$1
	mkdir -p "$tool"
	cp "$live_filter" "$tool/module-filter"
	cat > "$tool/module-manifest"
}

new_case() {
	case_name=$1
	broken=0
	tree=$work/$1/tree
	step mkdir -p "$tree"
}

put() {
	target=$tree/$1
	shift
	mkdir -p "${target%/*}"
	printf '%s\n' "$@" > "$target"
}

put_bytes() {
	target=$tree/$1
	mkdir -p "${target%/*}"
	printf "$2" > "$target"
}

put_text() {
	target=$tree/$1
	mkdir -p "${target%/*}"
	cat > "$target"
}

holds() {
	target=$tree/$1
	shift
	printf '%s\n' "$@" | cmp -s - "$target"
}

holds_bytes() { printf "$2" | cmp -s - "$tree/$1"; }

holds_text() { cmp -s - "$tree/$1"; }

attempt() {
	set +e
	"$@" > "$out" 2> "$err" < /dev/null
	status=$?
	set -e
}

filter() { attempt sh "$tool/module-filter" "$@"; }

apply_keeping() {
	kept_names=$1
	shift
	filter apply --keep "$kept_names" --root "$tree" "$@"
}

verify_keeping() {
	kept_names=$1
	shift
	filter verify --keep "$kept_names" --root "$tree" "$@"
}

said() { grep -qxF -- "$1" "$out"; }

said_only() {
	printf '%s\n' "$@" | sort > "$work/expected"
	sort "$out" | cmp -s - "$work/expected"
}

silent() { [ ! -s "$out" ]; }

refused_with() { [ "$status" -eq 1 ] && grep -qxF -- "refused: $1" "$err"; }

is_usage_error() { [ "$status" -eq 2 ] && grep -q '^usage: ' "$err" && silent; }

remember_tree() { cp -R "$tree" "$tree.before"; }

untouched() { diff -r "$tree.before" "$tree" > /dev/null 2>&1; }

well_formed() {
	LC_ALL=C awk -v comments="$2" '
		function fail() { flawed = 1; exit }
		function value_may_start() { return expecting == "value" || expecting == "value or close" }
		function value_closed() { expecting = (depth == 0) ? "end" : "comma or close" }
		BEGIN { BINMODE = 3; expecting = "value" }
		{
			size = length($0)
			at = 1
			while (at <= size) {
				c = substr($0, at, 1)
				if (c == " " || c == "\t" || c == "\r") { at++; continue }
				if (c == "/" && substr($0, at + 1, 1) == "/") {
					if (comments != "with comments") fail()
					break
				}
				if (c == "\"") {
					at++
					while (at <= size && substr($0, at, 1) != "\"") at += (substr($0, at, 1) == "\\") ? 2 : 1
					if (at > size) fail()
					at++
					if (value_may_start()) value_closed()
					else if (expecting == "key" || expecting == "key or close") expecting = "colon"
					else fail()
					continue
				}
				if (c == "{" || c == "[") {
					if (!value_may_start()) fail()
					holder[++depth] = c
					expecting = (c == "{") ? "key or close" : "value or close"
					at++
					continue
				}
				if (c == "}" || c == "]") {
					if (depth == 0) fail()
					if (c == "}" && !(holder[depth] == "{" && (expecting == "key or close" || expecting == "comma or close"))) fail()
					if (c == "]" && !(holder[depth] == "[" && (expecting == "value or close" || expecting == "comma or close"))) fail()
					depth--
					value_closed()
					at++
					continue
				}
				if (c == ":") {
					if (expecting != "colon") fail()
					expecting = "value"
					at++
					continue
				}
				if (c == ",") {
					if (expecting != "comma or close") fail()
					expecting = (holder[depth] == "{") ? "key" : "value"
					at++
					continue
				}
				if (match(substr($0, at), /^[-+.0-9A-Za-z]+/)) {
					if (!value_may_start()) fail()
					value_closed()
					at += RLENGTH
					continue
				}
				fail()
			}
		}
		END { exit (flawed || expecting != "end") ? 1 : 0 }
	' "$1"
}

printf 'module filter self-test\n'

new_case checker
put strict.json '{' '	"list": [' '		"a",' '		"b"' '	],' '	"text": "a } ] \" // b"' '}'
if well_formed "$tree/strict.json" 'strict'; then r=0; else r=1; fi
check "the well-formedness check of this suite accepts sound JSON" "$r"
put dangling.json '{' '	"list": [' '		"a",' '	]' '}'
if ! well_formed "$tree/dangling.json" 'strict'; then r=0; else r=1; fi
check "the well-formedness check of this suite refuses a dangling comma" "$r"
put missing.json '{' '	"a": 1' '	"b": 2' '}'
if ! well_formed "$tree/missing.json" 'strict'; then r=0; else r=1; fi
check "the well-formedness check of this suite refuses a missing comma" "$r"
put commented.json '{' '	// a comment' '	"a": 1' '}'
if well_formed "$tree/commented.json" 'with comments' && ! well_formed "$tree/commented.json" 'strict'; then r=0; else r=1; fi
check "the well-formedness check of this suite takes comments only where they are allowed" "$r"

tool_with_manifest standard <<'ROWS'
module alpha The alpha tools
module beta The beta helper
module gamma The gamma volume
needs beta alpha
asks beta a UI surface
asks gamma the devcontainer variant
path alpha tools/alpha/
path beta tools/alpha/beta-helper
path beta docs/beta notes.md
path gamma env/box/.box/gamma.sh
json alpha conf/rules.json Bash(sh alpha/*)
json alpha conf/rules.json Bash(sh alpha/*..*)
json alpha conf/rules.json /alpha
json alpha conf/last.json /alpha
key gamma conf/rules.json hooks
key gamma conf/keys.json hooks
cut gamma env/box/.box/box.json  && chown gamma
installs env/box/.box/ .box/
installs env/plain/.versions .versions
skip tooling/
skip .git/
skip .template/
ROWS
standard=$tool

new_case usage
filter
if is_usage_error; then r=0; else r=1; fi
check "no command is a usage error that prints the usage" "$r"
filter frobnicate
if is_usage_error; then r=0; else r=1; fi
check "an unknown command is a usage error" "$r"
filter apply --root "$tree"
if is_usage_error; then r=0; else r=1; fi
check "apply without --keep is a usage error" "$r"
filter verify --root "$tree"
if is_usage_error; then r=0; else r=1; fi
check "verify without --keep is a usage error" "$r"
filter check
if is_usage_error; then r=0; else r=1; fi
check "check without --keep is a usage error" "$r"
filter apply --root "$tree" --keep
if is_usage_error; then r=0; else r=1; fi
check "an option without its value is a usage error" "$r"
filter apply --keep '' --root "$tree" --force
if is_usage_error; then r=0; else r=1; fi
check "an unknown option is a usage error" "$r"
filter verify --keep '' --root "$tree" --prune
if is_usage_error; then r=0; else r=1; fi
check "--prune outside apply is a usage error" "$r"
filter check --keep '' --root "$tree"
if is_usage_error; then r=0; else r=1; fi
check "check takes no --root" "$r"
filter list --keep ''
if is_usage_error; then r=0; else r=1; fi
check "list takes no option" "$r"
filter apply --keep '' --root "$tree/absent"
if [ "$status" -eq 1 ] && grep -q '^refused: --root names no directory' "$err" && silent; then r=0; else r=1; fi
check "a root that is no directory is refused" "$r"
filter apply --keep '' --root "$tree" --payload "$tree/absent"
if [ "$status" -eq 1 ] && grep -q '^refused: --payload names no directory' "$err" && silent; then r=0; else r=1; fi
check "a payload that is no directory is refused" "$r"

new_case list
filter list
printf '%s\n' "alpha$tab-${tab}The alpha tools" "beta${tab}alpha${tab}The beta helper" "${tab}asks${tab}a UI surface" \
	"gamma$tab-${tab}The gamma volume" "${tab}asks${tab}the devcontainer variant" > "$work/expected"
if [ "$status" -eq 0 ] && cmp -s "$work/expected" "$out"; then r=0; else r=1; fi
check "list prints each module with what it needs and its title, then what it asks" "$r"

new_case check
filter check --keep 'alpha beta'
if [ "$status" -eq 0 ] && said_only 'ok'; then r=0; else r=1; fi
check "check accepts kept modules that have what they need" "$r"
filter check --keep ''
if [ "$status" -eq 0 ] && said_only 'ok'; then r=0; else r=1; fi
check "check accepts keeping no module" "$r"
filter check --keep 'alpha delta'
if refused_with 'no module named delta' && silent; then r=0; else r=1; fi
check "check refuses a name that is no module" "$r"
filter check --keep 'beta gamma'
if refused_with 'beta needs alpha' && silent; then r=0; else r=1; fi
check "check refuses a module kept without the module it needs" "$r"

new_case apply_needs
put docs/guide.md 'Core.' '<!-- MODULE gamma -->' 'Gamma.' '<!-- /MODULE gamma -->'
remember_tree
apply_keeping 'beta'
if refused_with 'beta needs alpha' && silent && untouched; then r=0; else r=1; fi
check "apply refuses an unmet need and leaves the tree as it was" "$r"
verify_keeping 'beta'
if refused_with 'beta needs alpha' && silent; then r=0; else r=1; fi
check "verify refuses an unmet need" "$r"

tool_with_manifest chain <<'ROWS'
module one The first
module two The second
module three The third
needs two one
needs three one
needs three two
ROWS
new_case chain
filter list
if [ "$status" -eq 0 ] && said "three${tab}one two${tab}The third"; then r=0; else r=1; fi
check "list names every module a module needs" "$r"
filter check --keep 'three one'
if refused_with 'three needs two'; then r=0; else r=1; fi
check "check refuses a module that lacks one of the two it needs" "$r"

tool_with_manifest unknown-row <<'ROWS'
module alpha The alpha tools
glob alpha docs/*.md
ROWS
new_case unknown_row
put docs/guide.md 'Core.'
apply_keeping ''
if refused_with 'module-manifest line 2: unknown row: glob' && silent; then r=0; else r=1; fi
check "a manifest row of an unknown kind is refused" "$r"

tool_with_manifest stranger <<'ROWS'
module alpha The alpha tools
json alpha+delta conf/rules.json Bash(delta)
ROWS
new_case stranger
put docs/guide.md 'Core.'
apply_keeping ''
if refused_with 'module-manifest line 2: no module named delta' && silent; then r=0; else r=1; fi
check "a manifest row that names no module is refused" "$r"

tool_with_manifest escaping <<'ROWS'
module alpha The alpha tools
path alpha ../outside/
ROWS
new_case escaping
put docs/guide.md 'Core.'
mkdir -p "$work/escaping/outside"
apply_keeping '' --prune
if refused_with 'module-manifest line 2: the path leaves the root: ../outside/' && silent && [ -d "$work/escaping/outside" ]; then r=0; else r=1; fi
check "a manifest path that leaves the root is refused" "$r"

tool=$standard

new_case markdown_dropped
put docs/guide.md 'Core line.' '<!-- MODULE alpha -->' '- Alpha line.' '<!-- /MODULE alpha -->' 'Last line.'
apply_keeping 'gamma'
if [ "$status" -eq 0 ] && holds docs/guide.md 'Core line.' 'Last line.' && said_only 'edited docs/guide.md'; then r=0; else r=1; fi
check "a Markdown block of a dropped module goes with both fence lines" "$r"

new_case markdown_kept
put docs/guide.md 'Core line.' '<!-- MODULE alpha -->' '- Alpha line.' '<!-- /MODULE alpha -->' 'Last line.'
remember_tree
apply_keeping 'alpha gamma'
if [ "$status" -eq 0 ] && untouched && silent; then r=0; else r=1; fi
check "a Markdown block of a kept module stays with its fences" "$r"

shell_like='run run.sh ci.yml ci.yaml gate.env conf.toml Dockerfile .gitignore'
new_case shell_dropped
for name in $shell_like; do
	put "scripts/$name" 'first' '# MODULE alpha' 'alpha only' '# /MODULE alpha' 'last'
done
apply_keeping ''
for name in $shell_like; do
	if [ "$status" -eq 0 ] && holds "scripts/$name" 'first' 'last' && said "edited scripts/$name"; then r=0; else r=1; fi
	check "a shell block of a dropped module goes from a file named $name" "$r"
done

new_case shell_kept
put scripts/run 'first' '# MODULE alpha' 'alpha only' '# /MODULE alpha' 'last'
remember_tree
apply_keeping 'alpha'
if [ "$status" -eq 0 ] && untouched && silent; then r=0; else r=1; fi
check "a shell block of a kept module stays with its fences" "$r"

new_case json_dropped
for name in box.json box.jsonc; do
	put "conf/$name" '{' '	"first": 1,' '	// MODULE alpha' '	// Why alpha needs it.' '	"alpha": 2,' '	// /MODULE alpha' '	"last": 3' '}'
done
apply_keeping ''
for name in box.json box.jsonc; do
	if [ "$status" -eq 0 ] && holds "conf/$name" '{' '	"first": 1,' '	"last": 3' '}' && said "edited conf/$name"; then r=0; else r=1; fi
	check "a JSON block of a dropped module goes from a file named $name" "$r"
done

new_case json_kept
put conf/box.json '{' '	"first": 1,' '	// MODULE alpha' '	"alpha": 2,' '	// /MODULE alpha' '	"last": 3' '}'
remember_tree
apply_keeping 'alpha'
if [ "$status" -eq 0 ] && untouched && silent; then r=0; else r=1; fi
check "a JSON block of a kept module stays with its fences" "$r"

new_case other_types
put src/Guard.java 'class Guard {' '// MODULE alpha' '<!-- MODULE alpha -->' '# MODULE alpha' '}'
put notes.txt '# MODULE alpha' 'never closed'
put Dockerfile.dev '# /MODULE alpha'
remember_tree
apply_keeping ''
if [ "$status" -eq 0 ] && untouched && silent; then r=0; else r=1; fi
check "a file of another type is never scanned" "$r"
verify_keeping ''
if [ "$status" -eq 0 ] && silent; then r=0; else r=1; fi
check "verify reads no file of another type" "$r"

near_miss() { refused_with "$1: a fence-like line that is no fence of this file type: $2"; }

new_case foreign_forms
put docs/guide.md '# MODULE alpha' 'prose' '// MODULE alpha'
put scripts/run '<!-- MODULE alpha -->' 'echo' '// /MODULE alpha'
put conf/box.json '# MODULE alpha' '<!-- /MODULE alpha -->'
remember_tree
apply_keeping 'alpha'
if near_miss docs/guide.md:1 '# MODULE alpha' && near_miss docs/guide.md:3 '// MODULE alpha' && near_miss scripts/run:1 '<!-- MODULE alpha -->' \
	&& near_miss scripts/run:3 '// /MODULE alpha' && near_miss conf/box.json:1 '# MODULE alpha' && near_miss conf/box.json:2 '<!-- /MODULE alpha -->' \
	&& untouched && silent; then r=0; else r=1; fi
check "a fence in the form of another file type is refused, kept module or not, and the tree stays as it was" "$r"
verify_keeping 'alpha'
if [ "$status" -eq 1 ] && said 'leftover docs/guide.md:1: fence-like line # MODULE alpha' && said 'leftover conf/box.json:2: fence-like line <!-- /MODULE alpha -->' \
	&& [ "$(grep -c '^leftover ' "$out")" -eq 6 ]; then r=0; else r=1; fi
check "verify names a fence in the form of another file type" "$r"

new_case carriage_returns
put_bytes docs/guide.md 'Core line.\r\n<!-- MODULE alpha -->\r\n- Alpha line.\r\n<!-- /MODULE alpha -->\r\nLast line.\r\n'
apply_keeping ''
if [ "$status" -eq 0 ] && holds_bytes docs/guide.md 'Core line.\r\nLast line.\r\n'; then r=0; else r=1; fi
check "a fence with a trailing carriage return is a fence, and the kept lines keep theirs" "$r"

new_case blanks_around
put_bytes scripts/run 'first\n  \t# MODULE alpha \t \nalpha only\n\t# /MODULE alpha  \nlast\n'
apply_keeping ''
if [ "$status" -eq 0 ] && holds scripts/run 'first' 'last'; then r=0; else r=1; fi
check "a fence with leading and trailing blanks is a fence" "$r"

new_case more_than_a_name
put scripts/run 'first' '# MODULE alpha and more' '#MODULE alpha' '	# /MODULE  alpha' 'last'
put docs/guide.md '<!-- MODULE alpha --> and more' '<!-- MODULE alpha beta -->' '<!--MODULE alpha-->' '<!-- MODULE alpha-->' '	<!--  /MODULE -->'
put conf/box.json '{' '	//MODULE alpha' '	// MODULE alpha  x' '}'
remember_tree
apply_keeping ''
if near_miss scripts/run:2 '# MODULE alpha and more' && near_miss scripts/run:3 '#MODULE alpha' && near_miss scripts/run:4 '# /MODULE  alpha' \
	&& near_miss docs/guide.md:1 '<!-- MODULE alpha --> and more' && near_miss docs/guide.md:2 '<!-- MODULE alpha beta -->' \
	&& near_miss docs/guide.md:3 '<!--MODULE alpha-->' && near_miss docs/guide.md:4 '<!-- MODULE alpha-->' && near_miss docs/guide.md:5 '<!--  /MODULE -->' \
	&& near_miss conf/box.json:2 '//MODULE alpha' && near_miss conf/box.json:3 '// MODULE alpha  x' && untouched && silent; then r=0; else r=1; fi
check "a fence-like line that is no exact fence is refused, and the tree stays as it was" "$r"
verify_keeping ''
if [ "$status" -eq 1 ] && said 'leftover docs/guide.md:4: fence-like line <!-- MODULE alpha-->' && [ "$(grep -c '^leftover ' "$out")" -eq 10 ]; then r=0; else r=1; fi
check "verify names a fence-like line that is no exact fence" "$r"
new_case project_comments
put .devcontainer/Dockerfile 'FROM base' '# MODULE: built in stage 2' '# MODULES are built in stage 3' '  # /MODULE' 'RUN true'
put docs/guide.md 'Core.' '<!-- MODULES: see below -->' '	<!--  /MODULES -->'
remember_tree
apply_keeping ''
if [ "$status" -eq 0 ] && untouched && silent; then r=0; else r=1; fi
check "a comment where MODULE is not followed by a blank and a name, as in a project's Dockerfile, is an ordinary line" "$r"
verify_keeping ''
if [ "$status" -eq 0 ] && silent; then r=0; else r=1; fi
check "verify reads such a comment as an ordinary line" "$r"
new_case fence_words_in_prose
put docs/guide.md 'A MODULE fence: <!-- MODULE alpha -->.' '`# MODULE alpha`' '#!/bin/sh' '## MODULE alpha'
put scripts/run 'echo "# MODULE alpha"' 'x=1 # MODULE alpha'
remember_tree
apply_keeping ''
if [ "$status" -eq 0 ] && untouched && silent; then r=0; else r=1; fi
check "a line that only mentions a fence further in is an ordinary line" "$r"

new_case unclosed
put docs/guide.md 'Core.' '<!-- MODULE alpha -->' 'Alpha.'
put docs/other.md 'Core.' '<!-- MODULE gamma -->' 'Gamma.' '<!-- /MODULE gamma -->'
remember_tree
apply_keeping ''
if refused_with 'docs/guide.md:2: fence alpha is never closed' && untouched && silent; then r=0; else r=1; fi
check "an unclosed fence is refused and the tree stays as it was, byte for byte" "$r"

new_case nested
put docs/guide.md 'Core.' '<!-- MODULE alpha -->' 'A.' '<!-- MODULE gamma -->' 'G.' '<!-- /MODULE gamma -->' '<!-- /MODULE alpha -->'
put docs/other.md 'Core.' '<!-- MODULE gamma -->' 'Gamma.' '<!-- /MODULE gamma -->'
remember_tree
apply_keeping ''
if refused_with 'docs/guide.md:4: fence gamma opens inside the fence alpha of line 2' && untouched && silent; then r=0; else r=1; fi
check "a nested fence is refused and the tree stays as it was, byte for byte" "$r"

new_case stray_closing
put scripts/run 'first' '# /MODULE alpha' 'last'
put docs/other.md 'Core.' '<!-- MODULE gamma -->' 'Gamma.' '<!-- /MODULE gamma -->'
remember_tree
apply_keeping ''
if refused_with 'scripts/run:2: closing fence alpha has no opening fence' && untouched && silent; then r=0; else r=1; fi
check "a stray closing fence is refused and the tree stays as it was, byte for byte" "$r"

new_case foreign_closing
put conf/box.json '{' '	// MODULE alpha' '	"a": 1,' '	// /MODULE gamma' '	"b": 2' '}'
remember_tree
apply_keeping ''
if refused_with 'conf/box.json:4: closing fence gamma stands inside the fence alpha of line 2' && untouched && silent; then r=0; else r=1; fi
check "a fence closed by another module's closing fence is refused" "$r"

new_case kept_unclosed
put docs/guide.md 'Core.' '<!-- MODULE alpha -->' 'Alpha.'
remember_tree
apply_keeping 'alpha'
if refused_with 'docs/guide.md:2: fence alpha is never closed' && untouched && silent; then r=0; else r=1; fi
check "a broken fence of a kept module is refused too" "$r"

new_case unknown_name
put docs/guide.md 'Core.' '<!-- MODULE delta -->' 'Delta.' '<!-- /MODULE delta -->' '<!-- MODULE delta -->' 'Never closed.'
remember_tree
apply_keeping ''
if [ "$status" -eq 0 ] && untouched && said_only 'note: docs/guide.md: fence of no manifest module: delta'; then r=0; else r=1; fi
check "a fence of no manifest module is left alone and named in one note" "$r"
verify_keeping ''
if [ "$status" -eq 0 ] && said_only 'note: docs/guide.md: fence of no manifest module: delta'; then r=0; else r=1; fi
check "verify names a fence of no manifest module in the note apply prints, and passes" "$r"

tool_with_manifest compound <<'ROWS'
module alpha The alpha tools
module beta The beta helper
module gamma The gamma volume
path alpha tools/alpha/
ROWS

new_case compound_kept
put docs/guide.md 'Core.' '<!-- MODULE alpha+beta -->' 'Both.' '<!-- /MODULE alpha+beta -->' 'Last.'
remember_tree
apply_keeping 'alpha beta'
if [ "$status" -eq 0 ] && untouched && silent; then r=0; else r=1; fi
check "a block of two modules stays with its fences while both are kept" "$r"

for kept_names in beta alpha gamma; do
	new_case "compound_without_$kept_names"
	put docs/guide.md 'Core.' '<!-- MODULE alpha+beta -->' 'Both.' '<!-- /MODULE alpha+beta -->' 'Last.'
	apply_keeping "$kept_names"
	if [ "$status" -eq 0 ] && holds docs/guide.md 'Core.' 'Last.' && said_only 'edited docs/guide.md'; then r=0; else r=1; fi
	check "a block of two modules goes with both fence lines, keeping '$kept_names'" "$r"
done

new_case compound_forms
put scripts/run 'first' '# MODULE alpha+beta' 'both only' '# /MODULE alpha+beta' 'last'
put conf/box.json '{' '	"first": 1,' '	// MODULE alpha+beta' '	"both": 2,' '	// /MODULE alpha+beta' '	"last": 3' '}'
apply_keeping 'alpha'
if [ "$status" -eq 0 ] && holds scripts/run 'first' 'last' && holds conf/box.json '{' '	"first": 1,' '	"last": 3' '}' \
	&& said_only 'edited scripts/run' 'edited conf/box.json'; then r=0; else r=1; fi
check "a block of two modules goes from a shell file and a JSON file once one of them is dropped" "$r"

new_case compound_unknown_part
put docs/guide.md 'Core.' '<!-- MODULE alpha+delta -->' 'Delta.' '<!-- /MODULE alpha+delta -->' '<!-- MODULE alpha+delta -->' 'Never closed.'
remember_tree
apply_keeping 'alpha beta gamma'
if [ "$status" -eq 0 ] && untouched && said_only 'note: docs/guide.md: fence of no manifest module: alpha+delta'; then r=0; else r=1; fi
check "a fence with a part that is no manifest module is left alone and named in one note" "$r"

new_case compound_closed_by_one
put docs/guide.md 'Core.' '<!-- MODULE alpha+beta -->' 'Both.' '<!-- /MODULE alpha -->' 'Last.'
