edited_scripts_parse() {
	parsed=0
	while IFS= read -r applied_line; do
		edited_file=${applied_line#edited }
		[ "$edited_file" != "$applied_line" ] || continue
		case $edited_file in
			*.sh) ;;
			*) case $(sed -n '1p' "$1/$edited_file") in '#!/bin/sh'|'#!/usr/bin/env sh') ;; *) continue ;; esac ;;
		esac
		sh -n "$1/$edited_file" || { printf '%s does not parse\n' "$edited_file"; return 1; }
		parsed=$((parsed + 1))
	done < "$2"
	[ "$parsed" -gt 0 ]
}
