exactly_the_dropped_lines_are_gone() {
	diff -rq "$pristine" "$tree" > "$own/differ" 2>&1
	sed 's/^\.\///' "$own/pristine-files" | BEFORE=$pristine AFTER=$tree MANIFEST=$live_manifest KEPT=$kept_set \
		DIFFERS=$own/differ LC_ALL=C awk '
		function trimmed(text) { sub(/^[ \t]+/, "", text); sub(/[ \t\r]+$/, "", text); return text }
		function field_rest(text, skipped,   i) {
			for (i = 1; i <= skipped; i++) text = substr(text, index(text, " ") + 1)
			return text
		}
		function first_field(text) { return substr(text, 1, index(text " ", " ") - 1) }
		function under(holder, name) { return (holder ~ /\/$/) ? (index(name, holder) == 1) : (holder == name) }
		function form_of(name) {
			sub(/^.*\//, "", name)
			if (name ~ /\.md$/) return "md"
			if (name ~ /\.jsonc?$/) return "json"
			if (name ~ /^\./ || name !~ /\./ || name ~ /\.(sh|yml|yaml|env|toml)$/) return "shell"
			return ""
		}
		function goes(names,   part, count, i) {
			count = split(names, part, "+")
			for (i = 1; i <= count; i++) if (!(part[i] in kept)) return 1
			return 0
		}
		function each_copy(file, what, owner,   i) {
			register(file, what, owner)
			for (i = 1; i <= installs; i++) {
				if (from[i] ~ /\/$/) { if (index(file, from[i]) == 1) register(to[i] substr(file, length(from[i]) + 1), what, owner) }
				else if (file == from[i]) register(to[i], what, owner)
			}
		}
		function register(file, what, owner) {
			if (what == "path") { held[++holders] = file; holder_module[holders] = owner }
			else rows_of[file] = rows_of[file] " " what
		}
		function fence(line) {
			line = trimmed(line)
			if (form == "md") {
				if (line !~ /^<!-- \/?MODULE [^ \t]+ -->$/) return 0
				line = substr(line, 6, length(line) - 9)
			} else if (form == "shell") {
				if (line !~ /^# \/?MODULE [^ \t]+$/) return 0
				line = substr(line, 3)
			} else {
				if (line !~ /^\/\/ \/?MODULE [^ \t]+$/) return 0
				line = substr(line, 4)
			}
			closing = (substr(line, 1, 1) == "/")
			fence_name = substr(line, closing ? 9 : 8)
			return of_modules(fence_name) && !all_own(fence_name)
		}
		function of_modules(names,   part, count, i) {
			count = split(names, part, "+")
			for (i = 1; i <= count; i++) if (!(part[i] in is_module)) return 0
			return 1
		}
		function all_own(names,   part, count, i) {
			count = split(names, part, "+")
			for (i = 1; i <= count; i++) if (!(part[i] in own)) return 0
			return 1
		}
		function mark(from_line, to_line,   i) { for (i = from_line; i <= to_line; i++) gone[i] = 1; marked = 1 }
		function mark_fences(   i, open, start) {
			open = ""
			for (i = 1; i <= n; i++) {
				if (!fence(old[i])) continue
				if (!closing && open == "") { open = fence_name; start = i }
				else if (closing && fence_name == open) {
					if (goes(open)) mark(start, i)
					open = ""
				}
			}
		}
		function mark_json(r,   i, line) {
			for (i = 1; i <= n; i++) {
				line = trimmed(old[i])
				sub(/,$/, "", line)
				if (line == "\"" text[r] "\"") mark(i, i)
			}
		}
		function mark_key(r,   i, j, indent, rest, value) {
			for (i = 2; i <= n && trimmed(old[i]) == ""; i++) ;
			match(old[i], /^[ \t]*/)
			indent = substr(old[i], 1, RLENGTH)
			for (i = 1; i <= n; i++) {
				if (substr(old[i], 1, length(indent)) != indent) continue
				rest = substr(old[i], length(indent) + 1)
				if (index(rest, "\"" text[r] "\"") != 1) continue
				rest = trimmed(substr(rest, length(text[r]) + 3))
				if (substr(rest, 1, 1) != ":") continue
				value = trimmed(substr(rest, 2))
				sub(/,$/, "", value)
				if (value !~ /[[{]$/) { mark(i, i); continue }
				for (j = i + 1; j <= n; j++) {
					if (substr(old[j], 1, length(indent)) != indent) continue
					value = substr(old[j], length(indent) + 1, 1)
					if (value == "}" || value == "]") break
				}
				mark(i, j)
			}
		}
		function mark_cut(r,   i, at) {
			for (i = 1; i <= n; i++) {
				at = index(old[i], text[r])
				if (!at) continue
				recut[i] = substr(old[i], 1, at - 1) substr(old[i], at + length(text[r]))
				marked = 1
			}
		}
		function only_a_comma_less(wanted, j,   k, q, line, c) {
			for (k = 1; k <= length(wanted); k++) {
				if (substr(wanted, k, 1) != ",") continue
				if (substr(wanted, 1, k - 1) substr(wanted, k + 1) != fresh[j]) continue
				if (substr(wanted, k + 1) !~ /^[ \t\r]*(\/\/.*)?$/) continue
				for (q = j + 1; q <= m; q++) {
					line = trimmed(fresh[q])
					if (line == "" || substr(line, 1, 2) == "//") continue
					c = substr(line, 1, 1)
					return c == "]" || c == "}"
				}
			}
			return 0
		}
		function compare(name,   after, line, i, j, wanted) {
			after = ENVIRON["AFTER"] "/" name
			m = 0
			split("", fresh)
			while ((getline line < after) > 0) fresh[++m] = line
			close(after)
			j = 0
			for (i = 1; i <= n; i++) {
				if (i in gone) continue
				wanted = (i in recut) ? recut[i] : old[i]
				if (++j > m) { print name ": line " i " is gone, though nothing of a dropped module holds it"; return 1 }
				if (fresh[j] == wanted || only_a_comma_less(wanted, j)) continue
				print name ": line " i " stands as line " j " changed: " fresh[j]
				return 1
			}
			if (j == m) return 0
			print name ": holds " (m - j) " line(s) beyond the lines a dropped module leaves"
			return 1
		}
		BEGIN {
			BINMODE = 3
			listed = split(ENVIRON["KEPT"], names, " ")
			for (i = 1; i <= listed; i++) kept[names[i]] = 1
			while ((getline row < ENVIRON["MANIFEST"]) > 0) {
				sub(/\r$/, "", row)
				sort = first_field(row)
				if (sort == "module") is_module[first_field(field_rest(row, 1))] = 1
				else if (sort == "installs") { from[++installs] = first_field(field_rest(row, 1)); to[installs] = field_rest(row, 2) }
				else if (sort == "path" || sort == "json" || sort == "key" || sort == "cut") list[++rows] = row
			}
			close(ENVIRON["MANIFEST"])
			for (r = 1; r <= rows; r++) {
				kind[r] = first_field(list[r])
				owners = first_field(field_rest(list[r], 1))
				if (kind[r] == "path") { each_copy(field_rest(list[r], 2), "path", owners); continue }
				text[r] = field_rest(list[r], 3)
				if (goes(owners)) each_copy(first_field(field_rest(list[r], 2)), r, owners)
			}
			prefix = "Files " ENVIRON["BEFORE"] "/"
			infix = " and " ENVIRON["AFTER"] "/"
			while ((getline line < ENVIRON["DIFFERS"]) > 0) {
				if (index(line, prefix) != 1) continue
				line = substr(line, length(prefix) + 1)
				at = index(line, infix)
				if (at) differs[substr(line, 1, at - 1)] = 1
			}
		}
		{
			name = $0
			split("", own)
			doomed = 0
			for (h = 1; h <= holders; h++) {
				if (!under(held[h], name)) continue
				if (holder_module[h] in kept) own[holder_module[h]] = 1
				else doomed = 1
			}
			if (doomed) next
			form = form_of(name)
			split("", old)
			split("", gone)
			split("", recut)
			n = 0
			before = ENVIRON["BEFORE"] "/" name
			while ((getline line < before) > 0) old[++n] = line
			close(before)
			marked = 0
			if (form != "") mark_fences()
			count = split(rows_of[name], mine, " ")
			for (k = 1; k <= count; k++) {
				r = mine[k]
				if (kind[r] == "json") mark_json(r)
				else if (kind[r] == "key") mark_key(r)
				else mark_cut(r)
			}
			if (marked) { if (compare(name)) wrong = 1 }
			else if (name in differs) { print name ": changed, though nothing of a dropped module stands in it"; wrong = 1 }
		}
		END { exit wrong }
	'
}

only_removed_paths_are_gone() {
	(cd "$tree" && find . -type f | sort) > "$own/tree-files"
	LC_ALL=C awk '
		stage == "removed" { if (sub(/^removed /, "")) removed[++removals] = "./" $0; next }
		stage == "after" { after[$0] = 1; if (!($0 in before)) appeared = 1; next }
		{ before[$0] = 1; file[++files] = $0 }
		END {
			for (f = 1; f <= files; f++) {
				if (file[f] in after) continue
				covered = 0
				for (p = 1; p <= removals; p++) {
					if (file[f] == removed[p]) covered = 1
					if (removed[p] ~ /\/$/ && substr(file[f], 1, length(removed[p])) == removed[p]) covered = 1
				}
				if (!covered) { print file[f]; vanished = 1 }
			}
			exit (appeared || vanished) ? 1 : 0
		}
	' "$own/pristine-files" stage=removed "$own/applied" stage=after "$own/tree-files"
}

