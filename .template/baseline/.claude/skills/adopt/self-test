settings_lines_stand_in_their_rows() {
	LC_ALL=C awk '
		function of_the_four(names,   part, count, i, found, joined) {
			count = split(names, part, "+")
			for (i = 1; i <= count; i++) found[part[i]] = 1
			joined = ""
			if ("agent-seat" in found) joined = joined "+agent-seat"
			if ("gate" in found) joined = joined "+gate"
			if ("security-lens" in found) joined = joined "+security-lens"
			if ("volumes" in found) joined = joined "+volumes"
			return substr(joined, 2)
		}
		FILENAME == ARGV[1] {
			if ($1 == "json" && $3 == ".claude/settings.json") {
				text = $0
				for (i = 1; i <= 3; i++) text = substr(text, index(text, " ") + 1)
				row_modules[text] = of_the_four($2)
			}
			next
		}
		{
			line = $0
			sub(/^[ \t]+/, "", line)
			sub(/[ \t\r]+$/, "", line)
			sub(/,$/, "", line)
			elsewhere = line
			gsub(/\.claude\/worktrees/, "", elsewhere)
			named = ""
			if (index(line, "fetch --prune origin)")) named = named "+agent-seat"
			if (index(line, "gate/")) named = named "+gate"
			if (index(line, "lens-request")) named = named "+security-lens"
			if (index(elsewhere, "/worktrees")) named = named "+volumes"
			named = substr(named, 2)
			inner = (line ~ /^".*"$/) ? substr(line, 2, length(line) - 2) : ""
			standing = (inner != "" && (inner in row_modules)) ? row_modules[inner] : ""
			if (standing != named) {
				print FNR ": " line
				misfit = 1
			}
		}
		END { exit misfit }
	' "$live_manifest" "$pristine/.claude/settings.json"
}

