{
	"permissions": {
		"allow": [
			"Edit(docs/**)",
			"Edit(CLAUDE.md)",
			"Edit(.claude/agents/**)",
			"Edit(.claude/worktrees/**)",
			"Edit(//worktrees/**)",
			"Edit(src/**)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git config core.hooksPath hooks)",
			"Bash(git config core.hooksPath)",
			"Bash(git config push.default nothing)",
			"Bash(git fetch origin)",
			"Bash(git fetch --prune origin)",
			"Bash(./verify:*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/.claude/worktrees/*/verify*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/.claude/worktrees/*/gate/dossier-check*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/.claude/worktrees/*/gate/walk*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/.claude/worktrees/*/gate/tip-evidence*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/.claude/worktrees/*/gate/scenario-check*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/.claude/worktrees/*/gate/lens-request*)",
			"Bash(/worktrees/*/verify*)",
			"Bash(/worktrees/*/gate/dossier-check*)",
			"Bash(/worktrees/*/gate/walk*)",
			"Bash(/worktrees/*/gate/tip-evidence*)",
			"Bash(/worktrees/*/gate/scenario-check*)",
			"Bash(/worktrees/*/gate/lens-request*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/agent/fold*)",
			"Bash(sh hooks/*)",
			"Bash(sh -n hooks/*)",
			"Bash(sh stacks/*)",
			"Bash(sh gate/*)"
		],
		"ask": [
			"Bash(gh api:*)",
			"Bash(git restore:*)",
			"Bash(git -C * restore*)",
			"Bash(git checkout:*)",
			"Bash(dd:*)",
			"Bash(xargs:*)",
			"Bash(curl:*)"
		],
		"deny": [
			"Bash(git push:*)",
			"Bash(git -C * push*)",
			"Bash(git merge *--no-verify*)",
			"Bash(git -C * merge *--no-verify*)",
			"Bash(git merge *--no-f*)",
			"Bash(git -C * merge *--no-f*)",
			"Bash(git merge *--sq*)",
			"Bash(git -C * merge *--sq*)",
			"Bash(rm -rf:*)",
			"Bash(rm:*)",
			"Bash(shred:*)",
			"Bash(sudo:*)",
			"Bash(git filter-branch:*)",
			"Bash(git -C * filter-branch*)",
			"Bash(git reset:*)",
			"Bash(git -C * reset*)",
			"Bash(git clean:*)",
			"Bash(git -C * clean*)",
			"Bash(git branch -D:*)",
			"Bash(git -C * branch -D*)",
			"Bash(git branch --delete --force:*)",
			"Bash(git -C * branch --delete --force*)",
			"Bash(git branch -d -f:*)",
			"Bash(git -C * branch -d -f*)",
			"Bash(git branch -df:*)",
			"Bash(git -C * branch -df*)",
			"Bash(git branch -fd:*)",
			"Bash(git -C * branch -fd*)",
			"Bash(git branch -f:*)",
			"Bash(git -C * branch -f*)",
			"Bash(git branch -M:*)",
			"Bash(git -C * branch -M*)",
			"Bash(git branch -C:*)",
			"Bash(git -C * branch -C*)",
			"Bash(git switch -C:*)",
			"Bash(git -C * switch -C*)",
			"Bash(git switch --force-create:*)",
			"Bash(git -C * switch --force-create*)",
			"Bash(git checkout -B:*)",
			"Bash(git -C * checkout -B*)",
			"Bash(git worktree add -B:*)",
			"Bash(git -C * worktree add -B*)",
			"Bash(cd *..*)",
			"Bash(cd *$*)",
			"Bash(cd *~*)",
			"Bash(cd *`*)",
			"Bash(sh hooks/*..*)",
			"Bash(sh -n hooks/*..*)",
			"Bash(sh stacks/*..*)",
			"Bash(sh gate/*..*)",
			"Bash(sh hooks/*breach-release*)",
			"Bash(hooks/breach-release*)",
			"Bash(./hooks/breach-release*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/.claude/worktrees/..*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/.claude/worktrees/*/..*)",
			"Bash(/worktrees/..*)",
			"Bash(/worktrees/*/..*)",
			"Bash(/workspaces/{{PROJECT_NAME}}/agent/fold*..*)",
			"EnterWorktree",
			"PowerShell",
			"Edit(**/.devcontainer/.claude-home/**)",
			"Read(**/.credentials.json)",
			"Read(.env)",
			"Read(.env.*)",
			"Read(**/secrets.local.*)"
		],
		"additionalDirectories": [
			"/tmp",
			"/worktrees"
		],
		"disableBypassPermissionsMode": "disable"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|Monitor",
				"hooks": [
					{
						"type": "command",
						"command": "case \"$CLAUDE_PROJECT_DIR\" in /*) ;; *) exit 0 ;; esac; g=\"$CLAUDE_PROJECT_DIR/agent/bash-shape-guard\"; [ -r \"$g\" ] && [ \"$(python3 -I -c 'import sys; print(sys.version_info >= (3, 9))' 2> /dev/null)\" = True ] && { python3 -I \"$g\"; [ $? -ne 2 ] || exit 2; }; exit 0",
						"timeout": 30
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "case \"$CLAUDE_PROJECT_DIR\" in /*) s=\"$CLAUDE_PROJECT_DIR/agent/session-check\"; [ -f \"$s\" ] && sh \"$s\" ;; *) m='agent guard inactive: CLAUDE_PROJECT_DIR is empty or no Linux path, so the hooks run no guard and its refusals are off'; printf '{\"systemMessage\":\"%s\",\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"%s\"}}\\n' \"$m\" \"$m\" ;; esac; exit 0",
						"timeout": 30
					}
				]
			}
		]
	},
	"worktree": {
		"baseRef": "head"
	}
}
