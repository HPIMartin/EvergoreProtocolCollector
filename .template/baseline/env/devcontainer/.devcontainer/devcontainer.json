{
	// ADAPT: project name; pick an image and toolchain features for your stack (pin explicit versions).
	"name": "{{PROJECT_NAME}}",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",
	"features": {
		// ADAPT: your stack's toolchains, pinned exactly per the stacks/ preset (example, Java):
		// "ghcr.io/devcontainers/features/java:1": { "version": "25" }
		// The node feature below is itself only a stack example; replace or remove it.
		"ghcr.io/devcontainers/features/node:1": { "version": "22.14.0" }
	},
	// Persistent per-project Claude home: survives container rebuilds (auth, memory, local settings).
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},
	"mounts": [
		"source=${localWorkspaceFolder}/.devcontainer/.claude-home,target=/home/vscode/.claude,type=bind"
	],
	// Wires the repo git hooks. ADAPT: append a warm-up run ("... && ./verify all") once the
	// project has a verify script, so the first real build finds a warm cache.
	// The CI preset (ci/gitlab/) builds this same folder into the pipeline image, where lifecycle
	// commands do not run: whatever the build needs belongs in "features" or a Dockerfile.
	"postCreateCommand": "git config core.hooksPath hooks",
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code"
				// ADAPT: stack extensions (example: "vscjava.vscode-java-pack")
			],
			"settings": {
				"files.eol": "\n"
			}
		}
	}
}
