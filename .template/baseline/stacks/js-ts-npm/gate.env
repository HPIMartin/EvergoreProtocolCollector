# The gate module's values for this preset (multi-agent-playbook.md, "The gate dossier"): /adopt
# copies them into the ADAPT block of gate/dossier-check. Each runner line below is the shape vitest
# prints with --reporter=verbose or cucumber-js's summary format prints; none was probed against a
# live run here. `verify all` runs cucumber-js last and stops at the first step that fails, so its
# success summary, a skipped scenario counted, proves the whole run and vitest's count the tests it
# executed. The features directory is the package root's, where `verify bdd` reads it. The @wip leg
# is off: it reads Cucumber-JVM's Gradle lines only.
features_dir='features'
test_readers='vitest sh'
test_path_re='(^|/)tests?/|^features/|\.(test|spec)\.[cm]?[jt]sx?$|(^|/)self-test$'
failure_marker='FAIL |×|✗|AssertionError|[0-9]+ scenarios? \([^)]*[0-9]+ failed'
frontend_root=''
needs_domain='^src/'
needs_frontend=''
reads_domain='^src/'
reads_frontend=''
walk_success_re='^[[:space:]]*(0 scenarios|[0-9]+ scenarios? \(([0-9]+ skipped, )?[0-9]+ passed\))[[:space:]]*$'
walk_task_lines=''
walk_count_re='^[[:space:]]*Tests[[:space:]]+([0-9]+) passed'
walk_failed_reports='artifacts/test-results/*.xml'
docs_guard_test=''
bdd_leg='off'
bdd_paths_re='^src/'
