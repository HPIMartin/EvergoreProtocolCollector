# The gate module's values for this preset (multi-agent-playbook.md, "The gate dossier"): /adopt
# copies them into the ADAPT block of gate/dossier-check. Reduced to the red leg: no reader of this
# port knows the runner's failing lines, so only a self-test's new cases are counted, and the walk
# and @wip legs are off until the project names its proof lines. The failure marker reads the
# failing lines of ctest and of pytest, which runs the acceptance scenarios through pytest-bdd, and
# a count of failures only in pytest's form; not the "- Failed" of a CMake configure check, nor the
# "0 failed" of a passing doctest summary.
features_dir='tests/acceptance/features'
test_readers='sh'
test_path_re='(^|/)tests/|(^|/)self-test$'
failure_marker='\*\*\*Failed|The following tests FAILED:|FAIL |^FAILED | FAILED( |$)|[1-9][0-9]* failed(,| in )'
frontend_root=''
needs_domain='^(src|include)/'
needs_frontend=''
reads_domain='^(src|include)/'
reads_frontend=''
walk_success_re=''
walk_task_lines=''
walk_count_re=''
walk_failed_reports=''
docs_guard_test=''
bdd_leg='off'
bdd_paths_re='^(src|include)/'
