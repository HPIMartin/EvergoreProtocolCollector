# The gate module's values for this preset (multi-agent-playbook.md, "The gate dossier"): /adopt
# copies them into the ADAPT block of gate/dossier-check. Reduced to the red leg: no reader of this
# port knows the runner's failing lines, so only a self-test's new cases are counted, and the walk
# and @wip legs are off until the project names its proof lines.
features_dir='tests'
test_readers='sh'
test_path_re='(^|/)tests/|(^|/)self-test$'
failure_marker='Failed |FAIL |Assert\.'
frontend_root=''
needs_domain='^src/'
needs_frontend=''
reads_domain='^src/'
reads_frontend=''
walk_success_re=''
walk_task_lines=''
walk_count_re=''
walk_failed_reports=''
docs_guard_test=''
bdd_leg='off'
bdd_paths_re='^src/'
