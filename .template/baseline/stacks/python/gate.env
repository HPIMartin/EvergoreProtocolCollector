# The gate module's values for this preset (multi-agent-playbook.md, "The gate dossier"): /adopt
# copies them into the ADAPT block of gate/dossier-check. Each runner line below is the shape
# `pytest -v` prints; none was probed against a live run here. The @wip leg is off: it reads
# Cucumber-JVM's Gradle lines only, and this preset's scenarios run under pytest-bdd.
features_dir='tests/features'
test_readers='pytest sh'
test_path_re='(^|/)tests/|(^|/)self-test$'
failure_marker='FAILED|(^|[[:space:]])ERROR([[:space:]]|$)|FAIL |AssertionError'
frontend_root=''
needs_domain='^src/'
needs_frontend=''
reads_domain='^src/'
reads_frontend=''
walk_success_re='^=+ [0-9]+ passed(, [0-9]+ (skipped|deselected|xfailed|xpassed|warnings?))* in '
walk_task_lines=''
walk_count_re='^=+ ([0-9]+) passed'
walk_failed_reports='artifacts/test-results/*.xml'
docs_guard_test=''
bdd_leg='off'
bdd_paths_re='^src/'
