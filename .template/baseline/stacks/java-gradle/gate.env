# The gate module's values for this preset (multi-agent-playbook.md, "The gate dossier"): /adopt
# copies them into the ADAPT block of gate/dossier-check. Each runner line below is the shape the
# preset's verify prints; none was probed against a live run here.
features_dir='src/test/resources/features'
test_readers='junit sh'
test_path_re='(^|/)src/test/|(^|/)self-test$'
failure_marker='FAILED|FAIL |AssertionError|AssertionFailedError'
frontend_root=''
needs_domain='^src/'
needs_frontend=''
reads_domain='^src/'
reads_frontend=''
walk_success_re='^BUILD SUCCESSFUL'
walk_task_lines='> Task :test'
walk_count_re='^\[verify\] executed test classes: ([0-9]+)$'
walk_failed_reports='build/test-results/test/*.xml'
# With the KB guard installed (README.md, "KB guard (optional)"): docs_guard_test='KbCitationGuardTest',
# and docs_guard_ran_re='^> Task :test( UP-TO-DATE)?$', because its declared inputs let an unchanged
# KB leave the test task up to date. Without the guard both stay as they are: empty, and '^> Task :test$'.
docs_guard_test=''
docs_guard_ran_re='^> Task :test$'
bdd_leg='on'
bdd_paths_re='^src/'
