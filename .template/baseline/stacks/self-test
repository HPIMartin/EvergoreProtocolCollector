line_of() { grep -nxF "$1" "$STUB_LOG" | head -n 1 | cut -d: -f1; }

installs_exactly_first() {
	project_with_every_tool "all-exact-$1" "$1/verify"
	STUB_CWD_LOG="$proj/cwd.log"
	export STUB_CWD_LOG
	attempt ./verify all
	unset STUB_CWD_LOG
	installed=$(line_of "$2")
	first_check=$(line_of "$3")
	if [ "$status" -eq 0 ] && [ -n "$installed" ] && [ -n "$first_check" ] &&
		[ "$installed" -lt "$first_check" ] && [ "$(grep -cxF "$2" "$STUB_LOG")" -eq 1 ] &&
		grep -qxF "$2 in $(cd "$proj/$4" && pwd -P)" "$proj/cwd.log"; then
		r=0
	else
		r=1
	fi
	case "$4" in
		.) where='at the root' ;;
		*) where="in $4/" ;;
	esac
	check "$1 all installs exactly what the lock file names, $where, before its first check" "$r"
}
