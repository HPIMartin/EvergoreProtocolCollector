#!/bin/sh
# > **ADAPT:** after changing a preset's verify script, change the case that pins the behaviour with
# > it. A preset whose verify script this suite does not cover is a preset nobody proved.
set -eu

stacks_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for leaked in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
	unset "$leaked"
done
unset SELENIUM_TAG GRID_INSPECT_FAILS GRID_INSPECT_ANSWER GRID_COMPOSE_FAILS GRID_HUB_ID GRID_HUB_HEALTH GRID_HUB_INSPECT_FAILS GRID_HUB_PS_FAILS

path_base="/usr/bin:/bin"
git_bin=$(command -v git || true)
[ -z "$git_bin" ] || path_base="$path_base:$(dirname "$git_bin")"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failures=0
proj=""
bin=""
out_file=""
status=0

check() {
	if [ "$2" -eq 0 ]; then
		printf '  ok   %s\n' "$1"
	else
		printf '  FAIL %s\n' "$1"
		failures=$((failures + 1))
	fi
}

stub_at() {
	cat > "$1" <<'STUB'
#!/bin/sh
name=$(basename "$0")
printf '%s %s\n' "$name" "$*" >> "$STUB_LOG"
[ -z "${STUB_CWD_LOG:-}" ] || printf '%s %s in %s\n' "$name" "$*" "$(pwd -P)" >> "$STUB_CWD_LOG"
if [ -n "${STUB_FAIL_MATCH:-}" ]; then
	if printf '%s %s' "$name" "$*" | grep -qE "$STUB_FAIL_MATCH"; then
		exit "${STUB_FAIL_CODE:-1}"
	fi
fi
exit 0
STUB
	chmod +x "$1"
}

stub() { stub_at "$bin/$1"; }

preset_tools=$(grep -h -o 'require [A-Za-z0-9_.][A-Za-z0-9_./-]*' "$stacks_dir"/*/verify | sed 's/^require //' |
	grep -v -x -e git -e '\./.*' | sort -u | tr '\n' ' ')
hidden_tools="$preset_tools docker"
hide_key=""
hidden_path=""

stand_in_for() {
	stand_in=$(PATH=$path_base mktemp -d "$work/stand-in.XXXXXX")
	names=$2
	set -- "$1"/. ! -name . -prune
	for name in $names; do
		set -- "$@" ! -name "$name" ! -name "$name.exe"
	done
	PATH=$path_base find "$@" -exec sh -c 'ln -s "$@" "$0"/' "$stand_in" {} +
}

hide() {
	[ "$1 / $2" != "$hide_key" ] || return 0
	hide_key="$1 / $2"
	hidden_path=""
	old_ifs=$IFS
	IFS=:
	for dir in $1; do
		IFS=$old_ifs
		for hidden in $2; do
			if [ -e "$dir/$hidden" ] || [ -e "$dir/$hidden.exe" ]; then
				stand_in_for "$dir" "$2"
				dir=$stand_in
				break
			fi
		done
		hidden_path="${hidden_path:+$hidden_path:}$dir"
		IFS=:
	done
	IFS=$old_ifs
}

locks=0
lock=""

aim_build_lock() {
	locks=$((locks + 1))
	lock="$work/build-$locks.lock"
	sed "s|^build_lock=.*|build_lock=\"$lock\"|" verify > verify.aimed
	mv verify.aimed verify
	chmod +x verify
	STUB_LOCK=$lock
	export STUB_LOCK
}

project() {
	name=$1
	script=$2
	shift 2
	proj="$work/$name"
	bin="$proj/stub-bin"
	out_file="$proj/out.txt"
	mkdir -p "$proj" "$bin"
	cd "$proj"
	if [ -z "${no_git:-}" ]; then
		git init -q .
		git config user.email stack@example.com
		git config user.name Stack
	fi
	cp "$stacks_dir/$script" verify
	chmod +x verify
	aim_build_lock
	STUB_LOG="$proj/stub.log"
	: > "$STUB_LOG"
	export STUB_LOG
	unset STUB_FAIL_MATCH STUB_FAIL_CODE
	hide "$path_base" "$hidden_tools"
	PATH="$bin:$hidden_path"
	export PATH
	for tool in "$@"; do
		stub "$tool"
	done
}

project_without_git() {
	no_git=1
	project "$@"
	no_git=""
}

project_with_every_tool() {
	project "$1" "$2" $preset_tools
	stub_at "$proj/gradlew"
	mkdir -p frontend
}

fails_with() {
	STUB_FAIL_MATCH=$1
	STUB_FAIL_CODE=$2
	export STUB_FAIL_MATCH STUB_FAIL_CODE
}

attempt() {
	set +e
	"$@" > "$out_file" 2>&1
	status=$?
	set -e
}

logged() { grep -qF "$1" "$STUB_LOG"; }

printf 'stack preset self-test\n'

