skip() {
	if [ "${STACKS_SELF_TEST_STRICT:-}" = 1 ]; then
		printf '  FAIL %s: skipped under STACKS_SELF_TEST_STRICT=1: %s\n' "$1" "$2"
		failures=$((failures + 1))
		return 0
	fi
	printf '  skip %s: %s\n' "$1" "$2"
	skips=$((skips + 1))
	skipped="$skipped
  skipped: $1"
}

lock_case() {
	if [ -z "$lock_here" ]; then
		skip "$1" "this machine lacks flock, timeout or /proc"
		return 0
	fi
	r=0
	lock_skip=""
	"$2"
	if [ -n "$lock_skip" ]; then
		skip "$1" "$lock_skip"
	else
		check "$1" "$r"
	fi
}

summarize() {
	printf 'stack preset self-test: '
	if [ "$failures" -eq 0 ]; then
		printf 'all cases pass'
	else
		printf '%s case(s) FAILED' "$failures"
	fi
	if [ "$skips" -eq 0 ]; then
		printf '\n'
	else
		printf ', %s case(s) skipped, unproved on this machine (STACKS_SELF_TEST_STRICT=1 fails on a skip):%s\n' \
			"$skips" "$skipped"
	fi
	[ "$failures" -eq 0 ]
}

skip_run() {
	(
		lock_here=""
		failures=0
		skips=0
		skipped=""
		STACKS_SELF_TEST_STRICT=$1
		lock_case 'a case this machine cannot prove' true
		summarize
	) > "$work/skip.out" 2>&1
}

