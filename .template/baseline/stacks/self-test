for row in 'java-gradle format ^gradlew format all' \
	'js-ts-npm format format:check format all' 'js-ts-npm tests ^npm.test all' \
	'python format ruff.format format all' 'python tests pytest all' \
	'cpp format ^clang-format.+--Werror format all' 'cpp tests ^ctest all' \
	'csharp-dotnet format ^dotnet.format format all' 'csharp-dotnet tests ^dotnet.test all' \
	'multi-stack format ^npm.run.--silent.format:check format all' 'multi-stack tests ^npm.test all'; do
	set -- $row
	preset=$1
	failed=$2
	failing=$3
	shift 3
	case "$preset $failed" in
		'multi-stack format') what="only the frontend's format check fails" ;;
		'multi-stack tests') what="only the frontend's tests fail" ;;
		*' format') what="its format check fails" ;;
		*) what="its tests fail" ;;
	esac
	for sub; do
		project_with_every_tool "failing-$preset-$failed-$sub" "$preset/verify"
		: > a.cpp
		git add a.cpp
		fails_with "$failing" 1
		attempt ./verify "$sub"
		if [ "$status" -eq 1 ]; then r=0; else r=1; fi
		check "$preset $sub exits 1 when $what" "$r"
	done
done

