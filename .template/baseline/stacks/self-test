await() {
	tries=0
	until "$@" 2>/dev/null; do
		tries=$((tries + 1))
		[ "$tries" -lt 100 ] || return 1
		sleep 0.1
	done
}

waits_seen() { [ "$(grep -c 'waiting for' "$1")" -ge "$2" ]; }

lock_stub_at() {
	cat > "$1" <<'STUB'
#!/bin/sh
name=$(basename "$0")
if flock -n "$STUB_LOCK" true; then state=free; else state=held; fi
printf '%s %s %s %s\n' "$name" "$state" "${STUB_RUN:-run}" "$*" >> "$STUB_LOG"
if [ -n "${STUB_HOLD:-}" ] && [ "${STUB_HOLD_ONLY:-$name}" = "$name" ]; then
	: > "$STUB_HOLD.held"
	until [ -e "$STUB_HOLD.go" ]; do sleep 0.1; done
fi
if [ -n "${STUB_NEST:-}" ]; then
	STUB_NEST= ./verify focus "$STUB_NEST" || exit 1
	if flock -n "$STUB_LOCK" true; then state=free; else state=held; fi
	printf '%s %s after the nested run\n' "$name" "$state" >> "$STUB_LOG"
fi
if [ -n "${STUB_LINGER:-}" ]; then
	sleep 30 < /dev/null > /dev/null 2>&1 &
	printf '%s\n' "$!" >> "$STUB_LINGER"
fi
printf '%s done %s\n' "$name" "${STUB_RUN:-run}" >> "$STUB_LOG"
exit 0
STUB
	chmod +x "$1"
}

lock_project() {
	project "$1" "$2"
	for tool in $preset_tools ./gradlew; do
		[ "$tool" != "${3:-}" ] || continue
		case "$tool" in
			./*) lock_stub_at "$proj/${tool#./}" ;;
			*) lock_stub_at "$bin/$tool" ;;
		esac
	done
	mkdir -p frontend
}

hold_lock() {
	timeout 60 flock "$lock" sh -c ': > "$1.held"; until [ -e "$1.go" ]; do sleep 0.1; done' _ "$1" &
	holder=$!
	await test -e "$1.held"
}

release_lock() {
	: > "$1.go"
	wait "$holder" || true
}

waited() { grep -q 'waiting for' "$out_file"; }

