r=0
for preset in $presets; do
	awk -v q="'" '
		function all_three() { return seen["HUP"] && seen["INT"] && seen["TERM"] }
		/^[ \t]*trap - "\$1"$/ { next }
		/^[ \t]*trap / {
			cond = $NF
			if (cond == "EXIT") {
				if (exit_traps && !all_three()) bad = 1
				exit_traps++
				split("", seen)
				cleanup = ""
				if (match($0, "release_build_lock; .*" q " EXIT$")) cleanup = substr($0, RSTART + 20, RLENGTH - 26)
				next
			}
			if (cond != "HUP" && cond != "INT" && cond != "TERM") { bad = 1; next }
			if (!exit_traps) bad = 1
			if ($0 !~ ("end_by_signal " cond q " " cond "$")) bad = 1
			if (cleanup != "" && index($0, q cleanup "; end_by_signal ") == 0) bad = 1
			seen[cond] = 1
		}
		END { if (!exit_traps || !all_three()) bad = 1; exit bad }' \
		"$stacks_dir/$preset/verify" || r=1
done
