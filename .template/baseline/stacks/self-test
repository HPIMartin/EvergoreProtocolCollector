	done
}
lock_case "focus, bdd, all and vuln run inside the build lock in every single-stack preset" \
	lock_taken_by_every_building_command

lock_held_across_the_composition() {
	lock_project lock-composed multi-stack/verify
	for run in all vuln; do
		: > "$STUB_LOG"
		attempt timeout 20 ./verify "$run"
		if [ "$status" -ne 0 ] || waited || grep -q ' free ' "$STUB_LOG"; then r=1; fi
		grep -q '^gradlew held ' "$STUB_LOG" || r=1
		grep -q '^npm held ' "$STUB_LOG" || r=1
	done
	for run in 'focus frontend/src/a.test.ts' 'focus src/test/resources/features/x.feature' \
		'focus src/test/java/ThingTest.java' bdd; do
		: > "$STUB_LOG"
		attempt timeout 20 ./verify $run
		if [ "$status" -ne 0 ] || [ ! -s "$STUB_LOG" ] || waited || grep -q ' free ' "$STUB_LOG"; then r=1; fi
	done
}
lock_case "the composed script runs every stack of a building command inside one hold of the lock and never waits for itself" \
	lock_held_across_the_composition

lock_queues_a_second_run() {
	lock_project lock-wait python/verify
	STUB_RUN=first STUB_HOLD="$proj/first" timeout 60 ./verify bdd > "$proj/first.out" 2>&1 &
	first_run=$!
	await test -e "$proj/first.held" || r=1
	STUB_RUN=second timeout 60 ./verify bdd > "$proj/second.out" 2>&1 &
	second_run=$!
	await grep -qF "[verify] waiting for $lock: another build on this machine holds it" "$proj/second.out" || r=1
	if grep -q ' second ' "$STUB_LOG"; then r=1; fi
	: > "$proj/first.go"
	first_status=0
	wait "$first_run" || first_status=$?
	second_status=0
	wait "$second_run" || second_status=$?
	[ "$first_status" -eq 0 ] && [ "$second_status" -eq 0 ] || r=1
	[ "$(awk '{ printf "%s ", $3 }' "$STUB_LOG")" = 'first first second second ' ] || r=1
}
lock_case "a second building run says it waits for the lock while another holds it, and runs after it" \
	lock_queues_a_second_run

lock_reentered_under_a_holder() {
	lock_project lock-reentry python/verify
	attempt timeout 20 flock "$lock" ./verify bdd
	if [ "$status" -ne 0 ] || waited || ! grep -q '^uv held ' "$STUB_LOG"; then r=1; fi
	: > "$STUB_LOG"
	STUB_NEST=tests/test_inner.py
	export STUB_NEST
	attempt timeout 20 ./verify bdd
	unset STUB_NEST
	if [ "$status" -ne 0 ] || waited || [ "$(grep -c '^uv done ' "$STUB_LOG")" -ne 2 ]; then r=1; fi
	grep -q '^uv held after the nested run$' "$STUB_LOG" || r=1
}
lock_case "a run inside a process that holds the lock, a flock holder or a verify run, goes on without waiting for itself and leaves the holder's lock held" \
	lock_reentered_under_a_holder

lock_freed_past_a_lingering_child() {
	for pair in python:bdd java-gradle:all multi-stack:all; do
		preset=${pair%%:*}
		run=${pair#*:}
		lock_project "lock-linger-$preset" "$preset/verify"
		: > "$proj/linger"
		STUB_LINGER="$proj/linger"
		export STUB_LINGER
		attempt timeout 20 ./verify "$run"
		unset STUB_LINGER
		if [ "$status" -ne 0 ] || [ ! -s "$proj/linger" ]; then r=1; fi
		flock -n "$lock" true || r=1
		attempt timeout 10 ./verify "$run"
		if [ "$status" -ne 0 ] || waited; then r=1; fi
		while read -r pid; do
			kill "$pid" 2> /dev/null || true
		done < "$proj/linger"
	done
}
lock_case "a building run frees the lock when it ends, though a process it started still holds the lock file open, with or without an exit trap of its own command" \
	lock_freed_past_a_lingering_child

signal_launch() {
	launch=""
	if env --default-signal="$1" true 2> /dev/null; then
		launch="env --default-signal=$1"
	elif [ "$1" = INT ]; then
		lock_skip="env here cannot give a background run its SIGINT back"
		return 1
	fi
}

lock_freed_on_a_signal() {
	signal_launch "$signal" || return 0
	lock_project "lock-signal-$signal" python/verify
	: > "$proj/linger"
	STUB_HOLD="$proj/tool" STUB_LINGER="$proj/linger" $launch ./verify bdd > "$proj/signal.out" 2>&1 &
	run_pid=$!
	await test -e "$proj/tool.held" || r=1
	kill -s "$signal" "$run_pid" || r=1
	: > "$proj/tool.go"
	wait "$run_pid" || true
	await grep -q '^uv done ' "$STUB_LOG" || r=1
	flock -n "$lock" true || r=1
	while read -r pid; do
		kill "$pid" 2> /dev/null || true
	done < "$proj/linger"
}
for signal in TERM HUP INT; do
	lock_case "a building run ended by SIG$signal frees the lock once its tool ends, though a process it started still holds the lock file open" \
		lock_freed_on_a_signal
done

lock_ended_by_a_signal() {
	case "$signal" in
		HUP) killed=129 ;;
		INT) killed=130 ;;
		TERM) killed=143 ;;
	esac
	signal_launch "$signal" || return 0
	lock_project "lock-end-$signal" python/verify
	STUB_HOLD="$proj/tool" $launch ./verify all > "$proj/signal.out" 2>&1 &
	run_pid=$!
	await test -e "$proj/tool.held" || r=1
	kill -s "$signal" "$run_pid" || r=1
	: > "$proj/tool.go"
	run_status=0
	wait "$run_pid" || run_status=$?
	[ "$run_status" -eq "$killed" ] || r=1
	[ "$(grep -c '^uv \(held\|free\) ' "$STUB_LOG")" -eq 1 ] || r=1
	flock -n "$lock" true || r=1
}
for signal in TERM HUP INT; do
	lock_case "a building run ended by SIG$signal starts no step after its tool ends and ends by that signal" \
		lock_ended_by_a_signal
done

lock_ended_where_the_signal_cannot_kill() {
	signal_launch TERM
	lock_project lock-end-unkillable python/verify
	STUB_HOLD="$proj/tool" $launch sh -c 'kill() { :; }; . "$0"' ./verify all > "$proj/signal.out" 2>&1 &
	run_pid=$!
	await test -e "$proj/tool.held" || r=1
	kill -s TERM "$run_pid" || r=1
	: > "$proj/tool.go"
	run_status=0
	wait "$run_pid" || run_status=$?
	[ "$run_status" -eq 1 ] || r=1
	[ "$(grep -c '^uv \(held\|free\) ' "$STUB_LOG")" -eq 1 ] || r=1
	flock -n "$lock" true || r=1
}
lock_case "a building run that the signal it re-raises cannot end, as a container's first process, starts no step after its tool ends and exits 1" \
	lock_ended_where_the_signal_cannot_kill

lock_interrupt_stops_the_caller() {
	if ! env --default-signal=INT true 2> /dev/null || ! command -v bash > /dev/null 2>&1 ||
		! command -v setsid > /dev/null 2>&1; then
		lock_skip="this machine lacks bash, setsid or an env that gives a background run its SIGINT back"
		return 0
	fi
	lock_project lock-interrupt-caller python/verify
	STUB_HOLD="$proj/tool" env --default-signal=INT setsid bash -c './verify all; ./verify all' \
		> "$proj/caller.out" 2>&1 &
	caller=$!
	await test -e "$proj/tool.held" || r=1
	kill -INT "-$caller" || r=1
	: > "$proj/tool.go"
	caller_status=0
	wait "$caller" || caller_status=$?
	[ "$caller_status" -eq 130 ] || r=1
	[ "$(grep -c '^uv \(held\|free\) ' "$STUB_LOG")" -eq 1 ] || r=1
	flock -n "$lock" true || r=1
}
lock_case "an interrupt to a bash loop over verify ends the run by the signal, so the loop starts no further run" \
	lock_interrupt_stops_the_caller

lock_cleaned_up_on_a_signal() {
	lock_project lock-cleanup-signal multi-stack/verify
	mkdir -p "$proj/tmp"
	signal_launch TERM
	STUB_HOLD="$proj/tool" STUB_HOLD_ONLY=npm TMPDIR="$proj/tmp" $launch ./verify all > "$proj/signal.out" 2>&1 &
	run_pid=$!
	await test -e "$proj/tool.held" || r=1
	kill -s TERM "$run_pid" || r=1
	: > "$proj/tool.go"
	run_status=0
	wait "$run_pid" || run_status=$?
	[ "$run_status" -eq 143 ] || r=1
	[ "$(grep -c '^npm \(held\|free\) ' "$STUB_LOG")" -eq 1 ] || r=1
	[ -z "$(ls -A "$proj/tmp")" ] || r=1
	flock -n "$lock" true || r=1
}
lock_case "the composed script's all, ended by a signal while its results file exists, removes that file as it ends" \
	lock_cleaned_up_on_a_signal

lock_awaited_through_an_unlocked_descriptor() {
	lock_project lock-open-unlocked python/verify
	hold_lock "$proj/holder" || r=1
	timeout 60 sh -c 'exec 7<"$1"; ./verify bdd' _ "$lock" > "$proj/caller.out" 2>&1 &
	caller=$!
	await waits_seen "$proj/caller.out" 1 || r=1
	if [ -s "$STUB_LOG" ]; then r=1; fi
	release_lock "$proj/holder"
	caller_status=0
	wait "$caller" || caller_status=$?
	if [ "$caller_status" -ne 0 ] || ! grep -q '^uv held ' "$STUB_LOG"; then r=1; fi
}
lock_case "a run that holds the lock file open but not its lock waits for the lock like any other, and runs no tool before it" \
	lock_awaited_through_an_unlocked_descriptor

lock_unrelated_descriptor_kept() {
	lock_project lock-unrelated java-gradle/verify
	: > "$proj/other.lock"
	attempt timeout 20 sh -c 'exec 9<"$1"; flock -n 9 || exit 9; flock "$2" ./verify all || exit 7; if flock -n "$1" true; then exit 8; fi' \
		_ "$proj/other.lock" "$lock"
	[ "$status" -eq 0 ] || r=1
}
lock_case "a run that took no lock, one inside a holder whose command sets its own exit trap, frees no lock its caller holds on descriptor 9" \
	lock_unrelated_descriptor_kept

lock_never_awaited() {
	for preset in $presets; do
		lock_project "lock-never-$preset" "$preset/verify"
		hold_lock "$proj/holder" || r=1
		for run in format stop outdated; do
			attempt timeout 10 ./verify "$run"
			if [ "$status" -ne 0 ] || waited; then r=1; fi
		done
		release_lock "$proj/holder"
	done
}
lock_case "format, stop and outdated never wait for the lock, in every preset" lock_never_awaited

lock_refused_before_the_queue() {
	for preset in $presets; do
		lock_project "lock-usage-$preset" "$preset/verify"
		hold_lock "$proj/holder" || r=1
		for run in nonsense focus; do
			attempt timeout 10 ./verify $run
			if [ "$status" -ne 2 ] || waited; then r=1; fi
		done
		stray=""
		case "$preset" in
			multi-stack) stray=docs/readme.md ;;
			csharp-dotnet) stray=src/Thing.cs ;;
		esac
		if [ -n "$stray" ]; then
			attempt timeout 10 ./verify focus "$stray"
			if [ "$status" -ne 2 ] || waited || [ -s "$STUB_LOG" ]; then r=1; fi
		fi
		release_lock "$proj/holder"
	done
	for refusal in java-gradle:./gradlew:bdd js-ts-npm:npm:bdd python:uv:bdd csharp-dotnet:dotnet:bdd \
		cpp:uv:focus:tests/acceptance/x.feature cpp:uv:all multi-stack:npm:all multi-stack:npm:vuln; do
		preset=${refusal%%:*}
		rest=${refusal#*:}
		missing=${rest%%:*}
		run=$(printf '%s' "${rest#*:}" | tr ':' ' ')
		lock_project "lock-tool-$preset-$locks" "$preset/verify" "$missing"
		hold_lock "$proj/holder" || r=1
		attempt timeout 10 ./verify $run
		if [ "$status" -ne 1 ] || waited || [ -s "$STUB_LOG" ]; then r=1; fi
		release_lock "$proj/holder"
	done
}
lock_case "a usage error or a missing tool is refused before the queue, and before any tool runs" \
	lock_refused_before_the_queue

lock_file_readable_to_all() {
	lock_project lock-mode python/verify
	[ ! -e "$lock" ] || r=1
	attempt sh -c 'umask 077 && timeout 20 ./verify bdd'
	[ "$status" -eq 0 ] || r=1
	case "$(ls -l "$lock" 2> /dev/null)" in
		'-rw-r--r--'*) ;;
		*) r=1 ;;
	esac
}
lock_case "a first building run under umask 077 leaves the lock file readable to every user, with mode 644" \
	lock_file_readable_to_all

lock_unreadable_refused() {
	lock_project lock-unreadable python/verify
	: > "$lock"
	chmod 000 "$lock"
	reader=""
	if [ "$(id -u)" -eq 0 ]; then
		reader="setpriv --inh-caps=-all --bounding-set=-dac_override,-dac_read_search"
	fi
	if $reader sh -c ': < "$1"' _ "$lock" 2>/dev/null; then
		lock_skip="a file with mode 000 stays readable to this user"
	else
		attempt timeout 10 $reader ./verify bdd
		if [ "$status" -ne 1 ] || [ -s "$STUB_LOG" ] ||
			! grep -qF "[verify] cannot read $lock, the machine-wide build lock; its owner can make it readable" "$out_file"; then
			r=1
		fi
	fi
	chmod 644 "$lock"
}
lock_case "an unreadable lock file stops a building run with a named message, before any tool runs" \
	lock_unreadable_refused

lock_requeued_on_a_new_file() {
	lock_project lock-deleted python/verify
	hold_lock "$proj/old" || r=1
	old_holder=$holder
	STUB_RUN=waiter timeout 60 ./verify bdd > "$proj/waiter.out" 2>&1 &
	waiter=$!
	await waits_seen "$proj/waiter.out" 1 || r=1
	rm -f "$lock"
	hold_lock "$proj/new" || r=1
	new_holder=$holder
	: > "$proj/old.go"
	wait "$old_holder" || true
	await waits_seen "$proj/waiter.out" 2 || r=1
	if grep -q ' waiter ' "$STUB_LOG"; then r=1; fi
	: > "$proj/new.go"
	wait "$new_holder" || true
	waiter_status=0
	wait "$waiter" || waiter_status=$?
	if [ "$waiter_status" -ne 0 ] || ! grep -q '^uv held waiter ' "$STUB_LOG"; then r=1; fi
}
lock_case "a run that waited on a deleted lock file queues again on the new one" lock_requeued_on_a_new_file

summarize || exit 1
