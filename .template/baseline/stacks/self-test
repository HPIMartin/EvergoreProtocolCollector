grid_project() {
	project "$1" java-gradle/grid/grid
	cp "$stacks_dir/java-gradle/grid/compose.yaml" "$proj/compose.yaml"
	GRID_STATE="$proj/state"
	export GRID_STATE
	mkdir -p "$GRID_STATE"
	: > "$GRID_STATE/members"
	printf '#!/bin/sh\nprintf "abc123def\\n"\n' > "$bin/hostname"
	chmod +x "$bin/hostname"
	cat > "$bin/docker" <<'STUB'
#!/bin/sh
printf 'docker %s\n' "$*" >> "$STUB_LOG"
members="$GRID_STATE/members"
case "$1 $2" in
	"inspect --type")
		case "$*" in
			*State.Health*)
				[ -z "${GRID_HUB_INSPECT_FAILS:-}" ] || exit 1
				[ "$6" = "${GRID_HUB_ID-hub123}" ] || exit 1
				printf '%s\n' "${GRID_HUB_HEALTH-healthy}"
				exit 0
				;;
		esac
		[ -z "${GRID_INSPECT_FAILS:-}" ] || exit 1
		printf '%s\n' "${GRID_INSPECT_ANSWER-/self-box}"
		;;
	"compose -f")
		printf 'compose-tag %s\n' "${SELENIUM_TAG-unset}" >> "$STUB_LOG"
		[ -z "${GRID_COMPOSE_FAILS:-}" ] || exit 1
		case "$*" in
			*' ps --quiet selenium-hub')
				[ -z "${GRID_HUB_PS_FAILS:-}" ] || exit 1
				printf '%s\n' "${GRID_HUB_ID-hub123}"
				;;
		esac
		;;
	"network inspect")
		cat "$members"
		;;
	"network connect")
		for last; do :; done
		printf '%s\n' "$last" >> "$members"
		;;
	"network disconnect")
		for last; do :; done
		grep -vxF "$last" "$members" > "$members.next" || true
		mv "$members.next" "$members"
		;;
esac
exit 0
STUB
	chmod +x "$bin/docker"
}

